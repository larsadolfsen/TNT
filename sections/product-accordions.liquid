<section class="px-4 py-4 bg-white" id="shopify-section-accordions-{{ section.id }}">
  <div class="divide-y divide-outline-variant border-y border-outline-variant max-w-screen-xl mx-auto">
    {%- for block in section.blocks -%}
      <div class="accordion-item py-4" {{ block.shopify_attributes }}>
        <button class="accordion-trigger flex items-center justify-between w-full text-left font-bold text-primary focus:outline-none">
          <span class="text-sm">{{ block.settings.title }}</span>
          <span class="material-symbols-outlined text-on-surface-variant transition-transform duration-200">expand_more</span>
        </button>
        <div class="accordion-content hidden mt-3 text-sm text-on-surface-variant space-y-2">
          {{ block.settings.content }}
        </div>
      </div>
    {%- endfor -%}
  </div>
</section>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const sectionContainer = document.getElementById("shopify-section-accordions-{{ section.id }}");
    if (!sectionContainer) return;
    
    const triggers = sectionContainer.querySelectorAll(".accordion-trigger");
    triggers.forEach(trigger => {
      trigger.addEventListener("click", function() {
        const content = this.nextElementSibling;
        const icon = this.querySelector(".material-symbols-outlined");
        
        if (content.classList.contains("hidden")) {
          content.classList.remove("hidden");
          if (icon) icon.classList.add("rotate-180");
        } else {
          content.classList.add("hidden");
          if (icon) icon.classList.remove("rotate-180");
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Klap-ud Paneler",
