<!-- Header (Not Sticky) -->
<header class="bg-white border-b border-outline-variant py-4 px-4">
  <div class="max-w-screen-xl mx-auto flex flex-col gap-4">
    <div class="flex items-center justify-between">
      <button id="menu-toggle" class="focus:outline-none bg-transparent border-0 p-0 cursor-pointer" aria-label="Menu" onclick="toggleMobileMenu(true)">
        <span class="material-symbols-outlined text-2xl text-primary block">menu</span>
      </button>
      <a href="{{ routes.root_url }}" class="font-serif text-2xl font-bold text-primary tracking-tight no-underline">
        {%- if section.settings.logo_text != blank -%}
          {{ section.settings.logo_text }}
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>
      <a href="{{ routes.cart_url }}" onclick="event.preventDefault(); toggleCartDrawer(true);" class="relative cursor-pointer text-primary no-underline">
        <span class="material-symbols-outlined text-2xl text-primary">shopping_cart</span>
        <span id="cart-counter" class="absolute -top-1 -right-1 bg-primary text-white text-[10px] font-bold px-1.5 rounded-full transition-transform duration-300 {% if cart.item_count == 0 %}scale-0{% endif %}">
          {{ cart.item_count }}
        </span>
      </a>
    </div>
    <!-- Search Bar -->
    {%- if section.settings.show_search -%}
      <form action="{{ routes.search_url }}" method="get" class="relative m-0">
        <input 
          type="text" 
          name="q" 
          id="search-input" 
          class="w-full h-10 pl-10 pr-4 rounded-full border border-outline-variant text-sm focus:ring-1 focus:ring-primary focus:border-primary bg-surface-container focus:outline-none" 
          placeholder="Søg efter klar voksdug, tykkelser eller dækkeservietter..."
        />
        <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-xl">search</span>
      </form>
    {%- endif -%}

    <!-- Menu under search bar -->
    {%- if section.settings.show_menu and section.settings.menu != blank -%}
      {%- assign header_menu = linklists[section.settings.menu] -%}
      {%- if header_menu.links.size > 0 -%}
        <nav class="w-full overflow-x-auto hide-scrollbar py-1 -mx-4 px-4 md:mx-0 md:px-0" aria-label="Kategori menu">
          <ul class="flex items-center gap-5 whitespace-nowrap md:justify-center md:flex-wrap list-none p-0 m-0">
            {%- for link in header_menu.links -%}
              <li>
                <a 
                  href="{{ link.url }}" 
                  class="text-sm font-medium text-primary hover:text-[#FFD814] border-b-2 border-transparent hover:border-[#FFD814] pb-1 transition-all duration-200 no-underline {% if link.active %}text-[#FFD814] border-[#FFD814]{% endif %}"
                  {% if link.active %}aria-current="page"{% endif %}
                >
                  {{ link.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endif -%}
  </div>
</header>

<!-- Mobile Menu Slide-out Drawer -->
<div id="mobile-menu-drawer" class="fixed inset-0 bg-black/50 z-50 hidden flex justify-start transition-opacity duration-300 opacity-0">
  <div class="bg-white w-5/6 max-w-sm h-full flex flex-col justify-between shadow-2xl p-6 transition-transform duration-300 -translate-x-full">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-outline-variant mb-6">
        <span class="font-serif text-xl font-bold text-primary tracking-tight">Menu</span>
        <button onclick="toggleMobileMenu(false)" class="material-symbols-outlined text-2xl text-primary bg-transparent border-0 cursor-pointer" aria-label="Luk menu">close</button>
      </div>
      <nav class="space-y-4 flex flex-col">
        <a href="{{ routes.root_url }}" class="block text-sm font-semibold text-primary hover:text-secondary py-2 border-b border-outline-variant/40 no-underline">Forside</a>
        {%- if section.settings.menu != blank -%}
          {%- for link in linklists[section.settings.menu].links -%}
            <a href="{{ link.url }}" class="block text-sm font-semibold text-primary hover:text-secondary py-2 border-b border-outline-variant/40 no-underline">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </nav>
    </div>
    <div class="pt-6 border-t border-outline-variant text-xs text-on-surface-variant space-y-2">
      <p class="font-semibold text-primary">Brug for hjælp?</p>
      <p>Ring til os: +45 70 20 10 30</p>
      <p>E-mail: support@textilogvoksdug.dk</p>
    </div>
  </div>
</div>

<!-- Shopping Cart Slide-out Drawer -->
<div id="cart-drawer" class="fixed inset-0 bg-black/50 z-50 hidden flex justify-end transition-opacity duration-300 opacity-0">
  <div class="bg-white w-5/6 max-w-sm h-full flex flex-col justify-between shadow-2xl p-6 transition-transform duration-300 translate-x-full">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-outline-variant mb-6">
        <span class="font-serif text-xl font-bold text-primary tracking-tight">Din Indkøbskurv</span>
        <button onclick="toggleCartDrawer(false)" class="material-symbols-outlined text-2xl text-primary bg-transparent border-0 cursor-pointer" aria-label="Luk kurv">close</button>
      </div>
      <!-- Cart Items List -->
      <div id="cart-items" class="space-y-4 overflow-y-auto max-h-[calc(100vh-280px)] pr-2 hide-scrollbar">
        <!-- Indsættes dynamisk via JavaScript -->
      </div>
    </div>
    <div class="pt-6 border-t border-outline-variant space-y-4">
      <div class="flex justify-between items-center text-sm">
        <span class="text-on-surface-variant">Subtotal</span>
        <span id="cart-subtotal" class="font-bold text-primary text-lg">Dkr 0,-</span>
      </div>
      <p class="text-[10px] text-on-surface-variant">Fragt beregnes ved kassen. Fri fragt ved køb over 499 kr.</p>
      <div class="flex flex-col gap-2">
        <a href="/checkout" class="w-full py-3 bg-primary text-white font-bold rounded-xl text-sm hover:bg-primary/95 text-center transition-colors no-underline block">Gå til betaling</a>
        <button onclick="toggleCartDrawer(false)" class="w-full py-2 text-xs text-primary font-semibold hover:underline bg-transparent border-0 cursor-pointer">Fortsæt med at handle</button>
      </div>
    </div>
  </div>
</div>

<!-- Toast Notifikation -->
<div id="toast-message" class="fixed bottom-6 left-1/2 -translate-x-1/2 bg-primary text-white text-xs px-4 py-3 rounded-full shadow-lg z-50 hidden transition-all duration-300 transform translate-y-2 opacity-0 flex items-center gap-2">
  <span class="material-symbols-outlined text-sm">check_circle</span>
  <span id="toast-text">Produkt tilføjet til kurven</span>
</div>

<script>
  function formatMoney(cents) {
    const kr = cents / 100;
    if (kr % 1 === 0) {
      return 'Dkr ' + kr + ',-';
    } else {
      return 'Dkr ' + kr.toFixed(2).replace('.', ',') + '';
    }
  }

  function toggleMobileMenu(open) {
    const drawer = document.getElementById("mobile-menu-drawer");
    if (!drawer) return;
    const panel = drawer.querySelector("div");
    if (open) {
      drawer.classList.remove("hidden");
      setTimeout(() => {
        drawer.classList.remove("opacity-0");
        panel.classList.remove("-translate-x-full");
      }, 10);
    } else {
      drawer.classList.add("opacity-0");
      panel.classList.add("-translate-x-full");
      setTimeout(() => {
        drawer.classList.add("hidden");
      }, 300);
    }
  }

  function toggleCartDrawer(open) {
    const drawer = document.getElementById("cart-drawer");
    if (!drawer) return;
    const panel = drawer.querySelector("div");
    if (open) {
      drawer.classList.remove("hidden");
      updateCartUI(); // Opdater elementer ved åbning
      setTimeout(() => {
        drawer.classList.remove("opacity-0");
        panel.classList.remove("translate-x-full");
      }, 10);
    } else {
      drawer.classList.add("opacity-0");
      panel.classList.add("translate-x-full");
      setTimeout(() => {
        drawer.classList.add("hidden");
      }, 300);
    }
  }

  function showToast(message) {
    const toast = document.getElementById("toast-message");
    const toastText = document.getElementById("toast-text");
    if (!toast || !toastText) return;
    toastText.innerText = message;
    toast.classList.remove("hidden");
    setTimeout(() => {
      toast.classList.remove("opacity-0", "translate-y-2");
    }, 10);

    setTimeout(() => {
      toast.classList.add("opacity-0", "translate-y-2");
      setTimeout(() => {
        toast.classList.add("hidden");
      }, 300);
    }, 2500);
  }

  async function updateCartUI() {
    try {
      const response = await fetch('/cart.js');
      const cart = await response.json();
      
      // Opdater kurve-tællere
      const counters = document.querySelectorAll('#cart-counter');
      counters.forEach(counter => {
        counter.innerText = cart.item_count;
        if (cart.item_count > 0) {
          counter.classList.remove("scale-0");
          counter.classList.add("scale-100");
        } else {
          counter.classList.remove("scale-100");
          counter.classList.add("scale-0");
        }
      });

      // Opdater kurveskuffen
      const cartItemsContainer = document.getElementById("cart-items");
      const cartSubtotal = document.getElementById("cart-subtotal");
      if (!cartItemsContainer || !cartSubtotal) return;

      cartItemsContainer.innerHTML = "";

      if (cart.item_count === 0) {
        cartItemsContainer.innerHTML = `
          <div class="py-12 text-center text-on-surface-variant flex flex-col items-center justify-center">
            <span class="material-symbols-outlined text-4xl mb-2 text-on-surface-variant/40">shopping_basket</span>
            <p class="text-sm font-semibold">Din indkøbskurv er tom.</p>
          </div>
        `;
        cartSubtotal.innerText = "Dkr 0,-";
        return;
      }

      cart.items.forEach(item => {
        let subtitle = item.variant_title || "";
        if (item.properties && Object.keys(item.properties).length > 0) {
          const props = Object.entries(item.properties)
            .map(([k, v]) => `${k}: ${v}`)
            .join(' • ');
          if (props) {
            subtitle = subtitle ? subtitle + " • " + props : props;
          }
        }

        const imgUrl = item.image ? item.image : "https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=150&q=80";

        const itemHtml = `
          <div class="flex gap-4 border-b border-outline-variant/60 pb-4">
            <img src="${imgUrl}" alt="${item.product_title}" class="w-16 h-16 object-cover rounded-xl bg-surface-container flex-shrink-0" />
            <div class="flex-1 min-w-0 flex flex-col justify-between">
              <div>
                <h4 class="text-xs font-semibold text-primary truncate" title="${item.product_title}">${item.product_title}</h4>
                <p class="text-[10px] text-on-surface-variant truncate">${subtitle}</p>
              </div>
              <div class="flex justify-between items-center mt-2">
                <div class="flex items-center border border-outline-variant rounded-full bg-surface-container overflow-hidden">
                  <button onclick="changeQuantity(${item.variant_id}, -1)" class="w-6 h-6 flex items-center justify-center text-primary text-xs font-bold bg-transparent border-0 hover:bg-outline-variant/40 cursor-pointer transition-colors">-</button>
                  <span class="w-6 text-center text-[11px] text-primary font-bold">${item.quantity}</span>
                  <button onclick="changeQuantity(${item.variant_id}, 1)" class="w-6 h-6 flex items-center justify-center text-primary text-xs font-bold bg-transparent border-0 hover:bg-outline-variant/40 cursor-pointer transition-colors">+</button>
                </div>
                <span class="text-xs font-bold text-primary">${formatMoney(item.final_line_price)}</span>
              </div>
            </div>
          </div>
        `;
        cartItemsContainer.insertAdjacentHTML("beforeend", itemHtml);
      });

      cartSubtotal.innerText = formatMoney(cart.total_price);
    } catch (error) {
      console.error("Fejl ved opdatering af kurv:", error);
    }
  }

  async function addToCart(variantId, qty = 1) {
    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          id: variantId,
          quantity: qty
        })
      });

      if (!response.ok) {
        throw new Error('Kunne ikke tilføje produkt');
      }

      const item = await response.json();
      showToast(`Tilføjet: ${item.product_title}`);
      toggleCartDrawer(true);
    } catch (error) {
      console.error("Fejl ved tilføjelse til kurv:", error);
      showToast("Der opstod en fejl ved tilføjelse til kurv.");
    }
  }

  async function changeQuantity(variantId, change) {
    try {
      const cartResponse = await fetch('/cart.js');
      const cart = await cartResponse.json();
      const existingItem = cart.items.find(item => item.variant_id === variantId);
      if (!existingItem) return;

      const newQty = existingItem.quantity + change;

      const response = await fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          id: variantId.toString(),
          quantity: newQty
        })
      });

      if (!response.ok) {
        throw new Error('Kunne ikke ændre antal');
      }

      await updateCartUI();
    } catch (error) {
      console.error("Fejl ved ændring af antal:", error);
    }
  }

  window.addToCart = addToCart;
  window.changeQuantity = changeQuantity;
  window.updateCartUI = updateCartUI;
  window.toggleCartDrawer = toggleCartDrawer;
  window.toggleMobileMenu = toggleMobileMenu;

  // Intercept søgning på kollektionssiden
  document.addEventListener("DOMContentLoaded", () => {
    const searchInput = document.getElementById("search-input");
    if (searchInput) {
      searchInput.addEventListener("input", () => {
        const grid = document.getElementById("product-grid");
        if (grid && typeof window.filterProducts === "function") {
          window.filterProducts();
        }
      });
      
      const searchForm = searchInput.closest("form");
      if (searchForm) {
        searchForm.addEventListener("submit", (e) => {
          const grid = document.getElementById("product-grid");
          if (grid && typeof window.filterProducts === "function") {
            e.preventDefault();
          }
        });
      }
    }
    
    updateCartUI();
  });
</script>


{% schema %}
{
  "name": "Custom Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text Override",
      "default": "Textil & Voksdug"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Vis søgefelt",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_menu",
      "label": "Vis menu under søgefelt",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu under søgefelt",
      "default": "main-menu"
    }
  ]
}
{% endschema %}
