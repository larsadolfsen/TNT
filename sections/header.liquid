{%- liquid

  # Block references lookup (dynamic discovery based on selected content type)
  assign logo_block = nil
  assign logo_visibility = ""
  assign navigation_block = nil
  assign navigation_visibility = ""
  assign search_block = nil
  assign search_visibility = ""
  assign theme_toggle_block = nil
  assign theme_toggle_visibility = ""
  assign cart_block = nil
  assign cart_visibility = ""
  assign hamburger_block = nil
  assign hamburger_visibility = ""

  for block in section.blocks
    assign block_vis = ""
    if block.settings.hide_on_mobile
      assign block_vis = block_vis | append: " max-sm:hidden"
    endif
    if block.settings.hide_on_tablet
      assign block_vis = block_vis | append: " sm:max-md:hidden"
    endif
    if block.settings.hide_on_desktop
      assign block_vis = block_vis | append: " md:hidden"
    endif

    case block.type
      when 'logo'
        if logo_block == nil
          assign logo_block = block
          assign logo_visibility = block_vis
        endif
      when 'navigation'
        if navigation_block == nil
          assign navigation_block = block
          assign navigation_visibility = block_vis
        endif
      when 'search'
        if search_block == nil
          assign search_block = block
          assign search_visibility = block_vis
        endif
      when 'theme_toggle'
        if theme_toggle_block == nil
          assign theme_toggle_block = block
          assign theme_toggle_visibility = block_vis
        endif
      when 'cart'
        if cart_block == nil
          assign cart_block = block
          assign cart_visibility = block_vis
        endif
      when 'hamburger'
        if hamburger_block == nil
          assign hamburger_block = block
          assign hamburger_visibility = block_vis
        endif
    endcase
  endfor
-%}
{%- capture logo_html -%}
  {%- assign logo_font_size_style = '' -%}
  {%- if logo_block and logo_block.settings.logo_height != blank -%}
    {%- assign logo_font_size_style = 'font-size: ' | append: logo_block.settings.logo_height | append: 'px;' -%}
  {%- endif -%}
  <a href="{{ routes.root_url }}" class="font-serif font-bold text-primary tracking-tight no-underline block hover:opacity-90 transition-opacity whitespace-nowrap" style="{{ logo_font_size_style }}">
    {%- if logo_block and logo_block.settings.logo_text != blank -%}
      {{ logo_block.settings.logo_text }}
    {%- else -%}
      {{ shop.name }}
    {%- endif -%}
  </a>
{%- endcapture -%}

{%- capture theme_toggle_button_html -%}
  <button 
    id="theme-toggle" 
    type="button" 
    onclick="toggleTheme()" 
    class="focus:outline-none bg-transparent border-0 p-0 cursor-pointer text-primary flex items-center justify-center hover:opacity-80 transition-opacity duration-200" 
    aria-label="Skift tema"
  >
    <span class="material-symbols-outlined text-2xl text-primary block theme-toggle-icon">dark_mode</span>
  </button>
{%- endcapture -%}

{%- capture cart_icon_html -%}
  <a href="{{ routes.cart_url }}" onclick="event.preventDefault(); toggleCartDrawer(true);" class="relative cursor-pointer text-primary no-underline flex items-center justify-center hover:opacity-80 transition-opacity">
    <span class="material-symbols-outlined text-2xl text-primary">shopping_cart</span>
    <span id="cart-counter" class="absolute -top-1 -right-1 bg-primary text-on-primary text-xs font-bold px-1.5 rounded-full transition-transform duration-300 {% if cart.item_count == 0 %}scale-0{% endif %}">
      {{ cart.item_count }}
    </span>
  </a>
{%- endcapture -%}

{%- capture hamburger_html -%}
  <button id="menu-toggle" class="focus:outline-none bg-transparent border-0 p-0 cursor-pointer flex items-center justify-center hover:opacity-80 transition-opacity" aria-label="Menu" onclick="toggleMobileMenu(true)">
    <span class="material-symbols-outlined text-2xl text-primary block">menu</span>
  </button>
{%- endcapture -%}

{%- capture search_form_html -%}
  <form action="{{ routes.search_url }}" method="get" class="relative m-0 w-full">
    <div class="relative w-full">
      <input 
        type="text" 
        name="q" 
        class="w-full h-10 pl-4 pr-24 rounded-full border border-outline-variant text-sm focus:ring-1 focus:ring-primary focus:border-primary bg-[#f1f5f9] dark:bg-[#1e293b] text-primary placeholder:text-primary/60 focus:outline-none transition-all" 
        placeholder="Søg efter klar voksdug, tykkelser eller dækkeservietter..."
      />
      <button 
        type="submit" 
        class="absolute right-1 top-1/2 -translate-y-1/2 h-8 px-3 rounded-full bg-primary text-on-primary hover:opacity-90 transition-all cursor-pointer focus:outline-none flex items-center justify-center gap-1.5 font-semibold text-xs"
        aria-label="Søg"
      >
        <span class="material-symbols-outlined text-[15px]">search</span>
        <span>Søg</span>
      </button>
    </div>
  </form>
{%- endcapture -%}

{%- style -%}
  .shopify-section-header-row + .shopify-section-header-row {
    margin-top: -1px;
    position: relative;
    z-index: 10;
  }

  .nav-menu-item {
    border-bottom: 2px solid transparent;
    transition: border-color 200ms ease;
  }
  .nav-menu-item:hover,
  .nav-menu-item--active {
    border-bottom-color: #facc15;
  }
{%- endstyle -%}

{%- assign left_zone_html = '' -%}
{%- assign center_zone_html = '' -%}
{%- assign right_zone_html = '' -%}
{%- assign fill_rows_html = '' -%}

{%- for block in section.blocks -%}
  {%- assign block_visibility_classes = "" -%}
  {%- if block.settings.hide_on_mobile -%}
    {%- assign block_visibility_classes = block_visibility_classes | append: " max-sm:hidden" -%}
  {%- endif -%}
  {%- if block.settings.hide_on_tablet -%}
    {%- assign block_visibility_classes = block_visibility_classes | append: " sm:max-md:hidden" -%}
  {%- endif -%}
  {%- if block.settings.hide_on_desktop -%}
    {%- assign block_visibility_classes = block_visibility_classes | append: " md:hidden" -%}
  {%- endif -%}

  {%- capture block_html -%}
    {%- case block.type -%}
      {%- when 'logo' -%}
        {%- assign block_logo_style = '' -%}
        {%- if block.settings.logo_height != blank -%}
          {%- assign block_logo_style = 'font-size: ' | append: block.settings.logo_height | append: 'px;' -%}
        {%- endif -%}
        <div class="flex-shrink-0{{ block_visibility_classes }}" {{ block.shopify_attributes }}>
          <a href="{{ routes.root_url }}" class="font-serif font-bold text-primary tracking-tight no-underline block hover:opacity-90 transition-opacity" style="{{ block_logo_style }}">
            {%- if block.settings.logo_text != blank -%}
              {{ block.settings.logo_text }}
            {%- else -%}
              {{ shop.name }}
            {%- endif -%}
          </a>
        </div>
      {%- when 'navigation' -%}
        {%- assign menu_handle = block.settings.menu -%}
        {%- if menu_handle != blank -%}
          <nav class="flex items-stretch overflow-x-auto hide-scrollbar w-full h-full{{ block_visibility_classes }}" aria-label="Hovedmenu" {{ block.shopify_attributes }}>
            <ul class="flex items-stretch whitespace-nowrap list-none p-0 m-0 w-full h-full {% if block.settings.placement == 'fill' or block.settings.placement == 'center' %}justify-center{% elsif block.settings.placement == 'right' %}justify-end{% else %}justify-start{% endif %}">
              {%- for link in linklists[menu_handle].links -%}
                <li class="nav-menu-item h-full flex items-center transition-all duration-200{% if link.active %} nav-menu-item--active{% endif %}" style="padding-inline: {{ block.settings.item_padding }}px;">
                  <a href="{{ link.url }}" class="text-base font-semibold text-primary no-underline">
                    {{ link.title }}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- when 'search' -%}
        {%- if block.settings.desktop_search_style == 'always_visible' -%}
          <div class="{% if block.settings.placement == 'fill' %}max-w-xl mx-auto w-full{% else %}{{ block.settings.desktop_width | default: 'max-w-md w-full' }}{% endif %} flex-shrink-0{{ block_visibility_classes }}" {{ block.shopify_attributes }}>
            {{ search_form_html }}
          </div>
        {%- else -%}
          <div class="flex-shrink-0{{ block_visibility_classes }}" {{ block.shopify_attributes }}>
            <button 
              type="button" 
              onclick="toggleSearchInput('desktop', '{{ section.id }}')" 
              class="focus:outline-none bg-transparent border-0 p-0 cursor-pointer text-primary flex items-center justify-center hover:opacity-80 transition-opacity duration-200" 
              aria-label="Søg"
            >
              <span class="material-symbols-outlined text-2xl text-primary block">search</span>
            </button>
          </div>
        {%- endif -%}
      {%- when 'theme_toggle' -%}
        <div class="flex-shrink-0{{ block_visibility_classes }}" {{ block.shopify_attributes }}>
          <button 
            type="button" 
            onclick="toggleTheme()" 
            class="focus:outline-none bg-transparent border-0 p-0 cursor-pointer text-primary flex items-center justify-center hover:opacity-80 transition-opacity duration-200" 
            aria-label="Skift tema"
          >
            <span class="material-symbols-outlined text-2xl text-primary block theme-toggle-icon">dark_mode</span>
          </button>
        </div>
      {%- when 'cart' -%}
        <div class="flex-shrink-0{{ block_visibility_classes }}" {{ block.shopify_attributes }}>
          <a href="{{ routes.cart_url }}" onclick="event.preventDefault(); toggleCartDrawer(true);" class="relative cursor-pointer text-primary no-underline flex items-center justify-center hover:opacity-80 transition-opacity">
            <span class="material-symbols-outlined text-2xl text-primary">shopping_cart</span>
            <span id="cart-counter" class="absolute -top-1 -right-1 bg-primary text-on-primary text-xs font-bold px-1.5 rounded-full transition-transform duration-300 {% if cart.item_count == 0 %}scale-0{% endif %}">
              {{ cart.item_count }}
            </span>
          </a>
        </div>
      {%- when 'hamburger' -%}
        <div class="flex-shrink-0{{ block_visibility_classes }}" {{ block.shopify_attributes }}>
          {{ hamburger_html }}
        </div>
      {%- when 'custom_content' -%}
        {%- if block.settings.content != blank -%}
          <div class="flex-shrink-0 text-sm text-primary w-full flex {% if block.settings.placement == 'fill' or block.settings.placement == 'center' %}justify-center text-center{% elsif block.settings.placement == 'right' %}justify-end text-right{% else %}justify-start text-left{% endif %}{{ block_visibility_classes }}" {{ block.shopify_attributes }}>
            <div class="prose prose-sm max-w-none text-primary">
              {{ block.settings.content }}
            </div>
          </div>
        {%- endif -%}
    {%- endcase -%}
  {%- endcapture -%}
  
  {%- if block.settings.placement == 'left' -%}
    {%- capture left_zone_html -%}{{ left_zone_html }}{{ block_html }}{%- endcapture -%}
  {%- elsif block.settings.placement == 'right' -%}
    {%- capture right_zone_html -%}{{ right_zone_html }}{{ block_html }}{%- endcapture -%}
  {%- elsif block.settings.placement == 'fill' -%}
    {%- capture fill_rows_html -%}{{ fill_rows_html }}<div class="w-full flex items-stretch" style="height: var(--nav-block-height);">{{ block_html }}</div>{%- endcapture -%}
  {%- else -%}
    {%- capture center_zone_html -%}{{ center_zone_html }}{{ block_html }}{%- endcapture -%}
  {%- endif -%}
{%- endfor -%}

{%- liquid
  assign section_visibility_classes = ""
  if section.settings.hide_on_mobile
    assign section_visibility_classes = section_visibility_classes | append: " max-sm:hidden"
  endif
  if section.settings.hide_on_tablet
    assign section_visibility_classes = section_visibility_classes | append: " sm:max-md:hidden"
  endif
  if section.settings.hide_on_desktop
    assign section_visibility_classes = section_visibility_classes | append: " md:hidden"
  endif
-%}

<!-- Outer Header Sticky Wrapper -->
<div id="shopify-section-header-wrapper-{{ section.id }}" 
     class="w-full z-[100] bg-background shopify-section-header-wrapper{{ section_visibility_classes }}"
     data-desktop-sticky="{{ section.settings.desktop_sticky }}"
     data-mobile-sticky="{{ section.settings.mobile_sticky }}">

  <!-- DESKTOP HEADER -->
  <header class="hidden md:flex md:items-center bg-background border-b border-outline-variant h-14 px-6 py-1">
    <div class="{% if section.settings.content_width == 'full' %}w-full{% else %}max-w-[var(--page-width,1440px)] mx-auto w-full{% endif %} flex items-center h-full">
      
      <!-- Main Row (Left, Center, Right) -->
      {%- if left_zone_html != blank or center_zone_html != blank or right_zone_html != blank -%}
        <div class="grid grid-cols-3 items-center gap-6 h-full w-full">
          <!-- Left Zone -->
          <div class="flex items-center justify-start gap-6 h-full self-stretch">
            {{ left_zone_html }}
          </div>

          <!-- Center Zone -->
          <div class="flex items-center justify-center gap-6 h-full self-stretch">
            {{ center_zone_html }}
          </div>

          <!-- Right Zone -->
          <div class="flex items-center justify-end gap-6 h-full self-stretch">
            {{ right_zone_html }}
          </div>
        </div>
      {%- endif -%}

      <!-- Fill Rows -->
      {{ fill_rows_html }}
      
    </div>
    
    <!-- Toggle Search Bar for desktop if search is block toggle -->
    {%- if search_block and search_block.settings.desktop_search_style == 'icon_toggle' -%}
      <div id="desktop-search-dropdown-{{ section.id }}" class="hidden mt-4 pt-3 border-t border-outline-variant/20 transition-all duration-300">
        {{ search_form_html }}
      </div>
    {%- endif -%}
  </header>

  <!-- MOBILE HEADER -->
  {%- assign show_mobile_header = false -%}
  {%- if hamburger_block or logo_block or theme_toggle_block or cart_block -%}
    {%- assign show_mobile_header = true -%}
  {%- elsif search_block and search_block.settings.mobile_search_style != 'hidden' -%}
    {%- assign show_mobile_header = true -%}
  {%- elsif navigation_block and navigation_block.settings.show_on_mobile_bar -%}
    {%- assign show_mobile_header = true -%}
  {%- elsif section.blocks.size > 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'custom_content' and block.settings.content != blank -%}
        {%- assign show_mobile_header = true -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endif -%}

  {%- if show_mobile_header -%}
    <header class="block md:hidden bg-background border-b border-outline-variant py-3 px-4">
      <div class="w-full flex flex-col gap-3">
        <div class="relative flex items-center justify-between w-full min-h-[44px]">
          <!-- Left Slot -->
          <div class="flex justify-start items-center gap-3 z-10 min-w-0">
            {%- if hamburger_block -%}
              <div class="{{ hamburger_visibility }} shrink-0" {{ hamburger_block.shopify_attributes }}>
                {{ hamburger_html }}
              </div>
            {%- endif -%}
            {%- if logo_block and logo_block.settings.placement == 'left' -%}
              <div class="{{ logo_visibility }} min-w-0" {{ logo_block.shopify_attributes }}>
                {{ logo_html }}
              </div>
            {%- endif -%}
          </div>

          <!-- Center Slot -->
          <div class="absolute inset-x-0 flex justify-center items-center pointer-events-none z-0">
            {%- if logo_block and logo_block.settings.placement != 'left' -%}
              <div class="{{ logo_visibility }} pointer-events-auto" {{ logo_block.shopify_attributes }}>
                {{ logo_html }}
              </div>
            {%- endif -%}
          </div>

          <!-- Right Slot -->
          <div class="flex justify-end items-center gap-3 z-10 shrink-0">
            {%- if search_block and search_block.settings.mobile_search_style == 'icon_toggle' -%}
              <div class="{{ search_visibility }}" {{ search_block.shopify_attributes }}>
                <button 
                  type="button" 
                  onclick="toggleSearchInput('mobile', '{{ section.id }}')" 
                  class="focus:outline-none bg-transparent border-0 p-0 cursor-pointer text-primary flex items-center justify-center hover:opacity-85 transition-opacity" 
                  aria-label="Søg"
                >
                  <span class="material-symbols-outlined text-2xl text-primary block">search</span>
                </button>
              </div>
            {%- endif -%}
            {%- if theme_toggle_block -%}
              <div class="{{ theme_toggle_visibility }}" {{ theme_toggle_block.shopify_attributes }}>
                {{ theme_toggle_button_html }}
              </div>
            {%- endif -%}
            {%- if cart_block -%}
              <div class="{{ cart_visibility }}" {{ cart_block.shopify_attributes }}>
                {{ cart_icon_html }}
              </div>
            {%- endif -%}
          </div>
        </div>

        <!-- Mobile Search Form (if under logo bar) -->
        {%- if search_block and search_block.settings.mobile_search_style == 'under_logo_bar' -%}
          <div class="w-full{{ search_visibility }}" {{ search_block.shopify_attributes }}>
            {{ search_form_html }}
          </div>
        {%- elsif search_block and search_block.settings.mobile_search_style == 'icon_toggle' -%}
          <div id="mobile-search-dropdown-{{ section.id }}" class="hidden w-full transition-all duration-300{{ search_visibility }}">
            {{ search_form_html }}
          </div>
        {%- endif -%}

        <!-- Mobile Navigation Bar -->
        {%- if navigation_block and navigation_block.settings.show_on_mobile_bar -%}
          {%- assign menu_handle = navigation_block.settings.menu -%}
          {%- if menu_handle != blank -%}
            <nav class="w-full overflow-x-auto hide-scrollbar py-1 -mx-4 px-4{{ navigation_visibility }}" aria-label="Kategori menu" {{ navigation_block.shopify_attributes }}>
              <ul class="flex items-center gap-5 whitespace-nowrap list-none p-0 m-0 {% if navigation_block.settings.placement == 'right' %}justify-end{% elsif navigation_block.settings.placement == 'left' %}justify-start{% else %}justify-center{% endif %}">
                {%- for link in linklists[menu_handle].links -%}
                  <li>
                    <a 
                      href="{{ link.url }}" 
                      class="text-sm font-medium text-primary hover:text-accent border-b-2 border-transparent hover:border-accent pb-1 transition-all duration-200 no-underline {% if link.active %}text-accent border-accent{% endif %}"
                      {% if link.active %}aria-current="page"{% endif %}
                    >
                      {{ link.title }}
                    </a>
                  </li>
                {%- endfor -%}
              </ul>
            </nav>
          {%- endif -%}
        {%- endif -%}

        <!-- Mobile Custom Content -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'custom_content' and block.settings.content != blank -%}
            {%- assign cc_vis = "" -%}
            {%- if block.settings.hide_on_mobile -%}
              {%- assign cc_vis = cc_vis | append: " max-sm:hidden" -%}
            {%- endif -%}
            {%- if block.settings.hide_on_tablet -%}
              {%- assign cc_vis = cc_vis | append: " sm:max-md:hidden" -%}
            {%- endif -%}
            {%- if block.settings.hide_on_desktop -%}
              {%- assign cc_vis = cc_vis | append: " md:hidden" -%}
            {%- endif -%}
            <div class="w-full text-center text-sm py-1 border-t border-outline-variant/10 pt-2{{ cc_vis }}" {{ block.shopify_attributes }}>
              <div class="prose prose-sm max-w-none text-primary">
                {{ block.settings.content }}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </header>
  {%- endif -%}
</div>
<!-- Mobile Menu Drawer -->
<div id="mobile-menu-drawer" class="fixed inset-0 bg-black/50 z-[200] hidden flex justify-start transition-opacity duration-300 opacity-0">
  <div class="bg-card-light w-5/6 max-w-sm h-full flex flex-col justify-between shadow-2xl p-6 transition-transform duration-300 -translate-x-full">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-outline-variant mb-6">
        <span class="font-serif text-xl font-bold text-primary tracking-tight">Menu</span>
        <button onclick="toggleMobileMenu(false)" class="material-symbols-outlined text-2xl text-primary bg-transparent border-0 cursor-pointer" aria-label="Luk menu">close</button>
      </div>
      <nav class="space-y-4 flex flex-col">
        <a href="{{ routes.root_url }}" class="block text-base font-semibold text-primary hover:text-secondary py-2 border-b border-outline-variant/40 no-underline">Forside</a>
        {%- liquid
          assign drawer_menu = 'main-menu'
          if hamburger_block and hamburger_block.settings.mobile_menu != blank
            assign drawer_menu = hamburger_block.settings.mobile_menu
          elsif navigation_block and navigation_block.settings.menu != blank
            assign drawer_menu = navigation_block.settings.menu
          endif
        -%}
        {%- if drawer_menu != blank -%}
          {%- for link in linklists[drawer_menu].links -%}
            <a href="{{ link.url }}" class="block text-base font-semibold text-primary hover:text-secondary py-2 border-b border-outline-variant/40 no-underline">{{ link.title }}</a>
          {%- endfor -%}
        {%- endif -%}
      </nav>
    </div>
    <div class="pt-6 border-t border-outline-variant text-xs text-primary/85 space-y-2">
      <p class="font-semibold text-primary">Brug for hjælp?</p>
      <p>Ring til os: +45 70 20 10 30</p>
      <p>E-mail: support@textilogvoksdug.dk</p>
    </div>
  </div>
</div>

<!-- Shopping Cart Slide-out Drawer -->
<div id="cart-drawer" class="fixed inset-0 bg-black/50 z-[200] hidden flex justify-end transition-opacity duration-300 opacity-0">
  <div class="bg-card-light w-5/6 max-w-sm h-full flex flex-col justify-between shadow-2xl p-6 transition-transform duration-300 translate-x-full">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-outline-variant mb-6">
        <span class="font-serif text-xl font-bold text-primary tracking-tight">Din Indkøbskurv</span>
        <button onclick="toggleCartDrawer(false)" class="material-symbols-outlined text-2xl text-primary bg-transparent border-0 cursor-pointer" aria-label="Luk kurv">close</button>
      </div>
      <!-- Cart Items List -->
      <div id="cart-items" class="space-y-4 overflow-y-auto max-h-[calc(100vh-280px)] pr-2 hide-scrollbar">
        <!-- Indsættes dynamisk via JavaScript -->
      </div>
    </div>
    <div class="pt-6 border-t border-outline-variant space-y-4">
      <div class="flex justify-between items-center text-sm">
        <span class="text-primary/85">Subtotal</span>
        <span id="cart-subtotal" class="font-bold text-primary text-lg">0,00 Kr.</span>
      </div>
      <p class="text-xs text-primary/85">Fragt beregnes ved kassen. Fri fragt ved køb over 499 kr.</p>
      <div class="flex flex-col gap-2">
        <a href="/checkout" class="w-full py-3 bg-accent hover:brightness-95 text-primary font-bold rounded-full text-sm text-center shadow-sm active:scale-95 transition-all no-underline block">Gå til betaling</a>
        <button onclick="toggleCartDrawer(false)" class="w-full py-2 text-sm text-primary font-semibold hover:underline bg-transparent border-0 cursor-pointer">Fortsæt med at handle</button>
      </div>
    </div>
  </div>
</div>


<script>
  function updateThemeToggleIcons(isDark) {
    const icons = document.querySelectorAll('.theme-toggle-icon');
    icons.forEach(icon => {
      icon.textContent = isDark ? 'light_mode' : 'dark_mode';
    });
  }

  function toggleTheme() {
    const rootEl = document.documentElement;
    const isCurrentlyDark = rootEl.classList.contains('dark');
    const nextDark = !isCurrentlyDark;
    
    if (nextDark) {
      rootEl.classList.add('dark');
      localStorage.setItem('theme', 'dark');
    } else {
      rootEl.classList.remove('dark');
      localStorage.setItem('theme', 'light');
    }
    updateThemeToggleIcons(nextDark);
  }

  function formatMoney(cents) {
    const kr = cents / 100;
    return kr.toFixed(2).replace('.', ',') + ' Kr.';
  }

  function toggleMobileMenu(open) {
    const drawer = document.getElementById("mobile-menu-drawer");
    if (!drawer) return;
    const panel = drawer.querySelector("div");
    if (open) {
      drawer.classList.remove("hidden");
      setTimeout(() => {
        drawer.classList.remove("opacity-0");
        panel.classList.remove("-translate-x-full");
      }, 10);
    } else {
      drawer.classList.add("opacity-0");
      panel.classList.add("-translate-x-full");
      setTimeout(() => {
        drawer.classList.add("hidden");
      }, 300);
    }
  }

  function toggleSearchInput(viewport = 'desktop', sectionId = '') {
    const baseId = viewport === 'mobile' ? 'mobile-search-dropdown' : 'desktop-search-dropdown';
    const formId = sectionId ? `${baseId}-${sectionId}` : baseId;
    const searchForm = document.getElementById(formId);
    if (!searchForm) return;
    searchForm.classList.toggle("hidden");
    if (!searchForm.classList.contains("hidden")) {
      const searchInput = searchForm.querySelector("input[name='q']");
      if (searchInput) {
        searchInput.focus();
      }
    }
  }

  function toggleCartDrawer(open) {
    const drawer = document.getElementById("cart-drawer");
    if (!drawer) return;
    const panel = drawer.querySelector("div");
    if (open) {
      drawer.classList.remove("hidden");
      updateCartUI(); // Opdater elementer ved åbning
      setTimeout(() => {
        drawer.classList.remove("opacity-0");
        panel.classList.remove("translate-x-full");
      }, 10);
      document.dispatchEvent(new CustomEvent("cart-drawer-opened"));
    } else {
      drawer.classList.add("opacity-0");
      panel.classList.add("translate-x-full");
      setTimeout(() => {
        drawer.classList.add("hidden");
      }, 300);
      document.dispatchEvent(new CustomEvent("cart-drawer-closed"));
    }
  }

  let currentCart = null;

  function renderCart(cart) {
    currentCart = cart;

    // Opdater kurve-tællere
    const counters = document.querySelectorAll('#cart-counter');
    counters.forEach(counter => {
      counter.innerText = cart.item_count;
      if (cart.item_count > 0) {
        counter.classList.remove("scale-0");
        counter.classList.add("scale-100");
      } else {
        counter.classList.remove("scale-100");
        counter.classList.add("scale-0");
      }
    });

    // Opdater kurveskuffen
    const cartItemsContainer = document.getElementById("cart-items");
    const cartSubtotal = document.getElementById("cart-subtotal");
    if (!cartItemsContainer || !cartSubtotal) return;

    cartItemsContainer.innerHTML = "";

    if (cart.item_count === 0) {
      cartItemsContainer.innerHTML = `
        <div class="py-12 text-center text-primary/85 flex flex-col items-center justify-center">
          <span class="material-symbols-outlined text-4xl mb-2 text-primary/40">shopping_basket</span>
          <p class="text-sm font-semibold">Din indkøbskurv er tom.</p>
        </div>
      `;
      cartSubtotal.innerText = "0,00 Kr.";
      return;
    }

    let calculatedTotalPrice = 0;

    cart.items.forEach(item => {
      let subtitle = item.variant_title || "";
      if (item.properties && Object.keys(item.properties).length > 0) {
        const props = Object.entries(item.properties)
          .map(([k, v]) => {
            if (k.startsWith('_')) return null; // Skjul interne data
            return `${k}: ${v}`;
          })
          .filter(Boolean)
          .join(' • ');
        if (props) {
          subtitle = subtitle ? subtitle + " • " + props : props;
        }
      }

      let imgUrl = item.image ? item.image : "https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=150&q=80";
      if (item.properties && item.properties._image) {
        imgUrl = item.properties._image;
      }

      // Beregn pris for denne linje (brug enten den transformerede pris fra Shopify eller vores gemte _unit_price som fallback)
      let linePrice = item.final_line_price;
      if (item.properties && item.properties._unit_price) {
        const customUnitPrice = parseInt(item.properties._unit_price, 10);
        const expectedUntransformedPrice = item.price * item.quantity;
        
        // Hvis Shopify returnerer den u-transformerede pris, overskriver vi med den rigtige beregnede pris.
        if (item.final_line_price === expectedUntransformedPrice) {
          linePrice = customUnitPrice * item.quantity;
        }
      }

      calculatedTotalPrice += linePrice;

      const isCustom = item.properties && item.properties._base_price;
      let detailsHtml = '';

      if (isCustom) {
        const basePriceCents = parseInt(item.properties._base_price, 10);
        const shapeSurchargeCents = parseInt(item.properties._shape_surcharge || "0", 10);
        const widthSurchargeCents = parseInt(item.properties._width_surcharge || "0", 10);
        const unitPriceCents = basePriceCents + shapeSurchargeCents + widthSurchargeCents;

        let shapeName = "Form: Firkantet";
        if (item.properties._shape === "rund") {
          shapeName = "Form: Rund";
        } else if (item.properties._shape === "oval") {
          shapeName = "Form: Oval";
        }

        const width = item.properties._width || "";
        const length = item.properties._length || "";
        let labelText = item.properties._shape === "rund" ? "Diameter" : "Længde";

        const shapeLine = item.properties._shape ? `
            <div class="flex justify-between gap-2">
              <span>${shapeName}</span>
              <span class="text-primary font-medium flex-shrink-0">${formatMoney(shapeSurchargeCents)}</span>
            </div>
        ` : '';

        const widthLine = item.properties._shape !== "rund" ? `
            <div class="flex justify-between gap-2">
              <span>Bredde: ${width} cm</span>
              <span class="text-primary font-medium flex-shrink-0">${formatMoney(widthSurchargeCents)}</span>
            </div>
        ` : '';

        const customProductTitle = (item.properties && item.properties._metervare_title) ? item.properties._metervare_title : item.product_title;

        detailsHtml = `
          <div>
            <h4 class="text-sm sm:text-base font-semibold text-primary mb-1.5" style="white-space: normal; overflow: visible;" title="${customProductTitle}">${customProductTitle}</h4>
            <div class="space-y-1 text-xs sm:text-sm text-primary/85 font-normal leading-normal">
              <div class="flex justify-between gap-2">
                <span>${labelText}: ${length} cm</span>
                <span class="text-primary font-medium flex-shrink-0">${formatMoney(basePriceCents)}</span>
              </div>
              ${shapeLine}
              ${widthLine}
              <div class="flex justify-between border-t border-outline-variant/60 pt-1 mt-1">
                <span>Pris pr. dug.</span>
                <span class="flex-shrink-0">${formatMoney(unitPriceCents)}</span>
              </div>
            </div>
          </div>
        `;
      } else {
        const isLengthCustomized = item.properties && item.properties._length;
        const displayName = isLengthCustomized ? item.title : item.product_title;
        const displaySubtitle = isLengthCustomized ? "" : subtitle;

        detailsHtml = `
          <div>
            <h4 class="text-sm sm:text-base font-semibold text-primary" style="white-space: normal; overflow: visible;" title="${displayName}">${displayName}</h4>
            ${displaySubtitle ? `<p class="text-xs sm:text-sm text-primary/85 truncate">${displaySubtitle}</p>` : ''}
          </div>
        `;
      }

      const itemHtml = `
        <div class="group relative flex gap-4 border-b border-outline-variant/60 pb-4">
          <img src="${imgUrl}" alt="${item.product_title}" class="w-16 h-16 object-cover rounded-xl bg-surface-container flex-shrink-0" />
          <div class="flex-1 min-w-0 flex flex-col justify-between">
            ${detailsHtml}
            <div class="flex justify-between items-center mt-2">
              <div class="flex items-center gap-2">
                <div class="flex items-center border border-outline-variant rounded-full bg-surface-container overflow-hidden">
                  <button onclick="changeQuantity('${item.key}', -1)" class="w-6 h-6 flex items-center justify-center text-primary text-xs font-bold bg-transparent border-0 hover:bg-outline-variant/40 cursor-pointer transition-colors">-</button>
                  <span class="w-6 text-center text-xs sm:text-sm text-primary font-bold">${item.quantity}</span>
                  <button onclick="changeQuantity('${item.key}', 1)" class="w-6 h-6 flex items-center justify-center text-primary text-xs font-bold bg-transparent border-0 hover:bg-outline-variant/40 cursor-pointer transition-colors">+</button>
                </div>
                <button onclick="removeItem('${item.key}')" class="w-8 h-8 flex items-center justify-center text-black hover:text-red-600 bg-transparent border-0 cursor-pointer transition-opacity duration-200 md:opacity-0 md:group-hover:opacity-100 opacity-100" aria-label="Fjern vare">
                  <span class="material-symbols-outlined" style="font-size: 16px;">delete</span>
                </button>
              </div>
              <span class="text-sm sm:text-base font-bold text-primary">${formatMoney(linePrice)}</span>
            </div>
          </div>
        </div>
      `;
      cartItemsContainer.insertAdjacentHTML("beforeend", itemHtml);
    });

    cartSubtotal.innerText = formatMoney(calculatedTotalPrice);
  }

  async function updateCartUI() {
    try {
      const response = await fetch('/cart.js');
      const cart = await response.json();
      renderCart(cart);
    } catch (error) {
      console.error("Fejl ved opdatering af kurv:", error);
    }
  }

  async function addToCart(variantId, qty = 1) {
    // Optimistic update of cart-counter
    const counters = document.querySelectorAll('#cart-counter');
    const originalCounts = [];
    counters.forEach(counter => {
      const currentCount = parseInt(counter.innerText) || 0;
      originalCounts.push({ counter, text: counter.innerText, hasScale0: counter.classList.contains("scale-0") });
      const newCount = currentCount + qty;
      counter.innerText = newCount;
      if (newCount > 0) {
        counter.classList.remove("scale-0");
        counter.classList.add("scale-100");
      }
    });

    try {
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          id: variantId,
          quantity: qty
        })
      });

      if (!response.ok) {
        throw new Error('Kunne ikke tilføje produkt');
      }

      const item = await response.json();
      toggleCartDrawer(true);
    } catch (error) {
      console.error("Fejl ved tilføjelse til kurv:", error);
      // Revert optimistic update
      originalCounts.forEach(item => {
        item.counter.innerText = item.text;
        if (item.hasScale0) {
          item.counter.classList.add("scale-0");
          item.counter.classList.remove("scale-100");
        } else {
          item.counter.classList.remove("scale-0");
          item.counter.classList.add("scale-100");
        }
      });
      alert("Der opstod en fejl ved tilføjelse til kurv.");
    }
  }

  async function changeQuantity(itemKey, change) {
    if (!currentCart) return;

    const existingItem = currentCart.items.find(item => item.key === itemKey);
    if (!existingItem) return;

    const newQty = existingItem.quantity + change;
    if (newQty < 0) return;

    // Gem oprindelig tilstand for rollback
    const originalCart = JSON.parse(JSON.stringify(currentCart));

    // Optimistisk opdatering af local state
    if (newQty === 0) {
      currentCart.items = currentCart.items.filter(item => item.key !== itemKey);
    } else {
      existingItem.quantity = newQty;
      const unitPrice = (existingItem.properties && existingItem.properties._unit_price)
        ? parseInt(existingItem.properties._unit_price, 10)
        : existingItem.price;
      existingItem.final_line_price = unitPrice * newQty;
    }
    
    currentCart.item_count = currentCart.items.reduce((sum, item) => sum + item.quantity, 0);
    
    // Totalpris beregnes ud fra summering af hver linjes linePrice (inklusiv fallback)
    currentCart.total_price = currentCart.items.reduce((sum, item) => {
      let linePrice = item.final_line_price;
      if (item.properties && item.properties._unit_price) {
        const customUnitPrice = parseInt(item.properties._unit_price, 10);
        const expectedUntransformedPrice = item.price * item.quantity;
        if (item.final_line_price === expectedUntransformedPrice) {
          linePrice = customUnitPrice * item.quantity;
        }
      }
      return sum + linePrice;
    }, 0);

    // Render med det samme
    renderCart(currentCart);

    try {
      const response = await fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          id: itemKey,
          quantity: newQty
        })
      });

      if (!response.ok) {
        throw new Error('Kunne ikke ændre antal på serveren');
      }

      const updatedCart = await response.json();
      renderCart(updatedCart);
    } catch (error) {
      console.error("Fejl ved ændring af antal:", error);
      renderCart(originalCart);
      alert("Kunne ikke ændre antal. Prøv igen.");
    }
  }

  async function removeItem(itemKey) {
    if (!currentCart) return;

    const existingItem = currentCart.items.find(item => item.key === itemKey);
    if (!existingItem) return;

    // Gem oprindelig tilstand
    const originalCart = JSON.parse(JSON.stringify(currentCart));

    // Optimistisk opdatering
    currentCart.items = currentCart.items.filter(item => item.key !== itemKey);
    currentCart.item_count = currentCart.items.reduce((sum, item) => sum + item.quantity, 0);
    
    currentCart.total_price = currentCart.items.reduce((sum, item) => {
      let linePrice = item.final_line_price;
      if (item.properties && item.properties._unit_price) {
        const customUnitPrice = parseInt(item.properties._unit_price, 10);
        const expectedUntransformedPrice = item.price * item.quantity;
        if (item.final_line_price === expectedUntransformedPrice) {
          linePrice = customUnitPrice * item.quantity;
        }
      }
      return sum + linePrice;
    }, 0);

    // Render med det samme
    renderCart(currentCart);

    try {
      const response = await fetch('/cart/change.js', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          id: itemKey,
          quantity: 0
        })
      });

      if (!response.ok) {
        throw new Error('Kunne ikke fjerne vare på serveren');
      }

      const updatedCart = await response.json();
      renderCart(updatedCart);
    } catch (error) {
      console.error("Fejl ved fjernelse af vare:", error);
      renderCart(originalCart);
      alert("Kunne ikke fjerne varen. Prøv igen.");
    }
  }

  window.addToCart = addToCart;
  window.changeQuantity = changeQuantity;
  window.removeItem = removeItem;
  window.updateCartUI = updateCartUI;
  window.toggleCartDrawer = toggleCartDrawer;
  window.toggleMobileMenu = toggleMobileMenu;
  window.toggleSearchInput = toggleSearchInput;

  // Sticky scroll mechanics and input search sync helpers
  function initHeaderSticky() {
    const wrappers = document.querySelectorAll('.shopify-section-header-wrapper');
    wrappers.forEach(wrapper => {
      const desktopSticky = wrapper.getAttribute('data-desktop-sticky');
      const mobileSticky = wrapper.getAttribute('data-mobile-sticky');

      let lastScrollY = window.scrollY;

      function handleScroll() {
        const currentScrollY = window.scrollY;
        const isMobile = window.innerWidth < 840; // md breakpoint is 840px in input.css
        const stickyMode = isMobile ? mobileSticky : desktopSticky;
        const headerHeight = wrapper.offsetHeight;

        if (stickyMode === 'none') {
          wrapper.classList.remove('fixed', 'sticky', 'top-0', 'shadow-md', 'translate-y-0', '-translate-y-full');
          wrapper.style.position = '';
          return;
        }

        if (stickyMode === 'always') {
          wrapper.style.position = 'sticky';
          wrapper.classList.add('top-0', 'shadow-md');
          wrapper.classList.remove('-translate-y-full');
        } else if (stickyMode === 'scroll_up') {
          wrapper.style.position = 'sticky';
          wrapper.classList.add('top-0', 'transition-transform', 'duration-300');

          if (currentScrollY > headerHeight) {
            if (currentScrollY > lastScrollY) {
              wrapper.classList.add('-translate-y-full', 'shadow-md');
              wrapper.classList.remove('translate-y-0');
            } else {
              wrapper.classList.remove('-translate-y-full');
              wrapper.classList.add('translate-y-0', 'shadow-md');
            }
          } else {
            wrapper.classList.remove('-translate-y-full', 'shadow-md');
            wrapper.classList.add('translate-y-0');
          }
        }

        lastScrollY = currentScrollY;
      }

      const wrapperId = wrapper.id;
      if (window[`_headerScrollHandler_${wrapperId}`]) {
        window.removeEventListener('scroll', window[`_headerScrollHandler_${wrapperId}`]);
        window.removeEventListener('resize', window[`_headerScrollHandler_${wrapperId}`]);
      }
      window[`_headerScrollHandler_${wrapperId}`] = handleScroll;

      window.addEventListener('scroll', handleScroll, { passive: true });
      window.addEventListener('resize', handleScroll);
      handleScroll();
    });
  }

  function initHeaderSearchSync() {
    const searchInputs = document.querySelectorAll("input[name='q']");
    searchInputs.forEach(searchInput => {
      // Sync on input
      searchInput.addEventListener("input", () => {
        const grid = document.getElementById("product-grid");
        if (grid && typeof window.filterProducts === "function") {
          searchInputs.forEach(otherInput => {
            if (otherInput !== searchInput) {
              otherInput.value = searchInput.value;
            }
          });
          window.filterProducts();
        }
      });
      
      // Prevent form submit when filtering is active
      const searchForm = searchInput.closest("form");
      if (searchForm) {
        searchForm.addEventListener("submit", (e) => {
          const grid = document.getElementById("product-grid");
          if (grid && typeof window.filterProducts === "function") {
            e.preventDefault();
          }
        });
      }
    });
  }

  document.addEventListener("DOMContentLoaded", () => {
    const rootEl = document.documentElement;
    updateThemeToggleIcons(rootEl.classList.contains('dark'));

    initHeaderSticky();
    initHeaderSearchSync();
    
    // Luk skuffer når der klikkes udenfor
    const menuDrawer = document.getElementById("mobile-menu-drawer");
    if (menuDrawer) {
      menuDrawer.addEventListener("click", (e) => {
        if (e.target === menuDrawer) {
          toggleMobileMenu(false);
        }
      });
    }

    const cartDrawer = document.getElementById("cart-drawer");
    if (cartDrawer) {
      cartDrawer.addEventListener("click", (e) => {
        if (e.target === cartDrawer) {
          toggleCartDrawer(false);
        }
      });
    }
    
    updateCartUI();
  });

  // Re-initialize for Shopify Theme Customizer loads
  document.addEventListener('shopify:section:load', (e) => {
    if (e.target.id.includes('header')) {
      initHeaderSticky();
      initHeaderSearchSync();
      updateCartUI();
      const rootEl = document.documentElement;
      updateThemeToggleIcons(rootEl.classList.contains('dark'));
    }
  });
</script>


