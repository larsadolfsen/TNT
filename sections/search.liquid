{% comment %}
  This section is used in the search template to render search results for
  products, articles, and pages. Products render through snippets/product-card,
  articles and pages through snippets/search-result-row.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/search
{% endcomment %}

{%- style -%}
  /* `.search-results` (assets/input.css) is an auto-fill grid left over from
     the per-item rows this section used to emit. Both zones below are single
     children of it, so each must span the whole track list instead of
     landing in one 200px cell. Columns are set here rather than with
     `lg:grid-cols-3` because assets/output.css is a prebuilt Tailwind file
     and that class is not in it. */
  #search-products-{{ section.id }},
  #search-rows-{{ section.id }} {
    grid-column: 1 / -1;
  }

  #search-products-{{ section.id }} {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media screen and (min-width: 1024px) {
    #search-products-{{ section.id }} {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<h1 class="font-serif text-3xl font-bold text-primary mb-6">{{ 'search.title' | t }}</h1>

<form action="{{ routes.search_url }}" method="get" role="search" class="relative max-w-xl mb-8">
  <div class="flex w-full items-stretch border border-outline-variant rounded-full bg-[#f1f5f9] dark:bg-[#1e293b] overflow-hidden focus-within:ring-1 focus-within:ring-primary focus-within:border-primary transition-all">
    <input
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
      class="w-full h-12 pl-5 pr-4 bg-transparent border-0 text-base text-primary placeholder:text-primary/60 focus:outline-none focus:ring-0"
    >
    <button 
      type="submit" 
      class="px-3 bg-accent text-on-accent hover:brightness-95 transition-all cursor-pointer focus:outline-none flex items-center justify-center gap-1 font-semibold text-sm shrink-0 border-l border-outline-variant"
      aria-label="{{ 'search.submit' | t }}"
    >
      {% render 'icon', name: 'search', class: 'text-base' %}
      <span>Søg</span>
    </button>
  </div>
</form>

{% if search.performed %}
  {% if search.results_count == 0 %}
    <p>{{ 'search.no_results_html' | t: terms: search.terms }}</p>
  {% else %}
    <p>{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>

    <div class="search-results">
      {% paginate search.results by 20 %}
        {% # Search result items may be an article, a page, or a product. %}
        {% # Products render as the same card the collection grid uses; %}
        {% # articles and pages render as link rows below them. %}
        {%- liquid
          assign has_products = false
          assign has_other = false
          for result in search.results
            if result.object_type == 'product'
              assign has_products = true
            else
              assign has_other = true
            endif
          endfor
        -%}

        {%- if has_products -%}
          <div id="search-products-{{ section.id }}" class="grid gap-4 lg:gap-6">
            {%- for result in search.results -%}
              {%- if result.object_type == 'product' -%}
                {%- render 'product-card', product: result, layout: 'minimal' -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if has_other -%}
          <div id="search-rows-{{ section.id }}" class="flex flex-col gap-3{% if has_products %} mt-8{% endif %}">
            {%- for result in search.results -%}
              {%- unless result.object_type == 'product' -%}
                {%- render 'search-result-row', result: result -%}
              {%- endunless -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {{ paginate | default_pagination }}
      {% endpaginate %}
    </div>
  {% endif %}
{% endif %}


{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
