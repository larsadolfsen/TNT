<section class="px-4 py-10 space-y-6 border-t border-outline-variant max-w-screen-xl mx-auto">
  <div class="space-y-4">
    {%- if section.settings.heading != blank -%}
      <h3 class="text-lg font-bold text-primary">{{ section.settings.heading }}</h3>
    {%- endif -%}
    
    <div class="text-sm text-on-surface-variant leading-relaxed">
      {%- if section.settings.use_product_description -%}
        {{ product.description }}
      {%- else -%}
        {{ section.settings.custom_description }}
      {%- endif -%}
    </div>

    {%- if section.settings.show_category_metafields -%}
      {%- assign ns = section.settings.metafields_namespace | default: 'shopify' -%}
      
      {% comment %} Define standard keys and check if there are any values {% endcomment %}
      {%- assign keys_to_show = "color,fabric,material,care-instructions,care_instructions,care-guide,care_guide,fabric-structure,fabric_structure,structure,occasion,shape,form,size" | split: "," -%}
      
      {%- assign has_any_metafield = false -%}
      {%- for key in keys_to_show -%}
        {%- if product.metafields[ns][key].value != blank -%}
          {%- assign has_any_metafield = true -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      {%- if has_any_metafield or section.settings.show_empty_fields -%}
        <div class="mt-8 bg-slate-50/50 border border-slate-200/80 rounded-2xl p-6 md:p-8 space-y-6">
          {% comment %} Header Row {% endcomment %}
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 border-b border-slate-200/60 pb-4">
            <h4 class="text-base font-bold text-slate-800">Kategori-metafelter</h4>
            
            {%- if product.category -%}
              <div class="inline-flex items-center gap-1.5 bg-slate-200/60 border border-slate-300/40 text-slate-700 text-xs font-semibold px-3 py-1 rounded-md self-start sm:self-auto">
                {{ product.category.name }}
                {%- if product.category.ancestors.size > 0 -%}
                  <span class="text-slate-500 font-normal font-sans">i</span>
                  {{ product.category.ancestors.last.name }}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>

          {% comment %} Metafields Table/List {% endcomment %}
          <div class="space-y-4">
            {%- for key in keys_to_show -%}
              {%- assign metafield = product.metafields[ns][key] -%}
              {%- assign value = metafield.value -%}
              
              {%- if value != blank or section.settings.show_empty_fields -%}
                {%- capture key_label -%}
                  {%- case key -%}
                    {%- when 'color' -%}Farve
                    {%- when 'fabric' or 'material' -%}Stof
                    {%- when 'care-instructions' or 'care_instructions' or 'care-guide' or 'care_guide' -%}Plejevejledning
                    {%- when 'fabric-structure' or 'fabric_structure' or 'structure' -%}Stofstruktur
                    {%- when 'occasion' -%}Lejlighed
                    {%- when 'shape' or 'form' -%}Form
                    {%- when 'size' -%}Størrelse
                    {%- else -%}{{ key | replace: '_', ' ' | replace: '-', ' ' | capitalize }}
                  {%- endcase -%}
                {%- endcapture -%}

                <div class="flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-6 py-1">
                  <span class="text-sm font-medium text-slate-700 sm:w-1/4">{{ key_label | strip }}</span>
                  <div class="w-full sm:w-3/4 bg-white border border-slate-200 rounded-lg min-h-[38px] p-1.5 flex flex-wrap gap-2 items-center">
                    {%- if value != blank -%}
                      {%- if metafield.type contains 'list.' -%}
                        {%- for item in value -%}
                          {%- render 'metafield-pill', item: item, key: key -%}
                        {%- endfor -%}
                      {%- else -%}
                        {%- render 'metafield-pill', item: value, key: key -%}
                      {%- endif -%}
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="grid grid-cols-2 gap-y-3 gap-x-4 pl-0 list-none">
        {%- for block in section.blocks -%}
          <li class="flex items-center gap-2 text-sm text-primary" {{ block.shopify_attributes }}>
            <span class="material-symbols-outlined text-sm text-emerald-600">
              {{ block.settings.icon | default: "check" }}
            </span>
            {{ block.settings.text }}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Produktbeskrivelse",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Om produktet"
    },
    {
      "type": "checkbox",
      "id": "use_product_description",
      "label": "Brug standard Shopify produktbeskrivelse",
      "default": true
    },
    {
      "type": "richtext",
      "id": "custom_description",
      "label": "Brugerdefineret beskrivelse",
      "info": "Bruges kun hvis ovenstående er slået fra."
    },
    {
      "type": "header",
      "content": "Kategori-metafelter"
    },
    {
      "type": "checkbox",
      "id": "show_category_metafields",
      "label": "Vis kategori-metafelter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_empty_fields",
      "label": "Vis tomme felter",
      "default": true
    },
    {
      "type": "text",
      "id": "metafields_namespace",
      "label": "Metafelt namespace",
      "default": "shopify"
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Checkliste punkt",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Ikon",
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Tekst",
          "default": "Nem at tørre af"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Produktbeskrivelse",
      "blocks": [
        {
          "type": "bullet",
          "settings": {
            "text": "Nem at tørre af"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "Vand- og smudsafvisende"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "Gennemsigtig finish"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "Tilpasses dine mål"
          }
        }
      ]
    }
  ]
}
{% endschema %}
