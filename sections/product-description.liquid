<section class="px-4 py-10 space-y-6 border-t border-outline-variant max-w-screen-xl mx-auto">
  <div class="space-y-4">
    {%- if section.settings.heading != blank -%}
      <h3 class="text-lg font-bold text-primary">{{ section.settings.heading }}</h3>
    {%- endif -%}
    
    <div class="text-sm text-on-surface-variant leading-relaxed">
      {%- if section.settings.use_product_description -%}
        {{ product.description }}
      {%- else -%}
        {{ section.settings.custom_description }}
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="grid grid-cols-2 gap-y-3 gap-x-4 pl-0 list-none">
        {%- for block in section.blocks -%}
          <li class="flex items-center gap-2 text-sm text-primary" {{ block.shopify_attributes }}>
            <span class="material-symbols-outlined text-sm text-emerald-600">
              {{ block.settings.icon | default: "check" }}
            </span>
            {{ block.settings.text }}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Produktbeskrivelse",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Om produktet"
    },
    {
      "type": "checkbox",
      "id": "use_product_description",
      "label": "Brug standard Shopify produktbeskrivelse",
      "default": true
    },
    {
      "type": "richtext",
      "id": "custom_description",
      "label": "Brugerdefineret beskrivelse",
      "info": "Bruges kun hvis ovenstående er slået fra."
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Checkliste punkt",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Ikon",
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Tekst",
          "default": "Nem at tørre af"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Produktbeskrivelse",
      "blocks": [
        {
          "type": "bullet",
          "settings": {
            "text": "Nem at tørre af"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "Vand- og smudsafvisende"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "Gennemsigtig finish"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "Tilpasses dine mål"
          }
        }
      ]
    }
  ]
}
{% endschema %}
