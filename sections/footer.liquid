<!-- Footer -->
<footer class="bg-card-light text-primary py-12 px-6 border-t border-outline-variant">
  <div class="max-w-screen-xl mx-auto space-y-10">
    <div class="space-y-4">
      <a href="{{ routes.root_url }}" class="font-serif text-2xl font-bold block text-primary no-underline">
        {%- if section.settings.footer_title != blank -%}
          {{ section.settings.footer_title }}
        {%- else -%}
          {{ shop.name }}
        {%- endif -%}
      </a>
      <p class="text-sm text-primary/70 max-w-sm">
        {{ section.settings.footer_description }}
      </p>
    </div>
    
    <div class="grid grid-cols-2 gap-8">
      <!-- Menu 1 -->
      <div class="space-y-4">
        <h4 class="text-xs font-bold uppercase tracking-widest text-primary/60">
          {%- if section.settings.menu_1_title != blank -%}
            {{ section.settings.menu_1_title }}
          {%- else -%}
            {{ linklists[section.settings.menu_1].title }}
          {%- endif -%}
        </h4>
        <nav class="flex flex-col gap-3 text-sm">
          {%- if section.settings.menu_1 != blank -%}
            {%- for link in linklists[section.settings.menu_1].links -%}
              <a class="text-primary/80 no-underline hover:text-primary transition-colors" href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a class="text-primary/80 no-underline hover:text-primary transition-colors" href="{{ pages['fragt-og-levering'].url | default: '#' }}">Fragt &amp; Retur</a>
            <a class="text-primary/80 no-underline hover:text-primary transition-colors" href="{{ pages['handelsbetingelser'].url | default: '#' }}">Handelsbetingelser</a>
            <a class="text-primary/80 no-underline hover:text-primary transition-colors" href="{{ pages['contact'].url | default: '#' }}">Kontakt os</a>
          {%- endif -%}
        </nav>
      </div>
      
      <!-- Menu 2 -->
      <div class="space-y-4">
        <h4 class="text-xs font-bold uppercase tracking-widest text-primary/60">
          {%- if section.settings.menu_2_title != blank -%}
            {{ section.settings.menu_2_title }}
          {%- else -%}
            {{ linklists[section.settings.menu_2].title }}
          {%- endif -%}
        </h4>
        <nav class="flex flex-col gap-3 text-sm">
          {%- if section.settings.menu_2 != blank -%}
            {%- for link in linklists[section.settings.menu_2].links -%}
              <a class="text-primary/80 no-underline hover:text-primary transition-colors" href="{{ link.url }}">{{ link.title }}</a>
            {%- endfor -%}
          {%- else -%}
            <a class="text-primary/80 no-underline hover:text-primary transition-colors" href="{{ pages['om-os'].url | default: '#' }}">Om os</a>
            <a class="text-primary/80 no-underline hover:text-primary transition-colors" href="{{ pages['vask-og-pleje'].url | default: '#' }}">Vaskevejledning</a>
          {%- endif -%}
        </nav>
      </div>
    </div>
    
    {%- if section.settings.show_newsletter -%}
      <div class="flex flex-col gap-3 pt-10 border-t border-outline-variant">
        <div class="space-y-1 max-w-sm">
          <h4 class="text-base font-bold text-primary">
            {%- if section.settings.newsletter_heading != blank -%}
              {{ section.settings.newsletter_heading }}
            {%- else -%}
              {{ 'newsletter.heading' | t }}
            {%- endif -%}
          </h4>
          {%- if section.settings.newsletter_description != blank -%}
            <p class="text-sm text-primary/70">{{ section.settings.newsletter_description }}</p>
          {%- endif -%}
        </div>
        {% render 'newsletter-form' %}
      </div>
    {%- endif -%}

    <div class="pt-8 border-t border-outline-variant flex flex-col items-center gap-4 text-center">
      {%- if section.settings.show_localization -%}
        {% content_for 'block', type: 'footer-localization', id: 'footer-localization' %}
      {%- endif -%}
      <p class="text-[10px] text-primary/50 italic">
        &copy; {{ 'now' | date: '%Y' }} {% if section.settings.copyright_text != blank %}{{ section.settings.copyright_text }}{% else %}{{ shop.name }}{% endif %}. {{ powered_by_link }}
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Footer",
  "settings": [
    {
      "type": "text",
      "id": "footer_title",
      "label": "Footer Title Override",
      "default": "Din butik / Your store"
    },
    {
      "type": "textarea",
      "id": "footer_description",
      "label": "Footer Description",
      "default": "Fortæl din brandhistorie her / Tell your brand story here."
    },
    {
      "type": "link_list",
      "id": "menu_1",
      "label": "First Menu"
    },
    {
      "type": "text",
      "id": "menu_1_title",
      "label": "First Menu Title Override",
      "default": "Hjælp"
    },
    {
      "type": "link_list",
      "id": "menu_2",
      "label": "Second Menu"
    },
    {
      "type": "text",
      "id": "menu_2_title",
      "label": "Second Menu Title Override",
      "default": "Info"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright Text",
      "default": "Textil & Voksdug. CVR: 12345678"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "newsletter_description",
      "label": "Supporting line (optional)"
    },
    {
      "type": "header",
      "content": "Country / language selector"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "Show country/language selector",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "localization_show_flags",
      "label": "Show flag icons next to country names",
      "default": true
    }
  ]
}
{% endschema %}
