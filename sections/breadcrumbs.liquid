{% comment %}
  Breadcrumbs Section
  Renders breadcrumbs navigation dynamically based on the current template.
  Composition only — styles, the mobile link, the desktop nav and the
  JSON-LD block each live in their own snippets/breadcrumbs-*.liquid; this
  section resolves the ancestor chain (via product/collection metafields)
  since Liquid snippets can't leak assigned variables back to the caller.
{% endcomment %}
{%- if settings.show_breadcrumbs -%}
{%- render 'breadcrumbs-style' -%}

{%- unless template == 'index' or template == 'cart' or template == 'list-collections' or template == '404' -%}
  {%- assign t = template | split: '.' | first -%}

  {%- comment -%}
    Identify the collection and build parent chain if applicable
  {%- endcomment -%}
  {%- assign leaf_collection = nil -%}
  {%- if t == 'collection' -%}
    {%- assign leaf_collection = collection -%}
  {%- elsif t == 'product' -%}
    {%- assign leaf_collection = product.metafields.custom.parent.value -%}
    {%- if leaf_collection == blank -%}
      {%- assign leaf_collection = collection -%}
      {%- if leaf_collection == blank -%}
        {%- assign leaf_collection = product.collections.first -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- assign c_level_0 = nil -%}
  {%- assign c_level_1 = nil -%}
  {%- assign c_level_2 = nil -%}
  {%- assign c_level_3 = nil -%}
  {%- assign c_level_4 = nil -%}
  {%- assign c_level_5 = nil -%}
  {%- assign c_level_6 = nil -%}

  {%- if leaf_collection != blank -%}
    {%- assign c_level_0 = leaf_collection -%}
    {%- assign c_level_1 = c_level_0.metafields.custom.parent.value -%}
    {%- if c_level_1 != blank -%}
      {%- assign c_level_2 = c_level_1.metafields.custom.parent.value -%}
      {%- if c_level_2 != blank -%}
        {%- assign c_level_3 = c_level_2.metafields.custom.parent.value -%}
        {%- if c_level_3 != blank -%}
          {%- assign c_level_4 = c_level_3.metafields.custom.parent.value -%}
          {%- if c_level_4 != blank -%}
            {%- assign c_level_5 = c_level_4.metafields.custom.parent.value -%}
            {%- if c_level_5 != blank -%}
              {%- assign c_level_6 = c_level_5.metafields.custom.parent.value -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- assign has_ellipsis = false -%}
  {%- case t -%}
    {%- when 'product' -%}
      {%- if c_level_0 != blank -%}
        {%- assign has_ellipsis = true -%}
      {%- endif -%}
    {%- when 'collection' and collection.handle -%}
      {%- if c_level_1 != blank -%}
        {%- assign has_ellipsis = true -%}
      {%- endif -%}
    {%- when 'blog' -%}
      {%- if current_tags -%}
        {%- assign has_ellipsis = true -%}
      {%- endif -%}
    {%- when 'article' -%}
      {%- assign has_ellipsis = true -%}
  {%- endcase -%}

  {%- assign parent_url = routes.root_url -%}
  {%- assign parent_title = "Forside" -%}

  {%- case t -%}
    {%- when 'product' -%}
      {%- if c_level_0 != blank -%}
        {%- assign parent_url = c_level_0.url -%}
        {%- assign parent_title = c_level_0.title -%}
      {%- endif -%}
    {%- when 'collection' and collection.handle -%}
      {%- if c_level_1 != blank -%}
        {%- assign parent_url = c_level_1.url -%}
        {%- assign parent_title = c_level_1.title -%}
      {%- endif -%}
    {%- when 'blog' -%}
      {%- if current_tags -%}
        {%- assign parent_url = blog.url -%}
        {%- assign parent_title = blog.title -%}
      {%- endif -%}
    {%- when 'article' -%}
      {%- assign parent_url = blog.url -%}
      {%- assign parent_title = blog.title -%}
  {%- endcase -%}

  {%- render 'breadcrumbs-mobile-link', parent_url: parent_url, parent_title: parent_title -%}

  {%- render 'breadcrumbs-nav', t: t, has_ellipsis: has_ellipsis, c_level_0: c_level_0, c_level_1: c_level_1, c_level_2: c_level_2, c_level_3: c_level_3, c_level_4: c_level_4, c_level_5: c_level_5, c_level_6: c_level_6 -%}

  <script src="{{ 'breadcrumbs.min.js' | asset_url }}" defer="defer"></script>

  {%- render 'breadcrumbs-json-ld', t: t, c_level_0: c_level_0, c_level_1: c_level_1, c_level_2: c_level_2, c_level_3: c_level_3, c_level_4: c_level_4, c_level_5: c_level_5, c_level_6: c_level_6 -%}
{%- endunless -%}
{%- endif -%}

{% schema %}
{
  "name": "Brødkrummer",
  "class": "shopify-section-breadcrumbs max-w-screen-xl mx-auto px-4 lg:px-6",
  "settings": [
    {
      "type": "select",
      "id": "max_width",
      "label": "Maksimal bredde",
      "default": "none",
      "options": [
        {
          "value": "1024px",
          "label": "Lille (1024px)"
        },
        {
          "value": "1280px",
          "label": "Standard (1280px)"
        },
        {
          "value": "1440px",
          "label": "Stor (1440px)"
        },
        {
          "value": "page-width",
          "label": "Global sidebredde"
        },
        {
          "value": "none",
          "label": "Fuld bredde"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Brødkrummer"
    }
  ]
}
{% endschema %}
