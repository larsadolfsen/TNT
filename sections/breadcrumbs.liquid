{% comment %}
  Breadcrumbs Section
  Renders breadcrumbs navigation dynamically based on the current template.
{% endcomment %}
{%- if settings.show_breadcrumbs -%}
{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    /* Always full width — override any section max-width settings */
    width: 100% !important;
    max-width: 100% !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    text-align: left !important;
    /* Always place breadcrumbs above the grid: row 1, full width */
    grid-column: 1 / -1 !important;
    grid-row-start: 1 !important;
  }

  @media screen and (min-width: 840px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- unless template == 'index' or template == 'cart' or template == 'list-collections' or template == '404' -%}
  {%- assign t = template | split: '.' | first -%}

  {%- comment -%}
    Identify the collection and build parent chain if applicable
  {%- endcomment -%}
  {%- assign leaf_collection = nil -%}
  {%- if t == 'collection' -%}
    {%- assign leaf_collection = collection -%}
  {%- elsif t == 'product' -%}
    {%- assign leaf_collection = product.metafields.custom.parent.value -%}
    {%- if leaf_collection == blank -%}
      {%- assign leaf_collection = collection -%}
      {%- if leaf_collection == blank -%}
        {%- assign leaf_collection = product.collections.first -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- assign c_level_0 = nil -%}
  {%- assign c_level_1 = nil -%}
  {%- assign c_level_2 = nil -%}
  {%- assign c_level_3 = nil -%}
  {%- assign c_level_4 = nil -%}
  {%- assign c_level_5 = nil -%}
  {%- assign c_level_6 = nil -%}

  {%- if leaf_collection != blank -%}
    {%- assign c_level_0 = leaf_collection -%}
    {%- assign c_level_1 = c_level_0.metafields.custom.parent.value -%}
    {%- if c_level_1 != blank -%}
      {%- assign c_level_2 = c_level_1.metafields.custom.parent.value -%}
      {%- if c_level_2 != blank -%}
        {%- assign c_level_3 = c_level_2.metafields.custom.parent.value -%}
        {%- if c_level_3 != blank -%}
          {%- assign c_level_4 = c_level_3.metafields.custom.parent.value -%}
          {%- if c_level_4 != blank -%}
            {%- assign c_level_5 = c_level_4.metafields.custom.parent.value -%}
            {%- if c_level_5 != blank -%}
              {%- assign c_level_6 = c_level_5.metafields.custom.parent.value -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- endif -%}
  {%- endif -%}

  {%- assign visible_count = 2 -%}
  {%- case t -%}
    {%- when 'blog' -%}
      {%- if current_tags -%}
        {%- assign visible_count = 3 -%}
      {%- endif -%}
    {%- when 'article' -%}
      {%- assign visible_count = 3 -%}
    {%- when 'product' -%}
      {%- if c_level_0 != blank -%}
        {%- assign visible_count = 3 -%}
        {%- if c_level_1 != blank -%}
          {%- assign visible_count = 4 -%}
          {%- if c_level_2 != blank -%}
            {%- assign visible_count = 5 -%}
            {%- if c_level_3 != blank -%}
              {%- assign visible_count = 6 -%}
              {%- if c_level_4 != blank -%}
                {%- assign visible_count = 7 -%}
                {%- if c_level_5 != blank -%}
                  {%- assign visible_count = 8 -%}
                  {%- if c_level_6 != blank -%}
                    {%- assign visible_count = 9 -%}
                  {%- endif -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
    {%- when 'collection' and collection.handle -%}
      {%- if c_level_1 != blank -%}
        {%- assign visible_count = 3 -%}
        {%- if c_level_2 != blank -%}
          {%- assign visible_count = 4 -%}
          {%- if c_level_3 != blank -%}
            {%- assign visible_count = 5 -%}
            {%- if c_level_4 != blank -%}
              {%- assign visible_count = 6 -%}
              {%- if c_level_5 != blank -%}
                {%- assign visible_count = 7 -%}
                {%- if c_level_6 != blank -%}
                  {%- assign visible_count = 8 -%}
                {%- endif -%}
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
      {%- endif -%}
  {%- endcase -%}

  {%- assign has_ellipsis = false -%}
  {%- case t -%}
    {%- when 'product' -%}
      {%- if c_level_0 != blank -%}
        {%- assign has_ellipsis = true -%}
      {%- endif -%}
    {%- when 'collection' and collection.handle -%}
      {%- if c_level_1 != blank -%}
        {%- assign has_ellipsis = true -%}
      {%- endif -%}
    {%- when 'blog' -%}
      {%- if current_tags -%}
        {%- assign has_ellipsis = true -%}
      {%- endif -%}
    {%- when 'article' -%}
      {%- assign has_ellipsis = true -%}
  {%- endcase -%}

  <style>
    /* Smooth horizontal scrolling for breadcrumbs */
    .breadcrumbs-wrapper {
      position: relative;
      width: 100%;
    }
    .breadcrumbs-nav {
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      user-select: none;
    }
    .breadcrumbs-nav.is-overflowing {
      cursor: grab;
    }
    .breadcrumbs-nav.active-dragging {
      cursor: grabbing !important;
      scroll-behavior: auto !important;
    }
    .breadcrumbs-nav > * {
      flex-shrink: 0;
    }
    .breadcrumbs-fade-left,
    .breadcrumbs-fade-right {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 32px;
      pointer-events: none;
      z-index: 10;
      transition: opacity 0.3s ease;
    }
    .breadcrumbs-fade-left {
      left: 0;
      background: linear-gradient(to right, var(--color-background, #ffffff), transparent);
    }
    .breadcrumbs-fade-right {
      right: 0;
      background: linear-gradient(to left, var(--color-background, #ffffff), transparent);
    }

    /* Ellipsis collapse/expand styles */
    .breadcrumbs-nav .breadcrumb-ellipsis {
      display: inline-flex;
      align-items: center;
    }
    .breadcrumbs-nav .breadcrumb-collapsed-item {
      display: none !important;
    }
    .breadcrumbs-nav.is-expanded .breadcrumb-ellipsis {
      display: none !important;
    }
    .breadcrumbs-nav.is-expanded .breadcrumb-collapsed-item {
      display: inline-flex !important;
      align-items: center;
    }

    /* Do not abbreviate breadcrumbs on desktop */
    @media screen and (min-width: 1200px) {
      .breadcrumbs-nav .breadcrumb-ellipsis {
        display: none !important;
      }
      .breadcrumbs-nav .breadcrumb-collapsed-item {
        display: inline-flex !important;
        align-items: center;
      }
    }
  </style>

  {%- assign parent_url = routes.root_url -%}
  {%- assign parent_title = "Forside" -%}

  {%- case t -%}
    {%- when 'product' -%}
      {%- if c_level_0 != blank -%}
        {%- assign parent_url = c_level_0.url -%}
        {%- assign parent_title = c_level_0.title -%}
      {%- endif -%}
    {%- when 'collection' and collection.handle -%}
      {%- if c_level_1 != blank -%}
        {%- assign parent_url = c_level_1.url -%}
        {%- assign parent_title = c_level_1.title -%}
      {%- endif -%}
    {%- when 'blog' -%}
      {%- if current_tags -%}
        {%- assign parent_url = blog.url -%}
        {%- assign parent_title = blog.title -%}
      {%- endif -%}
    {%- when 'article' -%}
      {%- assign parent_url = blog.url -%}
      {%- assign parent_title = blog.title -%}
  {%- endcase -%}

  <div class="mobile-breadcrumb md:hidden flex items-center justify-start h-12 text-left">
    <a href="{{ parent_url }}" class="flex items-center justify-start gap-1 hover:underline text-primary/85 no-underline text-sm">
      <span class="material-symbols-outlined text-[18px] select-none">chevron_left</span>
      <span>{{ parent_title }}</span>
    </a>
  </div>

  <div class="breadcrumbs-wrapper hidden md:block text-left">
    <div class="breadcrumbs-fade-left opacity-0"></div>
    <nav data-breadcrumbs-nav class="breadcrumbs-nav text-xs sm:text-sm text-primary/85 flex items-center justify-start gap-0.5 overflow-x-auto whitespace-nowrap h-12 hide-scrollbar" aria-label="Brødkrummer">
        
        {%- comment -%} Forside (root) {%- endcomment -%}
        {%- assign forside_class = "" -%}
        {%- if has_ellipsis -%}
          {%- assign forside_class = "breadcrumb-collapsed-item" -%}
        {%- endif -%}
        <a href="{{ routes.root_url }}" class="{{ forside_class }} hover:underline text-primary/85 no-underline">Forside</a>
        <span class="{{ forside_class }} material-symbols-outlined text-[16px]">chevron_right</span>

        {%- if has_ellipsis -%}
          <button type="button" onclick="this.closest('[data-breadcrumbs-nav]').classList.add('is-expanded')" class="breadcrumb-ellipsis hover:underline text-primary/85 cursor-pointer border-none bg-transparent p-0 text-sm font-normal" aria-label="Vis hele stien">...</button>
          <span class="breadcrumb-ellipsis material-symbols-outlined text-[16px] select-none">chevron_right</span>
        {%- endif -%}

        {%- case t -%}
          {%- when 'page' -%}
            <span class="text-primary/85 font-medium" aria-current="page">{{ page.title }}</span>

          {%- when 'product' -%}
            {%- if c_level_0 != blank -%}
              {%- if c_level_6 != blank -%}
                <a href="{{ c_level_6.url }}" class="breadcrumb-collapsed-item hover:underline text-primary/85 no-underline">{{ c_level_6.title }}</a>
                <span class="breadcrumb-collapsed-item material-symbols-outlined text-[16px]">chevron_right</span>
              {%- endif -%}
              {%- if c_level_5 != blank -%}
                <a href="{{ c_level_5.url }}" class="breadcrumb-collapsed-item hover:underline text-primary/85 no-underline">{{ c_level_5.title }}</a>
                <span class="breadcrumb-collapsed-item material-symbols-outlined text-[16px]">chevron_right</span>
              {%- endif -%}
              {%- if c_level_4 != blank -%}
                <a href="{{ c_level_4.url }}" class="breadcrumb-collapsed-item hover:underline text-primary/85 no-underline">{{ c_level_4.title }}</a>
                <span class="breadcrumb-collapsed-item material-symbols-outlined text-[16px]">chevron_right</span>
              {%- endif -%}
              {%- if c_level_3 != blank -%}
                <a href="{{ c_level_3.url }}" class="breadcrumb-collapsed-item hover:underline text-primary/85 no-underline">{{ c_level_3.title }}</a>
                <span class="breadcrumb-collapsed-item material-symbols-outlined text-[16px]">chevron_right</span>
              {%- endif -%}
              {%- if c_level_2 != blank -%}
                <a href="{{ c_level_2.url }}" class="breadcrumb-collapsed-item hover:underline text-primary/85 no-underline">{{ c_level_2.title }}</a>
                <span class="breadcrumb-collapsed-item material-symbols-outlined text-[16px]">chevron_right</span>
              {%- endif -%}
              {%- if c_level_1 != blank -%}
                <a href="{{ c_level_1.url }}" class="breadcrumb-collapsed-item hover:underline text-primary/85 no-underline">{{ c_level_1.title }}</a>
                <span class="breadcrumb-collapsed-item material-symbols-outlined text-[16px]">chevron_right</span>
              {%- endif -%}
              <a href="{{ c_level_0.url }}" class="hover:underline text-primary/85 no-underline">{{ c_level_0.title }}</a>
              <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            {%- endif -%}
            <span class="text-primary/85 font-medium" aria-current="page">{{ product.title }}</span>

          {%- when 'collection' and collection.handle -%}
            {%- if c_level_6 != blank -%}
              <a href="{{ c_level_6.url }}" class="breadcrumb-collapsed-item hover:underline text-primary/85 no-underline">{{ c_level_6.title }}</a>
              <span class="breadcrumb-collapsed-item material-symbols-outlined text-[16px]">chevron_right</span>
            {%- endif -%}
            {%- if c_level_5 != blank -%}
              <a href="{{ c_level_5.url }}" class="breadcrumb-collapsed-item hover:underline text-primary/85 no-underline">{{ c_level_5.title }}</a>
              <span class="breadcrumb-collapsed-item material-symbols-outlined text-[16px]">chevron_right</span>
            {%- endif -%}
            {%- if c_level_4 != blank -%}
              <a href="{{ c_level_4.url }}" class="breadcrumb-collapsed-item hover:underline text-primary/85 no-underline">{{ c_level_4.title }}</a>
              <span class="breadcrumb-collapsed-item material-symbols-outlined text-[16px]">chevron_right</span>
            {%- endif -%}
            {%- if c_level_3 != blank -%}
              <a href="{{ c_level_3.url }}" class="breadcrumb-collapsed-item hover:underline text-primary/85 no-underline">{{ c_level_3.title }}</a>
              <span class="breadcrumb-collapsed-item material-symbols-outlined text-[16px]">chevron_right</span>
            {%- endif -%}
            {%- if c_level_2 != blank -%}
              <a href="{{ c_level_2.url }}" class="breadcrumb-collapsed-item hover:underline text-primary/85 no-underline">{{ c_level_2.title }}</a>
              <span class="breadcrumb-collapsed-item material-symbols-outlined text-[16px]">chevron_right</span>
            {%- endif -%}
            {%- if c_level_1 != blank -%}
              <a href="{{ c_level_1.url }}" class="hover:underline text-primary/85 no-underline">{{ c_level_1.title }}</a>
              <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            {%- endif -%}
            <span class="text-primary/85 font-medium" aria-current="page">{{ collection.title }}</span>

          {%- when 'blog' -%}
            {%- if current_tags -%}
              <a href="{{ blog.url }}" class="hover:underline text-primary/85 no-underline">{{ blog.title }}</a>
              <span class="material-symbols-outlined text-[16px]">chevron_right</span>
              {%- assign tag_title = current_tags | join: " + " -%}
              <span class="text-primary/85 font-medium" aria-current="page">{{ tag_title }}</span>
            {%- else -%}
              <span class="text-primary/85 font-medium" aria-current="page">{{ blog.title }}</span>
            {%- endif -%}

          {%- when 'article' -%}
            <a href="{{ blog.url }}" class="hover:underline text-primary/85 no-underline">{{ blog.title }}</a>
            <span class="material-symbols-outlined text-[16px]">chevron_right</span>
            <span class="text-primary/85 font-medium" aria-current="page">{{ article.title }}</span>

          {%- else -%}
            <span class="text-primary/85 font-medium" aria-current="page">{{ page_title }}</span>
        {%- endcase -%}
      </nav>
      <div class="breadcrumbs-fade-right opacity-0"></div>
    </div>

    <script>
      (function() {
        function initBreadcrumbs() {
          const navs = document.querySelectorAll('[data-breadcrumbs-nav]');
          navs.forEach(nav => {
            if (nav.dataset.initialized) return;
            nav.dataset.initialized = 'true';

            const wrapper = nav.closest('.breadcrumbs-wrapper');
            if (!wrapper) return;

            const fadeLeft = wrapper.querySelector('.breadcrumbs-fade-left');
            const fadeRight = wrapper.querySelector('.breadcrumbs-fade-right');

            function updateFades() {
              const scrollLeft = nav.scrollLeft;
              const maxScroll = nav.scrollWidth - nav.clientWidth;
              const isOverflowing = nav.scrollWidth > nav.clientWidth;

              if (isOverflowing) {
                nav.classList.add('is-overflowing');
              } else {
                nav.classList.remove('is-overflowing');
              }

              if (fadeLeft) {
                if (scrollLeft > 4) {
                  fadeLeft.classList.remove('opacity-0');
                  fadeLeft.classList.add('opacity-100');
                } else {
                  fadeLeft.classList.remove('opacity-100');
                  fadeLeft.classList.add('opacity-0');
                }
              }

              if (fadeRight) {
                if (isOverflowing && scrollLeft < maxScroll - 4) {
                  fadeRight.classList.remove('opacity-0');
                  fadeRight.classList.add('opacity-100');
                } else {
                  fadeRight.classList.remove('opacity-100');
                  fadeRight.classList.add('opacity-0');
                }
              }
            }

            // Scroll listener
            nav.addEventListener('scroll', updateFades);
            window.addEventListener('resize', updateFades);

            if (window.ResizeObserver) {
              new ResizeObserver(updateFades).observe(nav);
            }

            // Drag to scroll
            let isDown = false;
            let startX;
            let scrollLeftVal;
            let hasMoved = false;

            nav.addEventListener('mousedown', (e) => {
              isDown = true;
              hasMoved = false;
              nav.classList.add('active-dragging');
              startX = e.pageX - nav.offsetLeft;
              scrollLeftVal = nav.scrollLeft;
            });

            nav.addEventListener('mouseleave', () => {
              isDown = false;
              nav.classList.remove('active-dragging');
            });

            nav.addEventListener('mouseup', () => {
              isDown = false;
              nav.classList.remove('active-dragging');
            });

            nav.addEventListener('mousemove', (e) => {
              if (!isDown) return;
              const x = e.pageX - nav.offsetLeft;
              const walk = (x - startX) * 1.5;
              if (Math.abs(x - startX) > 5) {
                hasMoved = true;
              }
              nav.scrollLeft = scrollLeftVal - walk;
            });

            // Prevent clicking links if we dragged
            nav.addEventListener('click', (e) => {
              if (hasMoved) {
                e.preventDefault();
                e.stopPropagation();
              }
            }, true);

            // Initialize state
            setTimeout(updateFades, 50);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initBreadcrumbs);
        } else {
          initBreadcrumbs();
        }
        
        // Support shopify section load events in theme customizer
        document.addEventListener('shopify:section:load', function(e) {
          if (e.target.classList.contains('shopify-section-breadcrumbs') || e.target.querySelector('[data-breadcrumbs-nav]')) {
            initBreadcrumbs();
          }
        });
      })();
    </script>

  {%- comment -%}
    Breadcrumb JSON-LD Schema
  {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Forside",
        "item": "{{ shop.url }}{{ routes.root_url }}"
      }
      {%- assign position = 2 -%}
      {%- case t -%}
