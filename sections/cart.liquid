{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<h1>{{ 'cart.title' | t }}</h1>

{% form 'cart', cart %}
  <table>
    {% for item in cart.items %}
      <tr>
        <td>
          {%- if item.properties._image != blank -%}
            <a href="{{ item.url }}" class="image">
              <img src="{{ item.properties._image }}" alt="{{ item.title }}" />
            </a>
          {%- else -%}
            {% render 'image', image: item.image, url: item.url %}
          {%- endif -%}
        </td>
        <td>
          {%- if item.properties._base_price != blank -%}
            {%- liquid
              assign base_price_cents = item.properties._base_price | plus: 0
              assign shape_surcharge_cents = item.properties._shape_surcharge | default: "0" | plus: 0
              assign width_surcharge_cents = item.properties._width_surcharge | default: "0" | plus: 0
              assign unit_price_cents = base_price_cents | plus: shape_surcharge_cents | plus: width_surcharge_cents
              
              assign shape_name = "Form: Firkantet"
              if item.properties._shape == "rund"
                assign shape_name = "Form: Rund"
              elsif item.properties._shape == "oval"
                assign shape_name = "Form: Oval"
              endif
            -%}
            {%- assign customized_title = item.properties._metervare_title | default: item.product.title -%}
            <p class="text-sm sm:text-base font-semibold text-primary truncate mb-1.5" title="{{ customized_title }}">{{ customized_title }}</p>
            <div class="space-y-1 text-xs sm:text-sm text-primary/85 font-normal leading-normal max-w-sm mt-1">
              <div class="flex justify-between gap-2">
                <span>
                  {%- if item.properties._shape == "rund" -%}
                    Diameter: {{ item.properties._length }} cm
                  {%- else -%}
                    Længde: {{ item.properties._length }} cm
                  {%- endif -%}
                </span>
                <span class="text-primary font-medium flex-shrink-0">{{ base_price_cents | money }}</span>
              </div>
              {%- if item.properties._shape != blank -%}
                <div class="flex justify-between gap-2">
                  <span>{{ shape_name }}</span>
                  <span class="text-primary font-medium flex-shrink-0">{{ shape_surcharge_cents | money }}</span>
                </div>
              {%- endif -%}
              {%- if item.properties._shape != "rund" and item.properties._width != blank -%}
                <div class="flex justify-between gap-2">
                  <span>Bredde: {{ item.properties._width }} cm</span>
                  <span class="text-primary font-medium flex-shrink-0">{{ width_surcharge_cents | money }}</span>
                </div>
              {%- endif -%}
              <div class="flex justify-between border-t border-outline-variant/60 pt-1 mt-1">
                <span>Pris pr. dug.</span>
                <span class="flex-shrink-0">{{ unit_price_cents | money }}</span>
              </div>
              {%- if item.quantity > 1 -%}
                <div class="flex justify-between border-t border-outline-variant/40 pt-1 text-primary text-sm sm:text-base font-semibold">
                  <span>I alt ({{ item.quantity }} stk.)</span>
                  <span class="flex-shrink-0">{{ item.final_line_price | money }}</span>
                </div>
              {%- endif -%}
            </div>
            {%- render 'unit-price', variant: item, size: 'sm' -%}
            {%- if item.line_level_discount_allocations.size > 0 -%}
              <div class="flex items-baseline gap-2 mt-1">
                <span class="text-sm text-primary/50 line-through">
                  <span class="sr-only">{{ 'cart.original_price_label' | t }}</span>{{ item.original_line_price | money }}
                </span>
                <span class="text-sm sm:text-base font-bold text-primary">{{ item.final_line_price | money }}</span>
              </div>
              <div class="flex flex-wrap gap-1.5 mt-1">
                {%- for allocation in item.line_level_discount_allocations -%}
                  {%- render 'cart-discount-chip', title: allocation.discount_application.title -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
            <div class="mt-2 text-sm">
              {{ 'cart.remove' | t | link_to: item.url_to_remove, class: 'text-red-600 hover:underline font-medium' }}
            </div>
          {%- else -%}
            {%- if item.properties._length != blank -%}
              <p class="text-sm sm:text-base font-semibold text-primary truncate" title="{{ item.title }}">{{ item.title }}</p>
            {%- else -%}
              <p class="text-sm sm:text-base font-semibold text-primary truncate" title="{{ item.product_title }}">{{ item.product_title }}</p>
              {%- if item.variant.title != 'Default Title' -%}
                <p class="text-xs sm:text-sm text-primary/85 truncate">{{ item.variant.title }}</p>
              {%- endif -%}
            {%- endif -%}
            {%- render 'unit-price', variant: item, size: 'sm' -%}
            {%- if item.line_level_discount_allocations.size > 0 -%}
              <div class="flex items-baseline gap-2 mt-1">
                <span class="text-sm text-primary/50 line-through">
                  <span class="sr-only">{{ 'cart.original_price_label' | t }}</span>{{ item.original_line_price | money }}
                </span>
                <span class="text-sm sm:text-base font-bold text-primary">{{ item.final_line_price | money }}</span>
              </div>
              <div class="flex flex-wrap gap-1.5 mt-1">
                {%- for allocation in item.line_level_discount_allocations -%}
                  {%- render 'cart-discount-chip', title: allocation.discount_application.title -%}
                {%- endfor -%}
              </div>
            {%- endif -%}
            <div class="mt-2 text-sm">
              {{ 'cart.remove' | t | link_to: item.url_to_remove, class: 'text-red-600 hover:underline font-medium' }}
            </div>
          {%- endif -%}
        </td>
        <td>
          <input type="text" name="updates[]" value="{{ item.quantity }}">
          <input type="submit" value="{{ 'cart.update' | t }}">
        </td>
      </tr>
    {% endfor %}
  </table>

  <dl class="w-full md:w-96 md:ml-auto mt-6 p-4 rounded-2xl bg-card-high flex flex-col gap-2">
    <div class="flex items-center justify-between gap-4 text-sm">
      <dt class="text-primary/70">{{ 'cart.subtotal' | t }}</dt>
      <dd class="text-primary">{{ cart.original_total_price | money }}</dd>
    </div>
    {%- for discount_application in cart.cart_level_discount_applications -%}
      <div class="flex items-center justify-between gap-4 text-sm">
        <dt class="flex items-center gap-2 text-primary/70">
          {{ 'cart.discount' | t }}
          {%- render 'cart-discount-chip', title: discount_application.title -%}
        </dt>
        <dd class="text-primary font-semibold">-{{ discount_application.total_allocated_amount | money }}</dd>
      </div>
    {%- endfor -%}
    <div class="border-t border-outline-variant my-1"></div>
    <div class="flex items-center justify-between gap-4 text-sm">
      <dt class="text-primary font-bold">{{ 'cart.total' | t }}</dt>
      <dd class="text-lg font-bold text-primary"><strong>{{ cart.total_price | money }}</strong></dd>
    </div>
    <p class="text-xs text-primary/60">{{ 'cart.shipping_note' | t }}</p>
  </dl>

  <button type="submit" name="checkout" class="w-full md:w-96 md:ml-auto py-3.5 px-8 mt-6 bg-accent hover:brightness-95 text-primary font-bold rounded-full text-sm text-center shadow-sm active:scale-95 transition-all cursor-pointer border-0 block focus:outline-none">
    {{ 'cart.checkout' | t }}
  </button>

  {%- if section.settings.show_dynamic_checkout -%}
    <div class="checkout-divider flex items-center gap-3 my-1 w-full md:w-96 md:ml-auto mt-3">
      <span class="flex-1 border-t border-outline-variant"></span>
      <span class="text-xs font-bold uppercase tracking-widest text-primary/50 shrink-0">{{ 'checkout.or_divider' | t }}</span>
      <span class="flex-1 border-t border-outline-variant"></span>
    </div>
    <div class="dynamic-checkout-wrapper w-full md:w-96 md:ml-auto">
      {%- if additional_checkout_buttons -%}
        {{ content_for_additional_checkout_buttons }}
      {%- endif -%}
    </div>
  {%- endif -%}
{% endform %}

{%- style -%}
  #shopify-section-{{ section.id }} .dynamic-checkout-wrapper:empty {
    display: none;
  }

  #shopify-section-{{ section.id }} .checkout-divider:has(+ .dynamic-checkout-wrapper:empty) {
    display: none;
  }
{%- endstyle -%}

{% schema %}
{
  "name": "t:general.cart",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Vis hurtige betalingsknapper under Gå til kassen",
      "default": true
    }
  ]
}
{% endschema %}
