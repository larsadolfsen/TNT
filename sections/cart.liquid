{% comment %}
  This section is used in the cart template to render /cart page with an
  overview of the items in customer's cart.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/cart
{% endcomment %}

<h1>{{ 'cart.title' | t }}</h1>

<form action="{{ routes.cart_url }}" method="post">
  <table>
    {% for item in cart.items %}
      <tr>
        <td>
          {% render 'image', image: item.image, url: item.url %}
        </td>
        <td>
          {%- if item.properties._base_price != blank -%}
            {%- liquid
              assign base_price_cents = item.properties._base_price | plus: 0
              assign shape_surcharge_cents = item.properties._shape_surcharge | default: "0" | plus: 0
              assign width_surcharge_cents = item.properties._width_surcharge | default: "0" | plus: 0
              assign unit_price_cents = base_price_cents | plus: shape_surcharge_cents | plus: width_surcharge_cents
              
              assign shape_name = "Rektangulær dug"
              if item.properties._shape == "rund"
                assign shape_name = "Rund dug"
              elsif item.properties._shape == "oval"
                assign shape_name = "Oval dug"
              endif
            -%}
            <div class="space-y-1 text-[11px] text-on-surface-variant font-normal leading-normal max-w-sm mt-1">
              <div class="flex justify-between gap-2">
                <span>{{ item.product.title }}{% if item.variant.title != 'Default Title' %}, {{ item.variant.title }}{% endif %}</span>
                <span class="text-primary font-medium flex-shrink-0">{{ base_price_cents | money }}</span>
              </div>
              <div class="flex justify-between gap-2">
                <span>{{ shape_name }}</span>
                <span class="text-primary font-medium flex-shrink-0">{{ shape_surcharge_cents | money }}</span>
              </div>
              <div class="flex justify-between gap-2">
                <span>Tilpasset i bredden</span>
                <span class="text-primary font-medium flex-shrink-0">{{ width_surcharge_cents | money }}</span>
              </div>
              <div class="flex justify-between border-t border-outline-variant/60 pt-1 font-bold text-primary text-xs mt-1">
                <span>Pris pr. stk.</span>
                <span class="flex-shrink-0">{{ unit_price_cents | money }}</span>
              </div>
              {%- if item.quantity > 1 -%}
                <div class="flex justify-between border-t border-outline-variant/40 pt-1 text-primary text-xs font-semibold">
                  <span>I alt ({{ item.quantity }} stk.)</span>
                  <span class="flex-shrink-0">{{ item.final_line_price | money }}</span>
                </div>
              {%- endif -%}
            </div>
            <div class="mt-2 text-xs">
              {{ 'cart.remove' | t | link_to: item.url_to_remove, class: 'text-red-600 hover:underline font-medium' }}
            </div>
          {%- else -%}
            <p class="text-xs font-semibold text-primary truncate" title="{{ item.product_title }}">{{ item.product_title }}</p>
            {%- if item.variant.title != 'Default Title' -%}
              <p class="text-[10px] text-on-surface-variant truncate">{{ item.variant.title }}</p>
            {%- endif -%}
            <div class="mt-2 text-xs">
              {{ 'cart.remove' | t | link_to: item.url_to_remove, class: 'text-red-600 hover:underline font-medium' }}
            </div>
          {%- endif -%}
        </td>
        <td>
          <input type="text" name="updates[]" value="{{ item.quantity }}">
          <input type="submit" value="{{ 'cart.update' | t }}">
        </td>
      </tr>
    {% endfor %}
  </table>

  <button type="submit" name="checkout" class="w-full md:w-96 py-3.5 px-8 mt-6 bg-[#FFD814] hover:bg-[#F7CA00] text-primary font-bold rounded-full text-sm text-center shadow-sm active:scale-95 transition-all cursor-pointer border-0 block focus:outline-none">
    {{ 'cart.checkout' | t }}
  </button>
</form>

{% schema %}
{
  "name": "t:general.cart",
  "settings": []
}
{% endschema %}
