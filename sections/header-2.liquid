{%- comment -%}
  Header 2 builder section: the header row block area plus the mobile menu
  drawer, cart drawer and cart config island (all snippets/header-*.liquid).
  Behaviour lives in assets/header.js and assets/header-cart.js.
{%- endcomment -%}

{%- liquid
  assign mobile_menu_handle = section.settings.menu
-%}

<header class="header-2 bg-card-light border-b border-outline-variant px-4 lg:px-6">
  <div class="{% if section.settings.content_width == 'content' %}max-w-screen-xl mx-auto{% endif %} w-full">
    <div class="flex flex-col w-full">
      {% content_for 'blocks' %}
    </div>
  </div>
</header>

{% render 'header-mobile-drawer', menu_handle: mobile_menu_handle %}
{% render 'header-cart-drawer' %}
{% render 'header-cart-config' %}

<script src="{{ 'header.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'header-cart.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Header 2",
  "blocks": [
    {
      "type": "header-row-2"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "content_width",
      "label": "Header width",
      "options": [
        {
          "value": "content",
          "label": "Content width"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "content"
    },

    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu list (for mobile drawer)",
      "default": "main-menu"
    }
  ],
  "presets": [
    {
      "name": "Header 2"
    }
  ]
}
{% endschema %}
