{% comment %}
  Product Media Gallery Section
  Renders the featured image, absolute bestseller badge, and gallery indicator dots.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}

<section class="relative max-w-screen-xl mx-auto">
  <div class="aspect-[3/2] bg-surface-container overflow-hidden">
    {%- if featured_image -%}
      <img 
        id="main-product-img" 
        alt="{{ product.title }}" 
        class="w-full h-full object-cover transition-all duration-200 opacity-100" 
        src="{{ featured_image | image_url: width: 1200 }}"
        width="1200"
        height="800"
      />
    {%- else -%}
      <img 
        id="main-product-img" 
        alt="Klar voksdug" 
        class="w-full h-full object-cover transition-all duration-200 opacity-100" 
        src="https://lh3.googleusercontent.com/aida-public/AB6AXuDT6v3nHI941v3VLOOVZi6aiIWU9Bk0oFqdFrpEO7HFKCiZVZWAkbZafIRHYpjXJ-vkib7-EqYsE-5f6cnWn3VaO92Upxnr3Udg0oV4LbzaJlQitsTts1KuFfq1PU0VMG5FNT1Mx8PjaQZMPzcPs3QUaHTsVPYlxETHQLH5N6-GqTQnIQ63D-Wyjal17RpHnqDmyEDHeA5W9mgHscm42-_bB9kfmytEfumkgNPSNYbcZvTfvcT4xd6XZB0EuIRQ-DmyrVWWdxzFyBaa"
        width="1200"
        height="800"
      />
    {%- endif -%}
  </div>
  <div class="absolute top-4 left-4">
    <span class="bg-white/90 backdrop-blur text-primary text-[10px] font-bold px-3 py-1.5 rounded tracking-widest shadow-sm border border-outline-variant">
      {{ section.settings.image_badge | default: "BESTSELLER" }}
    </span>
  </div>
</section>

<!-- Indicator Dots -->
<div class="flex justify-center items-center gap-2 px-4 mt-3 max-w-screen-xl mx-auto" id="gallery-dots">
  {%- if product.images.size > 0 -%}
    {%- for image in product.images -%}
      <button 
        class="dot-btn w-2.5 h-2.5 rounded-full {% if forloop.first %}bg-primary{% else %}bg-slate-300{% endif %} focus:outline-none transition-colors" 
        data-src="{{ image.src | image_url: width: 1200 }}"
        aria-label="Skift billede {{ forloop.index }}"
      ></button>
    {%- endfor -%}
  {%- endif -%}
</div>

<script>
  (() => {
    const initGallery = () => {
      const mainImg = document.getElementById("main-product-img");
      const dots = document.querySelectorAll(".dot-btn");
      if (!mainImg || dots.length <= 1) return;

      let currentIndex = 0;

      // Find initial active index
      dots.forEach((dot, index) => {
        if (dot.classList.contains("bg-primary")) {
          currentIndex = index;
        }
      });

      function showImage(index) {
        if (index >= dots.length) {
          currentIndex = 0;
        } else if (index < 0) {
          currentIndex = dots.length - 1;
        } else {
          currentIndex = index;
        }

        const activeDot = dots[currentIndex];
        const newSrc = activeDot.getAttribute("data-src");

        // Update dots styles
        dots.forEach(d => {
          d.classList.remove("bg-primary");
          d.classList.add("bg-slate-300");
        });
        activeDot.classList.remove("bg-slate-300");
        activeDot.classList.add("bg-primary");

        // Fade transition
        mainImg.classList.replace("opacity-100", "opacity-0");
        setTimeout(() => {
          mainImg.src = newSrc;
          mainImg.classList.replace("opacity-0", "opacity-100");
        }, 150);
      }

      // Click on dots
      dots.forEach((dot, index) => {
        dot.addEventListener("click", () => {
          showImage(index);
        });
      });

      // Swipe detection using pointer events for both touch and desktop mouse dragging
      const container = mainImg.parentElement;
      if (container) {
        container.style.touchAction = "pan-y";
        container.style.userSelect = "none";
        mainImg.style.userSelect = "none";
        mainImg.setAttribute("draggable", "false");

        let pointerStartX = 0;
        let pointerStartY = 0;
        let isDragging = false;

        container.addEventListener("pointerdown", (e) => {
          pointerStartX = e.clientX;
          pointerStartY = e.clientY;
          isDragging = true;
        });

        document.addEventListener("pointerup", (e) => {
          if (!isDragging) return;
          isDragging = false;

          const pointerEndX = e.clientX;
          const pointerEndY = e.clientY;

          const diffX = pointerEndX - pointerStartX;
          const diffY = pointerEndY - pointerStartY;

          // Minimum swipe distance of 40px, and horizontal dominant direction
          if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
            if (diffX < 0) {
              // Swipe Left -> Next Image
              showImage(currentIndex + 1);
            } else {
              // Swipe Right -> Previous Image
              showImage(currentIndex - 1);
            }
          }
        });

        // Cancel dragging if browser cancels the pointer
        container.addEventListener("pointercancel", () => {
          isDragging = false;
        });
      }
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initGallery);
    } else {
      initGallery();
    }
  })();
</script>

{% schema %}
{
  "name": "Product Media Gallery",
  "settings": [
    {
      "type": "text",
      "id": "image_badge",
      "label": "Image Sticker Text",
      "default": "BESTSELLER"
    }
  ],
  "presets": [
    {
      "name": "Product Media Gallery"
    }
  ]
}
{% endschema %}
