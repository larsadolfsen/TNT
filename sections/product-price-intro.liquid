{% comment %}
  Product Price and Intro Section
  Renders the product title, star reviews rating, buy volume badge, and base price per meter display.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}

<section class="max-w-screen-xl mx-auto px-4 pt-4 pb-3">
  <!-- Product Intro -->
  <h1 class="font-normal text-primary leading-tight text-lg">
    {{ product.title }}
  </h1>
  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1 mt-1.5">
    <div class="flex items-center gap-1">
      <div class="flex text-amber-500">
        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
        <span class="material-symbols-outlined text-sm" style="font-variation-settings: 'FILL' 1;">star</span>
      </div>
      <span class="text-xs font-medium text-primary">
        {{ section.settings.rating_score | default: "4,8" }} · {{ section.settings.rating_count | default: "163" }} anmeldelser
      </span>
    </div>
    <span class="text-xs text-on-surface-variant bg-surface-container px-2 py-0.5 rounded">
      {{ section.settings.badge_text | default: "300+ købt den seneste måned" }}
    </span>
  </div>

  <!-- Pricing -->
  <div class="flex items-baseline gap-2 flex-nowrap overflow-hidden mt-6">
    <span id="base-price-display" class="text-3xl font-bold tracking-tight text-primary whitespace-nowrap">
      {{ current_variant.price | money }}
    </span>
    <span class="text-sm text-on-surface-variant font-medium whitespace-nowrap">pr. meter · inkl. moms</span>
  </div>
  <p class="text-xs text-on-surface-variant mt-1.5">Skæres efter mål, så du kun betaler for den længde, du vælger.</p>
</section>

{% schema %}
{
  "name": "Product Price & Intro",
  "settings": [
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4,8"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Total Review Count",
      "default": "163"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Urgency Badge Text",
      "default": "300+ købt den seneste måned"
    }
  ],
  "presets": [
    {
      "name": "Product Price & Intro"
    }
  ]
}
{% endschema %}
