{% comment %}
  This section is used in the password template to render the landing page shown
  when password protection is applied to a store.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="min-h-screen flex flex-col justify-between bg-[#081018] text-white font-sans relative overflow-hidden selection:bg-secondary selection:text-white">
  
  <!-- Subtle Background Orbs -->
  <div class="absolute top-[-10%] left-[-10%] w-[50%] h-[50%] rounded-full bg-[#8a5100]/10 blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-[#0e1a28]/60 blur-[120px] pointer-events-none"></div>

  <!-- Header -->
  <header class="w-full max-w-7xl mx-auto px-6 py-8 flex justify-between items-center z-10">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-[#8a5100] text-3xl select-none">texture</span>
      <span class="font-serif text-xl font-bold tracking-wide uppercase text-white/95">
        {{ shop.name }}
      </span>
    </div>
  </header>

  <!-- Main Content Card -->
  <main class="flex-grow flex items-center justify-center px-4 py-12 z-10">
    <div class="w-full max-w-md bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-8 md:p-10 shadow-2xl relative">
      
      <!-- Lock Icon Badge -->
      <div class="w-16 h-16 bg-[#8a5100]/15 border border-[#8a5100]/35 rounded-full flex items-center justify-center mx-auto mb-6 text-[#8a5100]">
        <span class="material-symbols-outlined text-3xl select-none">lock</span>
      </div>

      <!-- Title / Heading -->
      <h1 class="font-serif text-3xl md:text-4xl text-center font-bold tracking-tight mb-3 text-white">
        {{ 'password.title' | t }}
      </h1>

      <!-- Password Message (if any) -->
      {% if shop.password_message != blank %}
        <div class="bg-white/5 border-l-2 border-[#8a5100] rounded-r-lg p-4 mb-6 text-sm text-white/85 leading-relaxed">
          {{ shop.password_message }}
        </div>
      {% endif %}

      <!-- Password Entry Form -->
      {% form 'storefront_password', class: 'space-y-6' %}
        {% if form.errors %}
          <div class="bg-red-500/10 border border-red-500/20 text-red-200 text-sm rounded-lg p-4 flex items-start gap-2.5">
            <span class="material-symbols-outlined text-xl shrink-0 mt-0.5 select-none">warning</span>
            <div>
              {{ form.errors | default_errors }}
            </div>
          </div>
        {% endif %}

        <div class="space-y-2">
          <label for="password-input" class="block text-xs font-semibold uppercase tracking-wider text-white/60">
            {{ 'password.password' | t }}
          </label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-3.5 top-1/2 -translate-y-1/2 text-white/40 text-xl select-none">vpn_key</span>
            <input 
              type="password" 
              name="password" 
              id="password-input" 
              placeholder="••••••••"
              class="w-full pl-11 pr-4 py-3 bg-white/5 border border-white/15 rounded-lg focus:outline-none focus:border-[#8a5100] focus:ring-1 focus:ring-[#8a5100] text-white placeholder-white/25 transition-all duration-200"
              autocomplete="current-password"
              required
            >
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full py-3 px-4 bg-[#8a5100] hover:bg-[#9e5d00] text-white font-medium rounded-lg shadow-lg hover:shadow-[#8a5100]/25 transition-all duration-300 transform hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer"
        >
          <span>{{ 'password.enter' | t }}</span>
          <span class="material-symbols-outlined text-lg select-none">login</span>
        </button>
      {% endform %}

    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full max-w-7xl mx-auto px-6 py-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-white/40 z-10 border-t border-white/5">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Alle rettigheder forbeholdes.</p>
    <a href="/admin" class="hover:text-white transition-colors duration-200 flex items-center gap-1">
      <span class="material-symbols-outlined text-sm select-none">admin_panel_settings</span>
      <span>Admin login</span>
    </a>
  </footer>

</div>

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
