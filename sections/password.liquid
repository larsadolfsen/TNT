{% comment %}
  This section is used in the password template to render the landing page shown
  when password protection is applied to a store.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="min-h-screen flex flex-col justify-between bg-background text-foreground font-sans relative overflow-hidden selection:bg-accent selection:text-on-accent">
  
  <!-- Header -->
  <header class="w-full max-w-7xl mx-auto px-6 py-8 flex justify-center items-center z-10 border-b border-outline-variant bg-card-light">
    <div class="flex items-center gap-2">
      <span class="font-serif text-2xl font-bold tracking-wide text-primary">
        {{ shop.name }}
      </span>
    </div>
  </header>

  <!-- Main Content Card -->
  <main class="flex-grow flex items-center justify-center px-4 py-12 z-10">
    <div class="password-card w-full max-w-md bg-card-light border border-outline-variant rounded-3xl p-8 md:p-10 shadow-sm relative">
      
      <!-- Lock Icon Badge -->
      <div class="w-14 h-14 bg-card-high border border-outline-variant rounded-full flex items-center justify-center mx-auto mb-6 text-foreground/40">
        <span class="material-symbols-outlined text-2xl select-none">lock</span>
      </div>

      <!-- Title / Heading -->
      <h1 class="font-serif text-2xl md:text-3xl text-center font-bold tracking-tight mb-4 text-primary">
        {{ 'password.title' | t }}
      </h1>

      <!-- Password Message (if any) -->
      {% if shop.password_message != blank %}
        <div class="bg-card-high border-l-2 border-accent rounded-r-lg p-4 mb-6 text-sm text-foreground/70 leading-relaxed">
          {{ shop.password_message }}
        </div>
      {% endif %}

      <!-- Password Entry Form -->
      {% form 'storefront_password', class: 'space-y-6' %}
        {% if form.errors %}
          <div class="bg-md-error-container border border-md-error/30 text-md-on-error-container text-sm rounded-2xl p-4 flex items-start gap-2.5">
            <span class="material-symbols-outlined text-xl shrink-0 mt-0.5 select-none">warning</span>
            <div class="font-medium">
              {{ form.errors | default_errors }}
            </div>
          </div>
        {% endif %}

        <div class="space-y-2">
          <label for="password-input" class="block text-xs font-bold uppercase tracking-wider text-foreground/50 pl-4">
            {{ 'password.password' | t }}
          </label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-foreground/40 text-xl select-none">vpn_key</span>
            <input 
              type="password" 
              name="password" 
              id="password-input" 
              placeholder="••••••••"
              class="w-full pl-12 pr-4 py-3.5 bg-card-high border border-outline-variant rounded-full focus:outline-none focus:border-primary/50 focus:ring-1 focus:ring-primary/30 text-primary placeholder-foreground/30 transition-all duration-200"
              autocomplete="current-password"
              required
            >
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full py-3.5 px-6 bg-accent hover:brightness-95 text-on-accent font-bold rounded-full shadow-sm transition-all duration-300 transform hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer uppercase tracking-wider text-xs font-sans"
        >
          <span>{{ 'password.enter' | t }}</span>
          <span class="material-symbols-outlined text-base select-none">arrow_forward</span>
        </button>
      {% endform %}

    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full max-w-7xl mx-auto px-6 py-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-foreground/40 z-10 border-t border-outline-variant bg-card-light">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Alle rettigheder forbeholdes.</p>
    <a href="/admin" class="hover:text-primary transition-colors duration-200 flex items-center gap-1">
      <span class="material-symbols-outlined text-sm select-none">admin_panel_settings</span>
      <span>Admin login</span>
    </a>
  </footer>

</div>

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
