{% comment %}
  This section is used in the password template to render the landing page shown
  when password protection is applied to a store.
  https://shopify.dev/docs/storefronts/themes/architecture/templates/password
{% endcomment %}

<div class="min-h-screen flex flex-col justify-between bg-[#f9f9f9] text-slate-800 font-sans relative overflow-hidden selection:bg-accent selection:text-[#1a1c1c]">
  
  <!-- Header -->
  <header class="w-full max-w-7xl mx-auto px-6 py-8 flex justify-center items-center z-10 border-b border-outline-variant bg-white">
    <div class="flex items-center gap-2">
      <span class="font-serif text-2xl font-bold tracking-wide text-[#0e1a28]">
        {{ shop.name }}
      </span>
    </div>
  </header>

  <!-- Main Content Card -->
  <main class="flex-grow flex items-center justify-center px-4 py-12 z-10">
    <div class="password-card w-full max-w-md bg-white border border-outline-variant rounded-3xl p-8 md:p-10 shadow-sm relative">
      
      <!-- Lock Icon Badge -->
      <div class="w-14 h-14 bg-slate-50 border border-outline-variant rounded-full flex items-center justify-center mx-auto mb-6 text-slate-400">
        <span class="material-symbols-outlined text-2xl select-none">lock</span>
      </div>

      <!-- Title / Heading -->
      <h1 class="font-serif text-2xl md:text-3xl text-center font-bold tracking-tight mb-4 text-[#0e1a28]">
        {{ 'password.title' | t }}
      </h1>

      <!-- Password Message (if any) -->
      {% if shop.password_message != blank %}
        <div class="bg-slate-50 border-l-2 border-accent rounded-r-lg p-4 mb-6 text-sm text-slate-600 leading-relaxed">
          {{ shop.password_message }}
        </div>
      {% endif %}

      <!-- Password Entry Form -->
      {% form 'storefront_password', class: 'space-y-6' %}
        {% if form.errors %}
          <div class="bg-red-50 border border-red-100 text-red-700 text-sm rounded-2xl p-4 flex items-start gap-2.5">
            <span class="material-symbols-outlined text-xl shrink-0 mt-0.5 select-none">warning</span>
            <div class="font-medium">
              {{ form.errors | default_errors }}
            </div>
          </div>
        {% endif %}

        <div class="space-y-2">
          <label for="password-input" class="block text-xs font-bold uppercase tracking-wider text-slate-500 pl-4">
            {{ 'password.password' | t }}
          </label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-xl select-none">vpn_key</span>
            <input 
              type="password" 
              name="password" 
              id="password-input" 
              placeholder="••••••••"
              class="w-full pl-12 pr-4 py-3.5 bg-white border border-outline-variant rounded-full focus:outline-none focus:border-slate-400 focus:ring-1 focus:ring-slate-400 text-slate-800 placeholder-slate-300 transition-all duration-200"
              autocomplete="current-password"
              required
            >
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full py-3.5 px-6 bg-accent hover:brightness-95 text-[#1a1c1c] font-bold rounded-full shadow-sm transition-all duration-300 transform hover:scale-[1.01] active:scale-[0.99] flex items-center justify-center gap-2 cursor-pointer uppercase tracking-wider text-xs font-sans"
        >
          <span>{{ 'password.enter' | t }}</span>
          <span class="material-symbols-outlined text-base select-none">arrow_forward</span>
        </button>
      {% endform %}

    </div>
  </main>

  <!-- Footer -->
  <footer class="w-full max-w-7xl mx-auto px-6 py-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-400 z-10 border-t border-outline-variant bg-white">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Alle rettigheder forbeholdes.</p>
    <a href="/admin" class="hover:text-slate-700 transition-colors duration-200 flex items-center gap-1">
      <span class="material-symbols-outlined text-sm select-none">admin_panel_settings</span>
      <span>Admin login</span>
    </a>
  </footer>

</div>

{% schema %}
{
  "name": "t:general.password",
  "settings": []
}
{% endschema %}
