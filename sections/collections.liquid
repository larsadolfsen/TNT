{% comment %}
  This section is used in the list-collections template to render a list of
  collections.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}
{%- style -%}
  #collections-grid-{{ section.id }} {
    grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, minmax(0, 1fr));
  }

  @media screen and (min-width: 768px) {
    #collections-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_tablet | default: 3 }}, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1024px) {
    #collections-grid-{{ section.id }} {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 4 }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

<div id="collections-grid-{{ section.id }}" class="collections">
  {% for collection in collections %}
    <a class="collection-card group" href="{{ collection.url }}">
      <div class="collection-card__image-wrapper">
        {% if collection.featured_image %}
          {% render 'image',
            class: 'collection-card__image',
            image: collection.featured_image,
            width: 600,
            height: 600,
            crop: 'center'
          %}
        {% else %}
          <div class="w-full h-full flex items-center justify-center bg-outline-variant text-primary/85 aspect-square rounded-2xl border border-outline-variant">
            <span class="material-symbols-outlined text-4xl">image</span>
          </div>
        {% endif %}
      </div>

      <div class="collection-card__content">
        <h3 class="collection-card__title">{{ collection.title }}</h3>

        {% if collection.description %}
          <p class="collection-card__description">{{ collection.description | strip_html | truncatewords: 15 }}</p>
        {% endif %}
      </div>
    </a>
  {% endfor %}
</div>

{% stylesheet %}
  .collections {
    display: grid;
    column-gap: var(--grid-gap);
    row-gap: var(--grid-row-gap);
  }
  .collection-card {
    display: flex;
    flex-direction: column;
    width: 100%;
    text-decoration: none;
  }
  .collection-card__image-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1/1;
    overflow: hidden;
    border-radius: 1rem; /* rounded-2xl */
    border: 1px solid var(--color-border);
    background-color: var(--color-surface-container, #f5f5f5);
    transition: border-color 0.3s ease;
  }
  .collection-card:hover .collection-card__image-wrapper {
    border-color: rgba(var(--color-primary-rgb, 0, 0, 0), 0.4);
  }
  .collection-card__image {
    width: 100%;
    height: 100%;
  }
  .collection-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .collection-card:hover .collection-card__image img {
    transform: scale(1.03);
  }
  .collection-card__content {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  .collection-card__title {
    font-family: var(--font-sans-family), sans-serif;
    font-size: 0.875rem; /* text-sm */
    font-weight: 600;
    color: var(--color-primary, #000);
    line-height: 1.25;
    margin: 0 0 0.25rem 0;
    transition: color 0.3s ease;
  }
  @media (max-width: 640px) {
    .collection-card__title {
      font-size: 0.75rem; /* text-xs */
    }
  }
  .collection-card__description {
    font-size: 0.75rem;
    color: var(--color-primary-opacity-75, rgba(0,0,0,0.75));
    margin: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collections_grid",
  "settings": [
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 4,
      "step": 1,
      "label": "Antal kolonner på mobil",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Antal kolonner på tablet",
      "default": 3
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Antal kolonner på desktop",
      "default": 4
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "px",
      "default": 10
    }
  ],
  "presets": [{ "name": "t:general.collections_grid" }]
}
{% endschema %}
