    <span class="material-symbols-outlined text-lg">close</span>
  </button>
  
  <!-- Header -->
  <div class="flex items-center gap-1.5 text-emerald-600 font-bold pb-2 border-b border-outline-variant">
    <span class="material-symbols-outlined text-lg">check_circle</span>
    <span class="text-xs">Tilføjet til kurv</span>
  </div>
  
  <!-- Added Product Specifications -->
  <div class="flex gap-3 bg-surface-container p-2 rounded-xl">
