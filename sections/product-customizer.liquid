{% comment %}
  New Product Customizer Section
  Built from scratch. Renders a premium length stepper.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- liquid
  assign min_length = section.settings.min_length | default: 50
  assign step_size = section.settings.step_size | default: 10

  assign metervare_product = all_products[section.settings.metervare_product] | default: all_products['metervare']
  assign metervare_variant = nil
  for variant in metervare_product.variants
    if variant.sku == 'BTM001'
      assign metervare_variant = variant
      break
    endif
  endfor
  if metervare_variant == nil
    assign metervare_variant = metervare_product.selected_or_first_available_variant
  endif
-%}

<!-- Hidden element to signal to product-buy-buttons that customizer is active -->
<div id="shape-selector" style="display: none;"></div>

<div class="px-6 py-6 border-y border-slate-100 max-w-screen-xl mx-auto my-4 rounded-2xl">
  <div class="flex flex-col gap-4">
    <!-- Length Selection Header -->
    <div class="flex items-center gap-3">
      <span class="w-6 h-6 flex items-center justify-center bg-slate-900 text-white text-xs font-bold rounded-full">1</span>
      <span class="font-bold text-sm uppercase tracking-wider text-slate-800">Vælg længde</span>
    </div>

    <!-- Pill-shaped Stepper matching screenshot -->
    <div class="w-full">
      <div class="flex w-full h-12 justify-between items-center bg-white border border-slate-200 rounded-full px-4 shadow-sm select-none">
        <!-- Minus button -->
        <button type="button" id="btn-length-minus" class="w-12 h-full flex items-center justify-center text-slate-500 hover:text-slate-955 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none">
          &mdash;
        </button>
        <!-- Value display -->
        <span id="display-length" class="text-center font-bold text-slate-900 text-base">200 cm</span>
        <!-- Plus button -->
        <button type="button" id="btn-length-plus" class="w-12 h-full flex items-center justify-center text-slate-500 hover:text-slate-955 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none">
          &#43;
        </button>
      </div>
    </div>

    <!-- Quantity Selector (Customizer Quantity) -->
    <div class="flex flex-col gap-2 mt-2 w-full">
      <div class="flex items-center gap-3">
        <span class="w-6 h-6 flex items-center justify-center bg-slate-900 text-white text-xs font-bold rounded-full">2</span>
        <span class="font-bold text-sm uppercase tracking-wider text-slate-800">Antal</span>
      </div>
      <div class="flex w-full h-12 justify-between items-center bg-white border border-slate-200 rounded-full px-4 shadow-sm select-none">
        <!-- Minus button -->
        <button type="button" id="btn-qty-minus" class="w-12 h-full flex items-center justify-center text-slate-500 hover:text-slate-955 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none">
          &mdash;
        </button>
        <!-- Value display -->
        <span id="display-qty" class="text-center font-bold text-slate-900 text-base">1</span>
        <!-- Plus button -->
        <button type="button" id="btn-qty-plus" class="w-12 h-full flex items-center justify-center text-slate-500 hover:text-slate-955 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none">
          &#43;
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Toast notification popup -->
<div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-[calc(1280px-2rem)] z-50 bg-[#0e1a28] border border-slate-800 text-white text-sm px-4 py-3 rounded-full shadow-xl flex items-center justify-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
  <span class="material-symbols-outlined text-emerald-400">check_circle</span>
  <span id="toast-text" class="truncate">Lagt i kurven</span>
</div>

<!-- Variant Data JSON -->
<script id="variant-data" type="application/json">
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "title": {{ variant.title | json }},
        "price": {{ variant.price | divided_by: 100.0 }},
        "available": {{ variant.available }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // 1. Config variables from Liquid settings
    const minLength = {{ min_length | json }};
    const stepSize = {{ step_size | json }};
    const metervareVariantId = {% if metervare_variant %}"gid://shopify/ProductVariant/{{ metervare_variant.id }}"{% else %}null{% endif %};
    
    // Parse variants
    let variants = [];
    try {
      variants = JSON.parse(document.getElementById('variant-data').textContent);
    } catch (e) {
      console.error("Failed to parse variants", e);
    }

    const productTitle = {{ product.title | json }};
    // Helper: Parse width from variant title or product title (e.g. "140 cm bred" -> 140)
    function getVariantWidth(variantTitle) {
      let match = variantTitle.match(/(\d+)/);
      if (!match && productTitle) {
        match = productTitle.match(/(\d+)/);
      }
      return match ? parseInt(match[1]) : 140;
    }

    // State
    let state = {
      length: 200,
      quantity: 1
    };

    // DOM cache
    const displayLength = document.getElementById("display-length");
    const btnLengthMinus = document.getElementById("btn-length-minus");
    const btnLengthPlus = document.getElementById("btn-length-plus");

    const displayQty = document.getElementById("display-qty");
    const btnQtyMinus = document.getElementById("btn-qty-minus");
    const btnQtyPlus = document.getElementById("btn-qty-plus");

    const addToCartBtn = document.getElementById("btn-add-to-cart");
    const summaryMal = document.getElementById("summary-mål");

    // Recalculate price display
    function updateUI() {
      // Find currently selected variant ID on the page (variant picker sets this)
      let activeVariantId = null;
      const variantInput = document.querySelector('select[name="id"], input[name="id"]');
      if (variantInput) {
        activeVariantId = parseInt(variantInput.value);
      }
      
      // Find the pricing variant (the one that is not the 'Tilpasset' variant)
      const pricingVariant = variants.find(v => !v.title.toLowerCase().includes("tilpasset") && v.price > 0) || variants[0];
      if (pricingVariant) {
        // Calculate price: (price per cm) * length * quantity
        const totalClothPrice = pricingVariant.price * state.length * state.quantity;
        
        const formattedPrice = totalClothPrice.toLocaleString("da-DK", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " kr.";
        
        // Update price display on buy button
        const priceDisplay = document.getElementById("btn-price-display");
        if (priceDisplay) {
          priceDisplay.textContent = formattedPrice;
        } else if (addToCartBtn) {
          const prefix = addToCartBtn.getAttribute("data-text-before-price") || "Læg i kurv – ";
          addToCartBtn.textContent = prefix + formattedPrice;
        }

        // Update the summary section if it exists
        const summaryPris = document.getElementById("summary-pris");
        if (summaryPris) {
          summaryPris.textContent = "Pris: " + formattedPrice;
        }

        // Update summary dimensions text (e.g. Klar gennemsigtig voksdug 140 x 200 cm)
        if (summaryMal) {
          const width = getVariantWidth(pricingVariant.title);
          summaryMal.textContent = `${pricingVariant.title} ${width} x ${state.length} cm`;
        }
      }
    }

    // Steppers listeners
    if (btnLengthMinus && displayLength) {
      btnLengthMinus.addEventListener("click", () => {
        if (state.length > minLength) {
          state.length -= stepSize;
          displayLength.textContent = state.length + " cm";
          updateUI();
        }
      });
    }

    if (btnLengthPlus && displayLength) {
      btnLengthPlus.addEventListener("click", () => {
        state.length += stepSize;
        displayLength.textContent = state.length + " cm";
        updateUI();
      });
    }

    if (btnQtyMinus && displayQty) {
      btnQtyMinus.addEventListener("click", () => {
        if (state.quantity > 1) {
          state.quantity -= 1;
          displayQty.textContent = state.quantity;
          updateUI();
        }
      });
    }

    if (btnQtyPlus && displayQty) {
      btnQtyPlus.addEventListener("click", () => {
        state.quantity += 1;
        displayQty.textContent = state.quantity;
        updateUI();
      });
    }

    // Add to cart click handler
    if (addToCartBtn) {
      addToCartBtn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        addToCartBtn.disabled = true;
        addToCartBtn.classList.add("opacity-50");

        // Find variant to add to cart (always add the 'Tilpasset' variant)
        const customizedVariant = variants.find(v => v.title.toLowerCase().includes("tilpasset")) || variants[0];
        // Find variant to use for pricing/width reference (not containing 'Tilpasset')
        const pricingVariant = variants.find(v => !v.title.toLowerCase().includes("tilpasset") && v.price > 0) || variants[0];

        if (!customizedVariant) {
          showToast("Fejl: Kunne ikke finde varianten.");
          addToCartBtn.disabled = false;
          addToCartBtn.classList.remove("opacity-50");
          return;
        }

        const width = getVariantWidth(pricingVariant ? pricingVariant.title : customizedVariant.title);
        const refPrice = pricingVariant ? pricingVariant.price : customizedVariant.price;
        const unitPriceCents = Math.round(refPrice * state.length * 100);

        const metervareIdNumeric = metervareVariantId ? parseInt(metervareVariantId.split("/").pop(), 10) : null;
        let titlePrefix = productTitle;
        if (pricingVariant && pricingVariant.title && pricingVariant.title.toLowerCase() !== "default title") {
          titlePrefix = `${productTitle}, ${pricingVariant.title}`;
        }
        const customizedTitle = `${titlePrefix} - ${width} x ${state.length} cm`;

        const itemToAdd = {
          id: metervareIdNumeric || customizedVariant.id,
          quantity: state.quantity,
          properties: {
            "_length": state.length.toString(),
            "_width": width.toString(),
            "_shape": "firkantet",
            "_unit_price": unitPriceCents.toString(),
            "_metervare_variant_id": "gid://shopify/ProductVariant/" + pricingVariant.id,
            "_price_per_cm": refPrice.toString(),
            "_title": customizedTitle
          }
        };

        // Optimistic cart count increment
        const counters = document.querySelectorAll('#cart-counter');
        counters.forEach(counter => {
          const currentCount = parseInt(counter.innerText) || 0;
          counter.innerText = currentCount + state.quantity;
          counter.classList.remove("scale-0");
          counter.classList.add("scale-100");
        });

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [itemToAdd] })
        })
        .then(response => {
          if (!response.ok) throw new Error("Add to cart failed");
          return response.json();
        })
        .then(data => {
          showToast("Lagt i kurven!");
          // Wait for Shopify session to update and fetch cart
          setTimeout(() => {
            fetch('/cart.js')
              .then(res => res.json())
              .then(cartData => {
                // Update cart count
                counters.forEach(counter => {
                  counter.innerText = cartData.item_count;
                });
                // Dispatch cart update event
                document.dispatchEvent(new CustomEvent("cart-updated-total", { 
                  detail: { cartTotal: cartData.total_price / 100.0 } 
                }));
                
                if (typeof window.toggleCartDrawer === "function") {
                  window.toggleCartDrawer(true);
                }
              });
          }, 350);
        })
        .catch(err => {
          console.error(err);
          showToast("Fejl ved tilføjelse til kurv.");
        })
        .finally(() => {
          addToCartBtn.disabled = false;
          addToCartBtn.classList.remove("opacity-50");
        });
      });
    }

    // Helper: Toast alert
    function showToast(message) {
      const toast = document.getElementById("toast");
      const toastText = document.getElementById("toast-text");
      if (!toast || !toastText) return;

      toastText.textContent = message;
      toast.classList.remove("translate-y-20", "opacity-0");
      toast.classList.add("translate-y-0", "opacity-100");

      clearTimeout(window.customizerToastTimeout);
      window.customizerToastTimeout = setTimeout(() => {
        toast.classList.remove("translate-y-0", "opacity-100");
        toast.classList.add("translate-y-20", "opacity-0");
      }, 2500);
    }

    // Listen for variant selections changes on page to recalculate
    document.addEventListener("change", (e) => {
      if (e.target && (e.target.name === "id" || e.target.classList.contains("single-option-selector"))) {
        setTimeout(updateUI, 50);
      }
    });

    // Initial load
    updateUI();
  });
</script>

{% schema %}
{
  "name": "Product Customizer",
  "settings": [
    {
      "type": "product",
      "id": "metervare_product",
      "label": "Metervare Produkt (sku=BTM001)",
      "info": "Vælg det produkt, der repræsenterer rå metervare (SKU BTM001)"
    },
    {
      "type": "number",
      "id": "step_size",
      "label": "Længde trin (cm)",
      "default": 10
    },
    {
      "type": "number",
      "id": "min_length",
      "label": "Minimum længde (cm)",
      "default": 50
    }
  ],
  "presets": [
    {
      "name": "Product Customizer"
    }
  ]
}
{% endschema %}