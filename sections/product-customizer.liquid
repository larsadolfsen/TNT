{% comment %}
  Product Customizer Steps Section
  Renders the interactive customization journey (Steps 1–4) for custom-cut tablecloths.
  Contains variant metadata, modals, toasts, and the javascript state/recalculation engine.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- liquid
  assign max_width = product.metafields.custom.bredde.value | default: product.metafields.custom.bredde | plus: 0
  if max_width == 0
    assign max_width = ""
  endif
  if max_width == blank
    for tag in product.tags
      assign tag_down = tag | downcase
      if tag_down contains 'bredde:'
        assign max_width = tag | remove_first: 'bredde:' | remove_first: 'Bredde:' | strip | plus: 0
      endif
    endfor
  endif
  if max_width == blank or max_width == 0
    for option in product.options_with_values
      assign option_name = option.name | downcase
      if option_name contains 'bredde' or option_name contains 'width' or option_name contains 'størrelse'
        assign max_width = option.values | first | plus: 0
      endif
    endfor
  endif
  if max_width == blank or max_width == 0
    assign max_width = 140
  endif

  assign surcharge_rectangular_id = 'null'
  assign surcharge_rectangular_price = 0.00
  if section.settings.surcharge_product_rectangular != blank
    assign surcharge_rectangular_id = section.settings.surcharge_product_rectangular.first_available_variant.id | default: 'null'
    assign surcharge_rectangular_price = section.settings.surcharge_product_rectangular.price | divided_by: 100.0 | default: 0.00
  endif

  assign surcharge_round_id = 'null'
  assign surcharge_round_price = 0.00
  if section.settings.surcharge_product_round != blank
    assign surcharge_round_id = section.settings.surcharge_product_round.first_available_variant.id | default: 'null'
    assign surcharge_round_price = section.settings.surcharge_product_round.price | divided_by: 100.0 | default: 0.00
  endif

  assign surcharge_oval_id = 'null'
  assign surcharge_oval_price = 0.00
  if section.settings.surcharge_product_oval != blank
    assign surcharge_oval_id = section.settings.surcharge_product_oval.first_available_variant.id | default: 'null'
    assign surcharge_oval_price = section.settings.surcharge_product_oval.price | divided_by: 100.0 | default: 0.00
  endif

  assign surcharge_width_id = 'null'
  assign surcharge_width_price = 0.00
  if section.settings.surcharge_product_width != blank
    assign surcharge_width_id = section.settings.surcharge_product_width.first_available_variant.id | default: 'null'
    assign surcharge_width_price = section.settings.surcharge_product_width.price | divided_by: 100.0 | default: 0.00
  endif
-%}

<section class="px-6 py-8 bg-surface-container border-y border-outline-variant max-w-screen-xl mx-auto my-4">
  <h2 class="text-lg font-bold text-primary mb-6">Vælg dine mål</h2>
  <div class="space-y-8">
    <!-- Step 1: Shape -->
    <div class="space-y-3">
      <div class="flex items-center justify-between w-full">
        <div class="flex items-center gap-3">
          <span class="w-6 h-6 flex items-center justify-center bg-primary text-white text-xs font-bold rounded-full">1</span>
          <span class="font-bold text-sm uppercase tracking-wider text-primary">Vælg form</span>
        </div>
        <button class="info-btn text-on-surface-variant hover:text-primary focus:outline-none flex items-center" aria-label="Hjælp">
          <span class="material-symbols-outlined text-xl">info</span>
        </button>
      </div>
      <div class="grid grid-cols-3 gap-2" id="shape-selector">
        <button data-shape="firkantet" class="shape-btn flex flex-col items-center justify-center py-4 rounded-xl border-2 border-primary bg-white text-primary transition-all">
          <span class="material-symbols-outlined mb-1">rectangle</span>
          <span class="text-xs font-bold">Firkantet</span>
        </button>
        <button data-shape="rund" class="shape-btn flex flex-col items-center justify-center py-4 rounded-xl border border-outline-variant bg-white text-on-surface-variant transition-all">
          <span class="material-symbols-outlined mb-1">circle</span>
          <span class="text-xs">Rund</span>
        </button>
        <button data-shape="oval" class="shape-btn flex flex-col items-center justify-center py-4 rounded-xl border border-outline-variant bg-white text-on-surface-variant transition-all">
          <span class="material-symbols-outlined mb-1">shape_line</span>
          <span class="text-xs">Oval</span>
        </button>
      </div>
    </div>

    <!-- Step 2: Width Stepper -->
    <div class="space-y-3">
      <div class="flex items-center justify-between w-full">
        <div class="flex items-center gap-3">
          <span class="w-6 h-6 flex items-center justify-center bg-primary text-white text-xs font-bold rounded-full">2</span>
          <span id="width-step-title" class="font-bold text-sm uppercase tracking-wider text-primary">Vælg bredde</span>
        </div>
        <button class="info-btn text-on-surface-variant hover:text-primary focus:outline-none flex items-center" aria-label="Hjælp">
          <span class="material-symbols-outlined text-xl">info</span>
        </button>
      </div>
      <div class="flex items-center bg-white rounded-xl border border-outline-variant overflow-hidden">
        <button id="btn-width-minus" class="w-12 h-12 flex items-center justify-center text-primary active:bg-slate-100 transition-colors">
          <span class="material-symbols-outlined">remove</span>
        </button>
        <input id="input-width" class="w-full h-12 text-center border-none focus:ring-0 text-lg font-bold text-primary bg-transparent focus:outline-none" type="text" value="140 cm" readonly/>
        <button id="btn-width-plus" class="w-12 h-12 flex items-center justify-center text-primary active:bg-slate-100 transition-colors">
          <span class="material-symbols-outlined">add</span>
        </button>
      </div>
    </div>

    <!-- Step 3: Length Stepper -->
    <div class="space-y-3 transition-opacity duration-300" id="length-container">
      <div class="flex items-center justify-between w-full">
        <div class="flex items-center gap-3">
          <span class="w-6 h-6 flex items-center justify-center bg-primary text-white text-xs font-bold rounded-full">3</span>
          <span id="length-step-title" class="font-bold text-sm uppercase tracking-wider text-primary">Vælg længde</span>
        </div>
        <button class="info-btn text-on-surface-variant hover:text-primary focus:outline-none flex items-center" aria-label="Hjælp">
          <span class="material-symbols-outlined text-xl">info</span>
        </button>
      </div>
      <div class="flex items-center bg-white rounded-xl border border-outline-variant overflow-hidden">
        <button id="btn-length-minus" class="w-12 h-12 flex items-center justify-center text-primary active:bg-slate-100 transition-colors">
          <span class="material-symbols-outlined">remove</span>
        </button>
        <input id="input-length" class="w-full h-12 text-center border-none focus:ring-0 text-lg font-bold text-primary bg-transparent focus:outline-none" type="text" value="200 cm" readonly/>
        <button id="btn-length-plus" class="w-12 h-12 flex items-center justify-center text-primary active:bg-slate-100 transition-colors">
          <span class="material-symbols-outlined">add</span>
        </button>
      </div>
      <p id="round-info-text" class="text-xs text-on-surface-variant hidden">Runde duge leveres med en fast diameter svarende til rullebredden.</p>
    </div>

    <!-- Step 4: Quantity Stepper -->
    <div class="space-y-3" id="quantity-container">
      <div class="flex items-center justify-between w-full">
        <div class="flex items-center gap-3">
          <span class="w-6 h-6 flex items-center justify-center bg-primary text-white text-xs font-bold rounded-full">4</span>
          <span id="quantity-step-title" class="font-bold text-sm uppercase tracking-wider text-primary">Vælg antal</span>
        </div>
        <button class="info-btn text-on-surface-variant hover:text-primary focus:outline-none flex items-center" aria-label="Hjælp">
          <span class="material-symbols-outlined text-xl">info</span>
        </button>
      </div>
      <div class="flex items-center bg-white rounded-xl border border-outline-variant overflow-hidden">
        <button id="btn-quantity-minus" class="w-12 h-12 flex items-center justify-center text-primary active:bg-slate-100 transition-colors">
          <span class="material-symbols-outlined">remove</span>
        </button>
        <input id="input-quantity" class="w-full h-12 text-center border-none focus:ring-0 text-lg font-bold text-primary bg-transparent focus:outline-none" type="text" value="1"/>
        <button id="btn-quantity-plus" class="w-12 h-12 flex items-center justify-center text-primary active:bg-slate-100 transition-colors">
          <span class="material-symbols-outlined">add</span>
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Help Modal Overlay -->
<div id="help-modal" class="fixed inset-0 z-[100] hidden items-center justify-center bg-black/50 p-4 transition-opacity duration-300">
  <div class="bg-white w-full max-w-md rounded-2xl p-6 shadow-xl relative transform scale-95 transition-transform duration-300">
    <!-- Close Button -->
    <button id="close-modal" class="absolute top-4 right-4 text-slate-400 hover:text-slate-600 flex items-center justify-center w-8 h-8 rounded-full bg-slate-100 focus:outline-none cursor-pointer">
      <span class="material-symbols-outlined">close</span>
    </button>
    <!-- Content -->
    <div class="space-y-4">
      <h3 class="text-lg font-bold text-primary">Guide til bestilling af metermål</h3>
      <ul class="space-y-2.5 text-sm text-on-surface-variant list-disc pl-5">
        <li>Vælg den dug, du ønsker at bestille.</li>
        <li>Vælg den længde du ønsker (min. {{ section.settings.min_length | default: 50 }} cm pr. dug)</li>
        <li>Vi anbefaler 15-25 cm. til nedhæng i hver side.</li>
        <li>Vælg antal, hvis du ønsker mere end en dug i samme længde og design</li>
        <li>Når du har udfyldt alle felter, tryk læg i kurv</li>
      </ul>
      <div class="bg-slate-50 p-4 rounded-xl border border-outline-variant mt-4">
        <h4 class="font-bold text-xs uppercase text-slate-500 tracking-wider mb-1">Eksempel på bestilling:</h4>
        <p class="text-xs text-on-surface-variant leading-relaxed">
          Har du et bord som er 2 meter langt, indtaster du i feltet 240 (i alt 40 cm. til nedløb)
        </p>
      </div>
    </div>
  </div>
</div>

