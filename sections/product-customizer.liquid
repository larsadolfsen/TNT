<!-- Shopify Variant Data JSON -->
<script id="variant-data" type="application/json">
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "title": {{ variant.title | json }},
        "price": {{ variant.price | divided_by: 100.0 }},
        "available": {{ variant.available }},
        "options": {{ variant.options | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    // Parse variants and attach width
    let variants = [];
    try {
      variants = JSON.parse(document.getElementById('variant-data').textContent);
      variants.forEach(v => {
        const match = v.title.match(/(\d+)/);
        v.width = match ? parseInt(match[1]) : 140;
      });
    } catch (e) {
      console.error("Failed to parse variant data", e);
    }

    const isMetervare = {% if product.metafields.custom.metervare.value == true or product.metafields.custom.metervare == true %}true{% else %}false{% endif %};
    const minWidthLimit = {{ section.settings.min_width | default: 80 }};
    const maxWidthLimit = {{ max_width | json }};

    // Find default width: prefer 140 if it is within limits, otherwise clamp
    let defaultWidth = 140;
    if (defaultWidth > maxWidthLimit) {
      defaultWidth = maxWidthLimit;
    }
    if (defaultWidth < minWidthLimit) {
      defaultWidth = minWidthLimit;
    }

    const surchargeRectangularId = {{ surcharge_rectangular_id | default: 'null' }};
    const surchargeRectangularValue = {{ surcharge_rectangular_price | default: 0.00 }};

    const surchargeRoundId = {{ surcharge_round_id | default: 'null' }};
    const surchargeRoundValue = {{ surcharge_round_price | default: 0.00 }};

    const surchargeOvalId = {{ surcharge_oval_id | default: 'null' }};
    const surchargeOvalValue = {{ surcharge_oval_price | default: 0.00 }};

    const surchargeWidthId = {{ surcharge_width_id | default: 'null' }};
    const surchargeWidthValue = {{ surcharge_width_price | default: 0.00 }};

    let freeShippingThreshold = window.freeShippingThreshold || 590.00;
    const stepSizeValue = {{ section.settings.step_size | default: 10 }};
    const minLengthValue = {{ section.settings.min_length | default: 50 }};
    const widthStepSizeValue = {{ section.settings.width_step | default: 10 }};

    // State Management
    let appState = {
      shape: "firkantet", 
      width: defaultWidth,
      length: Math.max(200, minLengthValue), 
      quantity: 1,
      cartCount: {{ cart.item_count }},
      cartTotal: {{ cart.total_price | divided_by: 100.0 }},
      basePricePerMeter: {{ current_variant.price | divided_by: 100.0 }},
      currentClothPrice: 0.00
    };

    // Cache elements safely
    const shapeButtons = document.querySelectorAll(".shape-btn");
    const widthInput = document.getElementById("input-width");
    const widthMinusBtn = document.getElementById("btn-width-minus");
    const widthPlusBtn = document.getElementById("btn-width-plus");
    const widthStepTitle = document.getElementById("width-step-title");
    const lengthInput = document.getElementById("input-length");
    const lengthMinusBtn = document.getElementById("btn-length-minus");
    const lengthPlusBtn = document.getElementById("btn-length-plus");
    const lengthContainer = document.getElementById("length-container");
    const lengthStepTitle = document.getElementById("length-step-title");
    const roundInfoText = document.getElementById("round-info-text");
    const summaryMalText = document.getElementById("summary-mål");
    const summaryPrisText = document.getElementById("summary-pris");
    const addToCartBtn = document.getElementById("btn-add-to-cart");
    const cartCounter = document.getElementById("cart-counter");
    const crossSellButtons = document.querySelectorAll(".btn-cross-sell");
    const toast = document.getElementById("toast");
    const toastText = document.getElementById("toast-text");
    
    // Quantity Elements
    const quantityInput = document.getElementById("input-quantity");
    const quantityMinusBtn = document.getElementById("btn-quantity-minus");
    const quantityPlusBtn = document.getElementById("btn-quantity-plus");

    // Help Modal Elements
    const helpModal = document.getElementById("help-modal");
    const closeModal = document.getElementById("close-modal");
    const infoBtns = document.querySelectorAll(".info-btn");

    // Cart Modal Elements
    const cartNotificationModal = document.getElementById("cart-modal");
    const closeCartModalBtn = document.getElementById("close-cart-modal");
    const modalProductImg = document.getElementById("modal-product-img");
    const modalProductSpecs = document.getElementById("modal-product-specs");
    const modalProductPrice = document.getElementById("modal-product-price");
    const modalProductTitle = document.querySelector("#cart-modal h4");
    const btnModalContinue = document.getElementById("btn-modal-continue");

    // Gallery Elements
    const dotButtons = document.querySelectorAll(".dot-btn");
    const mainProductImg = document.getElementById("main-product-img");

    // Format Price Utility
    function formatPrice(value) {
      return value.toLocaleString("da-DK", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " kr.";
    }

    // Find Active Variant based on selected width (smallest variant whose width is >= selected width)
    function getActiveVariant() {
      if (variants.length === 0) return { id: null, price: appState.basePricePerMeter };
      let potentialVariants = variants.filter(v => v.width >= appState.width);
      if (potentialVariants.length > 0) {
        potentialVariants.sort((a, b) => a.width - b.width);
        return potentialVariants[0];
      }
      // Fallback: sort descending by width to get the largest available variant
      let sortedAll = [...variants].sort((a, b) => b.width - a.width);
      return sortedAll[0] || variants[0];
    }

    // Calculation Engine
    function recalculate() {
      const activeVariant = getActiveVariant();
      appState.basePricePerMeter = activeVariant.price;

      // Dispatch custom event to notify other scripts about active variant update
      if (activeVariant && activeVariant.id) {
        document.dispatchEvent(new CustomEvent("variant-changed", {
          detail: { variantId: activeVariant.id }
        }));
      }

      let singlePrice = 0;
      let shapeSurcharge = 0;
      
      // Shape surcharge (Firkantet, Rund, Oval)
      if (appState.shape === "rund") {
        shapeSurcharge = surchargeRoundValue;
      } else if (appState.shape === "oval") {
        shapeSurcharge = surchargeOvalValue;
      } else if (appState.shape === "firkantet") {
        shapeSurcharge = surchargeRectangularValue;
      }

      let widthSurcharge = 0;
      if (appState.width !== 140) {
        widthSurcharge = surchargeWidthValue;
      }

      const surcharge = shapeSurcharge + widthSurcharge;
      
      if (appState.shape === "rund") {
        appState.length = appState.width;
        singlePrice = (appState.width * appState.basePricePerMeter) + surcharge;
        
        if (lengthContainer) lengthContainer.classList.add("hidden"); 
        if (widthStepTitle) widthStepTitle.textContent = "Vælg diameter";
      } else {
        if (appState.length < minLengthValue) appState.length = minLengthValue;
        
        singlePrice = (appState.length * appState.basePricePerMeter) + surcharge;
        
        if (lengthContainer) lengthContainer.classList.remove("hidden"); 
        if (lengthInput) {
          lengthInput.disabled = false;
          lengthInput.value = appState.length + " cm";
        }
        if (lengthMinusBtn) lengthMinusBtn.disabled = false;
        if (lengthPlusBtn) lengthPlusBtn.disabled = false;
        if (roundInfoText) roundInfoText.classList.add("hidden");
        if (lengthStepTitle) lengthStepTitle.textContent = "Vælg længde";
        if (widthStepTitle) widthStepTitle.textContent = "Vælg bredde";
      }

      const totalPrice = singlePrice * appState.quantity;
      appState.currentClothPrice = totalPrice;

      const formatted = formatPrice(totalPrice);
      if (summaryPrisText) {
        summaryPrisText.textContent = "Pris: " + formatted;
      }
      const priceDisplay = document.getElementById("btn-price-display");
      if (priceDisplay) {
        priceDisplay.textContent = formatted;
      } else if (addToCartBtn) {
        const prefix = addToCartBtn.getAttribute("data-text-before-price") || "Læg i kurv – ";
        addToCartBtn.textContent = prefix + formatted;
      }
      
      // Update dynamic display on top
      const basePriceDisplay = document.getElementById("base-price-display");
      if (basePriceDisplay) {
        const displayPrice = isMetervare ? activeVariant.price * 100 : activeVariant.price;
        basePriceDisplay.textContent = formatPrice(displayPrice);
      }

      // Update summary text (the multi-line breakdown)
      if (summaryMalText) {
        let variantText = "";
        if (activeVariant.title && activeVariant.title.trim().toLowerCase() !== "default title") {
          variantText = ", " + activeVariant.title;
        } else {
          variantText = `, (${appState.width}x${appState.length} cm)`;
        }
        const productName = "{{ product.title }}" + variantText;
        
        let shapeName = "Rektangulær dug";
        if (appState.shape === "rund") {
          shapeName = "Rund dug";
        } else if (appState.shape === "oval") {
          shapeName = "Oval dug";
        }

        const baseLinePrice = singlePrice - shapeSurcharge - widthSurcharge;

        const shapeLine = shapeSurcharge > 0 ? `
            <div class="flex justify-between gap-2">
              <span>${shapeName}</span>
              <span class="text-primary font-medium flex-shrink-0">${formatPrice(shapeSurcharge)}</span>
            </div>
        ` : '';

        const widthLine = widthSurcharge > 0 ? `
            <div class="flex justify-between gap-2">
              <span>Tilpasset i bredden</span>
              <span class="text-primary font-medium flex-shrink-0">${formatPrice(widthSurcharge)}</span>
            </div>
        ` : '';

        summaryMalText.innerHTML = `
          <div class="space-y-1 text-xs text-on-surface-variant font-normal leading-normal w-full max-w-sm mt-2 mb-2">
            <div class="flex justify-between gap-4">
              <span>${productName}</span>
              <span class="text-primary font-medium flex-shrink-0">${formatPrice(baseLinePrice)}</span>
            </div>
            ${shapeLine}
            ${widthLine}
            <div class="flex justify-between border-t border-outline-variant/60 pt-1 mt-1">
              <span>Pris pr. stk.</span>
              <span class="flex-shrink-0">${formatPrice(singlePrice)}</span>
            </div>
          </div>
        `;
      }

      // Set global variable to resolve initial page load race condition
      window.currentPageProductPrice = totalPrice;

      // Dispatch custom event to notify other scripts about product price update
      document.dispatchEvent(new CustomEvent("product-price-updated", {
        detail: { price: totalPrice }
      }));
    }

    // Live Free Shipping Status Bar Calculator
    function updateFreeShippingWidget() {
      const shippingProgressBar = document.getElementById("shipping-progress-bar");
      const shippingStatusText = document.getElementById("shipping-status-text");
      const shippingPercentText = document.getElementById("shipping-percent-text");
      const potentialBar = document.getElementById("shipping-potential-bar");
      
      if (!shippingProgressBar || !shippingStatusText || !shippingPercentText) return;
      
      const total = appState.cartTotal;
      const progressPercent = Math.min((total / freeShippingThreshold) * 100, 100);
      
      shippingProgressBar.style.width = progressPercent + "%";
      shippingPercentText.textContent = Math.round(progressPercent) + "%";
      
      if (potentialBar) {
        const potentialTotal = total + appState.currentClothPrice;
        const potentialPercent = Math.min((potentialTotal / freeShippingThreshold) * 100, 100);
        potentialBar.style.width = Math.max(0, potentialPercent - progressPercent) + "%";
      }
      
      if (total < freeShippingThreshold) {
        const missing = freeShippingThreshold - total;
        shippingStatusText.textContent = "Køb for " + formatPrice(missing) + " mere for at få fri fragt";
        shippingProgressBar.className = "h-full bg-emerald-600 transition-all duration-300";
      } else {
        shippingStatusText.textContent = "Du har opnået fri fragt!";
        shippingProgressBar.className = "h-full bg-emerald-500 transition-all duration-300";
      }
    }

    function updateModalFreeShippingWidget() {
      const modalProgressBar = document.getElementById("modal-shipping-progress-bar");
      const modalStatusText = document.getElementById("modal-shipping-status-text");
      const modalPercentText = document.getElementById("modal-shipping-percent-text");
      
      if (!modalProgressBar || !modalStatusText || !modalPercentText) return;
      
      const total = appState.cartTotal;
      const progressPercent = Math.min((total / freeShippingThreshold) * 100, 100);
      
      modalProgressBar.style.width = progressPercent + "%";
      modalPercentText.textContent = Math.round(progressPercent) + "%";
      
      if (total < freeShippingThreshold) {
        const missing = freeShippingThreshold - total;
        modalStatusText.textContent = "Køb for " + formatPrice(missing) + " mere for at få fri fragt";
        modalProgressBar.className = "h-full bg-emerald-600 transition-all duration-300";
      } else {
        modalStatusText.textContent = "Du har opnået fri fragt!";
        modalProgressBar.className = "h-full bg-emerald-500 transition-all duration-300";
      }
    }

    // Countdown Timer to 12.00 noon
    function startCountdown() {
      const countdownTimer = document.getElementById("countdown-timer");
      if (!countdownTimer) return;
      
      function updateTimer() {
        const now = new Date();
        const target = new Date();
        target.setHours(12, 0, 0, 0);
        
        if (now >= target) {
          target.setDate(target.getDate() + 1);
        }
        
        const diff = target - now;
        const hours = Math.floor(diff / (1000 * 60 * 60));
        const minutes = Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60));
        const seconds = Math.floor((diff % (1000 * 60)) / 1000);
        
        countdownTimer.textContent = 
          String(hours).padStart(2, '0') + ":" + 
          String(minutes).padStart(2, '0') + ":" + 
          String(seconds).padStart(2, '0');
      }
      
      updateTimer();
      setInterval(updateTimer, 1000);
    }

    // Show toast notification
    let toastTimeout;
    function showToast(message) {
      if (!toast || !toastText) return;
      toastText.textContent = message;
      toast.classList.remove("translate-y-20", "opacity-0");
      toast.classList.add("translate-y-0", "opacity-100");

      clearTimeout(toastTimeout);
      toastTimeout = setTimeout(() => {
        toast.classList.remove("translate-y-0", "opacity-100");
        toast.classList.add("translate-y-20", "opacity-0");
      }, 2500);
    }

    // Show cart modal confirmation
    function openCartModal(imgSrc, title, specs, priceText) {
      if (!cartNotificationModal) return;
      if (modalProductImg) modalProductImg.src = imgSrc;
      if (modalProductTitle) modalProductTitle.textContent = title;
      if (modalProductSpecs) modalProductSpecs.textContent = specs;
      if (modalProductPrice) modalProductPrice.textContent = priceText;
      
      updateModalFreeShippingWidget();

      cartNotificationModal.classList.remove("hidden");
      cartNotificationModal.classList.add("flex");
      
      setTimeout(() => {
        cartNotificationModal.classList.remove("-translate-y-full");
        cartNotificationModal.classList.add("translate-y-0");
      }, 10);

      clearTimeout(window.cartModalTimeout);
      window.cartModalTimeout = setTimeout(closeCartModal, 6000);
    }

    function closeCartModal() {
      if (!cartNotificationModal) return;
      cartNotificationModal.classList.add("-translate-y-full");
      cartNotificationModal.classList.remove("translate-y-0");
      
      setTimeout(() => {
        cartNotificationModal.classList.add("hidden");
        cartNotificationModal.classList.remove("flex");
      }, 300);
    }

    // Help Modal Controller
    if (infoBtns && helpModal) {
      infoBtns.forEach(btn => {
        btn.addEventListener("click", () => {
          helpModal.classList.remove("hidden");
          helpModal.classList.add("flex");
        });
      });
    }

    if (closeModal && helpModal) {
      closeModal.addEventListener("click", () => {
        helpModal.classList.add("hidden");
        helpModal.classList.remove("flex");
      });
    }

    if (helpModal) {
      helpModal.addEventListener("click", (e) => {
        if (e.target === helpModal) {
          helpModal.classList.add("hidden");
          helpModal.classList.remove("flex");
        }
      });
    }

    if (closeCartModalBtn) {
      closeCartModalBtn.addEventListener("click", closeCartModal);
    }
    if (btnModalContinue) {
      btnModalContinue.addEventListener("click", closeCartModal);
    }

    // Gallery Dots Interaction (handled in product-media.liquid)
    // The main gallery interactions are managed by product-media.liquid to work across templates.

    // Shape Selector Buttons
    if (shapeButtons) {
      shapeButtons.forEach(btn => {
        btn.addEventListener("click", function() {
          shapeButtons.forEach(b => {
            b.classList.remove("border-2", "border-primary", "text-primary");
            b.classList.add("border", "border-outline-variant", "text-on-surface-variant");
            const span = b.querySelector("span:last-child");
            if (span) span.classList.remove("font-bold");
          });
          
          this.classList.remove("border", "border-outline-variant", "text-on-surface-variant");
          this.classList.add("border-2", "border-primary", "text-primary");
          const activeSpan = this.querySelector("span:last-child");
          if (activeSpan) activeSpan.classList.add("font-bold");

          appState.shape = this.getAttribute("data-shape");
          recalculate();
        });
      });
    }

    // Width Stepper Interactions
    if (widthMinusBtn && widthInput) {
      widthMinusBtn.addEventListener("click", () => {
        if (appState.width > minWidthLimit) {
          appState.width = Math.max(minWidthLimit, appState.width - widthStepSizeValue);
          widthInput.value = appState.width + " cm";
          recalculate();
        }
      });
    }

    if (widthPlusBtn && widthInput) {
      widthPlusBtn.addEventListener("click", () => {
        if (appState.width < maxWidthLimit) {
          appState.width = Math.min(maxWidthLimit, appState.width + widthStepSizeValue);
          widthInput.value = appState.width + " cm";
          recalculate();
        }
      });
    }

    // Length Stepper Interactions
    if (lengthMinusBtn && lengthInput) {
      lengthMinusBtn.addEventListener("click", () => {
        if (appState.length > minLengthValue) {
          appState.length = Math.max(minLengthValue, appState.length - stepSizeValue);
          lengthInput.value = appState.length + " cm";
          recalculate();
        }
      });
    }

    if (lengthPlusBtn && lengthInput) {
      lengthPlusBtn.addEventListener("click", () => {
        appState.length += stepSizeValue;
        lengthInput.value = appState.length + " cm";
        recalculate();
      });
    }

    // Quantity Stepper Interactions
    if (quantityInput) {
      // Auto-select text on focus for easier editing
      quantityInput.addEventListener("focus", (e) => {
        e.target.select();
      });

      // Handle real-time typing
      quantityInput.addEventListener("input", (e) => {
        // Strip out non-digit characters
        let sanitized = e.target.value.replace(/\D/g, "");
        e.target.value = sanitized;

        const parsed = parseInt(sanitized);
        if (!isNaN(parsed) && parsed > 0) {
          appState.quantity = parsed;
          recalculate();
        }
      });

      // Handle leaving the field (blur)
      quantityInput.addEventListener("blur", (e) => {
        const parsed = parseInt(e.target.value);
        if (isNaN(parsed) || parsed < 1) {
          // Revert to last valid quantity
          e.target.value = appState.quantity;
        } else {
          appState.quantity = parsed;
          e.target.value = appState.quantity;
        }
        recalculate();
      });

      // Handle Enter key to confirm value
      quantityInput.addEventListener("keydown", (e) => {
        if (e.key === "Enter") {
          e.preventDefault();
          quantityInput.blur();
        }
      });
    }

    if (quantityMinusBtn && quantityInput) {
      quantityMinusBtn.addEventListener("click", () => {
        if (appState.quantity > 1) {
          appState.quantity -= 1;
          quantityInput.value = appState.quantity;
          recalculate();
        }
      });
    }

    if (quantityPlusBtn && quantityInput) {
      quantityPlusBtn.addEventListener("click", () => {
        appState.quantity += 1;
        quantityInput.value = appState.quantity;
        recalculate();
      });
    }

    // Add Tablecloth to Shopify Cart
    if (addToCartBtn) {
      addToCartBtn.addEventListener("click", () => {
        // Only run customizer AJAX add-to-cart if customizer is present
        if (!document.getElementById("shape-selector")) return;

        addToCartBtn.disabled = true;
        addToCartBtn.classList.add("opacity-50");

        const activeVariant = getActiveVariant();
        if (!activeVariant.id) {
          showToast("Fejl: Kunne ikke finde det valgte variant ID.");
          addToCartBtn.disabled = false;
          addToCartBtn.classList.remove("opacity-50");
          return;
        }

        let shapeSurcharge = 0;
        if (appState.shape === "rund") {
          shapeSurcharge = surchargeRoundValue;
        } else if (appState.shape === "oval") {
          shapeSurcharge = surchargeOvalValue;
        } else if (appState.shape === "firkantet") {
          shapeSurcharge = surchargeRectangularValue;
        }
        const shapeSurchargeCents = Math.round(shapeSurcharge * 100);

        let widthSurcharge = 0;
        if (appState.width !== 140) {
          widthSurcharge = surchargeWidthValue;
        }
        const widthSurchargeCents = Math.round(widthSurcharge * 100);

        const totalSinglePriceCents = Math.round((appState.currentClothPrice / appState.quantity) * 100);
        const adjustedBasePriceCents = totalSinglePriceCents - shapeSurchargeCents - widthSurchargeCents;

        let items = [];

        // Add parent product to cart
        items.push({
          id: activeVariant.id,
          quantity: appState.quantity,
          properties: {
            "Form": appState.shape.charAt(0).toUpperCase() + appState.shape.slice(1),
            "Mål": appState.shape === 'rund' ? `Ø ${appState.width} cm` : `${appState.width} × ${appState.length} cm`,
            "Antal dug(e)": appState.quantity,
            "_length": appState.length,
            "_width": appState.width,
            "_shape": appState.shape,
            "_unit_price": totalSinglePriceCents.toString(),
            "_base_price": adjustedBasePriceCents.toString(),
            "_shape_surcharge": shapeSurchargeCents.toString(),
            "_width_surcharge": widthSurchargeCents.toString()
          }
        });

        // Optimistic update of cart count, total and counters
        const quantityAdded = appState.quantity;
        const priceAdded = appState.currentClothPrice;

        const originalCartCount = appState.cartCount;
        const originalCartTotal = appState.cartTotal;

        appState.cartCount += quantityAdded;
        appState.cartTotal += priceAdded;

        const counters = document.querySelectorAll('#cart-counter');
        const originalCounts = [];
        counters.forEach(counter => {
          originalCounts.push({ counter, text: counter.innerText, hasScale0: counter.classList.contains("scale-0") });
          counter.innerText = appState.cartCount;
          if (appState.cartCount > 0) {
            counter.classList.remove("scale-0");
            counter.classList.add("scale-100");
          }
        });
        updateFreeShippingWidget();

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: items })
        })
        .then(response => {
          if (!response.ok) throw new Error("Adding to cart failed");
          return response.json();
        })
        .then(data => {
          showToast("Lagt i kurven!");
          return new Promise(resolve => {
            setTimeout(() => {
              fetch('/cart.js')
                .then(res => {
                  if (!res.ok) throw new Error("Cart fetch failed");
                  return res.json();
                })
                .then(resolve)
                .catch(err => {
                  console.error(err);
                  resolve(null);
                });
            }, 350);
          });
        })
        .then(cartData => {
          if (!cartData) return;
          appState.cartCount = cartData.item_count;
          appState.cartTotal = cartData.total_price / 100.0;
          
          if (cartCounter) cartCounter.textContent = appState.cartCount;
          document.dispatchEvent(new CustomEvent("cart-updated-total", { detail: { cartTotal: appState.cartTotal } }));
          updateFreeShippingWidget();

          // Open cart modal dialog
          const textMål = appState.shape === "rund" ? "Ø " + appState.width + " cm" : appState.width + " × " + appState.length + " cm";
          const formFormatted = appState.shape.charAt(0).toUpperCase() + appState.shape.slice(1);
          
          const modalImgSrc = mainProductImg ? mainProductImg.src : "";
          openCartModal(
            modalImgSrc, 
            "{{ product.title }}",
            `${formFormatted} · ${textMål} (${appState.quantity} stk)`,
            formatPrice(appState.currentClothPrice)
          );
        })
        .catch(err => {
          console.error(err);
          // Revert optimistic update
          appState.cartCount = originalCartCount;
          appState.cartTotal = originalCartTotal;
          originalCounts.forEach(item => {
            item.counter.innerText = item.text;
            if (item.hasScale0) {
              item.counter.classList.add("scale-0");
              item.counter.classList.remove("scale-100");
            } else {
              item.counter.classList.remove("scale-0");
              item.counter.classList.add("scale-100");
            }
          });
          updateFreeShippingWidget();
          showToast("Der opstod en fejl. Prøv igen.");
        })
        .finally(() => {
          addToCartBtn.disabled = false;
          addToCartBtn.classList.remove("opacity-50");
        });
      });
    }

    // Cross-sell Buttons Interaction (Direct AJAX Add to Cart)
    if (crossSellButtons) {
      crossSellButtons.forEach(btn => {
        btn.addEventListener("click", function() {
          const id = this.getAttribute("data-id");
          const navn = this.getAttribute("data-navn");
          const pris = parseFloat(this.getAttribute("data-pris"));
          
          if (id.includes("-mock")) {
            appState.cartCount += 1;
            appState.cartTotal += pris;
            if (cartCounter) cartCounter.textContent = appState.cartCount;
            document.dispatchEvent(new CustomEvent("cart-updated-total", { detail: { cartTotal: appState.cartTotal } }));
            updateFreeShippingWidget();
            showToast(navn + " er tilføjet!");
            
            this.textContent = "TILFØJET";
            this.classList.replace("bg-primary", "bg-emerald-600");
            setTimeout(() => {
              this.textContent = "TILFØJ";
              this.classList.replace("bg-emerald-600", "bg-primary");
            }, 2000);
            return;
          }

          this.disabled = true;
          this.classList.add("opacity-50");

          // Optimistic update of cart count, total and counters
          const originalCartCount = appState.cartCount;
          const originalCartTotal = appState.cartTotal;

          appState.cartCount += 1;
          appState.cartTotal += pris;

          const counters = document.querySelectorAll('#cart-counter');
          const originalCounts = [];
          counters.forEach(counter => {
            originalCounts.push({ counter, text: counter.innerText, hasScale0: counter.classList.contains("scale-0") });
            counter.innerText = appState.cartCount;
            if (appState.cartCount > 0) {
              counter.classList.remove("scale-0");
              counter.classList.add("scale-100");
            }
          });
          updateFreeShippingWidget();

          fetch('/cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              items: [{
                id: parseInt(id),
                quantity: 1
              }]
            })
          })
          .then(response => {
            if (!response.ok) throw new Error("Add failed");
            return response.json();
          })
          .then(data => {
            showToast(navn + " er tilføjet!");
            return new Promise(resolve => {
              setTimeout(() => {
                fetch('/cart.js')
                  .then(res => {
                    if (!res.ok) throw new Error("Cart fetch failed");
                    return res.json();
                  })
                  .then(resolve)
                  .catch(err => {
                    console.error(err);
                    resolve(null);
                  });
              }, 350);
            });
          })
          .then(cartData => {
            if (!cartData) return;
            appState.cartCount = cartData.item_count;
            appState.cartTotal = cartData.total_price / 100.0;
            if (cartCounter) cartCounter.textContent = appState.cartCount;
            document.dispatchEvent(new CustomEvent("cart-updated-total", { detail: { cartTotal: appState.cartTotal } }));
            updateFreeShippingWidget();
            
            this.textContent = "TILFØJET";
            this.classList.replace("bg-primary", "bg-emerald-600");
          })
          .catch(err => {
            console.error(err);
            // Revert optimistic update
            appState.cartCount = originalCartCount;
            appState.cartTotal = originalCartTotal;
            originalCounts.forEach(item => {
              item.counter.innerText = item.text;
              if (item.hasScale0) {
                item.counter.classList.add("scale-0");
                item.counter.classList.remove("scale-100");
              } else {
                item.counter.classList.remove("scale-0");
                item.counter.classList.add("scale-100");
              }
            });
            updateFreeShippingWidget();
            showToast("Kunne ikke tilføje til kurv.");
          })
          .finally(() => {
            this.disabled = false;
            this.classList.remove("opacity-50");
            setTimeout(() => {
              this.textContent = "TILFØJ";
              this.classList.replace("bg-emerald-600", "bg-primary");
            }, 2000);
          });
        });
      });
    }

    // Listen for threshold updates
    document.addEventListener("shipping-threshold-updated", (e) => {
      if (e.detail && typeof e.detail.threshold === "number") {
        freeShippingThreshold = e.detail.threshold;
        recalculate();
        updateFreeShippingWidget();
      }
    });

    // Initializations
    if (widthInput) widthInput.value = appState.width + " cm";
    if (lengthInput) lengthInput.value = appState.length + " cm";
    recalculate();
    updateFreeShippingWidget();
    startCountdown();
  });
</script>

{% schema %}
{
  "name": "Product Customizer",
  "settings": [
    {
      "type": "product",
      "id": "surcharge_product_rectangular",
      "label": "Firkantet tilpasning tillægsprodukt",
      "info": "Vælg produktet, der opkræver tillæg for firkantet dug."
    },
    {
      "type": "product",
      "id": "surcharge_product_round",
      "label": "Rund tilpasning tillægsprodukt",
      "info": "Vælg produktet, der opkræver tillæg for rund dug."
    },
    {
      "type": "product",
      "id": "surcharge_product_oval",
      "label": "Oval tilpasning tillægsprodukt",
      "info": "Vælg produktet, der opkræver tillæg for oval dug."
    },
    {
      "type": "product",
      "id": "surcharge_product_width",
      "label": "Bredde tilpasning tillægsprodukt",
      "info": "Vælg produktet, der opkræver tillæg for tilpasning af bredde (når bredden ikke er 140 cm)."
    },
    {
      "type": "number",
      "id": "step_size",
      "label": "Længde trin (cm)",
      "default": 10
    },
    {
      "type": "number",
      "id": "min_length",
      "label": "Minimum længde (cm)",
      "default": 50
    },
    {
      "type": "number",
      "id": "min_width",
      "label": "Minimum bredde (cm)",
      "default": 80
    },
    {
      "type": "number",
      "id": "width_step",
      "label": "Bredde/Diameter trin (cm)",
      "default": 10
    }
  ],
  "presets": [
    {
      "name": "Product Customizer"
    }
  ]
}
{% endschema %}
