{%- liquid
  assign layout_style = 'full_width_bg'
  assign is_full_width = section.settings.full_width | default: false

  # Calculate class names dynamically to handle grids and product detail column grids
  assign section_classes = 'section-content grid-layout'

  if is_full_width
    assign section_classes = section_classes | append: ' section-content--full-width'
  endif

  # Clamp columns and starting positions dynamically based on global grid settings
  assign cols_tb = settings.grid_cols_tablet | default: 2 | plus: 0
  assign cols_lg = settings.grid_cols_desktop | default: 3 | plus: 0

  assign span_tb = section.settings.column_span_tablet | default: cols_tb | plus: 0
  if span_tb > cols_tb
    assign span_tb = cols_tb
  endif

  assign start_tb = section.settings.column_start_tablet | default: 'auto'
  if start_tb != 'auto' and start_tb != blank
    assign start_tb_num = start_tb | plus: 0
    if start_tb_num > cols_tb
      assign start_tb = cols_tb
    endif
    assign max_span = cols_tb | minus: start_tb | plus: 1
    if span_tb > max_span
      assign span_tb = max_span
    endif
  endif

  assign span_lg = section.settings.column_span_desktop | default: cols_lg | plus: 0
  if span_lg > cols_lg
    assign span_lg = cols_lg
  endif

  assign start_lg = section.settings.column_start_desktop | default: 'auto'
  if start_lg != 'auto' and start_lg != blank
    assign start_lg_num = start_lg | plus: 0
    if start_lg_num > cols_lg
      assign start_lg = cols_lg
    endif
    assign max_span_lg = cols_lg | minus: start_lg | plus: 1
    if span_lg > max_span_lg
      assign span_lg = max_span_lg
    endif
  endif
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 840px) {
    #shopify-section-{{ section.id }} {
      --section-padding-top: {{ section.settings.padding_top }}px;
      --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-inner-padding {
    {%- if layout_style == 'full_width_bg' -%}
      padding-left: calc({{ section.settings.padding_left | default: 0 | times: 0.75 | round }}px + 1rem);
      padding-right: calc({{ section.settings.padding_right | default: 0 | times: 0.75 | round }}px + 1rem);
    {%- else -%}
      padding-left: {{ section.settings.padding_left | default: 0 | times: 0.75 | round }}px;
      padding-right: {{ section.settings.padding_right | default: 0 | times: 0.75 | round }}px;
    {%- endif -%}
  }

  @media screen and (min-width: 840px) {
    .section-{{ section.id }}-inner-padding {
      {%- if layout_style == 'full_width_bg' -%}
        padding-left: calc({{ section.settings.padding_left | default: 0 }}px + 1rem);
        padding-right: calc({{ section.settings.padding_right | default: 0 }}px + 1rem);
      {%- else -%}
        padding-left: {{ section.settings.padding_left | default: 0 }}px;
        padding-right: {{ section.settings.padding_right | default: 0 }}px;
      {%- endif -%}
    }
  }

  {%- unless section.settings.use_global_gap -%}
    .section-{{ section.id }}-inner-padding .grid-layout {
      --grid-gap: {% if section.settings.block_spacing != blank %}{{ section.settings.block_spacing }}{% else %}8{% endif %}px;
    }
  {%- endunless -%}

  .section-{{ section.id }}-inner-padding .section-content {
    --section-span-mb: {{ settings.grid_cols_mobile | default: 2 }};
    --section-span-tb: {{ span_tb }};
    --section-span-lg: {{ span_lg }};
    --span-mb: var(--section-span-mb);
    --span-tb: var(--section-span-tb);
    --span-lg: var(--section-span-lg);

    --section-span-mobile: {{ settings.grid_cols_mobile | default: 2 }};
    --section-span-expanded: {{ span_tb }};
    --section-span-large: {{ span_lg }};
    --span-mobile: var(--section-span-mobile);
    --span-expanded: var(--section-span-expanded);
    --span-large: var(--section-span-large);

    width: 100%;
    margin-left: auto;
    margin-right: auto;
    max-width: calc((var(--span-mb) / {{ settings.grid_cols_mobile | default: 2 }}) * 100%);
  }

  @media screen and (min-width: 840px) {
    .section-{{ section.id }}-inner-padding .section-content {
      max-width: min(calc((var(--span-tb) / {{ settings.grid_cols_tablet | default: 2 }}) * var(--page-width, 1440px)), 100%);
    }
  }

  @media screen and (min-width: 1200px) {
    .section-{{ section.id }}-inner-padding .section-content {
      max-width: min(calc((var(--span-lg) / {{ settings.grid_cols_desktop | default: 3 }}) * var(--page-width, 1440px)), 100%);
    }
  }

  #shopify-section-{{ section.id }} {
    --col-span: 4;
    grid-column-end: span var(--col-span);
    {%- if section.settings.order_mobile != 'auto' and section.settings.order_mobile != blank -%}
      order: {{ section.settings.order_mobile }};
    {%- endif -%}

    {%- if section.settings.background_color == 'dark' -%}
      --color-primary: #ffffff;
      --color-text: #e2e8f0;
      --color-border: rgba(255, 255, 255, 0.2);
    {%- endif -%}

    {%- if section.settings.hide_on_mobile -%}
      display: none;
    {%- endif -%}
  }

  @media screen and (min-width: 840px) {
    #shopify-section-{{ section.id }} {
      --col-span: {{ span_tb }};
      grid-column-end: span var(--col-span);
      {%- if section.settings.order_tablet != 'auto' and section.settings.order_tablet != blank -%}
        order: {{ section.settings.order_tablet }};
      {%- endif -%}

      {%- if start_tb != 'auto' and start_tb != blank -%}
        --col-start: {{ start_tb }};
        grid-column-start: var(--col-start);
      {%- endif -%}

      {%- if section.settings.hide_on_tablet -%}
        display: none;
      {%- else -%}
        {%- if section.settings.hide_on_mobile -%}
          display: block;
        {%- endif -%}
      {%- endif -%}
    }
  }

  @media screen and (min-width: 1200px) {
    #shopify-section-{{ section.id }} {
      --col-span: {{ span_lg }};
      grid-column-end: span var(--col-span);
      {%- if section.settings.order_desktop != 'auto' and section.settings.order_desktop != blank -%}
        order: {{ section.settings.order_desktop }};
      {%- endif -%}

      {%- if start_lg != 'auto' and start_lg != blank -%}
        --col-start: {{ start_lg }};
        grid-column-start: var(--col-start);
      {%- else -%}
        {%- if start_tb != 'auto' and start_tb != blank -%}
          grid-column-start: auto;
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.hide_on_desktop -%}
        display: none;
      {%- else -%}
        {%- if section.settings.hide_on_tablet or section.settings.hide_on_mobile -%}
          display: block;
        {%- endif -%}
      {%- endif -%}
    }
  }
{%- endstyle -%}

{%- capture bg_class -%}
  {%- case section.settings.background_color -%}
    {%- when 'transparent' -%}bg-transparent text-primary
    {%- when 'white', 'light' -%}bg-card-light text-primary
    {%- when 'light_grey', 'shade' -%}bg-card-shade text-primary
    {%- when 'dark' -%}bg-background-dark text-white
  {%- endcase -%}
{%- endcapture -%}
{%- assign bg_class = bg_class | strip -%}

{%- liquid
  assign float_right_lg = false
  if start_lg != 'auto' and start_lg != blank
    assign start_lg_num = start_lg | plus: 0
    assign span_lg_num = span_lg | plus: 0
    assign cols_lg_num = settings.grid_cols_desktop | default: 3 | plus: 0
    assign end_lg = start_lg_num | plus: span_lg_num | minus: 1
    if end_lg >= cols_lg_num
      assign float_right_lg = true
    endif
  endif

  assign float_right_tb = false
  if start_tb != 'auto' and start_tb != blank
    assign start_tb_num = start_tb | plus: 0
    assign span_tb_num = span_tb | plus: 0
    assign cols_tb_num = settings.grid_cols_tablet | default: 2 | plus: 0
    assign end_tb = start_tb_num | plus: span_tb_num | minus: 1
    if end_tb >= cols_tb_num
      assign float_right_tb = true
    endif
  endif

  if layout_style == 'full_width_bg'
    assign outer_class = 'section-section w-full ' | append: bg_class | append: ' section-' | append: section.id | append: '-padding section-section--full-width'
    if is_full_width
      assign inner_class = 'w-full section-' | append: section.id | append: '-inner-padding'
    else
      assign inner_class = 'max-w-[var(--page-width)] mx-auto section-' | append: section.id | append: '-inner-padding'
    endif
  else
    if is_full_width
      assign outer_class = 'section-section w-full px-4 expanded:px-8 section-' | append: section.id | append: '-padding'
    else
      assign outer_class = 'section-section max-w-[var(--page-width)] mx-auto px-4 expanded:px-8 section-' | append: section.id | append: '-padding'
    endif
    assign inner_class = 'w-full ' | append: bg_class | append: ' rounded-3xl py-10 expanded:py-16 shadow-md section-' | append: section.id | append: '-inner-padding'
  endif

  if float_right_lg
    assign outer_class = outer_class | append: ' float-right-desktop'
  endif
  if float_right_tb
    assign outer_class = outer_class | append: ' float-right-tablet'
  endif
-%}

<div class="{{ outer_class }}"{% if section.settings.border_top or section.settings.border_bottom %} style="{% if section.settings.border_top %}border-top:1px solid var(--color-border);{% endif %}{% if section.settings.border_bottom %}border-bottom:1px solid var(--color-border);{% endif %}"{% endif %}>
  <div class="{{ inner_class }}">
    <div class="{{ section_classes }}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Baggrundsfarve",
      "options": [
        { "value": "transparent", "label": "Transparent" },
        { "value": "white", "label": "Hvid" },
        { "value": "light_grey", "label": "Lys grå" },
        { "value": "dark", "label": "Mørk" }
      ],
      "default": "white"
    },

    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Fuld bredde",
      "default": false
    },
    {
      "type": "header",
      "content": "Mobil"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Skjul på mobil",
      "default": false
    },
    {
      "type": "select",
      "id": "order_mobile",
      "label": "Rækkefølge (Mobil)",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" },
        { "value": "7", "label": "7" },
        { "value": "8", "label": "8" },
        { "value": "9", "label": "9" },
        { "value": "10", "label": "10" },
        { "value": "11", "label": "11" },
        { "value": "12", "label": "12" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Tablet"
    },
    {
      "type": "select",
      "id": "column_span_tablet",
      "label": "Bredde",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "column_start_tablet",
      "label": "Kolonne",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "hide_on_tablet",
      "label": "Skjul på tablet",
      "default": false
    },
    {
      "type": "select",
      "id": "order_tablet",
      "label": "Række",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" },
        { "value": "7", "label": "7" },
        { "value": "8", "label": "8" },
        { "value": "9", "label": "9" },
        { "value": "10", "label": "10" },
        { "value": "11", "label": "11" },
        { "value": "12", "label": "12" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Desktop"
    },
    {
      "type": "select",
      "id": "column_span_desktop",
      "label": "Bredde",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "column_start_desktop",
      "label": "Kolonne",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ],
      "default": "1"
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Skjul på desktop",
      "default": false
    },
    {
      "type": "select",
      "id": "order_desktop",
      "label": "Række",
      "options": [
        { "value": "auto", "label": "Auto" },
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" },
        { "value": "7", "label": "7" },
        { "value": "8", "label": "8" },
        { "value": "9", "label": "9" },
        { "value": "10", "label": "10" },
        { "value": "11", "label": "11" },
        { "value": "12", "label": "12" }
      ],
      "default": "auto"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i venstre side",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i højre side",
      "default": 24
    },
    {
      "type": "header",
      "content": "Blokafstand / Grid-gap"
    },
    {
      "type": "checkbox",
      "id": "use_global_gap",
      "label": "Brug global afstand (Gap)",
      "default": true
    },
    {
      "type": "range",
      "id": "block_spacing",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Brugerdefineret afstand",
      "default": 16
    },
    {
      "type": "header",
      "content": "Kanter"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Kant i toppen",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Kant i bunden",
      "default": false
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    { "name": "Section" }
  ]
}
{% endschema %}
