{%- liquid
  assign layout_style = section.settings.layout_style | default: 'full_width_bg'
  assign is_full_width = section.settings.full_width | default: false

  # Detect if the section contains column group blocks
  assign has_group_block = false
  for block in section.blocks
    if block.type == 'group'
      assign has_group_block = true
      break
    endif
  endfor

  # Calculate class names dynamically to handle grids and product detail column grids
  assign section_classes = 'section-content grid-layout'
  unless has_group_block
    assign section_classes = section_classes | append: ' section-content--no-columns'
  endunless

  if is_full_width
    assign section_classes = section_classes | append: ' section-content--full-width'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 840px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-inner-padding {
    {%- if layout_style == 'full_width_bg' -%}
      padding-left: calc({{ section.settings.padding_left | default: 0 | times: 0.75 | round }}px + 1rem);
      padding-right: calc({{ section.settings.padding_right | default: 0 | times: 0.75 | round }}px + 1rem);
    {%- else -%}
      padding-left: {{ section.settings.padding_left | default: 0 | times: 0.75 | round }}px;
      padding-right: {{ section.settings.padding_right | default: 0 | times: 0.75 | round }}px;
    {%- endif -%}
  }

  @media screen and (min-width: 840px) {
    .section-{{ section.id }}-inner-padding {
      {%- if layout_style == 'full_width_bg' -%}
        padding-left: calc({{ section.settings.padding_left | default: 0 }}px + 1rem);
        padding-right: calc({{ section.settings.padding_right | default: 0 }}px + 1rem);
      {%- else -%}
        padding-left: {{ section.settings.padding_left | default: 0 }}px;
        padding-right: {{ section.settings.padding_right | default: 0 }}px;
      {%- endif -%}
    }
  }

  {%- unless section.settings.use_global_gap -%}
    .section-{{ section.id }}-inner-padding .grid-layout {
      --grid-gap: {% if section.settings.block_spacing != blank %}{{ section.settings.block_spacing }}{% else %}8{% endif %}px;
    }
  {%- endunless -%}

  .section-{{ section.id }}-inner-padding .section-content {
    --section-span-mb: {{ section.settings.column_span_mobile | default: 4 }};
    --section-span-tb: {{ section.settings.column_span_tablet | default: 8 }};
    --section-span-lg: {{ section.settings.column_span_desktop | default: 12 }};
    --span-mb: var(--section-span-mb);
    --span-tb: var(--section-span-tb);
    --span-lg: var(--section-span-lg);

    --section-span-mobile: {{ section.settings.column_span_mobile | default: 4 }};
    --section-span-expanded: {{ section.settings.column_span_tablet | default: 8 }};
    --section-span-large: {{ section.settings.column_span_desktop | default: 12 }};
    --span-mobile: var(--section-span-mobile);
    --span-expanded: var(--section-span-expanded);
    --span-large: var(--section-span-large);

    width: 100%;
    {%- if section.settings.alignment == 'left' -%}
      margin-left: 0 !important;
      margin-right: auto !important;
    {%- elsif section.settings.alignment == 'right' -%}
      margin-left: auto !important;
      margin-right: 0 !important;
    {%- else -%}
      margin-left: auto !important;
      margin-right: auto !important;
    {%- endif -%}
    max-width: calc((var(--span-mb) / 4) * 100%);
  }

  @media screen and (min-width: 840px) {
    .section-{{ section.id }}-inner-padding .section-content {
      max-width: min(calc((var(--span-tb) / 8) * var(--page-width, 1440px)), 100%);
    }
  }

  @media screen and (min-width: 1200px) {
    .section-{{ section.id }}-inner-padding .section-content {
      max-width: min(calc((var(--span-lg) / 12) * var(--page-width, 1440px)), 100%);
    }
  }

  /* Support Grid container logic on sections */
  #shopify-section-{{ section.id }} {
    --col-span: {{ section.settings.column_span_mobile | default: 4 }};
    grid-column-end: span var(--col-span);
    
    {%- if section.settings.row_span_mobile != 'auto' and section.settings.row_span_mobile != blank -%}
      --row-span: {{ section.settings.row_span_mobile }};
      grid-row-end: span var(--row-span);
    {%- endif -%}

    {%- if section.settings.justify_self != 'auto' and section.settings.justify_self != blank -%}
      justify-self: {{ section.settings.justify_self }};
    {%- endif -%}

    {%- if section.settings.align_self != 'auto' and section.settings.align_self != blank -%}
      align-self: {{ section.settings.align_self }};
    {%- endif -%}

    {%- if section.settings.hide_on_mobile -%}
      display: none !important;
    {%- endif -%}
  }

  @media screen and (min-width: 840px) {
    #shopify-section-{{ section.id }} {
      --col-span: {{ section.settings.column_span_tablet | default: 8 }};
      grid-column-end: span var(--col-span);

      {%- if section.settings.column_start_tablet != 'auto' and section.settings.column_start_tablet != blank -%}
        --col-start: {{ section.settings.column_start_tablet }};
        grid-column-start: var(--col-start);
      {%- endif -%}

      {%- if section.settings.row_span_tablet != 'auto' and section.settings.row_span_tablet != blank -%}
        --row-span: {{ section.settings.row_span_tablet }};
        grid-row-end: span var(--row-span);
      {%- endif -%}

      {%- if section.settings.row_start_tablet != 'auto' and section.settings.row_start_tablet != blank -%}
        --row-start: {{ section.settings.row_start_tablet }};
        grid-row-start: var(--row-start);
      {%- endif -%}

      {%- if section.settings.hide_on_tablet -%}
        display: none !important;
      {%- else -%}
        {%- if section.settings.hide_on_mobile -%}
          display: block !important;
        {%- endif -%}
      {%- endif -%}
    }
  }

  @media screen and (min-width: 1200px) {
    #shopify-section-{{ section.id }} {
      --col-span: {{ section.settings.column_span_desktop | default: 12 }};
      grid-column-end: span var(--col-span);

      {%- if section.settings.column_start_desktop != 'auto' and section.settings.column_start_desktop != blank -%}
        --col-start: {{ section.settings.column_start_desktop }};
        grid-column-start: var(--col-start);
      {%- else -%}
        {%- if section.settings.column_start_tablet != 'auto' and section.settings.column_start_tablet != blank -%}
          grid-column-start: auto;
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.row_span_desktop != 'auto' and section.settings.row_span_desktop != blank -%}
        --row-span: {{ section.settings.row_span_desktop }};
        grid-row-end: span var(--row-span);
      {%- else -%}
        {%- if section.settings.row_span_tablet != 'auto' and section.settings.row_span_tablet != blank -%}
          grid-row-end: auto;
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.row_start_desktop != 'auto' and section.settings.row_start_desktop != blank -%}
        --row-start: {{ section.settings.row_start_desktop }};
        grid-row-start: var(--row-start);
      {%- else -%}
        {%- if section.settings.row_start_tablet != 'auto' and section.settings.row_start_tablet != blank -%}
          grid-row-start: auto;
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.hide_on_desktop -%}
        display: none !important;
      {%- else -%}
        {%- if section.settings.hide_on_tablet or section.settings.hide_on_mobile -%}
          display: block !important;
        {%- endif -%}
      {%- endif -%}
    }
  }
{%- endstyle -%}

{%- capture bg_class -%}
  {%- case section.settings.background_color -%}
    {%- when 'transparent' -%}bg-transparent text-primary
    {%- when 'white', 'light' -%}bg-background text-primary
    {%- when 'light_grey', 'shade' -%}bg-background-shade text-primary
    {%- when 'dark' -%}bg-background-dark text-white
  {%- endcase -%}
{%- endcapture -%}

{%- liquid
  if layout_style == 'full_width_bg'
    assign outer_class = 'section-section w-full ' | append: bg_class | append: ' section-' | append: section.id | append: '-padding section-section--full-width'
    if is_full_width
      assign inner_class = 'w-full section-' | append: section.id | append: '-inner-padding'
    else
      assign inner_class = 'max-w-[var(--page-width)] mx-auto section-' | append: section.id | append: '-inner-padding'
    endif
  else
    if is_full_width
      assign outer_class = 'section-section w-full px-4 expanded:px-8 section-' | append: section.id | append: '-padding'
    else
      assign outer_class = 'section-section max-w-[var(--page-width)] mx-auto px-4 expanded:px-8 section-' | append: section.id | append: '-padding'
    endif
    assign inner_class = 'w-full ' | append: bg_class | append: ' rounded-3xl py-10 expanded:py-16 shadow-md section-' | append: section.id | append: '-inner-padding'
  endif
-%}

<div class="{{ outer_class }}"{% if section.settings.border_top or section.settings.border_bottom %} style="{% if section.settings.border_top %}border-top:1px solid var(--color-border);{% endif %}{% if section.settings.border_bottom %}border-bottom:1px solid var(--color-border);{% endif %}"{% endif %}>
  <div class="{{ inner_class }}">
    <div class="{{ section_classes }}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

