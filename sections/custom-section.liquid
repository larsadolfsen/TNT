{%- style -%}
  {%- if section.settings.disable_block_padding_vertical_mobile -%}
    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} .shopify-block {
        --block-padding-top: 0px;
        --block-padding-bottom: 0px;
      }
    }
  {%- endif -%}

  {%- if section.settings.disable_block_padding_horizontal_mobile -%}
    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} .shopify-block {
        --block-padding-left: 0px;
        --block-padding-right: 0px;
      }
    }
  {%- endif -%}
{%- endstyle -%}

<div class="custom-section full-width">
  {% if section.settings.background_image %}
    <div class="custom-section__background">
      {{ section.settings.background_image | image_url: width: 2000 | image_tag }}
    </div>
  {% endif %}

  <div class="custom-section__content">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .custom-section {
    position: relative;
    overflow: hidden;
    width: 100%;
  }
  .custom-section__background {
    position: absolute;
    width: 100%;
    height: 100%;
    z-index: -1;
    overflow: hidden;
  }
  .custom-section__background img {
    position: absolute;
    width: 100%;
    height: auto;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .custom-section__content {
    display: grid;
    grid-template-columns: var(--content-grid);
  }
  .custom-section__content > * {
    grid-column: 2;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.custom_section",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:labels.background"
    },
    {
      "type": "checkbox",
      "id": "disable_block_padding_vertical_mobile",
      "label": "Fjern 12px top/bund-afstand på blokke på mobil",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "disable_block_padding_horizontal_mobile",
      "label": "Fjern 16px sideafstand på blokke på mobil",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:general.custom_section"
    }
  ]
}
{% endschema %}
