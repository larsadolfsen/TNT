      originalPrice_formatted: null,
      image: "https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=400&q=80",
      thickness: "1,2 mm",
      width: "140 cm",
      form: "Firkantet",
      badge: null,
      rating: 4.3,
      reviews: 14,
      popularity: 55,
      url: "#"
    }
  ];

  let rawCollectionProducts = [];
  try {
    rawCollectionProducts = JSON.parse(document.getElementById('collection-products-json').textContent);
  } catch(e) {
    console.warn("Could not parse collection-products-json", e);
  }

  // Fallback to mockup products if the current collection has 0 items
  const products = rawCollectionProducts.length > 0 ? rawCollectionProducts : mockProducts;

  const productGrid = document.getElementById("product-grid");
  const productCountDisplay = document.getElementById("product-count-display");
  const searchInput = document.getElementById("search-input");

  window.onload = function() {
    filterProducts();
  };

  function syncFilters(changedInput) {
    const name = changedInput.name;
    const value = changedInput.value;
    const isChecked = changedInput.checked;
    
    let counterpartName;
    if (name.startsWith('mobile-')) {
      counterpartName = name.replace('mobile-', '');
    } else {
      counterpartName = 'mobile-' + name;
    }

    const counterparts = document.querySelectorAll(`input[name="${counterpartName}"][value="${value}"]`);
    counterparts.forEach(el => el.checked = isChecked);

    filterProducts();
  }

  function syncPriceFilters(changedInput) {
    const id = changedInput.id;
    const val = changedInput.value;
    if (id === 'price-min') {
      const el = document.getElementById('mobile-price-min');
      if (el) el.value = val;
    } else if (id === 'price-max') {
      const el = document.getElementById('mobile-price-max');
      if (el) el.value = val;
    } else if (id === 'mobile-price-min') {
      const el = document.getElementById('price-min');
      if (el) el.value = val;
    } else if (id === 'mobile-price-max') {
      const el = document.getElementById('price-max');
      if (el) el.value = val;
    }
    filterProducts();
  }

  function getSelectedFilters() {
    const filters = {};
    const checkedCheckboxes = document.querySelectorAll('input[type="checkbox"]:checked');
    checkedCheckboxes.forEach(cb => {
      let name = cb.name;
      if (name.startsWith('mobile-')) {
        name = name.replace('mobile-', '');
      }
      if (!filters[name]) {
        filters[name] = [];
      }
      if (!filters[name].includes(cb.value)) {
        filters[name].push(cb.value);
      }
    });
    return filters;
  }

  function filterProducts() {
    const activeFilters = getSelectedFilters();
    const searchQuery = searchInput ? searchInput.value.toLowerCase().trim() : "";
    const sortBy = document.getElementById("sort-select").value;

    const minPriceInput = document.getElementById("price-min");
    const maxPriceInput = document.getElementById("price-max");
    const minPrice = minPriceInput && minPriceInput.value ? parseFloat(minPriceInput.value) : 0;
    const maxPrice = maxPriceInput && maxPriceInput.value ? parseFloat(maxPriceInput.value) : Infinity;

    let filtered = products.filter(product => {
      // 1. Price Range Check
      if (product.price < minPrice || product.price > maxPrice) {
        return false;
      }

      // 2. Dynamic checkboxes filtering
      for (const filterKey in activeFilters) {
        const selectedValues = activeFilters[filterKey];
        if (selectedValues.length === 0) continue;

        let productValue = "";
        
        // Match specific standard keys first to keep backward compatibility
        if (filterKey === 'tykkelse') {
          productValue = product.thickness;
        } else if (filterKey === 'bredde') {
          productValue = product.width;
        } else if (filterKey === 'form') {
          productValue = product.form;
        }

        // If not found in standard properties, search in all tags and options
        if (!productValue) {
          // Check tags (e.g. tag is "farve:Rød", search tag starting with "farve:")
          const tagPrefix = filterKey.toLowerCase() + ":";
          if (product.tags) {
            const matchingTag = product.tags.find(t => t.toLowerCase().startsWith(tagPrefix));
            if (matchingTag) {
              productValue = matchingTag.substring(tagPrefix.length).trim();
            }
          }
        }

        if (!productValue && product.options) {
          // Check product variant options (case insensitive option name match)
          const optName = Object.keys(product.options).find(k => k.toLowerCase().includes(filterKey.toLowerCase()));
          if (optName) {
            productValue = product.options[optName];
          }
        }

        if (!productValue || !selectedValues.includes(productValue)) {
          return false;
        }
      }

      // 3. Search query check
      if (searchQuery) {
        const matchesTitle = product.title.toLowerCase().includes(searchQuery);
        const matchesThickness = product.thickness ? product.thickness.toLowerCase().includes(searchQuery) : false;
        const matchesForm = product.form ? product.form.toLowerCase().includes(searchQuery) : false;
        if (!matchesTitle && !matchesThickness && !matchesForm) {
          return false;
        }
      }
      return true;
    });

    if (sortBy === "price-asc") {
      filtered.sort((a, b) => a.price - b.price);
    } else if (sortBy === "price-desc") {
      filtered.sort((a, b) => b.price - a.price);
    } else {
      filtered.sort((a, b) => b.popularity - a.popularity);
    }

    renderProducts(filtered);
  }

  function renderProducts(items) {
    if (!productGrid) return;
    productCountDisplay.innerText = items.length;
    productGrid.innerHTML = "";

    if (items.length === 0) {
      productGrid.innerHTML = `
        <div class="col-span-full py-12 text-center">
          <span class="material-symbols-outlined text-4xl text-on-surface-variant mb-2">sentiment_dissatisfied</span>
          <p class="text-sm font-semibold text-primary">Ingen produkter matchede dine kriterier.</p>
          <button onclick="clearAllFilters()" class="mt-4 text-xs text-secondary underline bg-transparent border-0 cursor-pointer">Ryd filtre</button>
        </div>
      `;
      return;
    }

    items.forEach(product => {
      let originalPriceHtml = "";
      if (product.originalPrice && product.originalPrice > product.price) {
        const displayOrig = product.originalPrice_formatted ? product.originalPrice_formatted : `${product.originalPrice.toFixed(2).replace('.', ',')} Kr.`;
        originalPriceHtml = `<span class="text-[8px] sm:text-[9px] text-on-surface-variant line-through leading-none">${displayOrig}</span>`;
      }

      let badgeHtml = "";
      if (product.badge) {
        badgeHtml = `<span class="absolute top-2 left-2 bg-primary text-white text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10">${product.badge}</span>`;
      } else if (product.originalPrice && product.originalPrice > product.price) {
        const savings = Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100);
        badgeHtml = `<span class="absolute top-2 left-2 bg-secondary text-white text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10">Spar ${savings}%</span>`;
      }

      const displayPrice = product.price_formatted ? product.price_formatted : `${product.price.toFixed(2).replace('.', ',')} Kr.`;

      // Determine if it is a Metervare product (priced per meter)
      const isMetervare = product.type === "Metervare";

      // Determine if it is a general meter-sold product (priced per cm)
      const isMeterProduct = product.thickness || product.width || product.title.toLowerCase().includes("voksdug") || product.title.toLowerCase().includes("bordbeskytter");

      let priceLabel = 'Pris';
      if (isMetervare) {
        priceLabel = 'Pris pr. meter';
      } else if (isMeterProduct) {
        priceLabel = 'Pris pr. cm';
      }

      const cardHtml = `
        <div class="product-card flex flex-col bg-white border border-outline-variant rounded-2xl overflow-hidden hover:shadow-md hover:border-primary/40 transition-all duration-300 group relative">
          
          <!-- Image Zone -->
          <div class="relative w-full flex-shrink-0 bg-surface-container overflow-hidden" style="aspect-ratio: 1/1;">
            <a href="${product.url}" class="block w-full h-full">
              <img 
                src="${product.image}" 
                alt="${product.title}" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.src='https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=400&q=80'"
                loading="lazy"
              />
            </a>
            ${badgeHtml}
          </div>

          <!-- Info Zone -->
          <div class="p-3 flex flex-col justify-between flex-1 min-w-0">
            <div class="space-y-1">
              <h3 class="font-sans text-xs sm:text-sm font-bold text-primary leading-tight hover:text-secondary mb-1">
                <a href="${product.url}" class="text-primary no-underline hover:text-secondary line-clamp-2">${product.title}</a>
              </h3>
              
              <!-- Rating: 5 Stars -->
              <div class="flex items-center gap-1 text-[10px] text-secondary mt-1">
                <div class="flex text-[#FFB800] gap-0.5">
                  ${(() => {
                    let starsHtml = "";
                    const ratingFloor = Math.floor(product.rating);
                    const decimal = product.rating - ratingFloor;
                    for (let i = 1; i <= 5; i++) {
                      if (i <= ratingFloor) {
                        starsHtml += `<span class="material-symbols-outlined text-[12px] filled-star select-none" style="font-size: 12px; line-height: 1;">star</span>`;
                      } else if (i === ratingFloor + 1) {
                        if (decimal >= 0.75) {
                          starsHtml += `<span class="material-symbols-outlined text-[12px] filled-star select-none" style="font-size: 12px; line-height: 1;">star</span>`;
                        } else if (decimal >= 0.25) {
                          starsHtml += `<span class="material-symbols-outlined text-[12px] filled-star select-none" style="font-size: 12px; line-height: 1;">star_half</span>`;
                        } else {
                          starsHtml += `<span class="material-symbols-outlined text-[12px] text-outline-variant select-none" style="font-size: 12px; line-height: 1;">star</span>`;
                        }
                      } else {
                        starsHtml += `<span class="material-symbols-outlined text-[12px] text-outline-variant select-none" style="font-size: 12px; line-height: 1;">star</span>`;
                      }
                    }
                    return starsHtml;
                  })()}
                </div>
                <span class="font-bold text-primary ml-1">${product.rating}</span>
                <span class="text-on-surface-variant">(${product.reviews})</span>
              </div>
            </div>

            <!-- Price & Buy Button (No divider border) -->
            <div class="mt-3 space-y-3">
              <div class="flex flex-col items-start gap-1">
                <span class="text-[10px] sm:text-xs text-on-surface-variant leading-none">
                  ${priceLabel}
                </span>
                <div class="flex items-baseline gap-1.5 flex-wrap">
                  <span class="text-xs sm:text-sm md:text-base font-bold text-primary leading-none">
                    ${isMetervare || isMeterProduct ? 'Fra ' : ''}${displayPrice}
                  </span>
                  ${originalPriceHtml}
                </div>
              </div>

              <button onclick="window.addToCart(${product.id})" class="w-full bg-brand-yellow hover:brightness-95 text-primary py-2 rounded-full flex items-center justify-center gap-1.5 transition-colors focus:outline-none text-[11px] sm:text-xs font-bold border-0 cursor-pointer" aria-label="Køb ${product.title}">
                <span>Køb</span>
              </button>
            </div>
          </div>

        </div>
      `;
      productGrid.insertAdjacentHTML("beforeend", cardHtml);
    });
  }

  function applyQuickFilter(type, value) {
    clearAllFilters(false);
    const inputs = document.querySelectorAll(`input[name="${type}"], input[name="mobile-${type}"]`);
    inputs.forEach(input => {
      if (input.value === value) {
        input.checked = true;
      }
    });
    filterProducts();
  }

  function clearAllFilters(shouldRender = true) {
    document.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
      checkbox.checked = false;
    });
    ['price-min', 'price-max', 'mobile-price-min', 'mobile-price-max'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = "";
    });
    if (shouldRender) {
      filterProducts();
    }
  }

  function toggleMobileFilter(open) {
    const drawer = document.getElementById("mobile-filter-drawer");
    if (!drawer) return;
    const panel = drawer.querySelector("div");
    if (open) {
      drawer.classList.remove("hidden");
      setTimeout(() => {
        drawer.classList.remove("opacity-0");
        panel.classList.remove("translate-x-full");
      }, 10);
    } else {
      drawer.classList.add("opacity-0");
      panel.classList.add("translate-x-full");
      setTimeout(() => {
        drawer.classList.add("hidden");
      }, 300);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    const filterDrawer = document.getElementById("mobile-filter-drawer");
    if (filterDrawer) {
      filterDrawer.addEventListener("click", (e) => {
        if (e.target === filterDrawer) {
          toggleMobileFilter(false);
        }
      });
    }
  });

  window.syncFilters = syncFilters;
  window.syncPriceFilters = syncPriceFilters;
  window.filterProducts = filterProducts;
  window.applyQuickFilter = applyQuickFilter;
  window.clearAllFilters = clearAllFilters;
  window.toggleMobileFilter = toggleMobileFilter;
</script>

