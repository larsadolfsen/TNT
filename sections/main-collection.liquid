  function getProductValuesForKeyAll(product, filterKey) {
    const values = new Set();
    
    // 0. Metafield colors
    if ((filterKey === 'farve' || filterKey === 'color') && product.colors && product.colors.length > 0) {
      product.colors.forEach(c => {
        if (c.label) values.add(c.label);
      });
    }

    // 1. Direct fields
    if (filterKey === 'tykkelse' && product.thickness) values.add(product.thickness);
    if (filterKey === 'bredde' && product.width) values.add(product.width);
    if (filterKey === 'form' && product.form) values.add(product.form);
    
    // 2. Tags
    const tagPrefix = filterKey.toLowerCase() + ":";
    if (product.tags) {
      product.tags.forEach(t => {
        if (t.toLowerCase().startsWith(tagPrefix)) {
          values.add(t.substring(tagPrefix.length).trim());
        }
      });
    }
    
    // 3. Main options
    if (product.options) {
      const optName = Object.keys(product.options).find(k => k.toLowerCase().includes(filterKey.toLowerCase()));
      if (optName && product.options[optName]) {
        values.add(product.options[optName]);
      }
    }
    
    // 4. Variant options (variations)
    if (product.variants && product.variants.length > 0) {
      product.variants.forEach(v => {
        if (v.options) {
          const optName = Object.keys(v.options).find(k => k.toLowerCase().includes(filterKey.toLowerCase()));
          if (optName && v.options[optName]) {
            values.add(v.options[optName]);
          }
        }
      });
    }

    // 5. options_with_values
    if (product.options_with_values) {
      product.options_with_values.forEach(opt => {
        if (opt.name.toLowerCase().includes(filterKey.toLowerCase())) {
          opt.values.forEach(val => values.add(val));
        }
      });
    }

    // 6. Brand (vendor)
    if (filterKey === 'brand' && product.vendor) {
      values.add(product.vendor);
    }

    // 7. Rating thresholds
    if (filterKey === 'rating') {
      const r = parseFloat(product.rating) || 0;
      if (r >= 4.5) values.add('4.5');
      if (r >= 4.0) values.add('4.0');
      if (r >= 3.5) values.add('3.5');
    }
    
    return Array.from(values);
  }

  function renderFilterBlocks() {
    const desktopContainer = document.getElementById('desktop-filters');
    const mobileContainer = document.getElementById('mobile-filters');
    if (!desktopContainer || !mobileContainer) return;

    desktopContainer.innerHTML = '';
    mobileContainer.innerHTML = '';

    const filtersToRender = [];

    // 1. Price
    const prices = products.map(p => p.price);
    const minPrice = Math.min(...prices);
    const maxPrice = Math.max(...prices);
    if (prices.length > 0 && maxPrice > minPrice) {
      filtersToRender.push({
        key: 'price',
        title: 'Pris',
        type: 'price',
        min: minPrice,
        max: maxPrice
      });
    }

    // Helper to get option values
    function getOptionValues(optionNames) {
      const vals = new Set();
      products.forEach(p => {
        // Dynamic metafield colors inclusion
        if (p.colors && p.colors.length > 0 && optionNames.some(target => 'farve'.includes(target) || 'color'.includes(target))) {
          p.colors.forEach(c => {
            if (c.label) vals.add(c.label);
          });
        }

        if (p.options_with_values) {
          p.options_with_values.forEach(opt => {
            const nameDown = opt.name.toLowerCase();
            if (optionNames.some(target => nameDown.includes(target))) {
              opt.values.forEach(v => vals.add(v));
            }
          });
        }
        if (p.options) {
          Object.keys(p.options).forEach(k => {
            const nameDown = k.toLowerCase();
            if (optionNames.some(target => nameDown.includes(target))) {
              vals.add(p.options[k]);
            }
          });
        }
        if (p.variants) {
          p.variants.forEach(v => {
            if (v.options) {
              Object.keys(v.options).forEach(k => {
                const nameDown = k.toLowerCase();
                if (optionNames.some(target => nameDown.includes(target))) {
                  vals.add(v.options[k]);
                }
              });
            }
          });
        }
      });
      return Array.from(vals).filter(v => v && v.trim() !== '');
    }

    // 2. Color (Farve)
    const colors = getOptionValues(['farve', 'color', 'colour', 'mønster']);
    if (colors.length > 0) {
      filtersToRender.push({
        key: 'farve',
        title: 'Farve',
        type: 'color',
        values: colors.sort()
      });
    }

    // 3. Size (Størrelse / Bredde)
    const sizes = getOptionValues(['størrelse', 'size', 'bredde', 'width', 'længde', 'length']);
    if (sizes.length === 0) {
      const widthSet = new Set();
      products.forEach(p => {
        if (p.width) widthSet.add(p.width);
      });
      if (widthSet.size > 0) {
        sizes.push(...Array.from(widthSet));
      }
    }
    if (sizes.length > 0) {
      sizes.sort((a, b) => {
        const aNum = parseFloat(a.replace(',', '.')) || 0;
        const bNum = parseFloat(b.replace(',', '.')) || 0;
        return aNum - bNum;
      });
      filtersToRender.push({
        key: 'størrelse',
        title: 'Bredde',
        type: 'checkbox',
        values: sizes
      });
    }

    // 4. Tykkelse
    const thicknesses = getOptionValues(['tykkelse', 'thickness']);
    if (thicknesses.length === 0) {
      const thickSet = new Set();
      products.forEach(p => {
        if (p.thickness) thickSet.add(p.thickness);
      });
      if (thickSet.size > 0) {
        thicknesses.push(...Array.from(thickSet));
      }
    }
    if (thicknesses.length > 0) {
      thicknesses.sort((a, b) => {
        const aNum = parseFloat(a.replace(',', '.')) || 0;
        const bNum = parseFloat(b.replace(',', '.')) || 0;
        return aNum - bNum;
      });
      filtersToRender.push({
        key: 'tykkelse',
        title: 'Tykkelse',
        type: 'checkbox',
        values: thicknesses
      });
    }

    // 5. Brand (Mærke)
    const brands = Array.from(new Set(products.map(p => p.vendor).filter(v => v && v.trim() !== '')));
    if (brands.length > 0) {
      filtersToRender.push({
        key: 'brand',
        title: 'Brand',
        type: 'checkbox',
        values: brands.sort()
      });
    }

    // 6. User Rating (Brugerbedømmelse)
    const hasRatings = products.some(p => p.rating > 0);
    if (hasRatings) {
      filtersToRender.push({
        key: 'rating',
        title: 'Brugerbedømmelse',
        type: 'rating',
        values: [
          { val: '4.5', label: '4,5 stjerner & derover' },
          { val: '4.0', label: '4,0 stjerner & derover' },
          { val: '3.5', label: '3,5 stjerner & derover' }
        ]
      });
    }

    // 7. Form (Type / Form)
    const forms = getOptionValues(['form', 'type']);
    if (forms.length === 0) {
      const formSet = new Set();
      products.forEach(p => {
        if (p.form) formSet.add(p.form);
      });
      if (formSet.size > 0) {
        forms.push(...Array.from(formSet));
      }
    }
    if (forms.length > 0) {
      filtersToRender.push({
        key: 'form',
        title: 'Type / Form',
        type: 'checkbox',
        values: forms.sort()
      });
    }

    filtersToRender.forEach(filter => {
      const desktopHtml = renderFilterHtml(filter, false);
      const mobileHtml = renderFilterHtml(filter, true);
      desktopContainer.insertAdjacentHTML('beforeend', desktopHtml);
      mobileContainer.insertAdjacentHTML('beforeend', mobileHtml);
    });
  }

  function renderFilterHtml(filter, isMobile) {
    const prefix = isMobile ? 'mobile-' : '';
    if (filter.type === 'price') {
      return `
        <div class="filter-block">
          <div class="flex justify-between items-center cursor-pointer mb-3 mt-0 group/header" onclick="toggleFilterBlock(this)">
            <h3 class="text-sm font-semibold text-primary m-0 select-none font-sans">${filter.title}</h3>
            <span class="material-symbols-outlined text-sm select-none toggle-icon text-primary/60 group-hover/header:text-primary transition-colors">remove</span>
          </div>
          <div class="flex items-center gap-2 filter-content">
            <input type="number" id="${prefix}price-min" placeholder="Min" class="w-full text-xs border border-outline-variant rounded-xl bg-surface-container py-2 px-3 text-primary" oninput="syncPriceFilters(this)"/>
            <span class="text-xs text-primary/85">-</span>
            <input type="number" id="${prefix}price-max" placeholder="Maks" class="w-full text-xs border border-outline-variant rounded-xl bg-surface-container py-2 px-3 text-primary" oninput="syncPriceFilters(this)"/>
          </div>
        </div>
      `;
    }

    if (filter.type === 'color') {
      let optionsHtml = '';
      filter.values.forEach(opt => {
        const val = opt;
        const swatch = getColorSwatchStyles(val);
        const checkColorClass = swatch.isLight ? 'text-black/85' : 'text-white';
        const checkeredStyle = swatch.isCheckered ? 'background-size: 8px 8px; background-position: 0 0, 4px 4px;' : '';
        
        optionsHtml += `
          <label class="relative group cursor-pointer filter-label select-none flex items-center justify-center" title="${val}">
            <input type="checkbox" name="${prefix}${filter.key}" value="${val.replace(/"/g, '&quot;')}" onchange="syncFilters(this)" class="filter-checkbox sr-only peer"/>
            <div class="w-8 h-8 rounded-full border border-outline-variant/65 peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-[var(--color-accent)]/80 transition-all flex items-center justify-center relative shadow-sm hover:scale-105" style="background: ${swatch.bg}; ${checkeredStyle}">
              <span class="material-symbols-outlined text-xs font-bold ${checkColorClass} hidden peer-checked:block select-none pointer-events-none" style="font-size: 14px;">check</span>
            </div>
            <!-- Dynamic count badge/label on hover -->
            <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-surface-container-high text-primary text-[10px] font-semibold rounded-md opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap shadow-md border border-outline-variant z-20">
              ${val} <span class="filter-count text-[9px] text-primary/60 ml-0.5">(0)</span>
            </div>
          </label>
        `;
      });

      return `
        <div class="filter-block">
          <div class="flex justify-between items-center cursor-pointer mb-3 mt-0 group/header" onclick="toggleFilterBlock(this)">
            <h3 class="text-sm font-semibold text-primary m-0 select-none font-sans">${filter.title}</h3>
            <span class="material-symbols-outlined text-sm select-none toggle-icon text-primary/60 group-hover/header:text-primary transition-colors">remove</span>
          </div>
          <div class="flex flex-wrap gap-2.5 filter-content pt-1">
            ${optionsHtml}
          </div>
        </div>
      `;
    }

    if (filter.type === 'checkbox' || filter.type === 'rating') {
      let optionsHtml = '';
      filter.values.forEach(opt => {
        const val = filter.type === 'rating' ? opt.val : opt;
        const labelText = filter.type === 'rating' ? opt.label : opt;
        
        let displayVal = labelText;
        if (filter.key === 'størrelse' && labelText === '41x33 cm') {
          displayVal = '41x33 cm (Dækkeserviet)';
        } else if (filter.key === 'form') {
          if (labelText === 'Firkantet') displayVal = 'Firkantet (Rulle)';
          else if (labelText === 'Rund') displayVal = 'Rund skåret';
        }

        optionsHtml += `
          <label class="flex items-center gap-2 text-sm text-primary/85 cursor-pointer filter-label transition-all">
            <input type="checkbox" name="${prefix}${filter.key}" value="${val.replace(/"/g, '&quot;')}" onchange="syncFilters(this)" class="filter-checkbox rounded border-outline-variant text-primary focus:ring-primary"/>
            <span>${displayVal} <span class="filter-count text-xs text-primary/60 ml-0.5">(0)</span></span>
          </label>
        `;
      });

      return `
        <div class="filter-block">
          <div class="flex justify-between items-center cursor-pointer mb-3 mt-0 group/header" onclick="toggleFilterBlock(this)">
            <h3 class="text-sm font-semibold text-primary m-0 select-none font-sans">${filter.title}</h3>
            <span class="material-symbols-outlined text-sm select-none toggle-icon text-primary/60 group-hover/header:text-primary transition-colors">remove</span>
          </div>
          <div class="space-y-2 filter-content">
            ${optionsHtml}
          </div>
        </div>
      `;
    }
    return '';
  }

  function renderSortOptions() {
    const sortSelect = document.getElementById("sort-select");
    if (!sortSelect) return;

    const currentSortVal = sortSelect.value || "popularity";
    sortSelect.innerHTML = "";

    const options = [];

    // Best Selling / Popularity
    options.push({ val: "popularity", label: "Mest populære" });

    // Price sorting (if we have different prices)
    const uniquePrices = new Set(products.map(p => p.price));
    if (uniquePrices.size > 1) {
      options.push({ val: "price-asc", label: "Pris: Lav til høj" });
      options.push({ val: "price-desc", label: "Pris: Høj til lav" });
    }

    // User Rating (if ratings exist)
    const hasRatings = products.some(p => p.rating > 0);
    if (hasRatings) {
      options.push({ val: "rating-desc", label: "Brugerbedømmelse" });
    }

    // Newest
    options.push({ val: "newest", label: "Nyeste" });

    options.forEach(opt => {
      const el = document.createElement("option");
      el.value = opt.val;
      el.textContent = opt.label;
      if (opt.val === currentSortVal) {
        el.selected = true;
      }
      sortSelect.appendChild(el);
    });
  }

  function truncateFilterLists() {
    const filterContainers = document.querySelectorAll('#desktop-filters > div > div.filter-content, #mobile-filters > div > div.filter-content');
    filterContainers.forEach(container => {
      const labels = Array.from(container.querySelectorAll('label')).filter(l => l.style.display !== 'none');
      const isColor = container.classList.contains('flex-wrap');
      const limit = isColor ? 15 : 8;
      if (labels.length > limit) {
        for (let i = limit; i < labels.length; i++) {
          labels[i].classList.add('hidden', 'truncated-filter-option');
        }

        const toggleBtn = document.createElement('button');
        toggleBtn.type = 'button';
        toggleBtn.className = 'text-xs text-secondary hover:underline bg-transparent border-0 cursor-pointer p-0 mt-2 font-semibold flex items-center gap-1 w-full';
        toggleBtn.innerHTML = `<span>Vis flere (+${labels.length - limit})</span><span class="material-symbols-outlined text-xs">keyboard_arrow_down</span>`;
        
        toggleBtn.onclick = function() {
          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            for (let i = limit; i < labels.length; i++) {
              labels[i].classList.add('hidden');
            }
            toggleBtn.setAttribute('aria-expanded', 'false');
            toggleBtn.innerHTML = `<span>Vis flere (+${labels.length - limit})</span><span class="material-symbols-outlined text-xs">keyboard_arrow_down</span>`;
          } else {
            for (let i = limit; i < labels.length; i++) {
              labels[i].classList.remove('hidden');
            }
            toggleBtn.setAttribute('aria-expanded', 'true');
            toggleBtn.innerHTML = `<span>Vis færre</span><span class="material-symbols-outlined text-xs">keyboard_arrow_up</span>`;
          }
        };

        container.appendChild(toggleBtn);
      }
    });
  }

  // Bayesian rating index formula
  function getBayesianRating(p) {
    const r = p.rating || 0;
    const v = p.reviews || 0;
    const K = 5; 
    const C = 4.5;
    return (v / (v + K)) * r + (K / (v + K)) * C;
  }

  function syncFilters(changedInput) {
    const name = changedInput.name;
    const value = changedInput.value;
    const isChecked = changedInput.checked;
    
    let counterpartName;
    if (name.startsWith('mobile-')) {
      counterpartName = name.replace('mobile-', '');
    } else {
      counterpartName = 'mobile-' + name;
    }

    const counterparts = document.querySelectorAll(`input[name="${counterpartName}"][value="${value.replace(/"/g, '\\"')}"]`);
    counterparts.forEach(el => el.checked = isChecked);

    filterProducts();
  }

  // Handle switching variant on product card
  window.onCardVariantChange = function(buttonEl) {
    const productId = parseInt(buttonEl.dataset.productId);
    const optionName = buttonEl.dataset.optionName;
    const optionValue = buttonEl.dataset.optionValue;
    
    const cardEl = buttonEl.closest('.product-card');
    if (!cardEl) return;
    
    const product = products.find(p => p.id === productId);
    if (!product) return;

    const optionButtons = Array.from(cardEl.querySelectorAll('button[data-option-name]')).filter(btn => btn.dataset.optionName === optionName);
    optionButtons.forEach(btn => {
      const isColor = btn.querySelector('img') !== null;
      const val = btn.dataset.optionValue;
      const isSelected = (val === optionValue);
      
      if (isColor) {
        if (isSelected) {
          btn.className = "w-7 h-7 sm:w-9 sm:h-9 rounded-lg overflow-hidden border bg-card-high p-0.5 cursor-pointer transition-all border-[var(--color-accent)] ring-1 ring-[var(--color-accent)]/30";
        } else {
          btn.className = "w-7 h-7 sm:w-9 sm:h-9 rounded-lg overflow-hidden border bg-card-high p-0.5 cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60";
        }
      } else {
        if (isSelected) {
          btn.className = "px-2 py-0.5 text-[9px] sm:text-[11px] rounded-lg border bg-card-high cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold";
        } else {
          btn.className = "px-2 py-0.5 text-[9px] sm:text-[11px] rounded-lg border bg-card-high cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80";
        }
      }
    });

    const labelSpan = Array.from(cardEl.querySelectorAll('[data-selected-option-label]')).find(span => span.dataset.selectedOptionLabel === `${productId}-${optionName}`);
    if (labelSpan) {
      labelSpan.textContent = optionValue;
    }

    const activeOptions = {};
    const selectedButtons = Array.from(cardEl.querySelectorAll('.product-variant-swatches button')).filter(btn => btn.classList.contains('border-[var(--color-accent)]'));
    selectedButtons.forEach(btn => {
      activeOptions[btn.dataset.optionName] = btn.dataset.optionValue;
    });

    product.options_with_values.forEach(opt => {
      if (!activeOptions[opt.name]) {
        activeOptions[opt.name] = product.options[opt.name];
      }
    });

    let matchingVariant = product.variants.find(v => {
      return Object.entries(activeOptions).every(([name, val]) => {
        return v.options[name] === val;
      });
    });

    if (!matchingVariant) {
      matchingVariant = product.variants.find(v => v.options[optionName] === optionValue);
      
      if (matchingVariant) {
        product.options_with_values.forEach(opt => {
          const matchingVal = matchingVariant.options[opt.name];
          const labelSpanToUpdate = Array.from(cardEl.querySelectorAll('[data-selected-option-label]')).find(span => span.dataset.selectedOptionLabel === `${productId}-${opt.name}`);
          if (labelSpanToUpdate) {
            labelSpanToUpdate.textContent = matchingVal;
          }
          
          const optBtns = Array.from(cardEl.querySelectorAll('button[data-option-name]')).filter(btn => btn.dataset.optionName === opt.name);
          optBtns.forEach(btn => {
            const isColor = btn.querySelector('img') !== null;
            const val = btn.dataset.optionValue;
            const isSelected = (val === matchingVal);
            
            if (isColor) {
              if (isSelected) {
                btn.className = "w-7 h-7 sm:w-9 sm:h-9 rounded-lg overflow-hidden border bg-card-high p-0.5 cursor-pointer transition-all border-[var(--color-accent)] ring-1 ring-[var(--color-accent)]/30";
              } else {
                btn.className = "w-7 h-7 sm:w-9 sm:h-9 rounded-lg overflow-hidden border bg-card-high p-0.5 cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60";
              }
            } else {
              if (isSelected) {
                btn.className = "px-2 py-0.5 text-[9px] sm:text-[11px] rounded-lg border bg-card-high cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold";
              } else {
                btn.className = "px-2 py-0.5 text-[9px] sm:text-[11px] rounded-lg border bg-card-high cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80";
              }
            }
          });
        });
      }
    }

    if (matchingVariant) {
      // 1. Update card image with fade transition
      const imgEl = cardEl.querySelector('.product-card-image');
      if (imgEl) {
        imgEl.style.opacity = '0.3';
        setTimeout(() => {
          imgEl.src = matchingVariant.image;
          imgEl.style.opacity = '1';
        }, 100);
      }

      // 2. Update price display
      const priceValEl = cardEl.querySelector('.font-bold.text-primary.leading-none');
      if (priceValEl) {
        priceValEl.textContent = matchingVariant.price_formatted;
      }

      // 3. Update original price display
      const priceWrapper = cardEl.querySelector('.flex.items-baseline.gap-1.5');
      if (priceWrapper) {
        let originalPriceEl = priceWrapper.querySelector('.line-through');
        if (matchingVariant.originalPrice && matchingVariant.originalPrice > matchingVariant.price) {
          if (!originalPriceEl) {
            originalPriceEl = document.createElement('span');
            originalPriceEl.className = "text-[8px] sm:text-[9px] text-primary/70 line-through leading-none";
            priceWrapper.insertBefore(originalPriceEl, priceWrapper.querySelector('span:last-child'));
          }
          originalPriceEl.textContent = matchingVariant.originalPrice_formatted;
        } else if (originalPriceEl) {
          originalPriceEl.remove();
        }
      }

      // Update badge
      const imageZone = cardEl.querySelector('.relative.w-full.flex-shrink-0');
      if (imageZone) {
        let badgeEl = imageZone.querySelector('span');
        if (matchingVariant.originalPrice && matchingVariant.originalPrice > matchingVariant.price) {
          const savings = Math.round(((matchingVariant.originalPrice - matchingVariant.price) / matchingVariant.originalPrice) * 100);
          if (!badgeEl) {
            badgeEl = document.createElement('span');
            badgeEl.className = "absolute top-2 left-2 bg-secondary text-on-accent text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
            imageZone.appendChild(badgeEl);
          } else {
            badgeEl.className = "absolute top-2 left-2 bg-secondary text-on-accent text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
          }
          badgeEl.textContent = `Spar ${savings}%`;
        } else if (product.badge) {
          if (!badgeEl) {
            badgeEl = document.createElement('span');
            badgeEl.className = "absolute top-2 left-2 bg-primary text-on-primary text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
            imageZone.appendChild(badgeEl);
          } else {
            badgeEl.className = "absolute top-2 left-2 bg-primary text-on-primary text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
          }
          badgeEl.textContent = product.badge;
        } else if (badgeEl) {
          badgeEl.remove();
        }
      }
    }
  };

  function syncPriceFilters(changedInput) {
    const id = changedInput.id;
    const val = changedInput.value;
    if (id === 'price-min') {
      const el = document.getElementById('mobile-price-min');
      if (el) el.value = val;
    } else if (id === 'price-max') {
      const el = document.getElementById('mobile-price-max');
      if (el) el.value = val;
    } else if (id === 'mobile-price-min') {
      const el = document.getElementById('price-min');
      if (el) el.value = val;
    } else if (id === 'mobile-price-max') {
      const el = document.getElementById('price-max');
      if (el) el.value = val;
    }
    filterProducts();
  }

  function getSelectedFilters() {
    const filters = {};
    const checkedCheckboxes = document.querySelectorAll('input.filter-checkbox:checked');
    checkedCheckboxes.forEach(cb => {
      let name = cb.name;
      if (name.startsWith('mobile-')) {
        name = name.replace('mobile-', '');
      }
      if (!filters[name]) {
        filters[name] = [];
      }
      if (!filters[name].includes(cb.value)) {
        filters[name].push(cb.value);
      }
    });
    return filters;
  }

  function removeFilterChip(key, value) {
    const inputs = document.querySelectorAll(`input[name="${key}"][value="${value.replace(/"/g, '\\"')}"], input[name="mobile-${key}"][value="${value.replace(/"/g, '\\"')}"]`);
    inputs.forEach(input => {
      input.checked = false;
    });
    filterProducts();
  }

  function removePriceFilterChip() {
    ['price-min', 'price-max', 'mobile-price-min', 'mobile-price-max'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = "";
    });
    filterProducts();
  }

  function filterProducts() {
    const activeFilters = getSelectedFilters();
    const searchQuery = searchInput ? searchInput.value.toLowerCase().trim() : "";
    const sortEl = document.getElementById("sort-select");
    const sortBy = sortEl ? sortEl.value : "popularity";

    const minPriceInput = document.getElementById("price-min");
    const maxPriceInput = document.getElementById("price-max");
    const minPrice = minPriceInput && minPriceInput.value ? parseFloat(minPriceInput.value) : 0;
    const maxPrice = maxPriceInput && maxPriceInput.value ? parseFloat(maxPriceInput.value) : Infinity;

    let filtered = products.filter(product => {
      if (product.price < minPrice || product.price > maxPrice) {
        return false;
      }

      for (const filterKey in activeFilters) {
        const selectedValues = activeFilters[filterKey];
        if (selectedValues.length === 0) continue;

        let productValues = getProductValuesForKeyAll(product, filterKey);
        const hasMatch = productValues.some(val => selectedValues.includes(val));
        if (!hasMatch) {
          return false;
        }
      }

      if (searchQuery) {
        const matchesTitle = product.title.toLowerCase().includes(searchQuery);
        const matchesThickness = product.thickness ? product.thickness.toLowerCase().includes(searchQuery) : false;
        const matchesForm = product.form ? product.form.toLowerCase().includes(searchQuery) : false;
        if (!matchesTitle && !matchesThickness && !matchesForm) {
          return false;
        }
      }
      return true;
    });

    // Sort execution
    if (sortBy === "price-asc") {
      filtered.sort((a, b) => a.price - b.price);
    } else if (sortBy === "price-desc") {
      filtered.sort((a, b) => b.price - a.price);
    } else if (sortBy === "rating-desc") {
      filtered.sort((a, b) => getBayesianRating(b) - getBayesianRating(a));
    } else if (sortBy === "newest") {
      filtered.sort((a, b) => b.id - a.id);
    } else {
      filtered.sort((a, b) => b.popularity - a.popularity);
    }

    // Dynamic applied filters chips
    const appliedContainer = document.getElementById("applied-filters-container");
    const appliedList = document.getElementById("applied-filters-list");
    if (appliedContainer && appliedList) {
      appliedList.innerHTML = "";
      let hasActive = false;

      for (const key in activeFilters) {
        const vals = activeFilters[key];
        vals.forEach(val => {
          hasActive = true;
          const chip = document.createElement("div");
          chip.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-xs text-primary font-semibold transition-all";
          
          let displayKey = key.charAt(0).toUpperCase() + key.slice(1);
          if (key === 'tykkelse') displayKey = 'Tykkelse';
          else if (key === 'størrelse') displayKey = 'Bredde';
          else if (key === 'form') displayKey = 'Form';
          else if (key === 'farve') displayKey = 'Farve';
          else if (key === 'brand') displayKey = 'Brand';
          else if (key === 'rating') displayKey = 'Bedømmelse';

          let displayVal = val;
          if (key === 'rating') {
            displayVal = `${val} stjerner & derover`;
          }

          chip.innerHTML = `
            <span>${displayKey}: ${displayVal}</span>
            <button onclick="removeFilterChip('${key}', '${val.replace(/'/g, "\\'")}')" class="flex items-center justify-center hover:bg-accent/20 rounded-full w-4 h-4 cursor-pointer text-primary/80 transition-colors border-0 p-0 bg-transparent text-[10px]" aria-label="Fjern ${val}">
              <span class="material-symbols-outlined text-[10px]">close</span>
            </button>
          `;
          appliedList.appendChild(chip);
        });
      }

      const minVal = minPriceInput ? minPriceInput.value : "";
      const maxVal = maxPriceInput ? maxPriceInput.value : "";
      if (minVal || maxVal) {
        hasActive = true;
        const chip = document.createElement("div");
        chip.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-xs text-primary font-semibold transition-all";
        let text = "Pris: ";
        if (minVal && maxVal) text += `${minVal} - ${maxVal} Kr.`;
        else if (minVal) text += `Over ${minVal} Kr.`;
        else if (maxVal) text += `Under ${maxVal} Kr.`;

        chip.innerHTML = `
          <span>${text}</span>
          <button onclick="removePriceFilterChip()" class="flex items-center justify-center hover:bg-accent/20 rounded-full w-4 h-4 cursor-pointer text-primary/80 transition-colors border-0 p-0 bg-transparent text-[10px]" aria-label="Fjern prisfilter">
            <span class="material-symbols-outlined text-[10px]">close</span>
          </button>
        `;
        appliedList.appendChild(chip);
      }

      if (hasActive) {
        appliedContainer.classList.remove("hidden");
      } else {
        appliedContainer.classList.add("hidden");
      }
    }

    updateFilterCounts();
    renderProducts(filtered);
  }

