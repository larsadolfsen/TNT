{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: 0;
    padding-bottom: 0;
  }

  #product-grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, minmax(0, 1fr));
  }

  @media screen and (min-width: 768px) {
    #product-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet | default: 2 }}, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1024px) {
    #product-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 840px) {
    #shopify-section-{{ section.id }} {
      padding-top: 0;
      padding-bottom: 0;
    }
  }
{%- endstyle -%}

  {%- capture filters_html -%}
    {%- for filter in collection.filters -%}
      <div class="filter-block border-b border-outline-variant/40 pb-4 last:border-0">
        <div class="flex justify-between items-center cursor-pointer mb-3 mt-0 group/header" onclick="toggleFilterBlock(this)">
          <h3 class="text-sm font-semibold text-primary m-0 select-none font-sans">{{ filter.label }}</h3>
          {%- render 'icon', name: 'remove', class: 'text-sm select-none toggle-icon text-primary/60 group-hover/header:text-primary transition-colors' -%}
        </div>
        
        <div class="filter-content space-y-2">
          {%- case filter.type -%}
            {%- when 'list' or 'boolean' -%}
              {%- assign filter_label_down = filter.label | downcase -%}
              {%- if filter.presentation == 'swatch' or filter_label_down contains 'farve' or filter_label_down contains 'color' -%}
                <div class="flex flex-wrap gap-2.5 pt-1 filter-block-color">
                  {%- for value in filter.values -%}
                    <label class="relative group cursor-pointer filter-label select-none flex items-center justify-center" title="{{ value.label }}" data-color-name="{{ value.label }}">
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} class="filter-checkbox sr-only peer"/>
                      <div class="swatch-circle w-8 h-8 rounded-full border border-outline-variant/65 peer-checked:ring-2 peer-checked:ring-offset-2 peer-checked:ring-[var(--color-accent)]/80 transition-all flex items-center justify-center relative shadow-sm hover:scale-105">
                        {%- render 'icon', name: 'check', class: 'text-xs font-bold text-white hidden peer-checked:block select-none pointer-events-none', style: 'font-size: 14px;' -%}
                      </div>
                      <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-1 bg-surface-container-high text-primary text-[10px] font-semibold rounded-md opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none whitespace-nowrap shadow-md border border-outline-variant z-20">
                        {{ value.label }} <span class="filter-count text-[9px] text-primary/60 ml-0.5">({{ value.count }})</span>
                      </div>
                    </label>
                  {%- endfor -%}
                </div>
              {%- else -%}
                {%- for value in filter.values -%}
                  {%- liquid
                    assign display_val = value.label
                    assign val_label_down = value.label | downcase
                    if filter.label == 'størrelse' or filter.label == 'Størrelse' or filter.label == 'bredde' or filter.label == 'Bredde'
                      if val_label_down == '41x33 cm'
                        assign display_val = '41x33 cm (Dækkeserviet)'
                      endif
                    elsif filter.label == 'form' or filter.label == 'Form' or filter.label == 'type' or filter.label == 'Type'
                      if val_label_down == 'firkantet'
                        assign display_val = 'Firkantet (Rulle)'
                      elsif val_label_down == 'rund'
                        assign display_val = 'Rund skåret'
                      endif
                    endif
                  -%}
                  <label class="flex items-center gap-2 text-sm text-primary/85 cursor-pointer filter-label transition-all {% if value.count == 0 and value.active == false %}opacity-40 cursor-not-allowed pointer-events-none{% endif %}">
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %} class="filter-checkbox rounded border-outline-variant text-primary focus:ring-primary" {% if value.count == 0 and value.active == false %}disabled{% endif %}/>
                    <span>{{ display_val }} <span class="filter-count text-xs text-primary/60 ml-0.5">({{ value.count }})</span></span>
                  </label>
                {%- endfor -%}
              {%- endif -%}

            {%- when 'price_range' -%}
              <div class="flex items-center gap-2">
                {%- liquid
                  assign min_value = filter.min_value.value | money_without_currency | replace: '.', '' | replace: ',', '.'
                  assign max_value = filter.max_value.value | money_without_currency | replace: '.', '' | replace: ',', '.'
                  assign range_max = filter.range_max | money_without_currency | replace: '.', '' | replace: ',', '.'
                -%}
                <input type="number" name="{{ filter.min_value.param_name }}" id="price-min" placeholder="Min" value="{{ min_value }}" max="{{ range_max }}" class="w-full text-xs border border-outline-variant rounded-xl bg-surface-container py-2 px-3 text-primary price-filter-input" oninput="syncPriceFilters(this)"/>
                <span class="text-xs text-primary/85">-</span>
                <input type="number" name="{{ filter.max_value.param_name }}" id="price-max" placeholder="Maks" value="{{ max_value }}" max="{{ range_max }}" class="w-full text-xs border border-outline-variant rounded-xl bg-surface-container py-2 px-3 text-primary price-filter-input" oninput="syncPriceFilters(this)"/>
              </div>
          {%- endcase -%}
        </div>
      </div>
    {%- endfor -%}
  {%- endcapture -%}

  {%- liquid
    case section.settings.filter_width_desktop
      when 2
        assign filter_class = 'lg:col-span-2'
        assign product_class = 'lg:col-span-10'
      when 4
        assign filter_class = 'lg:col-span-4'
        assign product_class = 'lg:col-span-8'
      else
        assign filter_class = 'lg:col-span-3'
        assign product_class = 'lg:col-span-9'
    endcase
  -%}

  <!-- Main Layout Grid -->
  <div class="lg:grid lg:grid-cols-12 gap-[var(--grid-gap)] items-start">
    
    <!-- Desktop Sidebar Filters -->
    <aside class="hidden lg:block {{ filter_class }} bg-transparent sticky top-28 pr-6">
      <div class="flex items-center gap-2 pb-3.5 border-b border-outline-variant mb-5">
        {%- render 'icon', name: 'filter_list', class: 'text-lg text-primary select-none' -%}
        <h2 class="text-base font-semibold text-primary m-0 font-sans">Filtre</h2>
      </div>

      <div id="desktop-filters" class="space-y-6">
        {{ filters_html }}
      </div>
    </aside>

    <!-- Product Area -->
    <section class="{{ product_class }}">
      
      <!-- Mobile Controls & Info -->
      <div class="flex flex-col gap-4 mb-6">
        <div class="flex items-center justify-between">
          <div class="text-xs text-primary/85">
            Viser <span id="product-count-display" class="font-semibold text-primary">{{ collection.products_count }}</span> produkter
          </div>
          
          <div class="flex items-center gap-2">
            <div class="relative w-12 h-12 flex-shrink-0">
              <div class="absolute inset-0 flex flex-col items-center justify-center border border-outline-variant rounded-2xl bg-transparent text-primary pointer-events-none">
                {%- render 'icon', name: 'sort', class: 'text-lg' -%}
                <span class="text-[9px] font-semibold mt-0.5 leading-none">Sorter</span>
              </div>
              <select id="sort-select" onchange="filterProducts()" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer m-0 p-0 appearance-none" aria-label="Sortering">
                {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                {%- for option in collection.sort_options -%}
                  <option value="{{ option.value }}" {% if option.value == sort_by %}selected{% endif %}>{{ option.name }}</option>
                {%- endfor -%}
              </select>
            </div>

            <!-- Mobil Filter Knap -->
            <button onclick="toggleMobileFilter(true)" class="lg:hidden flex flex-col items-center justify-center border border-outline-variant rounded-2xl bg-transparent w-12 h-12 text-primary cursor-pointer p-0">
              {%- render 'icon', name: 'filter_list', class: 'text-lg' -%}
              <span class="text-[9px] font-semibold mt-0.5 leading-none">Filtrer</span>
            </button>
          </div>
        </div>

        <!-- Applied Filters Bar -->
        {%- assign has_active_filters = false -%}
        {%- for filter in collection.filters -%}
          {%- if filter.active_values.size > 0 or filter.min_value.value != blank or filter.max_value.value != blank -%}
            {%- assign has_active_filters = true -%}
          {%- endif -%}
        {%- endfor -%}

        <div id="applied-filters-container" class="flex flex-wrap gap-2 items-center {% unless has_active_filters %}hidden{% endunless %} border-t border-outline-variant/40 pt-3">
          <span class="text-xs font-bold text-primary/70 uppercase tracking-wider mr-1">Aktive filtre:</span>
          <div id="applied-filters-list" class="flex flex-wrap gap-1.5">
            {%- for filter in collection.filters -%}
              {%- for value in filter.active_values -%}
                <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-[11px] text-primary font-semibold transition-all">
                  <span>{{ filter.label }}: {{ value.label }}</span>
                  <a href="{{ value.url_to_remove }}" onclick="removeFilterChipUrl(event, this.href)" class="flex items-center justify-center hover:bg-accent/20 rounded-full w-4 h-4 cursor-pointer text-primary/80 transition-colors border-0 p-0 bg-transparent text-[10px]" aria-label="Fjern {{ value.label }}">
                    {%- render 'icon', name: 'close', class: 'text-[10px]' -%}
                  </a>
                </div>
              {%- endfor -%}
              {%- if filter.type == 'price_range' -%}
                {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
                  <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-[11px] text-primary font-semibold transition-all">
                    <span>
                      Pris: 
                      {%- if filter.min_value.value -%}{{ filter.min_value.value | money }}{%- else -%}0 Kr.{%- endif -%}
                      - 
                      {%- if filter.max_value.value -%}{{ filter.max_value.value | money }}{%- else -%}Maks{%- endif -%}
                    </span>
                    <a href="{{ filter.url_to_remove }}" onclick="removeFilterChipUrl(event, this.href)" class="flex items-center justify-center hover:bg-accent/20 rounded-full w-4 h-4 cursor-pointer text-primary/80 transition-colors border-0 p-0 bg-transparent text-[10px]" aria-label="Fjern prisfilter">
                      {%- render 'icon', name: 'close', class: 'text-[10px]' -%}
                    </a>
                  </div>
                {%- endif -%}
              {%- endif -%}
            {%- endfor -%}
          </div>
          <a href="{{ collection.url }}" onclick="clearAllFiltersUrl(event, this.href)" class="text-xs text-secondary hover:underline bg-transparent border-0 cursor-pointer p-0 ml-2 font-semibold no-underline">Ryd alle</a>
        </div>
      </div>

      <!-- Product Grid -->
      <div id="product-grid" class="grid gap-4 lg:gap-6 mt-4">
        {%- paginate collection.products by 24 -%}
          {%- for product in collection.products -%}
            {%- render 'product-card', product: product, layout: 'minimal', disable_reviews: section.settings.disable_reviews -%}
          {%- else -%}
            <div class="col-span-full py-12 text-center">
              {%- render 'icon', name: 'sentiment_dissatisfied', class: 'text-4xl text-primary/85 mb-2' -%}
              <p class="text-sm font-semibold text-primary">Ingen produkter matchede dine kriterier.</p>
            </div>
          {%- endfor -%}
          {%- if paginate.pages > 1 -%}
            {%- render 'pagination', paginate: paginate -%}
          {%- endif -%}
        {%- endpaginate -%}
      </div>
    </section>

  </div>

<!-- Mobile Filter Slide-out Drawer -->
<div id="mobile-filter-drawer" class="fixed inset-0 bg-black/50 z-[200] hidden flex justify-end transition-opacity duration-300 opacity-0">
  <div class="bg-card-light w-5/6 max-w-sm h-full flex flex-col justify-between shadow-2xl p-6 transition-transform duration-300 translate-x-full">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-outline-variant mb-6">
        <span class="font-sans text-xl font-bold text-primary tracking-tight">Filtrer produkter</span>
        <button onclick="toggleMobileFilter(false)" class="bg-transparent border-0 cursor-pointer" aria-label="Luk filtre">
          {%- render 'icon', name: 'close', class: 'text-2xl text-primary' -%}
        </button>
      </div>
      
      <div id="mobile-filters" class="space-y-6 overflow-y-auto max-h-[calc(100vh-200px)] pr-2 hide-scrollbar">
        {{ filters_html | replace: 'id="price-min"', 'id="mobile-price-min"' | replace: 'id="price-max"', 'id="mobile-price-max"' }}
      </div>
    </div>
    <div class="pt-4 border-t border-outline-variant">
      <a href="{{ collection.url }}" onclick="clearAllFiltersUrl(event, this.href)" class="block text-center py-3 border border-outline-variant rounded-xl text-xs font-bold text-primary bg-transparent cursor-pointer no-underline">Ryd alle</a>
    </div>
  </div>
</div>

<style>
  .material-symbols-outlined.filled-star {
    font-variation-settings: 'FILL' 1;
  }
</style>

{%- assign section_id_json = section.id | json -%}
<script type="application/json" id="main-collection-config">
  {"sectionId": {{ section_id_json }}}
</script>
<script src="{{ 'main-collection.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Kollektion Grid & Filtre",
  "class": "max-w-screen-xl mx-auto",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "disable_reviews",
      "label": "Deaktiver anmeldelser",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Antal kolonner på mobil",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Antal kolonner på tablet",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Antal kolonner på desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "filter_width_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Filterbredde på desktop (kolonner ud af 12)",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filter",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Filter overskrift",
          "default": "Filter"
        },
        {
          "type": "select",
          "id": "filter_type",
          "label": "Filter kildetype",
          "options": [
            { "value": "tag", "label": "Produkt Tag (f.eks. tykkelse:X)" },
            { "value": "option", "label": "Variant Option (f.eks. Størrelse)" },
            { "value": "price", "label": "Pris Range" }
          ],
          "default": "tag"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Søgenøgle / Præfiks",
          "info": "For tag: f.eks. 'tykkelse'. For option: f.eks. 'bredde'. (Udfyldes ikke for pris)",
          "default": "tykkelse"
        },
        {
          "type": "select",
          "id": "display_mapping",
          "label": "Visningsformat (Valgfrit)",
          "options": [
            { "value": "none", "label": "Standard (Vis rå værdi)" },
            { "value": "form", "label": "Form (Firkantet -> Rulle, Rund -> Rund skåret)" },
            { "value": "width", "label": "Bredde (41x33 cm -> Dækkeserviet)" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kollektion Grid & Filtre",
      "blocks": [
        {
          "type": "filter",
          "settings": {
            "title": "Tykkelse",
            "filter_type": "tag",
            "key": "tykkelse"
          }
        },
        {
          "type": "filter",
          "settings": {
            "title": "Størrelse / Bredde",
            "filter_type": "option",
            "key": "bredde",
            "display_mapping": "width"
          }
        },
        {
          "type": "filter",
          "settings": {
            "title": "Type / Form",
            "filter_type": "option",
            "key": "form",
            "display_mapping": "form"
          }
        },
        {
          "type": "filter",
          "settings": {
            "title": "Pris",
            "filter_type": "price"
          }
        }
      ]
    }
  ]
}
{% endschema %}
