  const productCountDisplay = document.getElementById("product-count-display");
  const searchInput = document.getElementById("search-input");
  
  let isInitialCountRun = true;

  // Initialize filters & sorting
  renderFilterBlocks();
  renderSortOptions();
  filterProducts();
  truncateFilterLists();
  
  // Disable initial count run check flag
  isInitialCountRun = false;

  window.onload = function() {
    isInitialCountRun = true;
    renderFilterBlocks();
    renderSortOptions();
    filterProducts();
    truncateFilterLists();
    isInitialCountRun = false;
  };

  // Dynamic color map from metafields
  const metafieldColorMap = {};
  products.forEach(p => {
    if (p.colors && p.colors.length > 0) {
      p.colors.forEach(c => {
        if (c.label) {
          const lKey = c.label.toLowerCase().trim();
          metafieldColorMap[lKey] = {
            color: c.color || '',
            image: c.image || ''
          };
        }
      });
    }
  });

  function isHexLight(color) {
    if (!color || typeof color !== 'string') return false;
    let hex = color.trim();
    if (hex.startsWith('#')) hex = hex.substring(1);
    if (hex.length === 3) {
      hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
    }
    if (hex.length !== 6) return false;
    const r = parseInt(hex.substring(0, 2), 16);
    const g = parseInt(hex.substring(2, 4), 16);
    const b = parseInt(hex.substring(4, 6), 16);
    const brightness = Math.sqrt(0.299 * (r * r) + 0.587 * (g * g) + 0.114 * (b * b));
    return brightness > 155;
  }

