{%- liquid
  # Dynamically extract all available filter values from the products of the collection in the backend (Liquid)
  assign thickness_list = ""
  assign width_list = ""
  assign form_list = ""

  paginate collection.products by 250
    for product in collection.products
      assign thickness = ''
      assign width = ''
      assign form = ''
      
      for tag in product.tags
        assign tag_down = tag | downcase
        if tag_down contains 'tykkelse:'
          assign thickness = tag | remove_first: 'tykkelse:' | remove_first: 'Tykkelse:' | strip
        elsif tag_down contains 'bredde:'
          assign width = tag | remove_first: 'bredde:' | remove_first: 'Bredde:' | strip
        elsif tag_down contains 'form:'
          assign form = tag | remove_first: 'form:' | remove_first: 'Form:' | strip
        endif
      endfor

      for option in product.options_with_values
        assign option_name = option.name | downcase
        if option_name contains 'tykkelse' or option_name contains 'thickness'
          assign thickness = option.values | first
        elsif option_name contains 'bredde' or option_name contains 'width' or option_name contains 'størrelse'
          assign width = option.values | first
        elsif option_name contains 'form' or option_name contains 'type'
          assign form = option.values | first
        endif
      endfor

      if thickness != blank
        assign check_thickness = thickness | prepend: '|' | append: '|'
        unless thickness_list contains check_thickness
          assign thickness_list = thickness_list | append: thickness | append: '|'
        endunless
      endif

      if width != blank
        assign check_width = width | prepend: '|' | append: '|'
        unless width_list contains check_width
          assign width_list = width_list | append: width | append: '|'
        endunless
      endif

      if form != blank
        assign check_form = form | prepend: '|' | append: '|'
        unless form_list contains check_form
          assign form_list = form_list | append: form | append: '|'
        endunless
      endif
    endfor
  endpaginate

  assign raw_thicknesses = thickness_list | split: '|' | compact
  assign raw_widths = width_list | split: '|' | compact
  assign raw_forms = form_list | split: '|' | compact

  # Clean/Fallback
  if raw_thicknesses == empty or raw_thicknesses.size == 0
    assign raw_thicknesses = "0,8 mm|1,2 mm|2,0 mm" | split: "|"
  endif
  if raw_widths == empty or raw_widths.size == 0
    assign raw_widths = "41x33 cm|80 cm|90 cm|100 cm|140 cm" | split: "|"
  endif
  if raw_forms == empty or raw_forms.size == 0
    assign raw_forms = "Firkantet|Rund|Dækkeserviet" | split: "|"
  endif

  # Numeric sort for thicknesses: "0,8 mm" -> padded key for sort e.g. "0008:0,8 mm"
  assign thickness_padded_list = ""
  for thick in raw_thicknesses
    if thick == blank
      continue
    endif
    assign thick_num_str = thick | replace: ',', '.' | split: ' ' | first
    assign thick_num = thick_num_str | plus: 0
    assign thick_num_int = thick_num | multiplied_by: 10 | plus: 0
    if thick_num_int < 10
      assign padded = "000" | append: thick_num_int
    elsif thick_num_int < 100
      assign padded = "00" | append: thick_num_int
    elsif thick_num_int < 1000
      assign padded = "0" | append: thick_num_int
    else
      assign padded = thick_num_int
    endif
    assign thickness_padded_list = thickness_padded_list | append: padded | append: ':' | append: thick | append: '|'
  endfor
  assign thickness_padded_arr = thickness_padded_list | split: '|' | sort
  assign thicknesses = ""
  for item in thickness_padded_arr
    if item == blank
      continue
    endif
    assign val = item | split: ':' | last
    assign thicknesses = thicknesses | append: val | append: '|'
  endfor
  assign thicknesses = thicknesses | split: '|' | compact

  # Numeric sort for widths: "41x33 cm" -> 41, "80 cm" -> 80
  assign width_padded_list = ""
  for wd in raw_widths
    if wd == blank
      continue
    endif
    if wd contains 'x'
      assign parts = wd | split: 'x'
      assign width_num_str = parts[0]
    else
      assign parts = wd | split: ' '
      assign width_num_str = parts[0]
    endif
    assign width_num = width_num_str | plus: 0
    if width_num < 10
      assign padded = "000" | append: width_num
    elsif width_num < 100
      assign padded = "00" | append: width_num
    elsif width_num < 1000
      assign padded = "0" | append: width_num
    else
      assign padded = width_num
    endif
    assign width_padded_list = width_padded_list | append: padded | append: ':' | append: wd | append: '|'
  endfor
  assign width_padded_arr = width_padded_list | split: '|' | sort
  assign widths = ""
  for item in width_padded_arr
    if item == blank
      continue
    endif
    assign val = item | split: ':' | last
    assign widths = widths | append: val | append: '|'
  endfor
  assign widths = widths | split: '|' | compact

  # Alphabetical sort for forms
  assign forms = raw_forms | sort
-%}
<div class="max-w-screen-xl mx-auto px-4 py-4">
  <!-- Main Layout Grid -->
  <div class="lg:grid lg:grid-cols-4 lg:gap-8 items-start">
    
    <!-- Desktop Sidebar Filters -->
    <aside class="hidden lg:block lg:col-span-1 bg-white p-5 border border-outline-variant rounded-2xl sticky top-28">
      <div class="flex justify-between items-center pb-4 border-b border-outline-variant mb-4">
        <h2 class="text-sm font-bold text-primary uppercase tracking-wider m-0">Filtrering</h2>
        <button onclick="clearAllFilters()" class="text-xs text-secondary hover:underline bg-transparent border-0 cursor-pointer p-0">Ryd alle</button>
      </div>

      <div class="space-y-6">
        {%- if section.settings.show_thickness_filter -%}
        <!-- Filter: Tykkelse -->
        <div>
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider mb-3 mt-0">Tykkelse</h3>
          <div class="space-y-2">
            {%- for thick in thicknesses -%}
              <label class="flex items-center gap-2 text-sm text-on-surface-variant cursor-pointer">
                <input type="checkbox" name="tykkelse" value="{{ thick | escape }}" onchange="syncFilters(this)" class="rounded border-outline-variant text-primary focus:ring-primary"/>
                <span>{{ thick }}</span>
              </label>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

        {%- if section.settings.show_width_filter -%}
        <!-- Filter: Bredde -->
        <div>
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider mb-3 mt-0">Størrelse / Bredde</h3>
          <div class="space-y-2">
            {%- for wd in widths -%}
              {%- liquid
                assign display_wd = wd
                if wd == '41x33 cm'
                  assign display_wd = '41x33 cm (Dækkeserviet)'
                endif
              -%}
              <label class="flex items-center gap-2 text-sm text-on-surface-variant cursor-pointer">
                <input type="checkbox" name="bredde" value="{{ wd | escape }}" onchange="syncFilters(this)" class="rounded border-outline-variant text-primary focus:ring-primary"/>
                <span>{{ display_wd }}</span>
              </label>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

        {%- if section.settings.show_form_filter -%}
        <!-- Filter: Form -->
        <div>
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider mb-3 mt-0">Type / Form</h3>
          <div class="space-y-2">
            {%- for fr in forms -%}
              {%- liquid
                assign display_fr = fr
                if fr == 'Firkantet'
                  assign display_fr = 'Firkantet (Rulle)'
                elsif fr == 'Rund'
                  assign display_fr = 'Rund skåret'
                endif
              -%}
              <label class="flex items-center gap-2 text-sm text-on-surface-variant cursor-pointer">
                <input type="checkbox" name="form" value="{{ fr | escape }}" onchange="syncFilters(this)" class="rounded border-outline-variant text-primary focus:ring-primary"/>
                <span>{{ display_fr }}</span>
              </label>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

        {%- if section.settings.show_price_filter -%}
        <!-- Filter: Pris -->
        <div>
          <h3 class="text-xs font-bold text-primary uppercase tracking-wider mb-3 mt-0">Pris</h3>
          <div class="flex items-center gap-2">
            <input type="number" id="price-min" placeholder="Min" class="w-full text-xs border border-outline-variant rounded-xl bg-surface-container py-2 px-3 text-primary focus:ring-1 focus:ring-primary focus:border-primary" oninput="syncPriceFilters(this)"/>
            <span class="text-xs text-on-surface-variant">-</span>
            <input type="number" id="price-max" placeholder="Maks" class="w-full text-xs border border-outline-variant rounded-xl bg-surface-container py-2 px-3 text-primary focus:ring-1 focus:ring-primary focus:border-primary" oninput="syncPriceFilters(this)"/>
          </div>
        </div>
        {%- endif -%}
      </div>
    </aside>

    <!-- Product Area -->
    <section class="lg:col-span-3">
      
      <!-- Mobile Controls & Info -->
      <div class="flex flex-col gap-4 mb-6">
        <div class="flex items-center justify-between">
          <div class="text-xs text-on-surface-variant">
            Viser <span id="product-count-display" class="font-semibold text-primary">0</span> produkter
          </div>
          
          <div class="flex items-center gap-2">
            <!-- Sortering -->
            <div class="relative">
              <select id="sort-select" onchange="filterProducts()" class="text-xs border border-outline-variant rounded-xl bg-surface-container py-2 pl-3 pr-8 focus:ring-1 focus:ring-primary focus:border-primary text-primary font-semibold cursor-pointer">
                <option value="popularity">Mest populære</option>
                <option value="price-asc">Pris: Lav til høj</option>
                <option value="price-desc">Pris: Høj til lav</option>
              </select>
            </div>

            <!-- Mobil Filter Knap -->
            <button onclick="toggleMobileFilter(true)" class="lg:hidden flex items-center gap-2 border border-outline-variant rounded-xl bg-surface-container py-2 px-3 text-xs text-primary font-semibold bg-transparent cursor-pointer">
              <span class="material-symbols-outlined text-sm">filter_list</span>
              Filtrer
            </button>
          </div>
        </div>
      </div>

      <!-- Product Grid -->
      <div id="product-grid" class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4 mt-4">
        <!-- Genereres via Javascript -->
      </div>
    </section>

  </div>
</div>

