{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 840px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

  <!-- Main Layout Grid -->
  <div class="lg:grid lg:grid-cols-4 lg:gap-8 items-start">
    
    <!-- Desktop Sidebar Filters -->
    <aside class="hidden lg:block lg:col-span-1 bg-card-light p-5 border border-outline-variant rounded-2xl sticky top-28">
      <div class="flex justify-between items-center pb-4 border-b border-outline-variant mb-4">
        <h2 class="text-sm font-bold text-primary uppercase tracking-wider m-0">Filtrering</h2>
        <button onclick="clearAllFilters()" class="text-xs text-secondary hover:underline bg-transparent border-0 cursor-pointer p-0">Ryd alle</button>
      </div>

      <div class="space-y-6">
        {%- for block in section.blocks -%}
          {%- liquid
            assign block_title = block.settings.title
            assign block_type = block.settings.filter_type
            assign block_key = block.settings.key | strip | downcase
            assign block_mapping = block.settings.display_mapping
            
            # Extract unique values for this filter from all products
            assign values_list_str = ""
          -%}
          
          {%- if block_type == 'price' -%}
            <!-- Filter: Pris -->
            <div {{ block.shopify_attributes }}>
              <h3 class="text-xs font-bold text-primary uppercase tracking-wider mb-3 mt-0">{{ block_title }}</h3>
              <div class="flex items-center gap-2">
                <input type="number" id="price-min" placeholder="Min" class="w-full text-xs border border-outline-variant rounded-xl bg-surface-container py-2 px-3 text-primary focus:ring-1 focus:ring-primary focus:border-primary" oninput="syncPriceFilters(this)"/>
                <span class="text-xs text-primary/85">-</span>
                <input type="number" id="price-max" placeholder="Maks" class="w-full text-xs border border-outline-variant rounded-xl bg-surface-container py-2 px-3 text-primary focus:ring-1 focus:ring-primary focus:border-primary" oninput="syncPriceFilters(this)"/>
              </div>
            </div>
            {%- continue -%}
          {%- endif -%}

          {%- paginate collection.products by 250 -%}
            {%- for product in collection.products -%}
              {%- liquid
                assign val = ""
                if block_type == 'tag'
                  for tag in product.tags
                    assign tag_down = tag | downcase
                    assign check_prefix = block_key | append: ':'
                    if tag_down contains check_prefix
                      assign val = tag | remove_first: check_prefix | strip
                      assign first_char = block_key | slice: 0 | upcase
                      assign rest = block_key | slice: 1, block_key.size
                      assign title_key = first_char | append: rest | append: ':'
                      assign val = val | remove_first: title_key | strip
                    endif
                  endfor
                elsif block_type == 'option'
                  for option in product.options_with_values
                    assign option_name = option.name | downcase
                    if option_name contains block_key
                      assign opt_index = forloop.index0
                      assign variant = product.first_available_variant | default: product.variants[0]
                      assign val = variant.options[opt_index]
                    endif
                  endfor
                endif

                if val != blank
                  assign check_val = val | prepend: '|' | append: '|'
                  unless values_list_str contains check_val
                    assign values_list_str = values_list_str | append: val | append: '|'
                  endunless
                endif
              -%}
            {%- endfor -%}
          {%- endpaginate -%}

          {%- liquid
            assign raw_values = values_list_str | split: '|' | compact
            
            # Fallbacks for empty collections
            if raw_values == empty or raw_values.size == 0
              if block_key contains 'tykkelse' or block_key contains 'thick'
                assign raw_values = "0,8 mm|1,2 mm|2,0 mm" | split: "|"
              elsif block_key contains 'bredde' or block_key contains 'width' or block_key contains 'størrelse' or block_key contains 'size'
                assign raw_values = "41x33 cm|80 cm|90 cm|100 cm|140 cm" | split: "|"
              elsif block_key contains 'form' or block_key contains 'type'
                assign raw_values = "Firkantet|Rund|Dækkeserviet" | split: "|"
              endif
            endif

            assign is_thickness = false
            assign is_width = false
            if block_key contains 'tykkelse' or block_key contains 'thick'
              assign is_thickness = true
            elsif block_key contains 'bredde' or block_key contains 'width' or block_key contains 'størrelse' or block_key contains 'size'
              assign is_width = true
            endif

            if is_thickness
              assign values_padded_list = ""
              for v in raw_values
                if v == blank
                  continue
                endif
                assign v_num_str = v | replace: ',', '.' | split: ' ' | first
                assign v_num = v_num_str | plus: 0
                assign v_num_int = v_num | times: 10 | plus: 0
                if v_num_int < 10
                  assign padded = "000" | append: v_num_int
                elsif v_num_int < 100
                  assign padded = "00" | append: v_num_int
                elsif v_num_int < 1000
                  assign padded = "0" | append: v_num_int
                else
                  assign padded = v_num_int
                endif
                assign values_padded_list = values_padded_list | append: padded | append: ':' | append: v | append: '|'
              endfor
              assign values_padded_arr = values_padded_list | split: '|' | sort
              assign sorted_values = ""
              for item in values_padded_arr
                if item == blank
                  continue
                endif
                assign real_val = item | split: ':' | last
                assign sorted_values = sorted_values | append: real_val | append: '|'
              endfor
              assign sorted_values = sorted_values | split: '|' | compact
            elsif is_width
              assign values_padded_list = ""
              for v in raw_values
                if v == blank
                  continue
                endif
                if v contains 'x'
                  assign parts = v | split: 'x'
                  assign v_num_str = parts[0]
                else
                  assign parts = v | split: ' '
                  assign v_num_str = parts[0]
                endif
                assign v_num = v_num_str | plus: 0
                if v_num < 10
                  assign padded = "000" | append: v_num
                elsif v_num < 100
                  assign padded = "00" | append: v_num
                elsif v_num < 1000
                  assign padded = "0" | append: v_num
                else
                  assign padded = v_num
                endif
                assign values_padded_list = values_padded_list | append: padded | append: ':' | append: v | append: '|'
              endfor
              assign values_padded_arr = values_padded_list | split: '|' | sort
              assign sorted_values = ""
              for item in values_padded_arr
                if item == blank
                  continue
                endif
                assign real_val = item | split: ':' | last
                assign sorted_values = sorted_values | append: real_val | append: '|'
              endfor
              assign sorted_values = sorted_values | split: '|' | compact
            else
              assign sorted_values = raw_values | sort
            endif
          -%}

          {%- if sorted_values.size > 0 -%}
            <!-- Filter: {{ block_title }} -->
            <div {{ block.shopify_attributes }}>
              <h3 class="text-xs font-bold text-primary uppercase tracking-wider mb-3 mt-0">{{ block_title }}</h3>
              <div class="space-y-2">
                {%- for val in sorted_values -%}
                  {%- liquid
                    assign display_val = val
                    if block_mapping == 'width' and val == '41x33 cm'
                      assign display_val = '41x33 cm (Dækkeserviet)'
                    elsif block_mapping == 'form'
                      if val == 'Firkantet'
                        assign display_val = 'Firkantet (Rulle)'
                      elsif val == 'Rund'
                        assign display_val = 'Rund skåret'
                      endif
                    endif
                  -%}
                  <label class="flex items-center gap-2 text-sm text-primary/85 cursor-pointer filter-label transition-all">
                    <input type="checkbox" name="{{ block_key }}" value="{{ val | escape }}" onchange="syncFilters(this)" class="filter-checkbox rounded border-outline-variant text-primary focus:ring-primary"/>
                    <span>{{ display_val }} <span class="filter-count text-xs text-primary/60 ml-0.5">(0)</span></span>
                  </label>
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </aside>

    <!-- Product Area -->
    <section class="lg:col-span-3">
      
      <!-- Mobile Controls & Info -->
      <div class="flex flex-col gap-4 mb-6">
        <div class="flex items-center justify-between">
          <div class="text-xs text-primary/85">
            Viser <span id="product-count-display" class="font-semibold text-primary">0</span> produkter
          </div>
          
          <div class="flex items-center gap-2">
            <!-- Sortering -->
            <div class="relative">
              <select id="sort-select" onchange="filterProducts()" class="text-xs border border-outline-variant rounded-xl bg-surface-container py-2 pl-3 pr-8 focus:ring-1 focus:ring-primary focus:border-primary text-primary font-semibold cursor-pointer">
                <option value="popularity">Mest populære</option>
                <option value="price-asc">Pris: Lav til høj</option>
                <option value="price-desc">Pris: Høj til lav</option>
                <option value="rating-desc">Brugerbedømmelse</option>
                <option value="newest">Nyeste</option>
              </select>
            </div>

            <!-- Mobil Filter Knap -->
            <button onclick="toggleMobileFilter(true)" class="lg:hidden flex items-center gap-2 border border-outline-variant rounded-xl bg-surface-container py-2 px-3 text-xs text-primary font-semibold bg-transparent cursor-pointer">
              <span class="material-symbols-outlined text-sm">filter_list</span>
              Filtrer
            </button>
          </div>
        </div>

        <!-- Applied Filters Bar -->
        <div id="applied-filters-container" class="flex flex-wrap gap-2 items-center hidden border-t border-outline-variant/40 pt-3">
          <span class="text-xs font-bold text-primary/70 uppercase tracking-wider mr-1">Aktive filtre:</span>
          <div id="applied-filters-list" class="flex flex-wrap gap-1.5"></div>
          <button onclick="clearAllFilters()" class="text-xs text-secondary hover:underline bg-transparent border-0 cursor-pointer p-0 ml-2 font-semibold">Ryd alle</button>
        </div>
      </div>

      <!-- Product Grid -->
      <div id="product-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-4 lg:gap-6 mt-4">
        <!-- Genereres via Javascript -->
      </div>
    </section>

  </div>

<!-- Mobile Filter Slide-out Drawer -->
