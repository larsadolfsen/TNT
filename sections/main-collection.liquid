  function updateFilterCounts() {
    const activeFilters = getSelectedFilters();
    const searchQuery = searchInput ? searchInput.value.toLowerCase().trim() : "";
    
    const minPriceInput = document.getElementById("price-min");
    const maxPriceInput = document.getElementById("price-max");
    const minPrice = minPriceInput && minPriceInput.value ? parseFloat(minPriceInput.value) : 0;
    const maxPrice = maxPriceInput && maxPriceInput.value ? parseFloat(maxPriceInput.value) : Infinity;

    const checkboxes = document.querySelectorAll('input.filter-checkbox');
    checkboxes.forEach(cb => {
      let name = cb.name;
      if (name.startsWith('mobile-')) {
        name = name.replace('mobile-', '');
      }
      const val = cb.value;

      const tempFilters = {};
      for (const k in activeFilters) {
        if (k !== name) {
          tempFilters[k] = activeFilters[k];
        }
      }

      let count = 0;
      products.forEach(product => {
        if (product.price < minPrice || product.price > maxPrice) return;

        if (searchQuery) {
          const matchesTitle = product.title.toLowerCase().includes(searchQuery);
          const matchesThickness = product.thickness ? product.thickness.toLowerCase().includes(searchQuery) : false;
          const matchesForm = product.form ? product.form.toLowerCase().includes(searchQuery) : false;
          if (!matchesTitle && !matchesThickness && !matchesForm) return;
        }

        for (const fk in tempFilters) {
          const selectedVals = tempFilters[fk];
          if (selectedVals.length === 0) continue;
          
          let pVals = getProductValuesForKeyAll(product, fk);
          const matchesTemp = pVals.some(v => selectedVals.includes(v));
          if (!matchesTemp) return;
        }

        let currentPVals = getProductValuesForKeyAll(product, name);
        if (currentPVals.includes(val)) {
          count++;
        }
      });

      const label = cb.closest('label');
      let countSpan = cb.parentNode.querySelector('.filter-count');
      if (countSpan) {
        countSpan.textContent = ` (${count})`;
      }

      if (count === 0) {
        if (isInitialCountRun) {
          cb.dataset.initialZero = "true";
          if (label) {
            label.style.display = "none";
          }
        }
        cb.disabled = true;
        if (label && !isInitialCountRun) {
          label.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
        }
      } else {
        cb.disabled = false;
        if (label) {
          label.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
          if (cb.dataset.initialZero !== "true") {
            label.style.display = ""; 
          }
        }
      }
    });
  }

</script>

