      'grøn': { bg: '#34c759', isLight: false },
      'groen': { bg: '#34c759', isLight: false },
      'green': { bg: '#34c759', isLight: false },
      'gul': { bg: '#ffcc00', isLight: true },
      'yellow': { bg: '#ffcc00', isLight: true },
      'orange': { bg: '#ff9500', isLight: false },
