  ];

  let rawCollectionProducts = [];
  try {
    rawCollectionProducts = JSON.parse(document.getElementById('collection-products-json').textContent);
  } catch(e) {
    console.warn("Could not parse collection-products-json", e);
  }

  // Fallback to mockup products if the current collection has 0 items
  const products = rawCollectionProducts.length > 0 ? rawCollectionProducts : mockProducts;

  const productGrid = document.getElementById("product-grid");
  const productCountDisplay = document.getElementById("product-count-display");
  const searchInput = document.getElementById("search-input");

  window.onload = function() {
    filterProducts();
  };

  function syncFilters(changedInput) {
    const name = changedInput.name;
    const value = changedInput.value;
    const isChecked = changedInput.checked;
    
    let counterpartName;
    if (name.startsWith('mobile-')) {
      counterpartName = name.replace('mobile-', '');
    } else {
      counterpartName = 'mobile-' + name;
    }

    const counterparts = document.querySelectorAll(`input[name="${counterpartName}"][value="${value}"]`);
    counterparts.forEach(el => el.checked = isChecked);

    filterProducts();
  }

  function getSelectedFilters() {
    const tykkelse = [...document.querySelectorAll('input[name="tykkelse"]:checked')].map(el => el.value);
    const bredde = [...document.querySelectorAll('input[name="bredde"]:checked')].map(el => el.value);
    const form = [...document.querySelectorAll('input[name="form"]:checked')].map(el => el.value);
    
    return { tykkelse, bredde, form };
  }

  function filterProducts() {
    const activeFilters = getSelectedFilters();
    const searchQuery = searchInput ? searchInput.value.toLowerCase().trim() : "";
    const sortBy = document.getElementById("sort-select").value;

    let filtered = products.filter(product => {
      if (activeFilters.tykkelse.length > 0 && !activeFilters.tykkelse.includes(product.thickness)) {
        return false;
      }
      if (activeFilters.bredde.length > 0 && !activeFilters.bredde.includes(product.width)) {
        return false;
      }
      if (activeFilters.form.length > 0 && !activeFilters.form.includes(product.form)) {
        return false;
      }
      if (searchQuery) {
        const matchesTitle = product.title.toLowerCase().includes(searchQuery);
        const matchesThickness = product.thickness.toLowerCase().includes(searchQuery);
        const matchesForm = product.form.toLowerCase().includes(searchQuery);
        if (!matchesTitle && !matchesThickness && !matchesForm) {
          return false;
        }
      }
      return true;
    });

    if (sortBy === "price-asc") {
      filtered.sort((a, b) => a.price - b.price);
    } else if (sortBy === "price-desc") {
      filtered.sort((a, b) => b.price - a.price);
    } else {
      filtered.sort((a, b) => b.popularity - a.popularity);
    }

    renderProducts(filtered);
  }

  function renderProducts(items) {
    if (!productGrid) return;
    productCountDisplay.innerText = items.length;
    productGrid.innerHTML = "";

    if (items.length === 0) {
      productGrid.innerHTML = `
        <div class="col-span-full py-12 text-center">
          <span class="material-symbols-outlined text-4xl text-on-surface-variant mb-2">sentiment_dissatisfied</span>
          <p class="text-sm font-semibold text-primary">Ingen produkter matchede dine kriterier.</p>
          <button onclick="clearAllFilters()" class="mt-4 text-xs text-secondary underline bg-transparent border-0 cursor-pointer">Ryd filtre</button>
        </div>
      `;
      return;
    }

    items.forEach(product => {
      let originalPriceHtml = "";
      if (product.originalPrice && product.originalPrice > product.price) {
        const displayOrig = product.originalPrice_formatted ? product.originalPrice_formatted : `Dkr ${product.originalPrice},-`;
        originalPriceHtml = `<span class="text-[8px] sm:text-[9px] text-on-surface-variant line-through leading-none mb-0.5">${displayOrig}</span>`;
      }

      let badgeHtml = "";
      if (product.badge) {
        badgeHtml = `<span class="absolute top-2 left-2 bg-primary text-white text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10">${product.badge}</span>`;
      } else if (product.originalPrice && product.originalPrice > product.price) {
        const savings = Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100);
        badgeHtml = `<span class="absolute top-2 left-2 bg-secondary text-white text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10">Spar ${savings}%</span>`;
      }

      const displayPrice = product.price_formatted ? product.price_formatted : `Dkr ${product.price},-`;

      // Determine if it is a meter-sold product
      const isMeterProduct = product.thickness || product.width || product.title.toLowerCase().includes("voksdug") || product.title.toLowerCase().includes("bordbeskytter");

      const cardHtml = `
        <div class="product-card flex flex-col bg-white border border-outline-variant rounded-2xl overflow-hidden hover:shadow-md hover:border-primary/40 transition-all duration-300 group relative">
          
          <!-- Image Zone -->
          <div class="relative w-full aspect-square flex-shrink-0 bg-surface-container overflow-hidden">
            <a href="${product.url}" class="block w-full h-full">
              <img 
                src="${product.image}" 
                alt="${product.title}" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                onerror="this.src='https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=400&q=80'"
                loading="lazy"
              />
            </a>
            ${badgeHtml}
          </div>

          <!-- Info Zone -->
          <div class="p-3 flex flex-col justify-between flex-1 min-w-0">
            <div class="space-y-1">
              <h3 class="font-sans text-xs sm:text-sm font-bold text-primary leading-tight hover:text-secondary mb-1">
                <a href="${product.url}" class="text-primary no-underline hover:text-secondary line-clamp-2">${product.title}</a>
              </h3>
              
              <!-- Rating: Single Star & Score -->
              <div class="flex items-center gap-1 text-[10px] text-secondary mt-1">
                <span class="material-symbols-outlined text-[12px] filled-star text-[#FFB800] select-none">star</span>
                <span class="font-bold text-primary">${product.rating}</span>
                <span class="text-on-surface-variant">(${product.reviews})</span>
              </div>
            </div>

            <!-- Price & Buy Button (No divider border) -->
            <div class="mt-3 space-y-3">
              <div class="flex items-center justify-between gap-2">
                <span class="text-[10px] sm:text-xs text-on-surface-variant leading-none">
                  ${isMeterProduct ? 'Pris pr. meter' : 'Pris'}
                </span>
                <div class="text-right flex flex-col items-end">
                  ${originalPriceHtml}
                  <span class="text-xs sm:text-sm md:text-base font-bold text-primary leading-none">
                    ${isMeterProduct ? 'Fra ' : ''}${displayPrice}
                  </span>
                </div>
              </div>

              <button onclick="window.addToCart(${product.id})" class="w-full bg-[#FFD814] hover:bg-[#e6c212] text-primary py-2 rounded-full flex items-center justify-center gap-1.5 transition-colors focus:outline-none text-[11px] sm:text-xs font-bold border-0 cursor-pointer" aria-label="Køb ${product.title}">
                <span>Køb</span>
              </button>
            </div>
          </div>

        </div>
      `;
      productGrid.insertAdjacentHTML("beforeend", cardHtml);
    });
  }

  function applyQuickFilter(type, value) {
    clearAllFilters(false);
    const inputs = document.querySelectorAll(`input[name="${type}"], input[name="mobile-${type}"]`);
    inputs.forEach(input => {
      if (input.value === value) {
        input.checked = true;
      }
    });
    filterProducts();
  }

  function clearAllFilters(shouldRender = true) {
    document.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
      checkbox.checked = false;
    });
    if (shouldRender) {
      filterProducts();
    }
  }

  function toggleMobileFilter(open) {
    const drawer = document.getElementById("mobile-filter-drawer");
    if (!drawer) return;
    const panel = drawer.querySelector("div");
    if (open) {
      drawer.classList.remove("hidden");
      setTimeout(() => {
        drawer.classList.remove("opacity-0");
        panel.classList.remove("translate-x-full");
      }, 10);
    } else {
      drawer.classList.add("opacity-0");
      panel.classList.add("translate-x-full");
      setTimeout(() => {
        drawer.classList.add("hidden");
      }, 300);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    const filterDrawer = document.getElementById("mobile-filter-drawer");
    if (filterDrawer) {
      filterDrawer.addEventListener("click", (e) => {
        if (e.target === filterDrawer) {
          toggleMobileFilter(false);
        }
      });
    }
  });

  window.syncFilters = syncFilters;
  window.filterProducts = filterProducts;
  window.applyQuickFilter = applyQuickFilter;
  window.clearAllFilters = clearAllFilters;
  window.toggleMobileFilter = toggleMobileFilter;
</script>

