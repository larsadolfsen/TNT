{%- liquid
  # Collection grid + sidebar/mobile filters. Composition only — filter-block
  # markup, toolbar, active-filter chips, product grid and the mobile drawer
  # each live in their own snippets/collection-*.liquid; behaviour (filter
  # toggling, price sync, drawer open/close) lives in assets/main-collection.js.
-%}

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: 0;
    padding-bottom: 0;
  }

  #product-grid {
    grid-template-columns: repeat({{ section.settings.columns_mobile | default: 2 }}, minmax(0, 1fr));
  }

  @media screen and (min-width: 768px) {
    #product-grid {
      grid-template-columns: repeat({{ section.settings.columns_tablet | default: 2 }}, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1024px) {
    #product-grid {
      grid-template-columns: repeat({{ section.settings.columns_desktop | default: 3 }}, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 840px) {
    #shopify-section-{{ section.id }} {
      padding-top: 0;
      padding-bottom: 0;
    }
  }
{%- endstyle -%}

  {%- capture filters_html -%}
    {%- render 'collection-filter-list', filters: collection.filters -%}
  {%- endcapture -%}

  {%- capture mobile_filters_html -%}
    {{- filters_html | replace: 'id="price-min"', 'id="mobile-price-min"' | replace: 'id="price-max"', 'id="mobile-price-max"' -}}
  {%- endcapture -%}

  {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}

  {%- liquid
    case section.settings.filter_width_desktop
      when 2
        assign filter_class = 'lg:col-span-2'
        assign product_class = 'lg:col-span-10'
      when 4
        assign filter_class = 'lg:col-span-4'
        assign product_class = 'lg:col-span-8'
      else
        assign filter_class = 'lg:col-span-3'
        assign product_class = 'lg:col-span-9'
    endcase
  -%}

  <!-- Main Layout Grid -->
  <div class="lg:grid lg:grid-cols-12 gap-[var(--grid-gap)] items-start">
    
    <!-- Desktop Sidebar Filters -->
    <aside class="hidden lg:block {{ filter_class }} bg-transparent sticky top-28 pr-6">
      <div class="flex items-center gap-2 pb-3.5 border-b border-outline-variant mb-5">
        {%- render 'icon', name: 'list-filter', class: 'text-lg text-primary select-none' -%}
        <h2 class="text-base font-semibold text-primary m-0 font-sans">Filtre</h2>
      </div>

      <div id="desktop-filters" class="space-y-6">
        {{ filters_html }}
      </div>
    </aside>

    <!-- Product Area -->
    <section class="{{ product_class }}">

      <!-- Mobile Controls & Info -->
      <div class="flex flex-col gap-4 mb-6">
        {%- render 'collection-toolbar', product_count: collection.products_count, sort_options: collection.sort_options, current_sort_by: sort_by -%}
        {%- render 'collection-active-filters', filters: collection.filters, collection_url: collection.url -%}
      </div>

      <!-- Product Grid -->
      <div id="product-grid" class="grid gap-4 lg:gap-6 mt-4">
        {%- render 'collection-product-grid', products: collection.products, disable_reviews: section.settings.disable_reviews -%}
      </div>
    </section>

  </div>

  {%- render 'collection-mobile-filter-drawer', filters_html: mobile_filters_html, collection_url: collection.url -%}

{%- liquid
  # Icons are captured here because icon.liquid can only be rendered at Liquid
  # compile time, not from the filter-toggle markup that
  # assets/main-collection.js builds at runtime — see .agents/AGENTS.md icon rule.
  capture icon_chevron_down_html
    render 'icon', name: 'chevron-down', class: 'text-xs'
  endcapture
  capture icon_chevron_up_html
    render 'icon', name: 'chevron-up', class: 'text-xs'
  endcapture
-%}
{%- assign section_id_json = section.id | json -%}
<script type="application/json" id="main-collection-config">
  {"sectionId": {{ section_id_json }}, "iconChevronDown": {{ icon_chevron_down_html | strip_newlines | json }}, "iconChevronUp": {{ icon_chevron_up_html | strip_newlines | json }}}
</script>
<script src="{{ 'main-collection.min.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Kollektion Grid & Filtre",
  "class": "max-w-screen-xl mx-auto",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "disable_reviews",
      "label": "Deaktiver anmeldelser",
      "default": false
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Antal kolonner på mobil",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Antal kolonner på tablet",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Antal kolonner på desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "filter_width_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Filterbredde på desktop (kolonner ud af 12)",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filter",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Filter overskrift",
          "default": "Filter"
        },
        {
          "type": "select",
          "id": "filter_type",
          "label": "Filter kildetype",
          "options": [
            { "value": "tag", "label": "Produkt Tag (f.eks. tykkelse:X)" },
            { "value": "option", "label": "Variant Option (f.eks. Størrelse)" },
            { "value": "price", "label": "Pris Range" }
          ],
          "default": "tag"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Søgenøgle / Præfiks",
          "info": "For tag: f.eks. 'tykkelse'. For option: f.eks. 'bredde'. (Udfyldes ikke for pris)",
          "default": "tykkelse"
        },
        {
          "type": "select",
          "id": "display_mapping",
          "label": "Visningsformat (Valgfrit)",
          "options": [
            { "value": "none", "label": "Standard (Vis rå værdi)" },
            { "value": "form", "label": "Form (Firkantet -> Rulle, Rund -> Rund skåret)" },
            { "value": "width", "label": "Bredde (41x33 cm -> Dækkeserviet)" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kollektion Grid & Filtre",
      "blocks": [
        {
          "type": "filter",
          "settings": {
            "title": "Tykkelse",
            "filter_type": "tag",
            "key": "tykkelse"
          }
        },
        {
          "type": "filter",
          "settings": {
            "title": "Størrelse / Bredde",
            "filter_type": "option",
            "key": "bredde",
            "display_mapping": "width"
          }
        },
        {
          "type": "filter",
          "settings": {
            "title": "Type / Form",
            "filter_type": "option",
            "key": "form",
            "display_mapping": "form"
          }
        },
        {
          "type": "filter",
          "settings": {
            "title": "Pris",
            "filter_type": "price"
          }
        }
      ]
    }
  ]
}
{% endschema %}
