{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 840px) {
    #shopify-section-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

  <!-- Main Layout Grid -->
  <div class="lg:grid lg:grid-cols-4 lg:gap-8 items-start">
    
    <!-- Desktop Sidebar Filters -->
    <aside class="hidden lg:block lg:col-span-1 bg-transparent sticky top-28 pr-6">
      <div class="flex items-center gap-2 pb-3.5 border-b border-outline-variant mb-5">
        <span class="material-symbols-outlined text-lg text-primary select-none">format_list_bulleted</span>
        <h2 class="text-base font-semibold text-primary m-0 font-sans">Filtre</h2>
      </div>

      <div id="desktop-filters" class="space-y-6">
        <!-- Generated dynamically in Javascript -->
      </div>
    </aside>

    <!-- Product Area -->
    <section class="lg:col-span-3">
      
      <!-- Mobile Controls & Info -->
      <div class="flex flex-col gap-4 mb-6">
        <div class="flex items-center justify-between">
          <div class="text-xs text-primary/85">
            Viser <span id="product-count-display" class="font-semibold text-primary">0</span> produkter
          </div>
          
          <div class="flex items-center gap-2">
            <!-- Sortering -->
            <div class="relative">
              <select id="sort-select" onchange="filterProducts()" class="text-xs border border-outline-variant rounded-xl bg-surface-container py-2 pl-3 pr-8 focus:ring-1 focus:ring-primary focus:border-primary text-primary font-semibold cursor-pointer">
                <!-- Generated dynamically in Javascript -->
              </select>
            </div>

            <!-- Mobil Filter Knap -->
            <button onclick="toggleMobileFilter(true)" class="lg:hidden flex items-center gap-2 border border-outline-variant rounded-xl bg-surface-container py-2 px-3 text-xs text-primary font-semibold bg-transparent cursor-pointer">
              <span class="material-symbols-outlined text-sm">filter_list</span>
              Filtrer
            </button>
          </div>
        </div>

        <!-- Applied Filters Bar -->
        <div id="applied-filters-container" class="flex flex-wrap gap-2 items-center hidden border-t border-outline-variant/40 pt-3">
          <span class="text-xs font-bold text-primary/70 uppercase tracking-wider mr-1">Aktive filtre:</span>
          <div id="applied-filters-list" class="flex flex-wrap gap-1.5"></div>
          <button onclick="clearAllFilters()" class="text-xs text-secondary hover:underline bg-transparent border-0 cursor-pointer p-0 ml-2 font-semibold">Ryd alle</button>
        </div>
      </div>

      <!-- Product Grid -->
      <div id="product-grid" class="grid grid-cols-2 md:grid-cols-4 gap-4 lg:gap-6 mt-4">
        <!-- Genereres via Javascript -->
      </div>
    </section>

  </div>

<!-- Mobile Filter Slide-out Drawer -->
<div id="mobile-filter-drawer" class="fixed inset-0 bg-black/50 z-50 hidden flex justify-end transition-opacity duration-300 opacity-0">
  <div class="bg-card-light w-5/6 max-w-sm h-full flex flex-col justify-between shadow-2xl p-6 transition-transform duration-300 translate-x-full">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-outline-variant mb-6">
        <span class="font-sans text-xl font-bold text-primary tracking-tight">Filtrer produkter</span>
        <button onclick="toggleMobileFilter(false)" class="material-symbols-outlined text-2xl text-primary bg-transparent border-0 cursor-pointer" aria-label="Luk filtre">close</button>
      </div>
      
      <div id="mobile-filters" class="space-y-6 overflow-y-auto max-h-[calc(100vh-200px)] pr-2 hide-scrollbar">
        <!-- Generated dynamically in Javascript -->
      </div>
    </div>
    <div class="pt-4 border-t border-outline-variant">
      <button onclick="clearAllFilters()" class="w-full py-3 border border-outline-variant rounded-xl text-xs font-bold text-primary bg-transparent cursor-pointer">Ryd alle</button>
    </div>
  </div>
</div>

<script id="collection-products-json" type="application/json">
  [
    {%- paginate collection.products by 250 -%}
      {%- for product in collection.products -%}
        {%- liquid
          assign thickness = ''
          assign width = ''
          assign form = ''
          assign badge = ''
          
          for tag in product.tags
            assign tag_down = tag | downcase
            if tag_down contains 'tykkelse:'
              assign thickness = tag | remove_first: 'tykkelse:' | remove_first: 'Tykkelse:' | strip
            elsif tag_down contains 'bredde:'
              assign width = tag | remove_first: 'bredde:' | remove_first: 'Bredde:' | strip
            elsif tag_down contains 'form:'
              assign form = tag | remove_first: 'form:' | remove_first: 'Form:' | strip
            elsif tag_down contains 'badge:'
              assign badge = tag | remove_first: 'badge:' | remove_first: 'Badge:' | strip
            endif
          endfor

          for option in product.options_with_values
            assign option_name = option.name | downcase
            if option_name contains 'tykkelse' or option_name contains 'thickness'
              assign thickness = option.values | first
            elsif option_name contains 'bredde' or option_name contains 'width' or option_name contains 'størrelse'
              assign width = option.values | first
            elsif option_name contains 'form' or option_name contains 'type'
              assign form = option.values | first
            endif
          endfor

          # Check if this is a meter product based on type, title, or tags/options
          assign is_meter_product = false
          assign product_title_down = product.title | downcase
          if product.type == 'Metervare' or product_title_down contains 'voksdug' or product_title_down contains 'bordbeskytter' or product_title_down contains 'meter' or thickness != blank or width != blank or form != blank
            assign is_meter_product = true
          endif

          # If it is a meter product, apply default fallbacks for missing values
          if is_meter_product
            if thickness == blank
              assign thickness = '1,2 mm'
            endif
            if width == blank
              assign width = '140 cm'
            endif
            if form == blank
              assign form = 'Firkantet'
            endif
          endif

          assign variant = product.first_available_variant | default: product.variants[0]
          
          assign display_price_cents = product.price
          assign display_original_price_cents = product.compare_at_price
          
          if product.type == 'Metervare'
            assign display_price_cents = product.price | times: 100
            if product.compare_at_price != blank and product.compare_at_price > 0
              assign display_original_price_cents = product.compare_at_price | times: 100
            endif
          endif

          assign price = display_price_cents | money_without_currency | replace: '.', '' | replace: ',', '.' | plus: 0
          assign originalPrice = display_original_price_cents | money_without_currency | replace: '.', '' | replace: ',', '.' | plus: 0
          if originalPrice == 0
            assign originalPrice = 'null'
          endif
        -%}
        {
          "id": {{ variant.id | json }},
          "title": {{ product.title | json }},
          "type": {{ product.type | json }},
          "vendor": {{ product.vendor | json }},
          "price": {{ price }},
          "price_formatted": {{ display_price_cents | money | json }},
          "originalPrice": {{ originalPrice }},
          "originalPrice_formatted": {% if originalPrice != 'null' %}{{ display_original_price_cents | money | json }}{% else %}null{% endif %},
          "image": {{ product.featured_image | image_url: width: 480 | json }},
          "url": {{ product.url | json }},
          "thickness": {{ thickness | json }},
          "width": {{ width | json }},
          "form": {{ form | json }},
          "badge": {{ badge | json }},
          "rating": {{ product.metafields.reviews.rating.value.rating | default: 4.8 | json }},
          "reviews": {{ product.metafields.reviews.rating_count.value | default: 12 | json }},
          "popularity": {{ forloop.index }},
          "tags": {{ product.tags | json }},
          "colors": [
            {%- for color_item in product.metafields.shopify['color-pattern'].value -%}
              {%- liquid
                assign label = color_item.label.value | default: color_item.label
                assign hex = color_item.farve.value | default: color_item.farve
                assign img_url = ''
                if color_item.billede.value != blank
                  assign img_url = color_item.billede.value | image_url: width: 80
                elsif color_item.billede != blank
                  assign img_url = color_item.billede | image_url: width: 80
                endif
              -%}
              {
                "label": {{ label | json }},
                "color": {{ hex | json }},
                "image": {{ img_url | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          "options": {
            {%- for option in product.options_with_values -%}
              {%- liquid
                assign opt_index = forloop.index0
                assign opt_val = variant.options[opt_index]
              -%}
              {{ option.name | json }}: {{ opt_val | json }}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          },
          "variants": [
            {%- for v in product.variants -%}
              {%- liquid
                assign v_display_price = v.price
                assign v_display_orig_price = v.compare_at_price
                
                if product.type == 'Metervare'
                  assign v_display_price = v.price | times: 100
                  if v.compare_at_price != blank and v.compare_at_price > 0
                    assign v_display_orig_price = v.compare_at_price | times: 100
                  endif
                endif

                assign v_price = v_display_price | money_without_currency | replace: '.', '' | replace: ',', '.' | plus: 0
                assign v_originalPrice = v_display_orig_price | money_without_currency | replace: '.', '' | replace: ',', '.' | plus: 0
                if v_originalPrice == 0
                  assign v_originalPrice = 'null'
                endif
              -%}
              {
                "id": {{ v.id | json }},
                "title": {{ v.title | json }},
                "available": {{ v.available | json }},
                "price": {{ v_price }},
                "price_formatted": {{ v_display_price | money | json }},
                "originalPrice": {{ v_originalPrice }},
                "originalPrice_formatted": {% if v_originalPrice != 'null' %}{{ v_display_orig_price | money | json }}{% else %}null{% endif %},
                "image": {% if v.featured_image != blank %}{{ v.featured_image | image_url: width: 480 | json }}{% else %}{{ product.featured_image | image_url: width: 480 | json }}{% endif %},
                "options": {
                  {%- for option in product.options_with_values -%}
                    {%- liquid
                      assign opt_index = forloop.index0
                      assign opt_val = v.options[opt_index]
                    -%}
                    {{ option.name | json }}: {{ opt_val | json }}{%- unless forloop.last -%},{%- endunless -%}
                  {%- endfor -%}
                }
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ],
          "options_with_values": [
            {%- for option in product.options_with_values -%}
              {
                "name": {{ option.name | json }},
                "values": {{ option.values | json }}
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    {%- endpaginate -%}
  ]
</script>

