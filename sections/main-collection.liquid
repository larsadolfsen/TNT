  function syncFilters(changedInput) {
    const name = changedInput.name;
    const value = changedInput.value;
    const isChecked = changedInput.checked;
    
    let counterpartName;
    if (name.startsWith('mobile-')) {
      counterpartName = name.replace('mobile-', '');
    } else {
      counterpartName = 'mobile-' + name;
    }

    const counterparts = document.querySelectorAll(`input[name="${counterpartName}"][value="${value}"]`);
    counterparts.forEach(el => el.checked = isChecked);

    filterProducts();
  }

  function syncPriceFilters(changedInput) {
    const id = changedInput.id;
    const val = changedInput.value;
    if (id === 'price-min') {
      const el = document.getElementById('mobile-price-min');
      if (el) el.value = val;
    } else if (id === 'price-max') {
      const el = document.getElementById('mobile-price-max');
      if (el) el.value = val;
    } else if (id === 'mobile-price-min') {
      const el = document.getElementById('price-min');
      if (el) el.value = val;
    } else if (id === 'mobile-price-max') {
      const el = document.getElementById('price-max');
      if (el) el.value = val;
    }
    filterProducts();
  }

  function getSelectedFilters() {
    const filters = {};
    const checkedCheckboxes = document.querySelectorAll('input.filter-checkbox:checked');
    checkedCheckboxes.forEach(cb => {
      let name = cb.name;
      if (name.startsWith('mobile-')) {
        name = name.replace('mobile-', '');
      }
      if (!filters[name]) {
        filters[name] = [];
      }
      if (!filters[name].includes(cb.value)) {
        filters[name].push(cb.value);
      }
    });
    return filters;
  }

  function removeFilterChip(key, value) {
    const inputs = document.querySelectorAll(`input[name="${key}"][value="${value}"], input[name="mobile-${key}"][value="${value}"]`);
    inputs.forEach(input => {
      input.checked = false;
    });
    filterProducts();
  }

  function removePriceFilterChip() {
    ['price-min', 'price-max', 'mobile-price-min', 'mobile-price-max'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = "";
    });
    filterProducts();
  }

  function getProductValueForKey(product, filterKey) {
    let productValue = "";
    if (filterKey === 'tykkelse') {
      productValue = product.thickness;
    } else if (filterKey === 'bredde') {
      productValue = product.width;
    } else if (filterKey === 'form') {
      productValue = product.form;
    }
    if (!productValue) {
      const tagPrefix = filterKey.toLowerCase() + ":";
      if (product.tags) {
        const matchingTag = product.tags.find(t => t.toLowerCase().startsWith(tagPrefix));
        if (matchingTag) {
          productValue = matchingTag.substring(tagPrefix.length).trim();
        }
      }
    }
    if (!productValue && product.options) {
      const optName = Object.keys(product.options).find(k => k.toLowerCase().includes(filterKey.toLowerCase()));
      if (optName) {
        productValue = product.options[optName];
      }
    }
    return productValue;
  }

  function updateFilterCounts() {
    const activeFilters = getSelectedFilters();
    const searchQuery = searchInput ? searchInput.value.toLowerCase().trim() : "";
    
    const minPriceInput = document.getElementById("price-min");
    const maxPriceInput = document.getElementById("price-max");
    const minPrice = minPriceInput && minPriceInput.value ? parseFloat(minPriceInput.value) : 0;
    const maxPrice = maxPriceInput && maxPriceInput.value ? parseFloat(maxPriceInput.value) : Infinity;

    const checkboxes = document.querySelectorAll('input.filter-checkbox');
    checkboxes.forEach(cb => {
      let name = cb.name;
      if (name.startsWith('mobile-')) {
        name = name.replace('mobile-', '');
      }
      const val = cb.value;

      const tempFilters = {};
      for (const k in activeFilters) {
        if (k !== name) {
          tempFilters[k] = activeFilters[k];
        }
      }

      let count = 0;
      products.forEach(product => {
        if (product.price < minPrice || product.price > maxPrice) return;

        if (searchQuery) {
          const matchesTitle = product.title.toLowerCase().includes(searchQuery);
          const matchesThickness = product.thickness ? product.thickness.toLowerCase().includes(searchQuery) : false;
          const matchesForm = product.form ? product.form.toLowerCase().includes(searchQuery) : false;
          if (!matchesTitle && !matchesThickness && !matchesForm) return;
        }

        for (const fk in tempFilters) {
          const selectedVals = tempFilters[fk];
          if (selectedVals.length === 0) continue;
          
          let pVal = getProductValueForKey(product, fk);
          if (!pVal || !selectedVals.includes(pVal)) return;
        }

        let currentPVal = getProductValueForKey(product, name);
        if (currentPVal === val) {
          count++;
        }
      });

      const label = cb.closest('label');
      let countSpan = cb.parentNode.querySelector('.filter-count');
      if (countSpan) {
        countSpan.textContent = ` (${count})`;
      }

      if (count === 0 && !cb.checked) {
        cb.disabled = true;
        if (label) {
          label.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
        }
      } else {
        cb.disabled = false;
        if (label) {
          label.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
        }
      }
    });
  }

  function truncateFilterLists() {
    const filterContainers = document.querySelectorAll('.space-y-6 > div > div.space-y-2, #mobile-filter-drawer .space-y-6 > div > div.space-y-2');
    filterContainers.forEach(container => {
      const labels = container.querySelectorAll('label');
      if (labels.length > 8) {
        for (let i = 8; i < labels.length; i++) {
          labels[i].classList.add('hidden', 'truncated-filter-option');
        }

        const toggleBtn = document.createElement('button');
        toggleBtn.type = 'button';
        toggleBtn.className = 'text-xs text-secondary hover:underline bg-transparent border-0 cursor-pointer p-0 mt-2 font-semibold flex items-center gap-1';
        toggleBtn.innerHTML = `<span>Vis flere (+${labels.length - 8})</span><span class="material-symbols-outlined text-xs">keyboard_arrow_down</span>`;
        
        toggleBtn.onclick = function() {
          const isExpanded = toggleBtn.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            for (let i = 8; i < labels.length; i++) {
              labels[i].classList.add('hidden');
            }
            toggleBtn.setAttribute('aria-expanded', 'false');
            toggleBtn.innerHTML = `<span>Vis flere (+${labels.length - 8})</span><span class="material-symbols-outlined text-xs">keyboard_arrow_down</span>`;
          } else {
            for (let i = 8; i < labels.length; i++) {
              labels[i].classList.remove('hidden');
            }
            toggleBtn.setAttribute('aria-expanded', 'true');
            toggleBtn.innerHTML = `<span>Vis færre</span><span class="material-symbols-outlined text-xs">keyboard_arrow_up</span>`;
          }
        };

        container.appendChild(toggleBtn);
      }
    });
  }

  // Bayesian rating index formula
  function getBayesianRating(p) {
    const r = p.rating || 0;
    const v = p.reviews || 0;
    const K = 5; 
    const C = 4.5;
    return (v / (v + K)) * r + (K / (v + K)) * C;
  }

  function filterProducts() {
    const activeFilters = getSelectedFilters();
    const searchQuery = searchInput ? searchInput.value.toLowerCase().trim() : "";
    const sortEl = document.getElementById("sort-select");
    const sortBy = sortEl ? sortEl.value : "popularity";

    const minPriceInput = document.getElementById("price-min");
    const maxPriceInput = document.getElementById("price-max");
    const minPrice = minPriceInput && minPriceInput.value ? parseFloat(minPriceInput.value) : 0;
    const maxPrice = maxPriceInput && maxPriceInput.value ? parseFloat(maxPriceInput.value) : Infinity;

    let filtered = products.filter(product => {
      if (product.price < minPrice || product.price > maxPrice) {
        return false;
      }

      for (const filterKey in activeFilters) {
        const selectedValues = activeFilters[filterKey];
        if (selectedValues.length === 0) continue;

        let productValue = getProductValueForKey(product, filterKey);
        if (!productValue || !selectedValues.includes(productValue)) {
          return false;
        }
      }

      if (searchQuery) {
        const matchesTitle = product.title.toLowerCase().includes(searchQuery);
        const matchesThickness = product.thickness ? product.thickness.toLowerCase().includes(searchQuery) : false;
        const matchesForm = product.form ? product.form.toLowerCase().includes(searchQuery) : false;
        if (!matchesTitle && !matchesThickness && !matchesForm) {
          return false;
        }
      }
      return true;
    });

    // Sort execution
    if (sortBy === "price-asc") {
      filtered.sort((a, b) => a.price - b.price);
    } else if (sortBy === "price-desc") {
      filtered.sort((a, b) => b.price - a.price);
    } else if (sortBy === "rating-desc") {
      filtered.sort((a, b) => getBayesianRating(b) - getBayesianRating(a));
    } else if (sortBy === "newest") {
      filtered.sort((a, b) => b.id - a.id);
    } else {
      filtered.sort((a, b) => b.popularity - a.popularity);
    }

    // Dynamic mobile apply button text
    const mobileApplyBtn = document.getElementById("mobile-apply-btn");
    if (mobileApplyBtn) {
      mobileApplyBtn.textContent = `Vis ${filtered.length} resultater`;
    }

    // Dynamic applied filters chips
    const appliedContainer = document.getElementById("applied-filters-container");
    const appliedList = document.getElementById("applied-filters-list");
    if (appliedContainer && appliedList) {
      appliedList.innerHTML = "";
      let hasActive = false;

      for (const key in activeFilters) {
        const vals = activeFilters[key];
        vals.forEach(val => {
          hasActive = true;
          const chip = document.createElement("div");
          chip.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-xs text-primary font-semibold transition-all";
          
          let displayKey = key.charAt(0).toUpperCase() + key.slice(1);
          if (key === 'tykkelse') displayKey = 'Tykkelse';
          else if (key === 'bredde') displayKey = 'Bredde';
          else if (key === 'form') displayKey = 'Form';

          chip.innerHTML = `
            <span>${displayKey}: ${val}</span>
            <button onclick="removeFilterChip('${key}', '${val.replace(/'/g, "\\'")}')" class="flex items-center justify-center hover:bg-accent/20 rounded-full w-4 h-4 cursor-pointer text-primary/80 transition-colors border-0 p-0 bg-transparent text-[10px]" aria-label="Fjern ${val}">
              <span class="material-symbols-outlined text-[10px]">close</span>
            </button>
          `;
          appliedList.appendChild(chip);
        });
      }

      const minVal = minPriceInput ? minPriceInput.value : "";
      const maxVal = maxPriceInput ? maxPriceInput.value : "";
      if (minVal || maxVal) {
        hasActive = true;
        const chip = document.createElement("div");
        chip.className = "inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-accent/10 border border-accent/20 text-xs text-primary font-semibold transition-all";
        let text = "Pris: ";
        if (minVal && maxVal) text += `${minVal} - ${maxVal} Kr.`;
        else if (minVal) text += `Over ${minVal} Kr.`;
        else if (maxVal) text += `Under ${maxVal} Kr.`;

        chip.innerHTML = `
          <span>${text}</span>
          <button onclick="removePriceFilterChip()" class="flex items-center justify-center hover:bg-accent/20 rounded-full w-4 h-4 cursor-pointer text-primary/80 transition-colors border-0 p-0 bg-transparent text-[10px]" aria-label="Fjern prisfilter">
            <span class="material-symbols-outlined text-[10px]">close</span>
          </button>
        `;
        appliedList.appendChild(chip);
      }

      if (hasActive) {
        appliedContainer.classList.remove("hidden");
      } else {
        appliedContainer.classList.add("hidden");
      }
    }

    // Update checkbox counts dynamically
    updateFilterCounts();

    renderProducts(filtered);
  }

  function renderProducts(items) {
    if (!productGrid) return;
    if (productCountDisplay) {
      productCountDisplay.innerText = items.length;
    }
    productGrid.innerHTML = "";

    if (items.length === 0) {
      productGrid.innerHTML = `
        <div class="col-span-full py-12 text-center">
          <span class="material-symbols-outlined text-4xl text-primary/85 mb-2">sentiment_dissatisfied</span>
          <p class="text-sm font-semibold text-primary">Ingen produkter matchede dine kriterier.</p>
          <button onclick="clearAllFilters()" class="mt-4 text-xs text-secondary underline bg-transparent border-0 cursor-pointer">Ryd filtre</button>
        </div>
      `;
      return;
    }

    items.forEach(product => {
      let originalPriceHtml = "";
      if (product.originalPrice && product.originalPrice > product.price) {
        const displayOrig = product.originalPrice_formatted ? product.originalPrice_formatted : `${product.originalPrice.toFixed(2).replace('.', ',')} Kr.`;
        originalPriceHtml = `<span class="text-[8px] sm:text-[9px] text-primary/70 line-through leading-none">${displayOrig}</span>`;
      }

      let badgeHtml = "";
      if (product.badge) {
        badgeHtml = `<span class="absolute top-2 left-2 bg-primary text-on-primary text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10">${product.badge}</span>`;
      } else if (product.originalPrice && product.originalPrice > product.price) {
        const savings = Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100);
        badgeHtml = `<span class="absolute top-2 left-2 bg-secondary text-on-accent text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10">Spar ${savings}%</span>`;
      }

      const displayPrice = product.price_formatted ? product.price_formatted : `${product.price.toFixed(2).replace('.', ',')} Kr.`;

      const isMetervare = product.type === "Metervare";
      const isMeterProduct = product.thickness || product.width || product.title.toLowerCase().includes("voksdug") || product.title.toLowerCase().includes("bordbeskytter");

      let swatchesHtml = "";
      if (product.options_with_values && product.options_with_values.length > 0 && product.variants && product.variants.length > 1) {
        swatchesHtml = `<div class="product-variant-swatches mt-3 space-y-2 border-t border-outline-variant/40 pt-2">`;
        
        product.options_with_values.forEach(opt => {
          const optNameLower = opt.name.toLowerCase();
          const isColor = optNameLower.includes("farve") || optNameLower.includes("mønster") || optNameLower.includes("color") || optNameLower.includes("colour");
          
          swatchesHtml += `
            <div class="flex flex-col gap-0.5">
              <span class="text-[9px] font-bold text-primary/70 uppercase tracking-wider">${opt.name}: <span class="text-primary font-semibold font-sans normal-case text-[10px]" data-selected-option-label="${product.id}-${opt.name}">${product.options[opt.name] || opt.values[0]}</span></span>
              <div class="flex flex-wrap gap-1 mt-0.5">
          `;
          
          opt.values.forEach(val => {
            const isSelected = (product.options[opt.name] === val);
            
            if (isColor) {
              const matchingVar = product.variants.find(v => v.options[opt.name] === val) || product.variants[0];
              const swatchImg = matchingVar.image || product.image;
              const activeBorderClass = isSelected ? "border-[var(--color-accent)] ring-2 ring-[var(--color-accent)]/30" : "border-outline-variant hover:border-[var(--color-accent)]/60";
              swatchesHtml += `
                <button 
                  type="button"
                  class="w-7 h-7 sm:w-9 sm:h-9 rounded-lg overflow-hidden border-2 bg-card-high shadow-sm p-0.5 cursor-pointer transition-all ${activeBorderClass}"
                  data-product-id="${product.id}"
                  data-option-name="${opt.name}"
                  data-option-value="${val}"
                  onclick="window.onCardVariantChange(this)"
                  title="${val}"
                >
                  <img src="${swatchImg}" alt="${val}" class="w-full h-full object-cover rounded-[5px]" />
                </button>
              `;
            } else {
              const activeTextClass = isSelected ? "border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold" : "border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80";
              swatchesHtml += `
                <button 
                  type="button"
                  class="px-2 py-0.5 text-[9px] sm:text-[11px] rounded-lg border-2 bg-card-high shadow-sm cursor-pointer transition-all ${activeTextClass}"
                  data-product-id="${product.id}"
                  data-option-name="${opt.name}"
                  data-option-value="${val}"
                  onclick="window.onCardVariantChange(this)"
                >
                  ${val}
                </button>
              `;
            }
          });
          
          swatchesHtml += `
              </div>
            </div>
          `;
        });
        
        swatchesHtml += `</div>`;
      }

      const cardHtml = `
        <div class="product-card flex flex-col bg-card-light border border-outline-variant rounded-2xl overflow-hidden hover:shadow-md hover:border-primary/40 transition-all duration-300 group relative max-h-[420px] sm:max-h-none" data-product-id="${product.id}">
          
          <!-- Image Zone -->
          <div class="relative w-full flex-shrink-0 bg-surface-container overflow-hidden" style="aspect-ratio: 1/1;">
            <a href="${product.url}" class="block w-full h-full">
              <img 
                src="${product.image}" 
                alt="${product.title}" 
                class="product-card-image w-full h-full object-cover group-hover:scale-105 transition-all duration-300"
                onerror="this.src='https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?auto=format&fit=crop&w=400&q=80'"
                loading="lazy"
              />
            </a>
            ${badgeHtml}
          </div>

          <!-- Info Zone -->
          <div class="p-3 flex flex-col justify-between flex-1 min-w-0">
            <div class="space-y-1">
              <h3 class="font-sans text-xs sm:text-sm font-bold text-primary leading-tight hover:text-secondary mb-1">
                <a href="${product.url}" class="text-primary no-underline hover:text-secondary line-clamp-2">${product.title}</a>
              </h3>
              
              <!-- Rating: 5 Stars -->
              <div class="flex items-center gap-1 text-[10px] text-secondary mt-1">
                <div class="flex text-[#FFB800] gap-0.5">
                  ${(() => {
                    let starsHtml = "";
                    const ratingFloor = Math.floor(product.rating);
                    const decimal = product.rating - ratingFloor;
                    for (let i = 1; i <= 5; i++) {
                      if (i <= ratingFloor) {
                        starsHtml += `<span class="material-symbols-outlined text-[12px] filled-star select-none" style="font-size: 12px; line-height: 1;">star</span>`;
                      } else if (i === ratingFloor + 1) {
                        if (decimal >= 0.75) {
                          starsHtml += `<span class="material-symbols-outlined text-[12px] filled-star select-none" style="font-size: 12px; line-height: 1;">star</span>`;
                        } else if (decimal >= 0.25) {
                          starsHtml += `<span class="material-symbols-outlined text-[12px] filled-star select-none" style="font-size: 12px; line-height: 1;">star_half</span>`;
                        } else {
                          starsHtml += `<span class="material-symbols-outlined text-[12px] text-outline-variant select-none" style="font-size: 12px; line-height: 1;">star</span>`;
                        }
                      } else {
                        starsHtml += `<span class="material-symbols-outlined text-[12px] text-outline-variant select-none" style="font-size: 12px; line-height: 1;">star</span>`;
                      }
                    }
                    return starsHtml;
                  })()}
                </div>
                <span class="font-bold text-primary ml-1">${product.rating}</span>
                <span class="text-primary/85">(${product.reviews})</span>
              </div>

              ${swatchesHtml}
            </div>

            <!-- Price & Buy Button (No divider border) -->
            <div class="mt-3 space-y-3">
              <div class="flex flex-col items-start gap-0.5">
                <div class="flex items-baseline gap-1.5 flex-wrap">
                  <span class="text-xs sm:text-sm md:text-base font-bold text-primary leading-none">
                    ${displayPrice}
                  </span>
                  ${originalPriceHtml}
                  <span class="text-[9px] sm:text-[10px] text-primary/75 font-semibold">
                    ${isMetervare ? 'pr. meter' : (isMeterProduct ? 'pr. cm' : '')}
                  </span>
                </div>
              </div>

              <button onclick="window.addToCart(${product.variants && product.variants.length > 0 ? product.variants[0].id : product.id})" class="w-full bg-accent hover:brightness-95 text-primary py-2 rounded-full flex items-center justify-center gap-1.5 transition-colors focus:outline-none text-[11px] sm:text-xs font-bold border-0 cursor-pointer" aria-label="Køb ${product.title}">
                <span>Køb</span>
              </button>
            </div>
          </div>

        </div>
      `;
      productGrid.insertAdjacentHTML("beforeend", cardHtml);
    });
  }

  // Handle switching variant on product card
  window.onCardVariantChange = function(buttonEl) {
    const productId = parseInt(buttonEl.dataset.productId);
    const optionName = buttonEl.dataset.optionName;
    const optionValue = buttonEl.dataset.optionValue;
    
    const cardEl = buttonEl.closest('.product-card');
    if (!cardEl) return;
    
    const product = products.find(p => p.id === productId);
    if (!product) return;

    const optionButtons = Array.from(cardEl.querySelectorAll('button[data-option-name]')).filter(btn => btn.dataset.optionName === optionName);
    optionButtons.forEach(btn => {
      const isColor = btn.querySelector('img') !== null;
      const val = btn.dataset.optionValue;
      const isSelected = (val === optionValue);
      
      if (isColor) {
        if (isSelected) {
          btn.className = "w-7 h-7 sm:w-9 sm:h-9 rounded-lg overflow-hidden border-2 bg-card-high shadow-sm p-0.5 cursor-pointer transition-all border-[var(--color-accent)] ring-2 ring-[var(--color-accent)]/30";
        } else {
          btn.className = "w-7 h-7 sm:w-9 sm:h-9 rounded-lg overflow-hidden border-2 bg-card-high shadow-sm p-0.5 cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60";
        }
      } else {
        if (isSelected) {
          btn.className = "px-2 py-0.5 text-[9px] sm:text-[11px] rounded-lg border-2 bg-card-high shadow-sm cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold";
        } else {
          btn.className = "px-2 py-0.5 text-[9px] sm:text-[11px] rounded-lg border-2 bg-card-high shadow-sm cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80";
        }
      }
    });

    const labelSpan = Array.from(cardEl.querySelectorAll('[data-selected-option-label]')).find(span => span.dataset.selectedOptionLabel === `${productId}-${optionName}`);
    if (labelSpan) {
      labelSpan.textContent = optionValue;
    }

    const activeOptions = {};
    const selectedButtons = Array.from(cardEl.querySelectorAll('.product-variant-swatches button')).filter(btn => btn.classList.contains('border-[var(--color-accent)]'));
    selectedButtons.forEach(btn => {
      activeOptions[btn.dataset.optionName] = btn.dataset.optionValue;
    });

    product.options_with_values.forEach(opt => {
      if (!activeOptions[opt.name]) {
        activeOptions[opt.name] = product.options[opt.name];
      }
    });

    let matchingVariant = product.variants.find(v => {
      return Object.entries(activeOptions).every(([name, val]) => {
        return v.options[name] === val;
      });
    });

    if (!matchingVariant) {
      matchingVariant = product.variants.find(v => v.options[optionName] === optionValue);
      
      if (matchingVariant) {
        product.options_with_values.forEach(opt => {
          const matchingVal = matchingVariant.options[opt.name];
          const labelSpanToUpdate = Array.from(cardEl.querySelectorAll('[data-selected-option-label]')).find(span => span.dataset.selectedOptionLabel === `${productId}-${opt.name}`);
          if (labelSpanToUpdate) {
            labelSpanToUpdate.textContent = matchingVal;
          }
          
          const optBtns = Array.from(cardEl.querySelectorAll('button[data-option-name]')).filter(btn => btn.dataset.optionName === opt.name);
          optBtns.forEach(btn => {
            const isColor = btn.querySelector('img') !== null;
            const val = btn.dataset.optionValue;
            const isSelected = (val === matchingVal);
            
            if (isColor) {
              if (isSelected) {
                btn.className = "w-7 h-7 sm:w-9 sm:h-9 rounded-lg overflow-hidden border-2 bg-card-high shadow-sm p-0.5 cursor-pointer transition-all border-[var(--color-accent)] ring-2 ring-[var(--color-accent)]/30";
              } else {
                btn.className = "w-7 h-7 sm:w-9 sm:h-9 rounded-lg overflow-hidden border-2 bg-card-high shadow-sm p-0.5 cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60";
              }
            } else {
              if (isSelected) {
                btn.className = "px-2 py-0.5 text-[9px] sm:text-[11px] rounded-lg border-2 bg-card-high shadow-sm cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold";
              } else {
                btn.className = "px-2 py-0.5 text-[9px] sm:text-[11px] rounded-lg border-2 bg-card-high shadow-sm cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80";
              }
            }
          });
        });
      }
    }

    if (matchingVariant) {
      // 1. Update card image with fade transition
      const imgEl = cardEl.querySelector('.product-card-image');
      if (imgEl) {
        imgEl.style.opacity = '0.3';
        setTimeout(() => {
          imgEl.src = matchingVariant.image;
          imgEl.style.opacity = '1';
        }, 100);
      }

      // 2. Update price display
      const priceValEl = cardEl.querySelector('.font-bold.text-primary.leading-none');
      if (priceValEl) {
        priceValEl.textContent = matchingVariant.price_formatted;
      }

      // 3. Update original price display
      const priceWrapper = cardEl.querySelector('.flex.items-baseline.gap-1.5');
      if (priceWrapper) {
        let originalPriceEl = priceWrapper.querySelector('.line-through');
        if (matchingVariant.originalPrice && matchingVariant.originalPrice > matchingVariant.price) {
          if (!originalPriceEl) {
            originalPriceEl = document.createElement('span');
            originalPriceEl.className = "text-[8px] sm:text-[9px] text-primary/70 line-through leading-none";
            priceWrapper.insertBefore(originalPriceEl, priceWrapper.querySelector('span:last-child'));
          }
          originalPriceEl.textContent = matchingVariant.originalPrice_formatted;
        } else if (originalPriceEl) {
          originalPriceEl.remove();
        }
      }

      // Update badge
      const imageZone = cardEl.querySelector('.relative.w-full.flex-shrink-0');
      if (imageZone) {
        let badgeEl = imageZone.querySelector('span');
        if (matchingVariant.originalPrice && matchingVariant.originalPrice > matchingVariant.price) {
          const savings = Math.round(((matchingVariant.originalPrice - matchingVariant.price) / matchingVariant.originalPrice) * 100);
          if (!badgeEl) {
            badgeEl = document.createElement('span');
            badgeEl.className = "absolute top-2 left-2 bg-secondary text-on-accent text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
            imageZone.appendChild(badgeEl);
          } else {
            badgeEl.className = "absolute top-2 left-2 bg-secondary text-on-accent text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
          }
          badgeEl.textContent = `Spar ${savings}%`;
        } else if (product.badge) {
          if (!badgeEl) {
            badgeEl = document.createElement('span');
            badgeEl.className = "absolute top-2 left-2 bg-primary text-on-primary text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
            imageZone.appendChild(badgeEl);
          } else {
            badgeEl.className = "absolute top-2 left-2 bg-primary text-on-primary text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
          }
          badgeEl.textContent = product.badge;
        } else if (badgeEl) {
          badgeEl.remove();
        }
      }

      const buyButton = cardEl.querySelector('button');
      if (buyButton) {
        if (matchingVariant.available) {
          buyButton.disabled = false;
          buyButton.classList.remove('opacity-50', 'cursor-not-allowed', 'bg-slate-200');
          buyButton.classList.add('bg-accent', 'hover:brightness-95');
          buyButton.setAttribute('onclick', `window.addToCart(${matchingVariant.id})`);
          buyButton.innerHTML = `<span>Køb</span>`;
        } else {
          buyButton.disabled = true;
          buyButton.classList.add('opacity-50', 'cursor-not-allowed', 'bg-slate-200');
          buyButton.classList.remove('bg-accent', 'hover:brightness-95');
          buyButton.removeAttribute('onclick');
          buyButton.innerHTML = `<span>Udsolgt</span>`;
        }
      }
    }
  };

  function applyQuickFilter(type, value) {
    clearAllFilters(false);
    const inputs = document.querySelectorAll(`input[name="${type}"], input[name="mobile-${type}"]`);
    inputs.forEach(input => {
      if (input.value === value) {
        input.checked = true;
      }
    });
    filterProducts();
  }

  function clearAllFilters(shouldRender = true) {
    document.querySelectorAll('input.filter-checkbox').forEach(checkbox => {
      checkbox.checked = false;
    });
    ['price-min', 'price-max', 'mobile-price-min', 'mobile-price-max'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.value = "";
    });
    if (shouldRender) {
      filterProducts();
    }
  }

  function toggleMobileFilter(open) {
    const drawer = document.getElementById("mobile-filter-drawer");
    if (!drawer) return;
    const panel = drawer.querySelector("div");
    if (open) {
      drawer.classList.remove("hidden");
      setTimeout(() => {
        drawer.classList.remove("opacity-0");
        panel.classList.remove("translate-x-full");
      }, 10);
    } else {
      drawer.classList.add("opacity-0");
      panel.classList.add("translate-x-full");
      setTimeout(() => {
        drawer.classList.add("hidden");
      }, 300);
    }
  }

  document.addEventListener("DOMContentLoaded", () => {
    const filterDrawer = document.getElementById("mobile-filter-drawer");
    if (filterDrawer) {
      filterDrawer.addEventListener("click", (e) => {
        if (e.target === filterDrawer) {
          toggleMobileFilter(false);
        }
      });
    }
  });

  window.syncFilters = syncFilters;
  window.syncPriceFilters = syncPriceFilters;
  window.filterProducts = filterProducts;
  window.applyQuickFilter = applyQuickFilter;
  window.clearAllFilters = clearAllFilters;
  window.toggleMobileFilter = toggleMobileFilter;
</script>

{% schema %}
{
  "name": "Kollektion Grid & Filtre",
  "class": "max-w-screen-xl mx-auto px-4",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 16
    }
  ],
  "blocks": [
    {
      "type": "filter",
      "name": "Filter",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Filter overskrift",
          "default": "Filter"
        },
        {
          "type": "select",
          "id": "filter_type",
          "label": "Filter kildetype",
          "options": [
            { "value": "tag", "label": "Produkt Tag (f.eks. tykkelse:X)" },
            { "value": "option", "label": "Variant Option (f.eks. Størrelse)" },
            { "value": "price", "label": "Pris Range" }
          ],
          "default": "tag"
        },
        {
          "type": "text",
          "id": "key",
          "label": "Søgenøgle / Præfiks",
          "info": "For tag: f.eks. 'tykkelse'. For option: f.eks. 'bredde'. (Udfyldes ikke for pris)",
          "default": "tykkelse"
        },
        {
          "type": "select",
          "id": "display_mapping",
          "label": "Visningsformat (Valgfrit)",
          "options": [
            { "value": "none", "label": "Standard (Vis rå værdi)" },
            { "value": "form", "label": "Form (Firkantet -> Rulle, Rund -> Rund skåret)" },
            { "value": "width", "label": "Bredde (41x33 cm -> Dækkeserviet)" }
          ],
          "default": "none"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kollektion Grid & Filtre",
      "blocks": [
        {
          "type": "filter",
          "settings": {
            "title": "Tykkelse",
            "filter_type": "tag",
            "key": "tykkelse"
          }
        },
        {
          "type": "filter",
          "settings": {
            "title": "Størrelse / Bredde",
            "filter_type": "option",
            "key": "bredde",
            "display_mapping": "width"
          }
        },
        {
          "type": "filter",
          "settings": {
            "title": "Type / Form",
            "filter_type": "option",
            "key": "form",
            "display_mapping": "form"
          }
        },
        {
          "type": "filter",
          "settings": {
            "title": "Pris",
            "filter_type": "price"
          }
        }
      ]
    }
  ]
}
{% endschema %}
