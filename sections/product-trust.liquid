{% comment %}
  Product Trust Section
  Renders the star reviews rating and buy volume badge.
{% endcomment %}

<section class="max-w-screen-xl mx-auto px-4 pt-1 pb-1">
  <!-- Product Trust -->
  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
    <div class="flex items-center gap-1">
      <div class="flex text-amber-500">
        <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">star</span>
        <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">star</span>
        <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">star</span>
        <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">star</span>
        <span class="material-symbols-outlined text-xs" style="font-variation-settings: 'FILL' 1;">star</span>
      </div>
      <span class="text-xs font-medium text-primary">
        {{ section.settings.rating_score | default: "4,8" }} ({{ section.settings.rating_count | default: "163" }})
      </span>
    </div>
    {%- if section.settings.badge_text != blank -%}
      <span class="text-xs text-on-surface-variant">
        {{ section.settings.badge_text }}
      </span>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product Trust",
  "settings": [
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4,8"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Total Review Count",
      "default": "163"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Urgency Badge Text",
      "default": "300+ købt den seneste måned"
    }
  ],
  "presets": [
    {
      "name": "Product Trust"
    }
  ]
}
{% endschema %}
