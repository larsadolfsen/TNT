<section class="px-4 py-10 bg-white">
  <div class="grid grid-cols-{{ section.blocks.size | default: 3 }} gap-4 max-w-screen-xl mx-auto">
    {%- for block in section.blocks -%}
      <div class="flex flex-col items-center text-center space-y-2" {{ block.shopify_attributes }}>
        {%- if block.settings.icon != blank -%}
          <span class="material-symbols-outlined text-2xl text-slate-600">{{ block.settings.icon }}</span>
        {%- endif -%}
        {%- if block.settings.title != blank -%}
          <span class="text-[10px] font-bold text-slate-700 leading-tight uppercase tracking-wider">{{ block.settings.title }}</span>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Materialer & Badges",
  "max_blocks": 4,
  "settings": [],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Material Symbol Ikon",
          "default": "eco",
          "info": "Navn på ikon fra Google Material Symbols, f.eks. eco, verified, local_shipping"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "100% Phthalatfri"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Materialer & Badges",
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "eco",
            "title": "100% Phthalatfri"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "verified",
            "title": "Oeko-Tex 100"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "local_shipping",
            "title": "Sendes på rulle"
          }
        }
      ]
    }
  ]
}
{% endschema %}
