{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
    padding-left: {{ section.settings.padding_sides | times: 0.75 | round }}px;
    padding-right: {{ section.settings.padding_sides | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
      padding-left: {{ section.settings.padding_sides }}px;
      padding-right: {{ section.settings.padding_sides }}px;
    }
  }

  {%- if section.settings.disable_block_padding_vertical_mobile -%}
    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} .shopify-block {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
      }
    }
  {%- endif -%}

  {%- if section.settings.disable_block_padding_horizontal_mobile -%}
    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} .shopify-block {
        padding-left: 0 !important;
        padding-right: 0 !important;
      }
    }
  {%- endif -%}
{%- endstyle -%}

{%- capture bg_class -%}
  {%- case section.settings.background_color -%}
    {%- when 'light' -%}
      bg-background text-primary
    {%- when 'dark' -%}
      bg-background-dark text-white
    {%- when 'shade' -%}
      bg-background-shade text-primary
  {%- endcase -%}
{%- endcapture -%}

{%- liquid
  if section.settings.layout_style == 'full_width_bg'
    assign outer_class = 'row-section w-full ' | append: bg_class | append: ' section-' | append: section.id | append: '-padding row-section--full-width'
    assign inner_class = 'max-w-[var(--page-width)] mx-auto px-4 md:px-8'
  else
    assign outer_class = 'row-section max-w-[var(--page-width)] mx-auto px-4 md:px-8 section-' | append: section.id | append: '-padding'
    assign inner_class = 'w-full ' | append: bg_class | append: ' rounded-3xl px-6 py-10 md:px-12 md:py-16 shadow-md'
  endif
-%}

<div class="{{ outer_class }}">
  <div class="{{ inner_class }}">
    <div class="row-content{% if section.settings.disable_columns_layout %} row-content--no-columns{% endif %}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Row",
  "settings": [
    {
      "type": "checkbox",
      "id": "disable_columns_layout",
      "label": "Deaktiver 2-kolonne layout på desktop",
      "default": false
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Baggrundsfarve",
      "options": [
        {
          "value": "light",
          "label": "Lys"
        },
        {
          "value": "dark",
          "label": "Mørk"
        },
        {
          "value": "shade",
          "label": "Grå / Tonet"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layoutbredde",
      "options": [
        {
          "value": "full_width_bg",
          "label": "Fuld bredde"
        },
        {
          "value": "boxed",
          "label": "Boks (begrænset bredde)"
        }
      ],
      "default": "full_width_bg"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "disable_block_padding_vertical_mobile",
      "label": "Fjern 12px top/bund-afstand på blokke på mobil",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "disable_block_padding_horizontal_mobile",
      "label": "Fjern 16px sideafstand på blokke på mobil",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Row"
    }
  ]
}
{% endschema %}
