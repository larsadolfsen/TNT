{%- liquid
  assign is_single_column = false
  if section.settings.alignment != 'columns' and section.settings.alignment != 'full_width'
    assign is_single_column = true
  endif
  assign layout_style = section.settings.layout_style | default: 'full_width_bg'

  # Detect if the row contains column group blocks
  assign has_group_block = false
  for block in section.blocks
    if block.type == 'group'
      assign has_group_block = true
      break
    endif
  endfor

  # Calculate class names dynamically to handle grids and product detail column grids
  assign row_classes = 'row-content'
  if is_single_column
    assign row_classes = row_classes | append: ' row-content--no-columns row-content--single row-content--' | append: section.settings.alignment
  else
    if has_group_block
      # Product details page uses custom columns grid - keep default
      if template.name != 'product'
        assign row_classes = row_classes | append: ' grid-layout'
      endif
    else
      # Content blocks (like Cards) should always layout as a responsive grid
      assign row_classes = row_classes | append: ' grid-layout row-content--no-columns'
    endif
  endif

  if section.settings.alignment == 'full_width'
    assign row_classes = row_classes | append: ' row-content--full-width'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 840px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-inner-padding {
    {%- if layout_style == 'full_width_bg' -%}
      padding-left: calc({{ section.settings.padding_sides | default: 0 }}px + 1rem);
      padding-right: calc({{ section.settings.padding_sides | default: 0 }}px + 1rem);
    {%- else -%}
      padding-left: {{ section.settings.padding_sides | default: 0 }}px;
      padding-right: {{ section.settings.padding_sides | default: 0 }}px;
    {%- endif -%}
  }

  @media screen and (min-width: 840px) {
    .section-{{ section.id }}-inner-padding {
      padding-left: {{ section.settings.padding_sides | default: 0 }}px;
      padding-right: {{ section.settings.padding_sides | default: 0 }}px;
    }
  }

  {%- if is_single_column -%}
    .row-content--single {
      display: flex;
      flex-direction: row;
      flex-wrap: wrap;
      width: 100%;
      gap: {{ section.settings.block_spacing | default: 8 }}px;
    }

    .row-content--left {
      justify-content: flex-start;
      text-align: left;
    }

    .row-content--center {
      justify-content: center;
      text-align: center;
    }

    .row-content--right {
      justify-content: flex-end;
      text-align: right;
    }

    .row-content--single > .shopify-block,
    .row-content--single > shopify-block,
    .row-content--single > [class*="shopify-block-"] {
      padding-top: 0;
      padding-bottom: 0;
      padding-left: 0;
      padding-right: 0;
      width: auto !important;
      display: inline-block !important;
      max-width: 100%;
    }

    .row-content--single > * > div {
      width: auto !important;
    }
  {%- endif -%}
{%- endstyle -%}

{%- capture bg_class -%}
  {%- case section.settings.background_color -%}
    {%- when 'light' -%}bg-background text-primary
    {%- when 'dark' -%}bg-background-dark text-white
    {%- when 'shade' -%}bg-background-shade text-primary
  {%- endcase -%}
{%- endcapture -%}

{%- liquid
  if layout_style == 'full_width_bg'
    assign outer_class = 'row-section w-full ' | append: bg_class | append: ' section-' | append: section.id | append: '-padding row-section--full-width'
    if section.settings.alignment == 'full_width'
      assign inner_class = 'w-full section-' | append: section.id | append: '-inner-padding'
    else
      assign inner_class = 'max-w-[var(--page-width)] mx-auto section-' | append: section.id | append: '-inner-padding'
    endif
  else
    if section.settings.alignment == 'full_width'
      assign outer_class = 'row-section w-full px-4 expanded:px-8 section-' | append: section.id | append: '-padding'
    else
      assign outer_class = 'row-section max-w-[var(--page-width)] mx-auto px-4 expanded:px-8 section-' | append: section.id | append: '-padding'
    endif
    assign inner_class = 'w-full ' | append: bg_class | append: ' rounded-3xl py-10 expanded:py-16 shadow-md section-' | append: section.id | append: '-inner-padding'
  endif
-%}

<div class="{{ outer_class }}">
  <div class="{{ inner_class }}">
    <div class="{{ row_classes }}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Row",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Baggrundsfarve",
      "options": [
        { "value": "light", "label": "Lys" },
        { "value": "dark",  "label": "Mørk" },
        { "value": "shade", "label": "Grå / Tonet" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Layoutbredde",
      "options": [
        { "value": "columns", "label": "Grid" },
        { "value": "full_width", "label": "Fuld bredde" },
        { "value": "left",    "label": "Venstre" },
        { "value": "center",  "label": "Centreret" },
        { "value": "right",   "label": "Højre" }
      ],
      "default": "columns"
    },

    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 24
    },
    {
      "type": "header",
      "content": "Blokafstand (kun enkeltkolonne)"
    },
    {
      "type": "range",
      "id": "block_spacing",
      "min": 0,
      "max": 64,
      "step": 4,
      "unit": "px",
      "label": "Afstand mellem blokke",
      "default": 8
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    { "name": "Row" }
  ]
}
{% endschema %}
