{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- capture bg_class -%}
  {%- case section.settings.background_color -%}
    {%- when 'light' -%}
      bg-background text-primary
    {%- when 'dark' -%}
      bg-background-dark text-white
    {%- when 'shade' -%}
      bg-background-shade text-primary
  {%- endcase -%}
{%- endcapture -%}

{%- capture grid_cols_desktop -%}
  {%- case section.settings.columns_desktop -%}
    {%- when 1 -%} md:grid-cols-1
    {%- when 2 -%} md:grid-cols-2
    {%- when 3 -%} md:grid-cols-3
    {%- when 4 -%} md:grid-cols-4
    {%- when 5 -%} md:grid-cols-5
    {%- when 6 -%} md:grid-cols-6
  {%- endcase -%}
{%- endcapture -%}

{%- capture grid_cols_mobile -%}
  {%- case section.settings.columns_mobile -%}
    {%- when '1' -%} grid-cols-1
    {%- when '2' -%} grid-cols-2
  {%- endcase -%}
{%- endcapture -%}

{%- if section.settings.layout_style == 'full_width_bg' -%}
  <div class="row-section w-full {{ bg_class }} section-{{ section.id }}-padding">
    <div class="max-w-[var(--page-width)] mx-auto px-4 md:px-8">
{%- else -%}
  <div class="row-section max-w-[var(--page-width)] mx-auto px-4 md:px-8 section-{{ section.id }}-padding">
    <div class="w-full {{ bg_class }} rounded-3xl px-6 py-10 md:px-12 md:py-16 shadow-md border border-outline-variant/30">
{%- endif -%}

      {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
        <div class="mb-10 md:mb-16 text-{{ section.settings.header_alignment }}">
          {%- if section.settings.subheading != blank -%}
            <span class="inline-block text-xs uppercase tracking-widest font-bold opacity-80 mb-3 bg-brand-yellow/15 text-primary px-3 py-1 rounded-full border border-brand-yellow/30 {% if section.settings.background_color == 'dark' %} bg-white/10 text-white border-white/20 {% endif %}">
              {{ section.settings.subheading }}
            </span>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="text-3xl md:text-4xl font-extrabold font-serif tracking-tight mt-1 leading-tight">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="grid {{ grid_cols_mobile }} {{ grid_cols_desktop }} {{ section.settings.column_gap }}">
        {%- for block in section.blocks -%}
          {%- capture card_class -%}
            {%- if block.settings.enable_card -%}
              {%- if section.settings.background_color == 'dark' -%}
                bg-white/5 border border-white/10 text-white shadow-xl hover:bg-white/10 hover:border-white/20 hover:-translate-y-1.5
              {%- else -%}
                bg-white border border-outline-variant/60 text-primary shadow-sm hover:shadow-md hover:border-primary/20 hover:-translate-y-1.5
              {%- endif -%}
              p-6 md:p-8 rounded-2xl transition-all duration-300
            {%- else -%}
              transition-transform duration-300 hover:-translate-y-0.5
            {%- endif -%}
          {%- endcapture -%}

          <div class="row-col flex flex-col {{ block.settings.align_content }} {{ card_class }}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              <div class="w-full mb-6 overflow-hidden rounded-xl">
                {{ block.settings.image | image_url: width: 800 | image_tag: class: 'w-full h-auto object-cover aspect-video hover:scale-105 transition-transform duration-500', loading: 'lazy' }}
              </div>
            {%- endif -%}
            
            {%- if block.settings.title != blank -%}
              <h3 class="text-xl font-bold font-serif mb-3 tracking-tight">
                {{ block.settings.title }}
              </h3>
            {%- endif -%}
            
            {%- if block.settings.text != blank -%}
              <div class="rte text-sm opacity-90 leading-relaxed mb-6 {% if block.settings.align_content contains 'center' %}mx-auto{% endif %}">
                {{ block.settings.text }}
              </div>
            {%- endif -%}

            {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
              <a href="{{ block.settings.button_link }}" class="inline-flex items-center justify-center px-6 py-3 rounded-full text-xs font-bold transition-all shadow-sm hover:scale-102 hover:brightness-95 active:scale-98 cursor-pointer {% if block.settings.button_style == 'primary' %} bg-brand-yellow text-primary {% else %} border border-current {% if section.settings.background_color == 'dark' %} hover:bg-white/15 {% else %} hover:bg-slate-50 {% endif %} {% endif %}">
                {{ block.settings.button_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>

{%- if section.settings.layout_style == 'full_width_bg' -%}
    </div>
  </div>
{%- else -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Række (Row)",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Fremhæv fordele eller funktioner"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Underoverskrift",
      "default": "Hvorfor vælge os"
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Overskriftsjustering",
      "options": [
        {
          "value": "left",
          "label": "Venstre"
        },
        {
          "value": "center",
          "label": "Centreret"
        },
        {
          "value": "right",
          "label": "Højre"
        }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Baggrundsfarve",
      "options": [
        {
          "value": "light",
          "label": "Lys"
        },
        {
          "value": "dark",
          "label": "Mørk"
        },
        {
          "value": "shade",
          "label": "Grå / Tonet"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layoutbredde",
      "options": [
        {
          "value": "full_width_bg",
          "label": "Fuld bredde baggrund (indhold boks-bredde)"
        },
        {
          "value": "boxed",
          "label": "Boks (begrænset bredde)"
        }
      ],
      "default": "full_width_bg"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Antal kolonner på desktop",
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Antal kolonner på mobil",
      "options": [
        {
          "value": "1",
          "label": "1 kolonne"
        },
        {
          "value": "2",
          "label": "2 kolonner"
        }
      ],
      "default": "1"
    },
    {
      "type": "select",
      "id": "column_gap",
      "label": "Afstand mellem kolonner",
      "options": [
        {
          "value": "gap-4",
          "label": "Lille"
        },
        {
          "value": "gap-8",
          "label": "Mellem"
        },
        {
          "value": "gap-12",
          "label": "Stor"
        }
      ],
      "default": "gap-8"
    },
    {
      "type": "header",
      "content": "Sektionsafstand (Padding)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Kolonne",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Billede"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Kolonneoverskrift"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Beskrivelse",
          "default": "<p>Del vigtige informationer om dine produkter, brand eller værdier her med dine kunder.</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Knap-etiket",
          "default": "Læs mere"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Knap-link"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Knap-stil",
          "options": [
            {
              "value": "primary",
              "label": "Primær (Gul)"
            },
            {
              "value": "secondary",
              "label": "Sekundær (Ramme)"
            }
          ],
          "default": "primary"
        },
        {
          "type": "select",
          "id": "align_content",
          "label": "Indholdsjustering",
          "options": [
            {
              "value": "items-start text-left",
              "label": "Venstrestillet"
            },
            {
              "value": "items-center text-center",
              "label": "Centreret"
            },
            {
              "value": "items-end text-right",
              "label": "Højrestillet"
            }
          ],
          "default": "items-center text-center"
        },
        {
          "type": "checkbox",
          "id": "enable_card",
          "label": "Vis som kort",
          "default": false,
          "info": "Giver kolonnen en boks-baggrund med kant og skygge for et mere markeret udseende."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Række (Row)",
      "blocks": [
        {
          "type": "column",
          "settings": {
            "title": "Hurtig levering",
            "text": "<p>Vi sender alle ugens hverdage med lynhurtig levering, så du hurtigt modtager dine varer.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "Dansk support",
            "text": "<p>Vores kundeservice sidder klar alle hverdage til at besvare dine spørgsmål på telefon og mail.</p>"
          }
        },
        {
          "type": "column",
          "settings": {
            "title": "30 dages returret",
            "text": "<p>Skulle du fortryde dit køb, kan du trygt returnere dine varer helt op til 30 dage efter modtagelse.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}
