{%- liquid
  assign is_single_column = false
  if section.settings.alignment != 'columns'
    assign is_single_column = true
  endif
  assign layout_style = section.settings.layout_style | default: 'full_width_bg'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .section-{{ section.id }}-inner-padding {
    {%- if layout_style == 'full_width_bg' -%}
      padding-left: calc({{ section.settings.padding_sides | default: 0 }}px + 1rem) !important;
      padding-right: calc({{ section.settings.padding_sides | default: 0 }}px + 1rem) !important;
    {%- else -%}
      padding-left: {{ section.settings.padding_sides | default: 0 }}px !important;
      padding-right: {{ section.settings.padding_sides | default: 0 }}px !important;
    {%- endif -%}
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-inner-padding {
      padding-left: {{ section.settings.padding_sides | default: 0 }}px !important;
      padding-right: {{ section.settings.padding_sides | default: 0 }}px !important;
    }
  }

  {%- if is_single_column -%}
    {%- if section.settings.alignment == 'left' or section.settings.alignment == 'center' or section.settings.alignment == 'right' -%}
      #shopify-section-{{ section.id }} .row-content--single {
        display: flex !important;
        flex-direction: row !important;
        flex-wrap: wrap !important;
        width: 100% !important;
        gap: {{ section.settings.block_spacing | default: 8 }}px !important;
      }

      #shopify-section-{{ section.id }} .row-content--left {
        justify-content: flex-start !important;
        text-align: left !important;
      }

      #shopify-section-{{ section.id }} .row-content--center {
        justify-content: center !important;
        text-align: center !important;
      }

      #shopify-section-{{ section.id }} .row-content--right {
        justify-content: flex-end !important;
        text-align: right !important;
      }

      #shopify-section-{{ section.id }} .row-content--single > .shopify-block {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        width: auto !important;
        display: inline-block !important;
        max-width: 100% !important;
      }
    {%- else -%}
      #shopify-section-{{ section.id }} .row-content--single {
        display: flex !important;
        flex-direction: column !important;
        align-items: stretch !important;
        width: 100% !important;
        gap: {{ section.settings.block_spacing | default: 8 }}px !important;
      }

      #shopify-section-{{ section.id }} .row-content--single > .shopify-block {
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        width: 100% !important;
        display: block !important;
      }

      #shopify-section-{{ section.id }} .row-content--left {
        text-align: left !important;
      }

      #shopify-section-{{ section.id }} .row-content--center {
        text-align: center !important;
      }

      #shopify-section-{{ section.id }} .row-content--right {
        text-align: right !important;
      }
    {%- endif -%}
  {%- endif -%}
{%- endstyle -%}

{%- capture bg_class -%}
  {%- case section.settings.background_color -%}
    {%- when 'light' -%}bg-background text-primary
    {%- when 'dark' -%}bg-background-dark text-white
    {%- when 'shade' -%}bg-background-shade text-primary
  {%- endcase -%}
{%- endcapture -%}

{%- liquid
  if layout_style == 'full_width_bg'
    assign outer_class = 'row-section w-full ' | append: bg_class | append: ' section-' | append: section.id | append: '-padding row-section--full-width'
    assign inner_class = 'max-w-[var(--page-width)] mx-auto section-' | append: section.id | append: '-inner-padding'
  else
    assign outer_class = 'row-section max-w-[var(--page-width)] mx-auto px-4 md:px-8 section-' | append: section.id | append: '-padding'
    assign inner_class = 'w-full ' | append: bg_class | append: ' rounded-3xl py-10 md:py-16 shadow-md section-' | append: section.id | append: '-inner-padding'
  endif
-%-}

<div class="{{ outer_class }}">
  <div class="{{ inner_class }}">
    <div class="row-content{% if is_single_column %} row-content--no-columns row-content--single row-content--{{ section.settings.alignment }}{% endif %}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Row",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "Baggrundsfarve",
      "options": [
        { "value": "light", "label": "Lys" },
        { "value": "dark",  "label": "Mørk" },
        { "value": "shade", "label": "Grå / Tonet" }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Layoutbredde",
      "options": [
        { "value": "columns", "label": "Kolonner" },
        { "value": "left",    "label": "Venstre" },
        { "value": "center",  "label": "Centreret" },
        { "value": "right",   "label": "Højre" }
      ],
      "default": "columns"
    },

    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bund",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Sider",
      "default": 16
    },
    {
      "type": "header",
      "content": "Blokafstand (kun enkeltkolonne)"
    },
    {
      "type": "range",
      "id": "block_spacing",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "label": "Afstand mellem blokke",
      "default": 8
    }
  ],
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    { "name": "Row" }
  ]
}
{% endschema %}
