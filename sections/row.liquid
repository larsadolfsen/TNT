{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 768px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- capture bg_class -%}
  {%- case section.settings.background_color -%}
    {%- when 'light' -%}
      bg-background text-primary
    {%- when 'dark' -%}
      bg-background-dark text-white
    {%- when 'shade' -%}
      bg-background-shade text-primary
  {%- endcase -%}
{%- endcapture -%}

{%- if section.settings.layout_style == 'full_width_bg' -%}
  <div class="row-section w-full {{ bg_class }} section-{{ section.id }}-padding">
    <div class="w-full">
{%- else -%}
  <div class="row-section max-w-[var(--page-width)] mx-auto px-4 md:px-8 section-{{ section.id }}-padding">
    <div class="w-full {{ bg_class }} rounded-3xl px-6 py-10 md:px-12 md:py-16 shadow-md">
{%- endif -%}

      <div class="row-content">
        {% content_for 'blocks' %}
      </div>

{%- if section.settings.layout_style == 'full_width_bg' -%}
    </div>
  </div>
{%- else -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Row",
  "settings": [
    {
      "type": "select",
      "id": "background_color",
      "label": "Baggrundsfarve",
      "options": [
        {
          "value": "light",
          "label": "Lys"
        },
        {
          "value": "dark",
          "label": "Mørk"
        },
        {
          "value": "shade",
          "label": "Grå / Tonet"
        }
      ],
      "default": "light"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layoutbredde",
      "options": [
        {
          "value": "full_width_bg",
          "label": "Fuld bredde"
        },
        {
          "value": "boxed",
          "label": "Boks (begrænset bredde)"
        }
      ],
      "default": "full_width_bg"
    },
    {
      "type": "header",
      "content": "Sektionsafstand (Padding)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "Row"
    }
  ]
}
{% endschema %}
