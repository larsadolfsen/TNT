{
  "name": "shopify-skeleton-tailwind",
  "version": "1.0.124",
  "description": "Shopify Skeleton Theme with Tailwind CSS v4",
  "main": "index.js",
  "scripts": {
    "tailwind:build": "tailwindcss -i ./assets/input.css -o ./assets/output.css --content \"./**/*.{js,json,liquid}\" --minify",
    "tailwind:watch": "tailwindcss -i ./assets/input.css -o ./assets/output.css --content \"./**/*.{js,json,liquid}\" --minify --watch",
    "shopify:dev": "shopify theme dev",
    "dev": "concurrently \"npm run tailwind:watch\" \"npm run shopify:dev\"",
    "build": "npm run tailwind:build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@shopify/cli": "^3.69.0",
    "@tailwindcss/cli": "^4.0.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.0.0"
  }
}
