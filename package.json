{
  "name": "shopify-skeleton-tailwind",
  "version": "1.20260813.2344",
  "description": "Shopify Skeleton Theme with Tailwind CSS v4",
  "main": "index.js",
  "scripts": {
    "tailwind:build": "tailwindcss -i ./assets/input.css -o ./assets/output.css --content \"./**/*.{js,json,liquid}\" --minify",
    "tailwind:watch": "tailwindcss -i ./assets/input.css -o ./assets/output.css --content \"./**/*.{js,json,liquid}\" --minify --watch",
    "js:build": "node scripts/build-js.mjs",
    "js:watch": "node scripts/build-js.mjs --watch",
    "shopify:dev": "shopify theme dev",
    "dev": "concurrently \"npm run tailwind:watch\" \"npm run js:watch\" \"npm run shopify:dev\"",
    "build": "npm run tailwind:build && npm run js:build",
    "bump-version": "node scripts/bump-version.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@shopify/cli": "^3.69.0",
    "@tailwindcss/cli": "^4.0.0",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "lucide-static": "^1.31.0",
    "tailwindcss": "^4.0.0"
  }
}
