{% style %}
  {% # Loads header font variations with display: swap %}
  {% if settings.type_header_font.family != blank %}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {%- assign header_font_bold = settings.type_header_font | font_modify: 'weight', 'bold' -%}
    {%- if header_font_bold -%}
      {{ header_font_bold | font_face: font_display: 'swap' }}
      {{ header_font_bold | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {%- endif -%}
    {{ settings.type_header_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {% endif %}

  {% # Loads body font variations with display: swap %}
  {% if settings.type_body_font.family != blank %}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold' -%}
    {%- if body_font_bold -%}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {%- endif -%}
    {{ settings.type_body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {% endif %}

  :root {
    {% if settings.type_header_font.family != blank %}
      --font-header-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      --font-header-style: {{ settings.type_header_font.style }};
      --font-header-weight: {{ settings.type_header_font.weight }};
    {% else %}
      --font-header-family: "Playfair Display", serif;
      --font-header-style: normal;
      --font-header-weight: 400;
    {% endif %}

    {% if settings.type_body_font.family != blank %}
      --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --font-body-style: {{ settings.type_body_font.style }};
      --font-body-weight: {{ settings.type_body_font.weight }};

      --font-primary--family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --font-primary--style: {{ settings.type_body_font.style }};
      --font-primary--weight: {{ settings.type_body_font.weight }};
    {% else %}
      --font-body-family: "Work Sans", sans-serif;
      --font-body-style: normal;
      --font-body-weight: 400;

      --font-primary--family: "Work Sans", sans-serif;
      --font-primary--style: normal;
      --font-primary--weight: 400;
    {% endif %}

    --page-width: {{ settings.max_page_width | default: 1440 }}px;
    --page-margin: {{ settings.min_page_margin }}px;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;

    --grid-cols-mobile: {{ settings.grid_cols_mobile | default: 2 }};
    --grid-cols-tablet: {{ settings.grid_cols_tablet | default: 2 }};
    --grid-cols-desktop: {{ settings.grid_cols_desktop | default: 3 }};

    /* Light Theme Settings */
    --color-primary: {{ settings.primary_color_light | default: '#0e1a28' }};
    --color-on-primary: {{ settings.primary_foreground_color_light | default: '#ffffff' }};
    --color-accent: {{ settings.accent_color_light | default: '#FFD814' }};
    --color-on-accent: {{ settings.accent_foreground_color_light | default: '#0e1a28' }};
    --color-background: {{ settings.background_color_light | default: '#ffffff' }};
    --color-background-dark: {{ settings.background_color_dark | default: '#0e1a28' }};
    --color-background-shade: {{ settings.background_shade_color_light | default: '#f9f9f9' }};
    --color-card-light: {{ settings.card_light_color_light | default: '#ffffff' }};
    --color-card-high: {{ settings.card_high_color_light | default: '#f3f4f6' }};
    --color-card-shade: {{ settings.background_shade_color_light | default: '#f9f9f9' }};
    --color-foreground: {{ settings.foreground_color_light | default: '#333333' }};
    --color-border: {{ settings.border_color_light | default: '#e2e8f0' }};
    --color-surface-container: {{ settings.background_shade_color_light | default: '#f9f9f9' }};

    /* Selected state of custom form controls (radio dots etc.) — deliberately pure
       black rather than --color-primary's #0e1a28, which carries a navy tint. */
    --color-control-selected: #000000;

    /* Deliberately not a light/dark pair — see docs/missing-surface-designs.md Shared foundations, Caveat 2 */
    --color-important: {{ settings.important_color | default: '#e11d48' }};
  }

  .dark {
    /* Dark Theme Settings */
    --color-primary: {{ settings.primary_color_dark | default: '#ffffff' }};
    --color-on-primary: {{ settings.primary_foreground_color_dark | default: '#0e1a28' }};
    --color-accent: {{ settings.accent_color_dark | default: '#FFD814' }};
    --color-on-accent: {{ settings.accent_foreground_color_dark | default: '#0e1a28' }};
    --color-background: {{ settings.background_color_dark | default: '#0e1a28' }};
    --color-background-dark: {{ settings.background_color_dark | default: '#0a111a' }};
    --color-background-shade: {{ settings.background_shade_color_dark | default: '#142131' }};
    --color-card-light: {{ settings.card_light_color_dark | default: '#1a2635' }};
    --color-card-high: {{ settings.card_high_color_dark | default: '#222f40' }};
    --color-card-shade: {{ settings.background_shade_color_dark | default: '#142131' }};
    --color-foreground: {{ settings.foreground_color_dark | default: '#e2e8f0' }};
    --color-border: {{ settings.border_color_dark | default: '#253549' }};
    --color-surface-container: {{ settings.background_shade_color_dark | default: '#142131' }};

    /* Black would be invisible on a dark panel — the selected control inverts. */
    --color-control-selected: #ffffff;
  }
{% endstyle %}
