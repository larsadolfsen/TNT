{% style %}
  {% # Loads header font variations with display: swap %}
  {% if settings.type_header_font.family != blank %}
    {{ settings.type_header_font | font_face: font_display: 'swap' }}
    {%- assign header_font_bold = settings.type_header_font | font_modify: 'weight', 'bold' -%}
    {%- if header_font_bold -%}
      {{ header_font_bold | font_face: font_display: 'swap' }}
      {{ header_font_bold | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {%- endif -%}
    {{ settings.type_header_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {% endif %}

  {% # Loads body font variations with display: swap %}
  {% if settings.type_body_font.family != blank %}
    {{ settings.type_body_font | font_face: font_display: 'swap' }}
    {%- assign body_font_bold = settings.type_body_font | font_modify: 'weight', 'bold' -%}
    {%- if body_font_bold -%}
      {{ body_font_bold | font_face: font_display: 'swap' }}
      {{ body_font_bold | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
    {%- endif -%}
    {{ settings.type_body_font | font_modify: 'style', 'italic' | font_face: font_display: 'swap' }}
  {% endif %}

  :root {
    {% if settings.type_header_font.family != blank %}
      --font-header-family: {{ settings.type_header_font.family }}, {{ settings.type_header_font.fallback_families }};
      --font-header-style: {{ settings.type_header_font.style }};
      --font-header-weight: {{ settings.type_header_font.weight }};
    {% else %}
      --font-header-family: "Playfair Display", serif;
      --font-header-style: normal;
      --font-header-weight: 400;
    {% endif %}

    {% if settings.type_body_font.family != blank %}
      --font-body-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --font-body-style: {{ settings.type_body_font.style }};
      --font-body-weight: {{ settings.type_body_font.weight }};

      --font-primary--family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
      --font-primary--style: {{ settings.type_body_font.style }};
      --font-primary--weight: {{ settings.type_body_font.weight }};
    {% else %}
      --font-body-family: "Work Sans", sans-serif;
      --font-body-style: normal;
      --font-body-weight: 400;

      --font-primary--family: "Work Sans", sans-serif;
      --font-primary--style: normal;
      --font-primary--weight: 400;
    {% endif %}

    --page-width: {{ settings.max_page_width | default: 1440 }}px;
    --page-margin: {{ settings.min_page_margin }}px;
    --style-border-radius-inputs: {{ settings.input_corner_radius }}px;

    /* Material Design 3 Light Theme System */
    --md-sys-color-primary: {{ settings.primary_color_light | default: 'rgb(110 93 14)' }};
    --md-sys-color-surface-tint: {{ settings.primary_color_light | default: 'rgb(110 93 14)' }};
    --md-sys-color-on-primary: {{ settings.primary_foreground_color_light | default: 'rgb(255 255 255)' }};
    --md-sys-color-primary-container: rgb(250 226 135);
    --md-sys-color-on-primary-container: rgb(84 70 0);
    --md-sys-color-secondary: rgb(103 94 64);
    --md-sys-color-on-secondary: rgb(255 255 255);
    --md-sys-color-secondary-container: rgb(239 226 188);
    --md-sys-color-on-secondary-container: rgb(78 70 42);
    --md-sys-color-tertiary: {{ settings.accent_color_light | default: 'rgb(68 102 78)' }};
    --md-sys-color-on-tertiary: {{ settings.accent_foreground_color_light | default: 'rgb(255 255 255)' }};
    --md-sys-color-tertiary-container: rgb(197 236 205);
    --md-sys-color-on-tertiary-container: rgb(44 78 55);
    --md-sys-color-error: rgb(186 26 26);
    --md-sys-color-on-error: rgb(255 255 255);
    --md-sys-color-error-container: rgb(255 218 214);
    --md-sys-color-on-error-container: rgb(147 0 10);
    --md-sys-color-background: {{ settings.background_color_light | default: 'rgb(255 249 238)' }};
    --md-sys-color-on-background: {{ settings.foreground_color_light | default: 'rgb(30 27 19)' }};
    --md-sys-color-surface: {{ settings.background_color_light | default: 'rgb(255 249 238)' }};
    --md-sys-color-on-surface: {{ settings.foreground_color_light | default: 'rgb(30 27 19)' }};
    --md-sys-color-surface-variant: rgb(234 226 207);
    --md-sys-color-on-surface-variant: rgb(75 71 57);
    --md-sys-color-outline: rgb(124 119 103);
    --md-sys-color-outline-variant: {{ settings.border_color_light | default: 'rgb(205 198 180)' }};
    --md-sys-color-shadow: rgb(0 0 0);
    --md-sys-color-scrim: rgb(0 0 0);
    --md-sys-color-inverse-surface: rgb(51 48 39);
    --md-sys-color-inverse-on-surface: rgb(247 240 226);
    --md-sys-color-inverse-primary: rgb(221 198 110);
    --md-sys-color-primary-fixed: rgb(250 226 135);
    --md-sys-color-on-primary-fixed: rgb(34 27 0);
    --md-sys-color-primary-fixed-dim: rgb(221 198 110);
    --md-sys-color-on-primary-fixed-variant: rgb(84 70 0);
    --md-sys-color-secondary-fixed: rgb(239 226 188);
    --md-sys-color-on-secondary-fixed: rgb(33 27 4);
    --md-sys-color-secondary-fixed-dim: rgb(210 198 161);
    --md-sys-color-on-secondary-fixed-variant: rgb(78 70 42);
    --md-sys-color-tertiary-fixed: rgb(197 236 205);
    --md-sys-color-on-tertiary-fixed: rgb(0 33 14);
    --md-sys-color-tertiary-fixed-dim: rgb(170 208 178);
    --md-sys-color-on-tertiary-fixed-variant: rgb(44 78 55);
    --md-sys-color-surface-dim: rgb(224 217 204);
    --md-sys-color-surface-bright: rgb(255 249 238);
    --md-sys-color-surface-container-lowest: rgb(255 255 255);
    --md-sys-color-surface-container-low: {{ settings.background_shade_color_light | default: 'rgb(250 243 229)' }};
    --md-sys-color-surface-container: {{ settings.card_light_color_light | default: 'rgb(244 237 223)' }};
    --md-sys-color-surface-container-high: {{ settings.card_high_color_light | default: 'rgb(238 231 218)' }};
    --md-sys-color-surface-container-highest: rgb(233 226 212);

    /* Legacy Theme variables mapped to MD3 */
    --color-primary: var(--md-sys-color-primary);
    --color-on-primary: var(--md-sys-color-on-primary);
    --color-accent: var(--md-sys-color-tertiary);
    --color-on-accent: var(--md-sys-color-on-tertiary);
    --color-background: var(--md-sys-color-background);
    --color-background-dark: var(--md-sys-color-background);
    --color-background-shade: var(--md-sys-color-surface-container-low);
    --color-card-light: var(--md-sys-color-surface-container);
    --color-card-high: var(--md-sys-color-surface-container-high);
    --color-card-shade: var(--md-sys-color-surface-container-low);
    --color-foreground: var(--md-sys-color-on-surface);
    --color-border: var(--md-sys-color-outline-variant);
  }

  .dark {
    /* Material Design 3 Dark Theme System */
    --md-sys-color-primary: {{ settings.primary_color_dark | default: 'rgb(221 198 110)' }};
    --md-sys-color-surface-tint: {{ settings.primary_color_dark | default: 'rgb(221 198 110)' }};
    --md-sys-color-on-primary: {{ settings.primary_foreground_color_dark | default: 'rgb(58 48 0)' }};
    --md-sys-color-primary-container: rgb(84 70 0);
    --md-sys-color-on-primary-container: rgb(250 226 135);
    --md-sys-color-secondary: rgb(210 198 161);
    --md-sys-color-on-secondary: rgb(55 48 22);
    --md-sys-color-secondary-container: rgb(78 70 42);
    --md-sys-color-on-secondary-container: rgb(239 226 188);
    --md-sys-color-tertiary: {{ settings.accent_color_dark | default: 'rgb(170 208 178)' }};
    --md-sys-color-on-tertiary: {{ settings.accent_foreground_color_dark | default: 'rgb(21 55 34)' }};
    --md-sys-color-tertiary-container: rgb(44 78 55);
    --md-sys-color-on-tertiary-container: rgb(197 236 205);
    --md-sys-color-error: rgb(255 180 171);
    --md-sys-color-on-error: rgb(105 0 5);
    --md-sys-color-error-container: rgb(147 0 10);
    --md-sys-color-on-error-container: rgb(255 218 214);
    --md-sys-color-background: {{ settings.background_color_dark | default: 'rgb(22 19 11)' }};
    --md-sys-color-on-background: {{ settings.foreground_color_dark | default: 'rgb(233 226 212)' }};
    --md-sys-color-surface: {{ settings.background_color_dark | default: 'rgb(22 19 11)' }};
    --md-sys-color-on-surface: {{ settings.foreground_color_dark | default: 'rgb(233 226 212)' }};
    --md-sys-color-surface-variant: rgb(75 71 57);
    --md-sys-color-on-surface-variant: rgb(205 198 180);
    --md-sys-color-outline: rgb(151 144 128);
    --md-sys-color-outline-variant: {{ settings.border_color_dark | default: 'rgb(75 71 57)' }};
    --md-sys-color-shadow: rgb(0 0 0);
    --md-sys-color-scrim: rgb(0 0 0);
    --md-sys-color-inverse-surface: rgb(233 226 212);
    --md-sys-color-inverse-on-surface: rgb(51 48 39);
    --md-sys-color-inverse-primary: rgb(110 93 14);
    --md-sys-color-primary-fixed: rgb(250 226 135);
    --md-sys-color-on-primary-fixed: rgb(34 27 0);
    --md-sys-color-primary-fixed-dim: rgb(221 198 110);
    --md-sys-color-on-primary-fixed-variant: rgb(84 70 0);
    --md-sys-color-secondary-fixed: rgb(239 226 188);
    --md-sys-color-on-secondary-fixed: rgb(33 27 4);
    --md-sys-color-secondary-fixed-dim: rgb(210 198 161);
    --md-sys-color-on-secondary-fixed-variant: rgb(78 70 42);
    --md-sys-color-tertiary-fixed: rgb(197 236 205);
    --md-sys-color-on-tertiary-fixed: rgb(0 33 14);
    --md-sys-color-tertiary-fixed-dim: rgb(170 208 178);
    --md-sys-color-on-tertiary-fixed-variant: rgb(44 78 55);
    --md-sys-color-surface-dim: rgb(22 19 11);
    --md-sys-color-surface-bright: rgb(60 57 47);
    --md-sys-color-surface-container-lowest: rgb(16 14 7);
    --md-sys-color-surface-container-low: {{ settings.background_shade_color_dark | default: 'rgb(30 27 19)' }};
    --md-sys-color-surface-container: {{ settings.card_light_color_dark | default: 'rgb(34 31 23)' }};
    --md-sys-color-surface-container-high: {{ settings.card_high_color_dark | default: 'rgb(45 42 33)' }};
    --md-sys-color-surface-container-highest: rgb(56 53 43);

    /* Legacy Theme variables mapped to MD3 (Dark) */
    --color-primary: var(--md-sys-color-primary);
    --color-on-primary: var(--md-sys-color-on-primary);
    --color-accent: var(--md-sys-color-tertiary);
    --color-on-accent: var(--md-sys-color-on-tertiary);
    --color-background: var(--md-sys-color-background);
    --color-background-dark: var(--md-sys-color-background);
    --color-background-shade: var(--md-sys-color-surface-container-low);
    --color-card-light: var(--md-sys-color-surface-container);
    --color-card-high: var(--md-sys-color-surface-container-high);
    --color-card-shade: var(--md-sys-color-surface-container-low);
    --color-foreground: var(--md-sys-color-on-surface);
    --color-border: var(--md-sys-color-outline-variant);
  }
{% endstyle %}
