{% doc %}
  Mobile drawer navigation list. Renders a flat, single-level list of
  top-level menu links inside the existing #mobile-menu-drawer <nav> in
  sections/header-2.liquid. Every top-level link is a plain tappable <a>;
  child links are not rendered (collection pages already list their
  subcategories, so the drawer does not need a submenu tree). No JS
  behaviour is attached to this markup.

  @param {string} menu_handle - required. A linklists handle, e.g. section.settings.menu.

  @example
  {% render 'nav-drawer-tree', menu_handle: section.settings.menu %}
{% enddoc %}

{%- if menu_handle != blank -%}
  {%- for link1 in linklists[menu_handle].links -%}
    {%- if link1.url != blank and link1.url != '#' -%}
      <a href="{{ link1.url }}" class="block min-h-[48px] flex items-center text-base font-semibold text-primary hover:text-secondary py-2 border-b border-outline-variant/40 no-underline focus-ring{% if link1.active %} border-l-2 border-primary pl-2{% endif %}">
        {{ link1.title }}
      </a>
    {%- else -%}
      <span class="block min-h-[48px] flex items-center text-base font-semibold text-primary py-2 border-b border-outline-variant/40{% if link1.active %} border-l-2 border-primary pl-2{% endif %}">
        {{ link1.title }}
      </span>
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}
