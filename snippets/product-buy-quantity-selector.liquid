{% doc %}
  Pill-shaped quantity stepper for the product buy-buttons block. Hidden by
  assets/product-buy-buttons.js when a customizer (#shape-selector) is
  present on the page, since custom-cut products don't use a quantity input.

  @example
  {% render 'product-buy-quantity-selector' %}
{% enddoc %}

<!-- Quantity Selector (Only visible for simple products when no customizer is present) -->
<div id="buy-buttons-quantity-container" class="w-full flex items-center bg-card-high rounded-full border border-outline-variant overflow-hidden mb-1">
  <button type="button" id="btn-buy-qty-minus" class="w-11 h-11 flex items-center justify-center text-primary active:bg-primary/10 transition-colors cursor-pointer border-r border-outline-variant">
    {% render 'icon', name: 'minus', button: true, class: 'select-none' %}
  </button>
  <input id="input-buy-qty" name="quantity" class="w-full h-11 text-center border-none focus:ring-0 text-[16px] font-bold text-primary bg-transparent focus:outline-none" type="text" inputmode="numeric" pattern="[0-9]*" value="1" style="border: none; padding: 0; margin: 0; box-shadow: none; outline: none; text-align: center; font-size: 16px; font-weight: 700; color: var(--color-primary); min-height: unset; line-height: 1;" />
  <button type="button" id="btn-buy-qty-plus" class="w-11 h-11 flex items-center justify-center text-primary active:bg-primary/10 transition-colors cursor-pointer border-l border-outline-variant">
    {% render 'icon', name: 'plus', button: true, class: 'select-none' %}
  </button>
</div>
