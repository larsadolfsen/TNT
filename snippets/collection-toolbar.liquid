{% doc %}
  Collection page toolbar above the product grid: live product count, the
  sort dropdown, and the mobile "open filters" button (desktop keeps its
  filters in the always-visible sidebar, so this button is lg:hidden).

  @param {number} product_count - required. collection.products_count.
  @param {object} sort_options - required. collection.sort_options.
  @param {string} current_sort_by - required. Currently active sort value.

  @example
  {% render 'collection-toolbar', product_count: collection.products_count, sort_options: collection.sort_options, current_sort_by: sort_by %}
{% enddoc %}

<div class="flex items-center justify-between">
  <div class="text-xs text-primary/85">
    Viser <span id="product-count-display" class="font-semibold text-primary">{{ product_count }}</span> produkter
  </div>

  <div class="flex items-center gap-2">
    <div class="relative w-12 h-12 flex-shrink-0">
      <div class="absolute inset-0 flex flex-col items-center justify-center border border-outline-variant rounded-2xl bg-transparent text-primary pointer-events-none">
        {%- render 'icon', name: 'sort', class: 'text-lg' -%}
        <span class="text-[9px] font-semibold mt-0.5 leading-none">Sorter</span>
      </div>
      <select id="sort-select" onchange="filterProducts()" class="absolute inset-0 w-full h-full opacity-0 cursor-pointer m-0 p-0 appearance-none" aria-label="Sortering">
        {%- for option in sort_options -%}
          <option value="{{ option.value }}" {% if option.value == current_sort_by %}selected{% endif %}>{{ option.name }}</option>
        {%- endfor -%}
      </select>
    </div>

    <!-- Mobil Filter Knap -->
    <button onclick="toggleMobileFilter(true)" class="lg:hidden flex flex-col items-center justify-center border border-outline-variant rounded-2xl bg-transparent w-12 h-12 text-primary cursor-pointer p-0">
      {%- render 'icon', name: 'filter_list', class: 'text-lg' -%}
      <span class="text-[9px] font-semibold mt-0.5 leading-none">Filtrer</span>
    </button>
  </div>
</div>
