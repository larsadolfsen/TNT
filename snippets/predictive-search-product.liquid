{% doc %}
  One predictive-search product result row (Surface 4).

  Predictive search results come back as JSON from Shopify's
  `/search/suggest.json` at runtime, so a single result can't be re-rendered
  through Liquid per keystroke. Instead this markup is embedded once inside
  a <template> (see snippets/predictive-search-panel.liquid) and
  assets/predictive-search.js clones + hydrates one copy per result via the
  `data-field` hooks below — the DOM structure and Tailwind classes stay
  centralized here as the single source of truth rather than being
  duplicated as a JS-built HTML string.

  @example
  <template data-ps-template="product">
    {% render 'predictive-search-product' %}
  </template>
{% enddoc %}

<a href="#" class="predictive-search-row flex items-center gap-3 px-4 py-2 min-h-[64px] no-underline hover:bg-card-high focus-ring" data-field="url" role="option">
  <span class="w-12 h-12 rounded-md overflow-hidden bg-surface-container border border-outline-variant shrink-0 flex items-center justify-center" data-field="thumb-wrap">
    <img data-field="image" class="hidden w-full h-full object-cover" loading="lazy" alt="" />
    <span data-field="thumb-fallback">
      {% render 'icon', name: 'image', class: 'text-primary/45 text-xl' %}
    </span>
  </span>
  <span class="flex-1 min-w-0 flex flex-col gap-0.5">
    <span class="text-sm font-medium text-primary line-clamp-2" data-field="title"></span>
    <span class="text-xs text-primary/70 hidden" data-field="context"></span>
  </span>
  <span class="flex flex-col items-end gap-0.5 shrink-0 pl-2">
    <span class="text-sm font-bold text-primary whitespace-nowrap" data-field="price"></span>
    <span class="text-xs text-primary/60 line-through hidden" data-field="compare"></span>
    <span class="text-[11px] font-bold uppercase tracking-wider text-primary/60 hidden" data-field="sold-out">{{ 'predictive_search.sold_out' | t }}</span>
  </span>
</a>
