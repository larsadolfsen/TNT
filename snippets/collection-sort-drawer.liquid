{% doc %}
  Slide-out sort drawer, opened by the toolbar's sort button (assets/main-collection.js
  toggles #sort-drawer). Mirrors collection-mobile-filter-drawer's markup/animation so
  sorting opens in the same sidebar pattern as filtering, instead of a native <select>
  popup.

  @param {object} sort_options - required. collection.sort_options.
  @param {string} current_sort_by - required. Currently active sort value.

  @example
  {% render 'collection-sort-drawer', sort_options: collection.sort_options, current_sort_by: sort_by %}
{% enddoc %}

<div id="sort-drawer" class="fixed inset-0 bg-black/50 z-[200] hidden flex justify-end transition-opacity duration-300 opacity-0">
  <div class="bg-card-light w-5/6 max-w-sm h-full flex flex-col shadow-2xl p-6 transition-transform duration-300 translate-x-full overflow-y-auto">
    <div class="flex items-center justify-between pb-4 border-b border-outline-variant mb-2">
      <span class="font-sans text-xl font-bold text-primary tracking-tight">Sorter efter</span>
      <button type="button" onclick="toggleSortDrawer(false)" class="bg-transparent border-0 cursor-pointer" aria-label="Luk sortering">
        {%- render 'icon', name: 'x', class: 'text-2xl text-primary' -%}
      </button>
    </div>

    <div class="flex flex-col">
      {%- for option in sort_options -%}
        <label class="flex items-center justify-between gap-3 py-4 border-b border-outline-variant/40 last:border-0 cursor-pointer text-primary">
          <span class="text-sm font-medium">{{ option.name }}</span>
          <input type="radio" name="sort-drawer-option" value="{{ option.value }}" {% if option.value == current_sort_by %}checked{% endif %} onchange="selectSortOption(this.value)" class="w-5 h-5 accent-[var(--color-accent)] cursor-pointer flex-shrink-0"/>
        </label>
      {%- endfor -%}
    </div>
  </div>
</div>
