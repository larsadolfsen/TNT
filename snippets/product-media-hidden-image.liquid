{% doc %}
  Hidden <img id="main-product-img"> that assets/product-media.js keeps in
  sync with the active slide. Exists purely for third-party cart/checkout
  apps that read a product image from the DOM rather than the Shopify API —
  never shown (class="hidden").

  @param {image} [featured_image] - Variant/product featured image; omitted when blank.

  @example
  {% render 'product-media-hidden-image', featured_image: featured_image %}
{% enddoc %}

<!-- Hidden dummy image for third-party cart compatibility -->
{%- if featured_image -%}
  <img id="main-product-img" src="{{ featured_image | image_url: width: 1200 }}" class="hidden" alt="" width="{{ featured_image.width | default: 1200 }}" height="{{ featured_image.height | default: 1200 }}" />
{%- endif -%}
