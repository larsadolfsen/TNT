{% doc %}
  Account row shown at the top of the mobile menu drawer (Surface 1),
  above the menu links, below the "Menu" title. Navigates straight to
  routes.account_url (Shopify redirects to login when signed out) — the
  mobile drawer is not the place for a floating dropdown panel.

  @example
  {% render 'header-account-mobile-row' %}
{% enddoc %}

{%- if customer -%}
  {%- liquid
    assign first_initial = customer.first_name | slice: 0, 1
    assign last_initial = customer.last_name | slice: 0, 1
    if first_initial != blank
      assign initials = first_initial | append: last_initial
    else
      assign initials = customer.email | slice: 0, 1
    endif
    assign initials = initials | upcase
  -%}
  <a href="{{ routes.account_url }}" class="flex items-center gap-3 min-h-[48px] py-2 border-b border-outline-variant text-primary no-underline focus-ring">
    <span class="w-7 h-7 shrink-0 rounded-full bg-primary text-on-primary flex items-center justify-center text-xs font-bold tracking-wider" aria-hidden="true">{{ initials }}</span>
    <span class="text-base font-semibold text-primary">{{ customer.first_name | default: customer.email }}</span>
  </a>
{%- else -%}
  <a href="{{ routes.account_url }}" class="flex items-center gap-3 min-h-[48px] py-2 border-b border-outline-variant text-primary no-underline focus-ring">
    {% render 'icon', name: 'user', class: 'text-2xl text-primary shrink-0' %}
    <span class="text-base font-semibold text-primary">{{ 'account.mobile_cta' | t }}</span>
  </a>
{%- endif -%}
