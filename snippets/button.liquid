{% doc %}
  Renders a button or link styled to match the existing CTA convention used
  throughout the theme (see the "Læg i kurv" button in
  blocks/product-buy-buttons.liquid): pill-shaped, bold label, subtle press
  scale, accent color for primary actions.

  @param {string} label - required. Visible button text.
  @param {string} [variant] - 'primary' (default) | 'secondary'. Primary uses the accent color (bg-accent/text-on-accent), matching the main CTA convention. Secondary uses the card-high surface with an outline border, matching the convention for buttons that sit inside a card (see ai.md section 2).
  @param {string} [as] - 'button' (default) | 'a' | 'submit'. 'a' renders an anchor tag (requires `url`); 'submit' renders a <button type="submit">.
  @param {string} [url] - Destination URL. Used when as: 'a'.
  @param {string} [class] - Extra CSS classes appended to the base variant style.
  @param {string} [attributes] - Raw additional HTML attributes appended verbatim (e.g. id="...", data-*, aria-label="...", onclick="...").

  @example
  {% render 'button', label: 'Læg i kurv' %}
  {% render 'button', label: 'Se alle produkter', variant: 'secondary', as: 'a', url: collection.url %}
  {% render 'button', label: 'Send', as: 'submit', attributes: 'id="btn-submit"' %}
{% enddoc %}

{%- liquid
  assign variant = variant | default: 'primary'
  assign as = as | default: 'button'

  if variant == 'secondary'
    assign base_class = 'bg-card-high hover:bg-surface-container text-primary border border-outline-variant font-bold h-12 px-6 rounded-full text-base shadow-sm active:scale-95 transition-all cursor-pointer focus:outline-none flex items-center justify-center gap-1'
  else
    assign base_class = 'bg-accent hover:brightness-95 text-on-accent font-bold h-12 px-6 rounded-full text-base shadow-sm active:scale-95 transition-all cursor-pointer focus:outline-none flex items-center justify-center gap-1'
  endif

  assign full_class = base_class
  if class
    assign full_class = full_class | append: ' ' | append: class
  endif
-%}
{%- if as == 'a' -%}
  <a href="{{ url }}" class="{{ full_class }} no-underline"{% if attributes %} {{ attributes }}{% endif %}>{{ label }}</a>
{%- else -%}
  <button type="{% if as == 'submit' %}submit{% else %}button{% endif %}" class="{{ full_class }}"{% if attributes %} {{ attributes }}{% endif %}>{{ label }}</button>
{%- endif -%}
