{%- comment %}
  Renders a reusable product card. This file resolves the card's data (badge
  tag, variant, price, unit-pricing rule, rating) and composes the zones; the
  zones themselves live in product-card-image / product-card-price /
  star-rating / savings-badge / button.

  Accepts:
  - product: {Object} Shopify Product object (required unless placeholder_index is set)
  - class: {String} Extra classes to apply to the card (optional)
  - layout: {String} 'minimal' or 'standard' (optional)
  - disable_reviews: {Boolean} Disable reviews display (optional)
  - placeholder_index: {Number} Renders a numbered design-mode mockup card
    instead, for editor previews when no real products are available yet.
    Omit `product` when using this.

  Usage:
  {% render 'product-card', product: product, layout: 'minimal', disable_reviews: section.settings.disable_reviews %}
  {% render 'product-card', placeholder_index: 1 %}
{% endcomment -%}

{%- if product == blank and placeholder_index != blank -%}
  <div class="product-card flex flex-col bg-transparent max-h-[420px] sm:max-h-none border border-outline-variant rounded-2xl p-3">
    <div class="relative w-full aspect-square bg-surface-container rounded-2xl flex items-center justify-center overflow-hidden mb-2">
      {{ 'product-' | append: placeholder_index | placeholder_svg_tag: 'w-full h-full bg-slate-100 opacity-50' }}
    </div>
    <div class="space-y-1">
      <h3 class="type-sans">Eksempel produkt {{ placeholder_index }}</h3>
      <p class="type-md type-bold text-primary">199,00 kr.</p>
    </div>
  </div>
{%- elsif product != blank -%}
  {%- liquid
    assign is_minimal = false
    if layout == 'minimal'
      assign is_minimal = true
    endif

    assign badge = ''

    for tag in product.tags
      assign tag_down = tag | downcase
      if tag_down contains 'badge:'
        assign badge = tag | remove_first: 'badge:' | remove_first: 'Badge:' | strip
      endif
    endfor

    assign variant = product.first_available_variant | default: product.variants[0]
    assign price = product.price
    assign original_price = product.compare_at_price

    # Headline rule: when the card's variant carries native Shopify unit
    # pricing (unit_price_measurement), the unit price is the headline price
    # and the raw per-unit price is suppressed. No product type/tag/metafield
    # gating — presence of unit pricing is the only signal, so this stays
    # correct for any merchant who configures it, not just this catalog.
    assign unit_measurement = variant.unit_price_measurement
    assign has_unit_price = false
    if unit_measurement != blank
      assign has_unit_price = true
    endif

    if has_unit_price
      assign unit_suffix = unit_measurement.reference_unit
      if unit_measurement.reference_value != 1
        assign unit_suffix = unit_measurement.reference_value | append: ' ' | append: unit_measurement.reference_unit
      endif
    endif

    # Let's mock a rating if metafields are not present, or use product rating metafields if they are
    assign rating = product.metafields.reviews.rating.value | default: 4.8
    assign reviews_count = product.metafields.reviews.rating_count.value | default: 142
  -%}

  <div class="product-card flex flex-col transition-all duration-300 group relative {{ class }}{% if is_minimal %} bg-transparent max-h-[420px] sm:max-h-none{% else %} bg-card-light border border-outline-variant rounded-2xl overflow-hidden hover:shadow-md hover:border-primary/40{% endif %}" data-product-id="{{ product.id }}" data-layout="{% if is_minimal %}minimal{% else %}standard{% endif %}">
    
    <!-- Image Zone -->
    {%- render 'product-card-image', product: product, is_minimal: is_minimal, badge: badge -%}
    <!-- Info Zone -->
    <div class="p-3 flex flex-col justify-start flex-1 min-w-0">
      <div class="space-y-1">
        {%- if is_minimal -%}
          <h3 class="type-sans mb-1">
            <a href="{{ product.url }}" class="text-primary no-underline">{{ product.title }}</a>
          </h3>
        {%- else -%}
          <h3 class="type-sans mb-1 hover:text-secondary">
            <a href="{{ product.url }}" class="text-primary no-underline hover:text-secondary">{{ product.title }}</a>
          </h3>
        {%- endif -%}
        
        <div class="product-savings-container flex items-center mt-1 mb-1">
          {%- unless settings.disable_savings_badge -%}
            {%- if original_price > price -%}
              {%- assign savings = original_price | minus: price | times: 100 | divided_by: original_price -%}
              {%- render 'savings-badge', savings: savings -%}
            {%- endif -%}
          {%- endunless -%}
        </div>
        
        <!-- Rating: 5 Stars -->
        {%- unless disable_reviews -%}
          {%- liquid
            assign star_size = 14
            assign rating_wrapper_class = 'type-sm'
            if is_minimal
              assign star_size = 12
              assign rating_wrapper_class = 'type-xs'
            endif
          -%}
          {%- render 'star-rating',
            rating: rating,
            reviews_count: reviews_count,
            star_size: star_size,
            wrapper_class: rating_wrapper_class
          -%}
        {%- endunless -%}

        <!-- Price display (moved directly below rating/title) -->
        {%- render 'product-card-price',
          product: product,
          variant: variant,
          price: price,
          original_price: original_price,
          has_unit_price: has_unit_price,
          unit_suffix: unit_suffix,
          is_minimal: is_minimal
        -%}
      </div>
 
      <!-- Buy Button (No divider border) -->
      {%- unless is_minimal -%}
        <div class="mt-3">
          {%- capture buy_attributes -%}
            onclick="window.addToCart('{{ variant.id }}')" aria-label="Køb {{ product.title | escape }}"
          {%- endcapture -%}
          {%- render 'button', label: 'Køb', size: 'sm', class: 'w-full', attributes: buy_attributes -%}
        </div>
      {%- endunless -%}
    </div>
  </div>
 

{%- endif -%}
