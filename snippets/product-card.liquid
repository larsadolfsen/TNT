{%- comment %}
  Renders a reusable product card.
  Accepts:
  - product: {Object} Shopify Product object (required)
  - class: {String} Extra classes to apply to the card (optional)
  - layout: {String} 'minimal' or 'standard' (optional)
  - disable_reviews: {Boolean} Disable reviews display (optional)
  
  Usage:
  {% render 'product-card', product: product, layout: 'minimal', disable_reviews: section.settings.disable_reviews %}
{% endcomment -%}

{%- if product != blank -%}
  {%- liquid
    assign is_minimal = false
    if layout == 'minimal'
      assign is_minimal = true
    endif

    assign thickness = ''
    assign width = ''
    assign form = ''
    assign badge = ''
    
    for tag in product.tags
      assign tag_down = tag | downcase
      if tag_down contains 'tykkelse:'
        assign thickness = tag | remove_first: 'tykkelse:' | remove_first: 'Tykkelse:' | strip
      elsif tag_down contains 'bredde:'
        assign width = tag | remove_first: 'bredde:' | remove_first: 'Bredde:' | strip
      elsif tag_down contains 'form:'
        assign form = tag | remove_first: 'form:' | remove_first: 'Form:' | strip
      elsif tag_down contains 'badge:'
        assign badge = tag | remove_first: 'badge:' | remove_first: 'Badge:' | strip
      endif
    endfor

    for option in product.options_with_values
      assign option_name = option.name | downcase
      if option_name contains 'tykkelse' or option_name contains 'thickness'
        assign thickness = option.values | first
      elsif option_name contains 'bredde' or option_name contains 'width' or option_name contains 'størrelse'
        assign width = option.values | first
      elsif option_name contains 'form' or option_name contains 'type'
        assign form = option.values | first
      endif
    endfor

    # Check if this is a meter product based on title, type, or tags/options
    assign is_meter_product = false
    assign product_title_down = product.title | downcase
    if product.type == 'Metervare' or product_title_down contains 'voksdug' or product_title_down contains 'bordbeskytter' or product_title_down contains 'meter' or thickness != blank or width != blank or form != blank
      assign is_meter_product = true
    endif

    # If it is a meter product, apply default fallbacks for missing values
    if is_meter_product
      if thickness == blank
        assign thickness = '1,2 mm'
      endif
      if width == blank
        assign width = '140 cm'
      endif
      if form == blank
        assign form = 'Firkantet'
      endif
    endif

    assign variant = product.first_available_variant | default: product.variants[0]
    assign price = product.price
    assign original_price = product.compare_at_price

    # Let's mock a rating if metafields are not present, or use product rating metafields if they are
    assign rating = product.metafields.reviews.rating.value | default: 4.8
    assign reviews_count = product.metafields.reviews.rating_count.value | default: 142
  -%}

  <div class="product-card flex flex-col transition-all duration-300 group relative {{ class }}{% if is_minimal %} bg-transparent max-h-[420px] sm:max-h-none{% else %} bg-card-light border border-outline-variant rounded-2xl overflow-hidden hover:shadow-md hover:border-primary/40{% endif %}" data-product-id="{{ product.id }}" data-layout="{% if is_minimal %}minimal{% else %}standard{% endif %}">
    
    <!-- Image Zone -->
    <div class="relative w-full flex-shrink-0 bg-surface-container overflow-hidden{% if is_minimal %} rounded-2xl border border-outline-variant{% endif %}" style="aspect-ratio: 1/1;">
      <a href="{{ product.url }}" class="block w-full h-full">
        {%- if product.featured_image != blank -%}
          <img 
            src="{{ product.featured_image | image_url: width: 480 }}" 
            alt="{{ product.title | escape }}" 
            class="product-card-image w-full h-full object-cover{% if is_minimal %} group-hover:scale-103 transition-transform duration-1000 ease-out{% else %} group-hover:scale-105 transition-transform duration-500{% endif %}"
            loading="lazy"
          />
        {%- else -%}
          <div class="w-full h-full flex items-center justify-center bg-outline-variant text-primary/85">
            <span class="material-symbols-outlined text-4xl">image</span>
          </div>
        {%- endif -%}
      </a>
      {%- if badge != blank -%}
        <span class="absolute top-2 left-2 bg-primary text-on-primary {% if is_minimal %}text-[8px] sm:text-[9px]{% else %}text-[10px] sm:text-xs{% endif %} font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10">{{ badge }}</span>
      {%- endif -%}
    </div>
    <!-- Info Zone -->
    <div class="p-3 flex flex-col justify-start flex-1 min-w-0">
      <div class="space-y-1">
        {%- if is_minimal -%}
          <h3 class="font-sans text-xs sm:text-sm font-normal text-primary leading-tight mb-1">
            <a href="{{ product.url }}" class="text-primary no-underline">{{ product.title }}</a>
          </h3>
        {%- else -%}
          <h3 class="text-sm sm:text-base font-normal text-primary leading-tight hover:text-secondary mb-1">
            <a href="{{ product.url }}" class="text-primary no-underline hover:text-secondary">{{ product.title }}</a>
          </h3>
        {%- endif -%}
        
        <div class="product-savings-container flex items-center mt-1 mb-1">
          {%- unless settings.disable_savings_badge -%}
            {%- if original_price > price -%}
              {%- assign savings = original_price | minus: price | times: 100 | divided_by: original_price -%}
              {%- assign badge_text = settings.savings_badge_text | default: "[savings] % rabat" | replace: "[savings]", savings -%}
              <span class="product-savings-badge inline-block bg-[#c8102e] text-white text-[10px] font-bold px-2 py-0.5 rounded-md uppercase">{{ badge_text }}</span>
            {%- endif -%}
          {%- endunless -%}
        </div>
        
        <!-- Rating: 5 Stars -->
        {%- unless disable_reviews -%}
          <div class="flex items-center gap-1 {% if is_minimal %}text-[10px]{% else %}text-xs sm:text-sm{% endif %} text-secondary mt-1">
            <div class="flex text-[#FFB800] gap-0.5">
              {%- assign rating_floor = rating | floor -%}
              {%- assign decimal = rating | minus: rating_floor -%}
              {%- assign rating_floor_plus_1 = rating_floor | plus: 1 -%}
              {%- for i in (1..5) -%}
                {%- if i <= rating_floor -%}
                  <span class="material-symbols-outlined {% if is_minimal %}text-[12px]{% else %}text-[14px]{% endif %} filled-star select-none" style="font-size: {% if is_minimal %}12px{% else %}14px{% endif %}; line-height: 1;">star</span>
                {%- elsif i == rating_floor_plus_1 -%}
                  {%- if decimal >= 0.75 -%}
                    <span class="material-symbols-outlined {% if is_minimal %}text-[12px]{% else %}text-[14px]{% endif %} filled-star select-none" style="font-size: {% if is_minimal %}12px{% else %}14px{% endif %}; line-height: 1;">star</span>
                  {%- elsif decimal >= 0.25 -%}
                    <span class="material-symbols-outlined {% if is_minimal %}text-[12px]{% else %}text-[14px]{% endif %} filled-star select-none" style="font-size: {% if is_minimal %}12px{% else %}14px{% endif %}; line-height: 1;">star_half</span>
                  {%- else -%}
                    <span class="material-symbols-outlined {% if is_minimal %}text-[12px]{% else %}text-[14px]{% endif %} text-outline-variant select-none" style="font-size: {% if is_minimal %}12px{% else %}14px{% endif %}; line-height: 1;">star</span>
                  {%- endif -%}
                {%- else -%}
                  <span class="material-symbols-outlined {% if is_minimal %}text-[12px]{% else %}text-[14px]{% endif %} text-outline-variant select-none" style="font-size: {% if is_minimal %}12px{% else %}14px{% endif %}; line-height: 1;">star</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <span class="font-bold text-primary ml-1">{{ rating }}</span>
            <span class="text-primary/85">({{ reviews_count }})</span>
          </div>
        {%- endunless -%}

        <!-- Price display (moved directly below rating/title) -->
        <div class="flex flex-col items-start gap-0.5 mt-1">
          {%- unless is_minimal -%}
            <span class="text-xs sm:text-sm text-primary/85 leading-none">
              {%- if is_meter_product -%}
                Pris pr. meter
              {%- else -%}
                Pris
              {%- endif -%}
            </span>
          {%- endunless -%}
          <div class="flex items-baseline gap-1.5 flex-wrap">
            <span class="{% if is_minimal %}text-xs sm:text-sm md:text-base{% else %}text-sm sm:text-base md:text-lg{% endif %} font-bold text-primary leading-none">
              {%- if product.price_varies or is_meter_product -%}Fra {%- endif -%}{{ price | money }}
            </span>
            {%- if original_price > price -%}
              <span class="text-[12px] text-primary/70 line-through leading-none">{{ original_price | money }}</span>
            {%- endif -%}
            {%- if is_minimal -%}
              <span class="text-[9px] sm:text-[10px] text-primary/75 font-semibold">
                {%- if is_meter_product -%}pr. meter{%- endif -%}
              </span>
            {%- endif -%}
          </div>
        </div>

        {%- if product.variants.size > 1 -%}
          <div class="product-variant-swatches mt-3 space-y-{% if is_minimal %}2{% else %}2.5{% endif %} border-t border-outline-variant/40 pt-2{% unless is_minimal %}.5{% endunless %}">
            {%- for option in product.options_with_values -%}
              {%- assign option_name_down = option.name | downcase -%}
              {%- assign is_color = false -%}
              {%- if option_name_down contains 'farve' or option_name_down contains 'mønster' or option_name_down contains 'color' or option_name_down contains 'colour' -%}
                {%- assign is_color = true -%}
              {%- endif -%}
              
              <div class="flex flex-col gap-1">
                <span class="text-[9px] font-bold text-primary/70 uppercase tracking-wider">
                  {{ option.name }}: <span class="text-primary font-semibold font-sans normal-case text-[10px]" data-selected-option-label="{{ product.id }}-{{ option.name }}">{{ variant.options[forloop.index0] }}</span>
                </span>
                <div class="flex flex-wrap gap-{% if is_minimal %}1{% else %}1.5{% endif %} mt-0.5">
                  {%- for value in option.values -%}
                    {%- assign is_selected = false -%}
                    {%- if variant.options[forloop.parentloop.index0] == value -%}
                      {%- assign is_selected = true -%}
                    {%- endif -%}
                    
                    {%- if is_color -%}
                      {%- assign swatch_img = product.featured_image -%}
                      {%- for v in product.variants -%}
                        {%- if v.options[forloop.parentloop.parentloop.index0] == value -%}
                          {%- if v.featured_image != blank -%}
                            {%- assign swatch_img = v.featured_image -%}
                          {%- endif -%}{%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      
                      <button 
                        type="button"
                        class="inline-flex items-center gap-1.5 {% if is_minimal %}px-2 py-0.5 text-[9px] sm:text-[11px]{% else %}px-2.5 py-1 text-[11px]{% endif %} rounded-full border bg-card-high cursor-pointer transition-all {% if is_selected %}border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold{% else %}border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80{% endif %}"
                        data-product-id="{{ product.id }}"
                        data-option-name="{{ option.name }}"
                        data-option-value="{{ value | escape }}"
                        onclick="onCardVariantClick(this)"
                        title="{{ value | escape }}"
                      >
                        <span class="{% if is_minimal %}w-3 h-3 sm:w-3.5 sm:h-3.5{% else %}w-3.5 h-3.5{% endif %} rounded-full overflow-hidden flex-shrink-0 border border-black/10">
                          <img src="{{ swatch_img | image_url: width: 50 }}" alt="{{ value | escape }}" class="w-full h-full object-cover" />
                        </span>
                        <span>{{ value }}</span>
                      </button>
                    {%- else -%}
                      <button 
                        type="button"
                        class="{% if is_minimal %}px-2 py-0.5 text-[9px] sm:text-[11px]{% else %}px-2.5 py-1 text-[11px]{% endif %} rounded-full border bg-card-high cursor-pointer transition-all {% if is_selected %}border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold{% else %}border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80{% endif %}"
                        data-product-id="{{ product.id }}"
                        data-option-name="{{ option.name }}"
                        data-option-value="{{ value | escape }}"
                        onclick="onCardVariantClick(this)"
                      >
                        {{ value }}
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
 
        {%- if is_meter_product -%}
          <!-- Shape swatches -->
          {%- assign current_form = form | default: 'Firkantet' | downcase -%}
          <div class="product-shape-swatches mt-3 space-y-2 border-t border-outline-variant/40 pt-2">
            <div class="flex flex-col gap-0.5">
              <span class="text-[9px] font-bold text-primary/70 uppercase tracking-wider">Form: <span class="text-primary font-semibold font-sans normal-case text-[10px]">{{ form | default: 'Firkantet' }}</span></span>
              <div class="flex flex-wrap gap-1.5 mt-0.5">
                <a href="/products/firkantet-dug-1" class="px-2.5 py-1 text-[11px] rounded-full border bg-card-high cursor-pointer transition-all no-underline text-center flex items-center justify-center {% if current_form == 'firkantet' %}border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold{% else %}border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80{% endif %}">Firkantet</a>
                <a href="/products/afrunding" class="px-2.5 py-1 text-[11px] rounded-full border bg-card-high cursor-pointer transition-all no-underline text-center flex items-center justify-center {% if current_form == 'rund' %}border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold{% else %}border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80{% endif %}">Rund</a>
                <a href="/products/oval-dug" class="px-2.5 py-1 text-[11px] rounded-full border bg-card-high cursor-pointer transition-all no-underline text-center flex items-center justify-center {% if current_form == 'oval' %}border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold{% else %}border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80{% endif %}">Oval</a>
              </div>
            </div>
          </div>
        {%- endif -%}
 
        <script type="application/json" class="product-variants-json">
          {
            "id": {{ product.id | json }},
            "title": {{ product.title | json }},
            "type": {{ product.type | json }},
            "image": {{ product.featured_image | image_url: width: 480 | json }},
            "badge": {{ badge | json }},
            "options_with_values": [
              {%- for option in product.options_with_values -%}
                {
                  "name": {{ option.name | json }},
                  "values": {{ option.values | json }}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ],
            "variants": [
              {%- for v in product.variants -%}
                {%- liquid
                  assign v_display_price = v.price
                  assign v_display_orig_price = v.compare_at_price
                  
                  if product.type == 'Metervare'
                    assign v_display_price = v.price | times: 100
                    if v.compare_at_price != blank and v.compare_at_price > 0
                      assign v_display_orig_price = v.compare_at_price | times: 100
                    endif
                  endif
 
                  assign v_price = v_display_price | money_without_currency | replace: '.', '' | replace: ',', '.' | plus: 0
                  assign v_originalPrice = v_display_orig_price | money_without_currency | replace: '.', '' | replace: ',', '.' | plus: 0
                  if v_originalPrice == 0
                    assign v_originalPrice = 'null'
                  endif
                -%}
                {
                  "id": {{ v.id | json }},
                  "title": {{ v.title | json }},
                  "available": {{ v.available | json }},
                  "price": {{ v_price }},
                  "price_formatted": {{ v_display_price | money | json }},
                  "originalPrice": {{ v_originalPrice }},
                  "originalPrice_formatted": {% if v_originalPrice != 'null' %}{{ v_display_orig_price | money | json }}{% else %}null{% endif %},
                  "image": {% if v.featured_image != blank %}{{ v.featured_image | image_url: width: 480 | json }}{% else %}{{ product.featured_image | image_url: width: 480 | json }}{% endif %},
                  "options": {
                    {%- for option in product.options_with_values -%}
                      {%- liquid
                        assign opt_index = forloop.index0
                        assign opt_val = v.options[opt_index]
                      -%}
                      {{ option.name | json }}: {{ opt_val | json }}{%- unless forloop.last -%},{%- endunless -%}
                    {%- endfor -%}
                  }
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          }
        </script>
      </div>
 
      <!-- Buy Button (No divider border) -->
      {%- unless is_minimal -%}
        <div class="mt-3">
          <button 
            onclick="window.addToCart('{{ variant.id }}')" 
            class="w-full bg-accent hover:brightness-95 text-primary py-2 rounded-full flex items-center justify-center gap-1.5 transition-colors focus:outline-none text-xs sm:text-sm font-bold border-0 cursor-pointer" 
            aria-label="Køb {{ product.title | escape }}"
          >
            <span>Køb</span>
          </button>
        </div>
      {%- endunless -%}
    </div>
  </div>
 
  {%- unless request.design_mode -%}
    <script>
      if (typeof window.onCardVariantClick !== 'function') {
        window.onCardVariantClick = function(buttonEl) {
          const disableSavingsBadge = {{ settings.disable_savings_badge | json }};
          const savingsBadgeTextTemplate = {{ settings.savings_badge_text | default: "[savings] % rabat" | json }};
          const cardEl = buttonEl.closest('.product-card');
          if (!cardEl) return;
          
          const isMinimal = (cardEl.dataset.layout === 'minimal');
          
          // Read JSON product data
          const jsonEl = cardEl.querySelector('.product-variants-json');
          if (!jsonEl) return;
          const product = JSON.parse(jsonEl.textContent);
          
          const optionName = buttonEl.dataset.optionName;
          const optionValue = buttonEl.dataset.optionValue;
          const productId = product.id;
          
          // Update buttons styling
          const optionButtons = Array.from(cardEl.querySelectorAll('button[data-option-name]')).filter(btn => btn.dataset.optionName === optionName);
          optionButtons.forEach(btn => {
            const isColor = btn.querySelector('img') !== null;
            const val = btn.dataset.optionValue;
            const isSelected = (val === optionValue);
            
            if (isColor) {
              if (isSelected) {
                btn.className = isMinimal 
                  ? "inline-flex items-center gap-1.5 px-2 py-0.5 text-[9px] sm:text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold"
                  : "inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold";
              } else {
                btn.className = isMinimal 
                  ? "inline-flex items-center gap-1.5 px-2 py-0.5 text-[9px] sm:text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80"
                  : "inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80";
              }
            } else {
              if (isSelected) {
                btn.className = isMinimal 
                  ? "px-2 py-0.5 text-[9px] sm:text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold"
                  : "px-2.5 py-1 text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold";
              } else {
                btn.className = isMinimal 
                  ? "px-2 py-0.5 text-[9px] sm:text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80"
                  : "px-2.5 py-1 text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80";
              }
            }
          });

          // Update label text showing selected value
          const labelSpan = Array.from(cardEl.querySelectorAll('[data-selected-option-label]')).find(span => span.dataset.selectedOptionLabel === `${productId}-${optionName}`);
          if (labelSpan) {
            labelSpan.textContent = optionValue;
          }

          // Now gather all currently selected options on this card
          const activeOptions = {};
          const selectedButtons = Array.from(cardEl.querySelectorAll('.product-variant-swatches button')).filter(btn => btn.classList.contains('border-[var(--color-accent)]'));
          selectedButtons.forEach(btn => {
            activeOptions[btn.dataset.optionName] = btn.dataset.optionValue;
          });

          // Fallback for options that don't have selected buttons yet
          product.options_with_values.forEach(opt => {
            if (!activeOptions[opt.name]) {
              // Find active option from default variant
              const defaultBtn = Array.from(cardEl.querySelectorAll('button[data-option-name]')).find(btn => btn.dataset.optionName === opt.name && btn.classList.contains('border-[var(--color-accent)]'));
              if (defaultBtn) {
                activeOptions[opt.name] = defaultBtn.dataset.optionValue;
              } else {
                // Find first available value
                activeOptions[opt.name] = opt.values[0];
              }
            }
          });

          // Find matching variant
          let matchingVariant = product.variants.find(v => {
            return Object.entries(activeOptions).every(([name, val]) => {
              return v.options[name] === val;
            });
          });

          // If no perfect match, find first variant matching the clicked option value
          if (!matchingVariant) {
            matchingVariant = product.variants.find(v => v.options[optionName] === optionValue);
            
            // Update other swatches styling to match this found variant's options
            if (matchingVariant) {
              product.options_with_values.forEach(opt => {
                const matchingVal = matchingVariant.options[opt.name];
                const labelSpanToUpdate = Array.from(cardEl.querySelectorAll('[data-selected-option-label]')).find(span => span.dataset.selectedOptionLabel === `${productId}-${opt.name}`);
                if (labelSpanToUpdate) {
                  labelSpanToUpdate.textContent = matchingVal;
                }
                
                const optBtns = Array.from(cardEl.querySelectorAll('button[data-option-name]')).filter(btn => btn.dataset.optionName === opt.name);
                optBtns.forEach(btn => {
                  const isColor = btn.querySelector('img') !== null;
                  const val = btn.dataset.optionValue;
                  const isSelected = (val === matchingVal);
                  
                  if (isColor) {
                    if (isSelected) {
                      btn.className = isMinimal 
                        ? "inline-flex items-center gap-1.5 px-2 py-0.5 text-[9px] sm:text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold"
                        : "inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold";
                    } else {
                      btn.className = isMinimal 
                        ? "inline-flex items-center gap-1.5 px-2 py-0.5 text-[9px] sm:text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80"
                        : "inline-flex items-center gap-1.5 px-2.5 py-1 text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80";
                    }
                  } else {
                    if (isSelected) {
                      btn.className = isMinimal 
                        ? "px-2 py-0.5 text-[9px] sm:text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold"
                        : "px-2.5 py-1 text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold";
                    } else {
                      btn.className = isMinimal 
                        ? "px-2 py-0.5 text-[9px] sm:text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80"
                        : "px-2.5 py-1 text-[11px] rounded-full border bg-card-high cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80";
                    }
                  }
                });
              });
            }
          }

          if (matchingVariant) {
            // 1. Update card image
            const imgEl = cardEl.querySelector('img');
            if (imgEl) {
              imgEl.src = matchingVariant.image;
            }

            // 2. Update price display
            const priceValEl = cardEl.querySelector('.text-sm.sm\\:text-base.md\\:text-lg.font-bold.text-primary.leading-none, .text-xs.sm\\:text-sm.md\\:text-base.font-bold.text-primary.leading-none');
            if (priceValEl) {
              const isMetervare = product.type === "Metervare";
              const isMeterProduct = product.thickness || product.width || product.title.toLowerCase().includes("voksdug") || product.title.toLowerCase().includes("bordbeskytter");
              const pricePrefix = isMetervare || isMeterProduct ? 'Fra ' : '';
              priceValEl.textContent = `${pricePrefix}${matchingVariant.price_formatted}`;
            }

            // 3. Update original price display
            const priceWrapper = cardEl.querySelector('.flex.items-baseline.gap-1.5');
            if (priceWrapper) {
              let originalPriceEl = priceWrapper.querySelector('.line-through');
              if (matchingVariant.originalPrice && matchingVariant.originalPrice > matchingVariant.price) {
                if (!originalPriceEl) {
                  originalPriceEl = document.createElement('span');
                  originalPriceEl.className = "text-[12px] text-primary/70 line-through leading-none";
                  priceWrapper.appendChild(originalPriceEl);
                }
                originalPriceEl.textContent = matchingVariant.originalPrice_formatted;
              } else if (originalPriceEl) {
                originalPriceEl.remove();
              }
            }

            // Update badge (only product.badge is on the image now)
            let badgeEl = cardEl.querySelector('.relative.w-full.flex-shrink-0 span');
            if (product.badge) {
              if (!badgeEl) {
                badgeEl = document.createElement('span');
                badgeEl.className = isMinimal 
                  ? "absolute top-2 left-2 bg-primary text-on-primary text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10"
                  : "absolute top-2 left-2 bg-primary text-on-primary text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
                cardEl.querySelector('.relative.w-full.flex-shrink-0').appendChild(badgeEl);
              } else {
                badgeEl.className = isMinimal 
                  ? "absolute top-2 left-2 bg-primary text-on-primary text-[8px] sm:text-[9px] font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10"
                  : "absolute top-2 left-2 bg-primary text-on-primary text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
              }
              badgeEl.textContent = product.badge;
            } else if (badgeEl) {
              badgeEl.remove();
            }

            // Update savings badge under the name
            const savingsContainer = cardEl.querySelector('.product-savings-container');
            if (savingsContainer) {
              let savingsBadge = savingsContainer.querySelector('.product-savings-badge');
              if (!disableSavingsBadge && matchingVariant.originalPrice && matchingVariant.originalPrice > matchingVariant.price) {
                const savings = Math.round(((matchingVariant.originalPrice - matchingVariant.price) / matchingVariant.originalPrice) * 100);
                if (!savingsBadge) {
                  savingsBadge = document.createElement('span');
                  savingsBadge.className = "product-savings-badge inline-block bg-[#c8102e] text-white text-[10px] font-bold px-2 py-0.5 rounded-md uppercase";
                  savingsContainer.appendChild(savingsBadge);
                }
                savingsBadge.textContent = savingsBadgeTextTemplate.replace('[savings]', savings);
              } else if (savingsBadge) {
                savingsBadge.remove();
              }
            }

            // 4. Update button active variant target
            const buyButton = cardEl.querySelector('button');
            if (buyButton && !isMinimal) {
              if (matchingVariant.available) {
                buyButton.disabled = false;
                buyButton.classList.remove('opacity-50', 'cursor-not-allowed', 'bg-slate-200');
                buyButton.classList.add('bg-accent', 'hover:brightness-95');
                buyButton.setAttribute('onclick', `window.addToCart('${matchingVariant.id}')`);
                buyButton.innerHTML = `<span>Køb</span>`;
              } else {
                buyButton.disabled = true;
                buyButton.classList.add('opacity-50', 'cursor-not-allowed', 'bg-slate-200');
                buyButton.classList.remove('bg-accent', 'hover:brightness-95');
                buyButton.removeAttribute('onclick');
                buyButton.innerHTML = `<span>Udsolgt</span>`;
              }
            }
          }
        };
      }
    </script>
  {%- endunless -%}
{%- endif -%}
