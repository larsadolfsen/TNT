{%- comment %}
  Renders a reusable product card.
  Accepts:
  - product: {Object} Shopify Product object (required)
  - class: {String} Extra classes to apply to the card (optional)
  
  Usage:
  {% render 'product-card', product: product %}
{% endcomment -%}

{%- if product != blank -%}
  {%- liquid
    assign thickness = '1,2 mm'
    assign width = '140 cm'
    assign form = 'Firkantet'
    assign badge = ''
    
    for tag in product.tags
      assign tag_down = tag | downcase
      if tag_down contains 'tykkelse:'
        assign thickness = tag | remove_first: 'tykkelse:' | remove_first: 'Tykkelse:' | strip
      elsif tag_down contains 'bredde:'
        assign width = tag | remove_first: 'bredde:' | remove_first: 'Bredde:' | strip
      elsif tag_down contains 'form:'
        assign form = tag | remove_first: 'form:' | remove_first: 'Form:' | strip
      elsif tag_down contains 'badge:'
        assign badge = tag | remove_first: 'badge:' | remove_first: 'Badge:' | strip
      endif
    endfor

    for option in product.options_with_values
      assign option_name = option.name | downcase
      if option_name contains 'tykkelse' or option_name contains 'thickness'
        assign thickness = option.values | first
      elsif option_name contains 'bredde' or option_name contains 'width' or option_name contains 'størrelse'
        assign width = option.values | first
      elsif option_name contains 'form' or option_name contains 'type'
        assign form = option.values | first
      endif
    endfor

    assign variant = product.first_available_variant | default: product.variants[0]
    assign price = product.price
    assign original_price = product.compare_at_price

    # Check if this is a meter product based on title or tags
    assign is_meter_product = false
    assign product_title_down = product.title | downcase
    if product_title_down contains 'voksdug' or product_title_down contains 'bordbeskytter' or product_title_down contains 'meter' or thickness != blank or width != blank
      assign is_meter_product = true
    endif

    # Let's mock a rating if metafields are not present, or use product rating metafields if they are
    assign rating = product.metafields.reviews.rating.value | default: 4.8
    assign reviews_count = product.metafields.reviews.rating_count.value | default: 142
  -%}

  <div class="product-card flex flex-col bg-card-light border border-outline-variant rounded-2xl overflow-hidden hover:shadow-md hover:border-primary/40 transition-all duration-300 group relative {{ class }}">
    
    <!-- Image Zone -->
    <div class="relative w-full flex-shrink-0 bg-surface-container overflow-hidden" style="aspect-ratio: 1/1;">
      <a href="{{ product.url }}" class="block w-full h-full">
        {%- if product.featured_image != blank -%}
          <img 
            src="{{ product.featured_image | image_url: width: 480 }}" 
            alt="{{ product.title | escape }}" 
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            loading="lazy"
          />
        {%- else -%}
          <div class="w-full h-full flex items-center justify-center bg-outline-variant text-primary/85">
            <span class="material-symbols-outlined text-4xl">image</span>
          </div>
        {%- endif -%}
      </a>
      {%- if badge != blank -%}
        <span class="absolute top-2 left-2 bg-primary text-on-primary text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10">{{ badge }}</span>
      {%- elsif original_price > price -%}
        {%- assign savings = original_price | minus: price | times: 100 | divided_by: original_price -%}
        <span class="absolute top-2 left-2 bg-secondary text-on-accent text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10">Spar {{ savings }}%</span>
      {%- endif -%}
    </div>

    <!-- Info Zone -->
    <div class="p-3 flex flex-col justify-between flex-1 min-w-0">
      <div class="space-y-1">
        <h3 class="text-sm sm:text-base font-bold text-primary leading-tight hover:text-secondary mb-1">
          <a href="{{ product.url }}" class="text-primary no-underline hover:text-secondary line-clamp-2">{{ product.title }}</a>
        </h3>
        
        <!-- Rating: 5 Stars -->
        <div class="flex items-center gap-1 text-xs sm:text-sm text-secondary mt-1">
          <div class="flex text-star-rating gap-0.5">
            {%- assign rating_floor = rating | floor -%}
            {%- assign decimal = rating | minus: rating_floor -%}
            {%- assign rating_floor_plus_1 = rating_floor | plus: 1 -%}
            {%- for i in (1..5) -%}
              {%- if i <= rating_floor -%}
                <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star</span>
              {%- elsif i == rating_floor_plus_1 -%}
                {%- if decimal >= 0.75 -%}
                  <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star</span>
                {%- elsif decimal >= 0.25 -%}
                  <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star_half</span>
                {%- else -%}
                  <span class="material-symbols-outlined text-[14px] text-outline-variant select-none" style="font-size: 14px; line-height: 1;">star</span>
                {%- endif -%}
              {%- else -%}
                <span class="material-symbols-outlined text-[14px] text-outline-variant select-none" style="font-size: 14px; line-height: 1;">star</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
          <span class="font-bold text-primary ml-1">{{ rating }}</span>
          <span class="text-primary/85">({{ reviews_count }})</span>
        </div>

        {%- if product.variants.size > 1 -%}
          <div class="product-variant-swatches mt-3 space-y-2.5 border-t border-outline-variant/40 pt-2.5">
            {%- for option in product.options_with_values -%}
              {%- assign option_name_down = option.name | downcase -%}
              {%- assign is_color = false -%}
              {%- if option_name_down contains 'farve' or option_name_down contains 'mønster' or option_name_down contains 'color' or option_name_down contains 'colour' -%}
                {%- assign is_color = true -%}
              {%- endif -%}
              
              <div class="flex flex-col gap-1">
                <span class="text-[9px] font-bold text-primary/70 uppercase tracking-wider">
                  {{ option.name }}: <span class="text-primary font-semibold font-sans normal-case text-[10px]" data-selected-option-label="{{ product.id }}-{{ option.name }}">{{ variant.options[forloop.index0] }}</span>
                </span>
                <div class="flex flex-wrap gap-1.5 mt-0.5">
                  {%- for value in option.values -%}
                    {%- assign is_selected = false -%}
                    {%- if variant.options[forloop.parentloop.index0] == value -%}
                      {%- assign is_selected = true -%}
                    {%- endif -%}
                    
                    {%- if is_color -%}
                      {%- assign swatch_img = product.featured_image -%}
                      {%- for v in product.variants -%}
                        {%- if v.options[forloop.parentloop.parentloop.index0] == value -%}
                          {%- if v.featured_image != blank -%}
                            {%- assign swatch_img = v.featured_image -%}
                          {%- endif -%}{%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      
                      <button 
                        type="button"
                        class="w-10 h-10 rounded-xl overflow-hidden border-2 bg-card-high shadow-sm p-0.5 cursor-pointer transition-all {% if is_selected %}border-[var(--color-accent)] ring-2 ring-[var(--color-accent)]/30{% else %}border-outline-variant hover:border-[var(--color-accent)]/60{% endif %}"
                        data-product-id="{{ product.id }}"
                        data-option-name="{{ option.name }}"
                        data-option-value="{{ value | escape }}"
                        onclick="onCardVariantClick(this)"
                        title="{{ value | escape }}"
                      >
                        <img src="{{ swatch_img | image_url: width: 100 }}" alt="{{ value | escape }}" class="w-full h-full object-cover rounded-[10px]" />
                      </button>
                    {%- else -%}
                      <button 
                        type="button"
                        class="px-2.5 py-1 text-[11px] rounded-xl border-2 bg-card-high shadow-sm cursor-pointer transition-all {% if is_selected %}border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold{% else %}border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80{% endif %}"
                        data-product-id="{{ product.id }}"
                        data-option-name="{{ option.name }}"
                        data-option-value="{{ value | escape }}"
                        onclick="onCardVariantClick(this)"
                      >
                        {{ value }}
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          </div>

          <script type="application/json" class="product-variants-json">
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "type": {{ product.type | json }},
              "image": {{ product.featured_image | image_url: width: 480 | json }},
              "badge": {{ badge | json }},
              "options_with_values": [
                {%- for option in product.options_with_values -%}
                  {
                    "name": {{ option.name | json }},
                    "values": {{ option.values | json }}
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ],
              "variants": [
                {%- for v in product.variants -%}
                  {%- liquid
                    assign v_display_price = v.price
                    assign v_display_orig_price = v.compare_at_price
                    
                    if product.type == 'Metervare'
                      assign v_display_price = v.price | times: 100
                      if v.compare_at_price != blank and v.compare_at_price > 0
                        assign v_display_orig_price = v.compare_at_price | times: 100
                      endif
                    endif

                    assign v_price = v_display_price | money_without_currency | replace: '.', '' | replace: ',', '.' | plus: 0
                    assign v_originalPrice = v_display_orig_price | money_without_currency | replace: '.', '' | replace: ',', '.' | plus: 0
                    if v_originalPrice == 0
                      assign v_originalPrice = 'null'
                    endif
                  -%}
                  {
                    "id": {{ v.id | json }},
                    "title": {{ v.title | json }},
                    "available": {{ v.available | json }},
                    "price": {{ v_price }},
                    "price_formatted": {{ v_display_price | money | json }},
                    "originalPrice": {{ v_originalPrice }},
                    "originalPrice_formatted": {% if v_originalPrice != 'null' %}{{ v_display_orig_price | money | json }}{% else %}null{% endif %},
                    "image": {% if v.featured_image != blank %}{{ v.featured_image | image_url: width: 480 | json }}{% else %}{{ product.featured_image | image_url: width: 480 | json }}{% endif %},
                    "options": {
                      {%- for option in product.options_with_values -%}
                        {%- liquid
                          assign opt_index = forloop.index0
                          assign opt_val = v.options[opt_index]
                        -%}
                        {{ option.name | json }}: {{ opt_val | json }}{%- unless forloop.last -%},{%- endunless -%}
                      {%- endfor -%}
                    }
                  }{%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
              ]
            }
          </script>
        {%- endif -%}
      </div>

      <!-- Price & Buy Button (No divider border) -->
      <div class="mt-3 space-y-3">
        <div class="flex flex-col items-start gap-1">
          <span class="text-xs sm:text-sm text-primary/85 leading-none">
            {%- if is_meter_product -%}
              Pris pr. meter
            {%- else -%}
              Pris
            {%- endif -%}
          </span>
          <div class="flex items-baseline gap-1.5 flex-wrap">
            <span class="text-sm sm:text-base md:text-lg font-bold text-primary leading-none">
              {%- if product.price_varies or is_meter_product -%}Fra {%- endif -%}{{ price | money }}
            </span>
            {%- if original_price > price -%}
              <span class="text-xs text-primary/70 line-through leading-none">{{ original_price | money }}</span>
            {%- endif -%}
          </div>
        </div>

        <button 
          onclick="window.addToCart('{{ variant.id }}')" 
          class="w-full bg-accent hover:brightness-95 text-primary py-2 rounded-full flex items-center justify-center gap-1.5 transition-colors focus:outline-none text-xs sm:text-sm font-bold border-0 cursor-pointer" 
          aria-label="Køb {{ product.title | escape }}"
        >
          <span>Køb</span>
        </button>
      </div>
    </div>

  {%- unless request.design_mode -%}
    <script>
      if (typeof window.onCardVariantClick !== 'function') {
        window.onCardVariantClick = function(buttonEl) {
          const cardEl = buttonEl.closest('.product-card');
          if (!cardEl) return;
          
          // Read JSON product data
          const jsonEl = cardEl.querySelector('.product-variants-json');
          if (!jsonEl) return;
          const product = JSON.parse(jsonEl.textContent);
          
          const optionName = buttonEl.dataset.optionName;
          const optionValue = buttonEl.dataset.optionValue;
          const productId = product.id;           // Update buttons styling
          const optionButtons = Array.from(cardEl.querySelectorAll('button[data-option-name]')).filter(btn => btn.dataset.optionName === optionName);
          optionButtons.forEach(btn => {
            const isColor = btn.querySelector('img') !== null;
            const val = btn.dataset.optionValue;
            const isSelected = (val === optionValue);
            
            if (isColor) {
              if (isSelected) {
                btn.className = "w-10 h-10 rounded-xl overflow-hidden border-2 bg-card-high shadow-sm p-0.5 cursor-pointer transition-all border-[var(--color-accent)] ring-2 ring-[var(--color-accent)]/30";
              } else {
                btn.className = "w-10 h-10 rounded-xl overflow-hidden border-2 bg-card-high shadow-sm p-0.5 cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60";
              }
            } else {
              if (isSelected) {
                btn.className = "px-2.5 py-1 text-[11px] rounded-xl border-2 bg-card-high shadow-sm cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold";
              } else {
                btn.className = "px-2.5 py-1 text-[11px] rounded-xl border-2 bg-card-high shadow-sm cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80";
              }
            }
          });

          // Update label text showing selected value
          const labelSpan = Array.from(cardEl.querySelectorAll('[data-selected-option-label]')).find(span => span.dataset.selectedOptionLabel === `${productId}-${optionName}`);
          if (labelSpan) {
            labelSpan.textContent = optionValue;
          }

          // Now gather all currently selected options on this card
          const activeOptions = {};
          const selectedButtons = Array.from(cardEl.querySelectorAll('.product-variant-swatches button')).filter(btn => btn.classList.contains('border-[var(--color-accent)]'));
          selectedButtons.forEach(btn => {
            activeOptions[btn.dataset.optionName] = btn.dataset.optionValue;
          });

          // Fallback for options that don't have selected buttons yet
          product.options_with_values.forEach(opt => {
            if (!activeOptions[opt.name]) {
              // Find active option from default variant
              const defaultBtn = Array.from(cardEl.querySelectorAll('button[data-option-name]')).find(btn => btn.dataset.optionName === opt.name && btn.classList.contains('border-[var(--color-accent)]'));
              if (defaultBtn) {
                activeOptions[opt.name] = defaultBtn.dataset.optionValue;
              } else {
                // Find first available value
                activeOptions[opt.name] = opt.values[0];
              }
            }
          });

          // Find matching variant
          let matchingVariant = product.variants.find(v => {
            return Object.entries(activeOptions).every(([name, val]) => {
              return v.options[name] === val;
            });
          });

          // If no perfect match, find first variant matching the clicked option value
          if (!matchingVariant) {
            matchingVariant = product.variants.find(v => v.options[optionName] === optionValue);
            
            // Update other swatches styling to match this found variant's options
            if (matchingVariant) {
              product.options_with_values.forEach(opt => {
                const matchingVal = matchingVariant.options[opt.name];
                const labelSpanToUpdate = Array.from(cardEl.querySelectorAll('[data-selected-option-label]')).find(span => span.dataset.selectedOptionLabel === `${productId}-${opt.name}`);
                if (labelSpanToUpdate) {
                  labelSpanToUpdate.textContent = matchingVal;
                }
                
                const optBtns = Array.from(cardEl.querySelectorAll('button[data-option-name]')).filter(btn => btn.dataset.optionName === opt.name);
                optBtns.forEach(btn => {
                  const isColor = btn.querySelector('img') !== null;
                  const val = btn.dataset.optionValue;
                  const isSelected = (val === matchingVal);
                  
                  if (isColor) {
                    if (isSelected) {
                      btn.className = "w-10 h-10 rounded-xl overflow-hidden border-2 bg-card-high shadow-sm p-0.5 cursor-pointer transition-all border-[var(--color-accent)] ring-2 ring-[var(--color-accent)]/30";
                    } else {
                      btn.className = "w-10 h-10 rounded-xl overflow-hidden border-2 bg-card-high shadow-sm p-0.5 cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60";
                    }
                  } else {
                    if (isSelected) {
                      btn.className = "px-2.5 py-1 text-[11px] rounded-xl border-2 bg-card-high shadow-sm cursor-pointer transition-all border-[var(--color-accent)] bg-[var(--color-accent)]/5 text-primary font-bold";
                    } else {
                      btn.className = "px-2.5 py-1 text-[11px] rounded-xl border-2 bg-card-high shadow-sm cursor-pointer transition-all border-outline-variant hover:border-[var(--color-accent)]/60 text-primary/80";
                    }
                  }
                }); });
              });
            }
          }

          if (matchingVariant) {
            // 1. Update card image
            const imgEl = cardEl.querySelector('img');
            if (imgEl) {
              imgEl.src = matchingVariant.image;
            }

            // 2. Update price display
            const priceValEl = cardEl.querySelector('.text-sm.sm\\:text-base.md\\:text-lg.font-bold.text-primary.leading-none, .text-sm.sm\\:text-base.font-bold.text-primary.leading-none');
            if (priceValEl) {
              const isMetervare = product.type === "Metervare";
              const isMeterProduct = product.thickness || product.width || product.title.toLowerCase().includes("voksdug") || product.title.toLowerCase().includes("bordbeskytter");
              const pricePrefix = isMetervare || isMeterProduct ? 'Fra ' : '';
              priceValEl.textContent = `${pricePrefix}${matchingVariant.price_formatted}`;
            }

            // 3. Update original price display
            const priceWrapper = cardEl.querySelector('.flex.items-baseline.gap-1.5');
            if (priceWrapper) {
              let originalPriceEl = priceWrapper.querySelector('.line-through');
              if (matchingVariant.originalPrice && matchingVariant.originalPrice > matchingVariant.price) {
                if (!originalPriceEl) {
                  originalPriceEl = document.createElement('span');
                  originalPriceEl.className = "text-xs text-primary/70 line-through leading-none";
                  priceWrapper.appendChild(originalPriceEl);
                }
                originalPriceEl.textContent = matchingVariant.originalPrice_formatted;
              } else if (originalPriceEl) {
                originalPriceEl.remove();
              }
            }

            // Update badge
            let badgeEl = cardEl.querySelector('.absolute.top-2.left-2');
            if (matchingVariant.originalPrice && matchingVariant.originalPrice > matchingVariant.price) {
              const savings = Math.round(((matchingVariant.originalPrice - matchingVariant.price) / matchingVariant.originalPrice) * 100);
              if (!badgeEl) {
                badgeEl = document.createElement('span');
                badgeEl.className = "absolute top-2 left-2 bg-secondary text-white text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
                cardEl.querySelector('.relative.w-full.flex-shrink-0').appendChild(badgeEl);
              } else {
                badgeEl.className = "absolute top-2 left-2 bg-secondary text-white text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
              }
              badgeEl.textContent = `Spar ${savings}%`;
            } else if (product.badge) {
              if (!badgeEl) {
                badgeEl = document.createElement('span');
                badgeEl.className = "absolute top-2 left-2 bg-primary text-white text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
                cardEl.querySelector('.relative.w-full.flex-shrink-0').appendChild(badgeEl);
              } else {
                badgeEl.className = "absolute top-2 left-2 bg-primary text-white text-[10px] sm:text-xs font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10";
              }
              badgeEl.textContent = product.badge;
            } else if (badgeEl) {
              badgeEl.remove();
            }

            // 4. Update button active variant target
            const buyButton = cardEl.querySelector('button');
            if (buyButton) {
              if (matchingVariant.available) {
                buyButton.disabled = false;
                buyButton.classList.remove('opacity-50', 'cursor-not-allowed', 'bg-slate-200');
                buyButton.classList.add('bg-accent', 'hover:brightness-95');
                buyButton.setAttribute('onclick', `window.addToCart('${matchingVariant.id}')`);
                buyButton.innerHTML = `<span>Køb</span>`;
              } else {
                buyButton.disabled = true;
                buyButton.classList.add('opacity-50', 'cursor-not-allowed', 'bg-slate-200');
                buyButton.classList.remove('bg-accent', 'hover:brightness-95');
                buyButton.removeAttribute('onclick');
                buyButton.innerHTML = `<span>Udsolgt</span>`;
              }
            }
          }
        };
      }
    </script>
  {%- endunless -%}
{%- endif -%}
