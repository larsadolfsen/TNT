{%- comment %}
  Renders a reusable product card.
  Accepts:
  - product: {Object} Shopify Product object (required)
  - class: {String} Extra classes to apply to the card (optional)
  - layout: {String} 'minimal' or 'standard' (optional)
  - disable_reviews: {Boolean} Disable reviews display (optional)
  
  Usage:
  {% render 'product-card', product: product, layout: 'minimal', disable_reviews: section.settings.disable_reviews %}
{% endcomment -%}

{%- if product != blank -%}
  {%- liquid
    assign is_minimal = false
    if layout == 'minimal'
      assign is_minimal = true
    endif

    assign thickness = ''
    assign width = ''
    assign form = ''
    assign badge = ''
    
    for tag in product.tags
      assign tag_down = tag | downcase
      if tag_down contains 'tykkelse:'
        assign thickness = tag | remove_first: 'tykkelse:' | remove_first: 'Tykkelse:' | strip
      elsif tag_down contains 'bredde:'
        assign width = tag | remove_first: 'bredde:' | remove_first: 'Bredde:' | strip
      elsif tag_down contains 'form:'
        assign form = tag | remove_first: 'form:' | remove_first: 'Form:' | strip
      elsif tag_down contains 'badge:'
        assign badge = tag | remove_first: 'badge:' | remove_first: 'Badge:' | strip
      endif
    endfor

    for option in product.options_with_values
      assign option_name = option.name | downcase
      if option_name contains 'tykkelse' or option_name contains 'thickness'
        assign thickness = option.values | first
      elsif option_name contains 'bredde' or option_name contains 'width' or option_name contains 'størrelse'
        assign width = option.values | first
      elsif option_name contains 'form' or option_name contains 'type'
        assign form = option.values | first
      endif
    endfor

    # Check if this is a meter product based on title, type, tags/options, or metafield
    assign is_meter_product = false
    assign product_title_down = product.title | downcase
    if product.type == 'Metervare' or product_title_down contains 'voksdug' or product_title_down contains 'bordbeskytter' or product_title_down contains 'meter' or thickness != blank or width != blank or form != blank or product.metafields.custom.metervare.value == true or product.metafields.custom.metervare == true
      assign is_meter_product = true
    endif

    # If it is a meter product, apply default fallbacks for missing values
    if is_meter_product
      if thickness == blank
        assign thickness = '1,2 mm'
      endif
      if width == blank
        assign width = '140 cm'
      endif
      if form == blank
        assign form = 'Firkantet'
      endif
    endif

    assign variant = product.first_available_variant | default: product.variants[0]
    assign price = product.price
    assign original_price = product.compare_at_price

    if is_meter_product
      assign price = product.price | times: 100
      if original_price != blank and original_price > 0
        assign original_price = product.compare_at_price | times: 100
      endif
    endif

    # Let's mock a rating if metafields are not present, or use product rating metafields if they are
    assign rating = product.metafields.reviews.rating.value | default: 4.8
    assign reviews_count = product.metafields.reviews.rating_count.value | default: 142
  -%}

  <div class="product-card flex flex-col transition-all duration-300 group relative {{ class }}{% if is_minimal %} bg-transparent max-h-[420px] sm:max-h-none{% else %} bg-card-light border border-outline-variant rounded-2xl overflow-hidden hover:shadow-md hover:border-primary/40{% endif %}" data-product-id="{{ product.id }}" data-layout="{% if is_minimal %}minimal{% else %}standard{% endif %}">
    
    <!-- Image Zone -->
    <div class="relative w-full flex-shrink-0 bg-surface-container overflow-hidden{% if is_minimal %} rounded-2xl border border-outline-variant{% endif %}" style="aspect-ratio: 1/1;">
      <a href="{{ product.url }}" class="block w-full h-full">
        {%- if product.featured_image != blank -%}
          {%- capture img_classes -%}
            product-card-image{% if is_minimal %} group-hover:scale-103 transition-transform duration-1000 ease-out{% else %} group-hover:scale-105 transition-transform duration-500{% endif %}
          {%- endcapture -%}
          {%- render 'image',
            image: product.featured_image,
            fill: true,
            img_class: img_classes,
            width: 480,
            widths: '180, 360, 480, 720',
            sizes: '(max-width: 640px) 180px, 320px',
            alt: product.title,
            loading: 'lazy'
          -%}
        {%- else -%}
          <div class="w-full h-full flex items-center justify-center bg-outline-variant text-primary/85">
            {%- render 'icon', name: 'image', class: 'text-4xl' -%}
          </div>
        {%- endif -%}
      </a>
      {%- if badge != blank -%}
        <span class="absolute top-2 left-2 bg-primary text-on-primary {% if is_minimal %}text-[9px] sm:text-[11px]{% else %}text-[11px]{% endif %} font-bold px-2 py-0.5 rounded-md tracking-wider uppercase z-10">{{ badge }}</span>
      {%- endif -%}
    </div>
    <!-- Info Zone -->
    <div class="p-3 flex flex-col justify-start flex-1 min-w-0">
      <div class="space-y-1">
        {%- if is_minimal -%}
          <h3 class="font-sans text-xs sm:text-sm font-normal text-primary leading-tight mb-1">
            <a href="{{ product.url }}" class="text-primary no-underline">{{ product.title }}</a>
          </h3>
        {%- else -%}
          <h3 class="text-sm sm:text-base font-normal text-primary leading-tight hover:text-secondary mb-1">
            <a href="{{ product.url }}" class="text-primary no-underline hover:text-secondary">{{ product.title }}</a>
          </h3>
        {%- endif -%}
        
        <div class="product-savings-container flex items-center mt-1 mb-1">
          {%- unless settings.disable_savings_badge -%}
            {%- if original_price > price -%}
              {%- assign savings = original_price | minus: price | times: 100 | divided_by: original_price -%}
              {%- assign badge_text = settings.savings_badge_text | default: "[savings] % rabat" | replace: "[savings]", savings -%}
              <span class="product-savings-badge inline-block bg-[#c8102e] text-white text-[11px] font-semibold px-2 py-0.5 rounded-md uppercase">{{ badge_text }}</span>
            {%- endif -%}
          {%- endunless -%}
        </div>
        
        <!-- Rating: 5 Stars -->
        {%- unless disable_reviews -%}
          <div class="flex items-center gap-1 {% if is_minimal %}text-[10px]{% else %}text-xs sm:text-sm{% endif %} text-secondary mt-1">
            <div class="flex text-[#FFB800] gap-0.5">
              {%- assign rating_floor = rating | floor -%}
              {%- assign decimal = rating | minus: rating_floor -%}
              {%- assign rating_floor_plus_1 = rating_floor | plus: 1 -%}
              {%- for i in (1..5) -%}
                {%- if i <= rating_floor -%}
                  <span class="material-symbols-outlined {% if is_minimal %}text-[12px]{% else %}text-[14px]{% endif %} filled-star select-none" style="font-size: {% if is_minimal %}12px{% else %}14px{% endif %}; line-height: 1;">star</span>
                {%- elsif i == rating_floor_plus_1 -%}
                  {%- if decimal >= 0.75 -%}
                    <span class="material-symbols-outlined {% if is_minimal %}text-[12px]{% else %}text-[14px]{% endif %} filled-star select-none" style="font-size: {% if is_minimal %}12px{% else %}14px{% endif %}; line-height: 1;">star</span>
                  {%- elsif decimal >= 0.25 -%}
                    <span class="material-symbols-outlined {% if is_minimal %}text-[12px]{% else %}text-[14px]{% endif %} filled-star select-none" style="font-size: {% if is_minimal %}12px{% else %}14px{% endif %}; line-height: 1;">star_half</span>
                  {%- else -%}
                    <span class="material-symbols-outlined {% if is_minimal %}text-[12px]{% else %}text-[14px]{% endif %} text-outline-variant select-none" style="font-size: {% if is_minimal %}12px{% else %}14px{% endif %}; line-height: 1;">star</span>
                  {%- endif -%}
                {%- else -%}
                  <span class="material-symbols-outlined {% if is_minimal %}text-[12px]{% else %}text-[14px]{% endif %} text-outline-variant select-none" style="font-size: {% if is_minimal %}12px{% else %}14px{% endif %}; line-height: 1;">star</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
            <span class="font-bold text-primary ml-1">{{ rating }}</span>
            <span class="text-primary/85">({{ reviews_count }})</span>
          </div>
        {%- endunless -%}

        <!-- Price display (moved directly below rating/title) -->
        <div class="flex flex-col items-start gap-0.5 mt-1">
          {%- unless is_minimal -%}
            <span class="text-xs sm:text-sm text-primary/85 leading-none">
              {%- if is_meter_product -%}
                Pris pr. meter
              {%- else -%}
                Pris
              {%- endif -%}
            </span>
          {%- endunless -%}
          <div class="flex items-baseline gap-1.5 flex-wrap">
            <span class="{% if is_minimal %}text-xs sm:text-sm md:text-base{% else %}text-sm sm:text-base md:text-lg{% endif %} font-bold text-primary leading-none">
              {%- assign show_fra = false -%}
              {%- if product.variants.size > 1 -%}
                {%- if product.price_varies or is_meter_product -%}
                  {%- assign show_fra = true -%}
                {%- endif -%}
              {%- endif -%}
              {%- if show_fra -%}Fra {% endif %}{{ price | money }}
            </span>
            {%- if original_price > price -%}
              <span class="text-[12px] text-primary/70 line-through leading-none">{{ original_price | money }}</span>
            {%- endif -%}
            {%- if is_minimal -%}
              <span class="text-[9px] sm:text-[10px] text-primary/75 font-semibold">
                {%- if is_meter_product -%}pr. meter{%- endif -%}
              </span>
            {%- endif -%}
          </div>
        </div>


      </div>
 
      <!-- Buy Button (No divider border) -->
      {%- unless is_minimal -%}
        <div class="mt-3">
          <button 
            onclick="window.addToCart('{{ variant.id }}')" 
            class="w-full bg-accent hover:brightness-95 text-primary py-2 px-3 rounded-full flex items-center justify-center gap-1 transition-colors focus:outline-none text-xs sm:text-sm font-bold border-0 cursor-pointer" 
            aria-label="Køb {{ product.title | escape }}"
          >
            <span>Køb</span>
          </button>
        </div>
      {%- endunless -%}
    </div>
  </div>
 

{%- endif -%}
