{% doc %}
  Renders a 5-star rating row with half-star support, followed by the numeric
  rating and the review count. Generic — not card-specific.
  Depends on snippets/icon.liquid (Material Symbols 'star' / 'star_half').

  Takes `wrapper_class` rather than a layout flag so the snippet stays free of
  any caller's layout knowledge.

  @param {number} rating - required. Average rating, e.g. 4.8.
  @param {number} reviews_count - required. Number of reviews shown in parentheses.
  @param {number} [star_size] - Star font-size in px. Defaults to 14.
  @param {string} [wrapper_class] - Extra classes for the row wrapper, typically text-size utilities.

  @example
  {% render 'star-rating', rating: 4.8, reviews_count: 142 %}
  {% render 'star-rating', rating: 4.8, reviews_count: 142, star_size: 12, wrapper_class: 'text-[10px]' %}
{% enddoc %}

{%- liquid
  assign star_size = star_size | default: 14

  assign rating_floor = rating | floor
  assign decimal = rating | minus: rating_floor
  assign rating_floor_plus_1 = rating_floor | plus: 1
-%}
{%- capture star_style -%}font-size: {{ star_size }}px; line-height: 1;{%- endcapture -%}
{%- capture star_size_class -%}text-[{{ star_size }}px]{%- endcapture -%}
{%- assign star_class_filled = star_size_class | append: ' filled-star select-none' -%}
{%- assign star_class_outline = star_size_class | append: ' text-outline-variant select-none' -%}
<div class="flex items-center gap-1 {{ wrapper_class }} text-secondary mt-1">
  <div class="flex text-amber-500 gap-0.5">
    {%- for i in (1..5) -%}
      {%- if i <= rating_floor -%}
        {%- render 'icon', name: 'star', class: star_class_filled, style: star_style -%}
      {%- elsif i == rating_floor_plus_1 -%}
        {%- if decimal >= 0.75 -%}
          {%- render 'icon', name: 'star', class: star_class_filled, style: star_style -%}
        {%- elsif decimal >= 0.25 -%}
          {%- render 'icon', name: 'star_half', class: star_class_filled, style: star_style -%}
        {%- else -%}
          {%- render 'icon', name: 'star', class: star_class_outline, style: star_style -%}
        {%- endif -%}
      {%- else -%}
        {%- render 'icon', name: 'star', class: star_class_outline, style: star_style -%}
      {%- endif -%}
    {%- endfor -%}
  </div>
  <span class="font-bold text-primary ml-1">{{ rating }}</span>
  <span class="text-primary/85">({{ reviews_count }})</span>
</div>
