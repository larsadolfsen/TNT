{% doc %}
  Renders the `--block-padding-{top,bottom,left,right}` CSS custom
  properties from a block's padding_top/padding_bottom/padding_sides
  settings. Must be called from inside a `{% style %}...{% endstyle %}` tag.

  @param {object} block - required. The section or block whose `settings` supplies padding_top/padding_bottom/padding_sides.
  @param {number} [top_default] - Default px for padding_top when unset. Defaults to 0.
  @param {number} [bottom_default] - Default px for padding_bottom when unset. Defaults to 0.
  @param {number} [sides_default] - Default px for padding_sides when unset. Defaults to 0.

  @example
  {%- style -%}
    #shopify-block-{{ block.id }}.shopify-block {
      {%- render 'block-padding-vars', block: block -%}
    }
  {%- endstyle -%}
{% enddoc %}
--block-padding-top: {{ block.settings.padding_top | default: top_default | default: 0 }}px;
--block-padding-bottom: {{ block.settings.padding_bottom | default: bottom_default | default: 0 }}px;
--block-padding-left: {{ block.settings.padding_sides | default: sides_default | default: 0 }}px;
--block-padding-right: {{ block.settings.padding_sides | default: sides_default | default: 0 }}px;
