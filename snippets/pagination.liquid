{%- if paginate.parts.size > 0 -%}
  <nav class="flex items-center justify-center gap-1.5 mt-8 border-t border-outline-variant/40 pt-6 col-span-full" role="navigation" aria-label="Pagination">
    {%- if paginate.previous -%}
      <a href="{{ paginate.previous.url }}" class="w-11 h-11 flex items-center justify-center rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container text-primary transition-all no-underline" aria-label="Forrige side">
        {%- render 'icon', name: 'chevron-left', button: true -%}
      </a>
    {%- endif -%}

    {%- for part in paginate.parts -%}
      {%- if part.is_link -%}
        <a href="{{ part.url }}" class="w-11 h-11 flex items-center justify-center rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container text-primary font-semibold text-sm transition-all no-underline">
          {{ part.title }}
        </a>
      {%- else -%}
        {%- if part.title == paginate.current_page -%}
          <span class="w-11 h-11 flex items-center justify-center rounded-xl bg-primary text-on-primary font-bold text-sm select-none" aria-current="page">
            {{ part.title }}
          </span>
        {%- else -%}
          <span class="w-11 h-11 flex items-center justify-center text-primary/60 font-semibold text-sm select-none">
            {{ part.title }}
          </span>
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}

    {%- if paginate.next -%}
      <a href="{{ paginate.next.url }}" class="w-11 h-11 flex items-center justify-center rounded-xl border border-outline-variant hover:border-primary hover:bg-surface-container text-primary transition-all no-underline" aria-label="Næste side">
        {%- render 'icon', name: 'chevron-right', button: true -%}
      </a>
    {%- endif -%}
  </nav>
{%- endif -%}
