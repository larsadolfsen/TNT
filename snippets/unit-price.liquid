{% doc %}
  Renders the native "$X.XX / unit" unit-price line (Surface 12), built from
  Shopify's `unit_price` / `unit_price_measurement` fields. Works with any
  object exposing those two fields — a product variant or a cart line item.

  Renders nothing when the object has no unit-price data, or when the
  theme-wide `settings.show_unit_pricing` toggle is off (defaults to on).

  @param {object} variant - required. A variant or cart line item exposing `unit_price` and `unit_price_measurement`.
  @param {string} [size] - 'xs' (11px, dense contexts e.g. predictive search) | 'sm' (12px, default — collection card, cart line) | 'base' (14px — product page, beside the hero price).

  @example
  {% render 'unit-price', variant: current_variant, size: 'base' %}
  {% render 'unit-price', variant: item, size: 'sm' %}
{% enddoc %}

{%- liquid
  assign show_unit_pricing = settings.show_unit_pricing | default: true
  assign measurement = variant.unit_price_measurement
-%}
{%- if measurement != blank and show_unit_pricing -%}
  {%- case size -%}
    {%- when 'xs' -%}
      {%- assign unit_price_size_class = 'text-[11px]' -%}
    {%- when 'base' -%}
      {%- assign unit_price_size_class = 'text-sm' -%}
    {%- else -%}
      {%- assign unit_price_size_class = 'text-xs' -%}
  {%- endcase -%}

  {%- assign unit_suffix = measurement.reference_unit -%}
  {%- if measurement.reference_value != 1 -%}
    {%- assign unit_suffix = measurement.reference_value | append: ' ' | append: measurement.reference_unit -%}
  {%- endif -%}

  <span class="unit-price {{ unit_price_size_class }} text-primary/70">{{ variant.unit_price | money }} / {{ unit_suffix }}</span>
{%- endif -%}
