{% doc %}
  Slide-out filter drawer for mobile widths, opened by the toolbar's filter
  button (assets/main-collection.js toggles #mobile-filter-drawer). Reuses
  the same filter markup as the desktop sidebar, with price-input ids
  rewritten by the caller so the two forms don't collide.

  @param {string} filters_html - required. Rendered collection-filter-list
    output, with #price-min/#price-max ids remapped to #mobile-price-min/max.
  @param {string} collection_url - required. collection.url, for "Ryd alle".

  @example
  {% render 'collection-mobile-filter-drawer', filters_html: mobile_filters_html, collection_url: collection.url %}
{% enddoc %}

<div id="mobile-filter-drawer" class="fixed inset-0 bg-black/50 z-[200] hidden flex justify-end transition-opacity duration-300 opacity-0">
  <div class="bg-card-light w-5/6 max-w-sm h-full flex flex-col justify-between shadow-2xl p-6 transition-transform duration-300 translate-x-full">
    <div>
      <div class="flex items-center justify-between pb-4 border-b border-outline-variant mb-6">
        <span class="font-sans text-xl font-bold text-primary tracking-tight">Filtrer produkter</span>
        <button onclick="toggleMobileFilter(false)" class="bg-transparent border-0 cursor-pointer" aria-label="Luk filtre">
          {%- render 'icon', name: 'close', class: 'text-2xl text-primary' -%}
        </button>
      </div>

      <div id="mobile-filters" class="space-y-6 overflow-y-auto max-h-[calc(100vh-200px)] pr-2 hide-scrollbar">
        {{ filters_html }}
      </div>
    </div>
    <div class="pt-4 border-t border-outline-variant">
      <a href="{{ collection_url }}" onclick="clearAllFiltersUrl(event, this.href)" class="block text-center py-3 border border-outline-variant rounded-xl text-xs font-bold text-primary bg-transparent cursor-pointer no-underline">Ryd alle</a>
    </div>
  </div>
</div>
