{% doc %}
  Predictive search results panel shell (Surface 4) — states, group
  structure and clonable row <template>s. assets/predictive-search.js does
  all the fetching/rendering; this snippet only supplies markup.

  @param {string} id - required. Unique id suffix (use block.id).
  @param {string} [variant] - 'dropdown' (desktop, default) | 'mobile' (full-screen takeover).

  @example
  {% render 'predictive-search-panel', id: block.id, variant: 'dropdown' %}
{% enddoc %}

{%- liquid
  assign variant = variant | default: 'dropdown'
  capture icon_collection_html
    render 'icon', name: 'store', class: 'text-[18px] text-primary/45'
  endcapture
  capture icon_page_html
    render 'icon', name: 'file-text', class: 'text-[18px] text-primary/45'
  endcapture
-%}

<style>
  [data-ps-panel="{{ id }}"][data-ps-variant="mobile"] [data-field="thumb-wrap"] {
    width: 56px;
    height: 56px;
  }
  [data-ps-panel="{{ id }}"][data-ps-variant="mobile"] .predictive-search-row {
    min-height: 72px;
    padding: 12px 16px;
  }
  [data-ps-panel="{{ id }}"] [data-ps-cursor="true"] {
    background-color: var(--color-card-high);
    box-shadow: inset 2px 0 0 0 var(--color-primary);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-ps-panel="{{ id }}"] .animate-pulse {
      animation: none;
    }
  }
</style>

<div
  id="predictive-results-{{ id }}"
  class="{% if variant == 'dropdown' %}predictive-search-panel absolute rounded-2xl border border-outline-variant bg-card-light shadow-md overflow-y-auto hide-scrollbar{% else %}flex-1 overflow-y-auto{% endif %}"
  {% if variant == 'dropdown' %}
    style="top: calc(100% + 8px); left: 0; right: 0; z-index: 50; max-height: min(70vh, 560px);"
  {% else %}
    style="overscroll-behavior: contain; padding-bottom: env(safe-area-inset-bottom);"
  {% endif %}
  role="listbox"
  aria-label="{{ 'predictive_search.results_label' | t }}"
  data-ps-panel="{{ id }}"
  data-ps-variant="{{ variant }}"
  hidden
>
  <div data-ps-refining-bar class="hidden h-0.5 bg-primary sticky top-0 z-10"></div>

  <div data-ps-state="loading-first" class="hidden" data-ps-skeleton-host></div>

  <div data-ps-state="results" class="hidden">
    <div data-ps-queries role="group" aria-label="{{ 'predictive_search.queries' | t }}" class="hidden"></div>
    <div data-ps-divider class="hidden border-t border-outline-variant"></div>
    <div data-ps-products-group role="group" aria-label="{{ 'predictive_search.products' | t }}" class="hidden">
      <p class="px-4 pt-4 pb-2 text-xs font-bold uppercase tracking-widest text-primary/60" aria-hidden="true">{{ 'predictive_search.products' | t }}</p>
      <div data-ps-products-list></div>
    </div>
    <div data-ps-other-group role="group" class="hidden">
      <p data-ps-other-heading class="px-4 pt-4 pb-2 text-xs font-bold uppercase tracking-widest text-primary/60" aria-hidden="true"></p>
      <div data-ps-other-list></div>
    </div>
    <div data-ps-footer class="hidden sticky bottom-0 bg-card-light border-t border-outline-variant px-4 py-3">
      <button type="button" data-ps-see-all class="w-full h-11 flex items-center justify-between text-primary font-semibold text-sm bg-transparent border-0 cursor-pointer focus-ring">
        <span data-field="see-all-label"></span>
        {% render 'icon', name: 'arrow-right', class: 'text-[18px]' %}
      </button>
    </div>
  </div>

  <div data-ps-state="no-results" class="hidden py-10 px-6 text-center">
    {% render 'icon', name: 'search-x', class: 'text-primary/45 text-[32px]' %}
    <p class="text-sm font-semibold text-primary mt-2" data-field="no-results-title"></p>
    <p class="text-sm text-primary/70 mt-1">{{ 'predictive_search.no_results_hint' | t }}</p>
    <div data-ps-no-results-suggestions class="mt-4 hidden text-left">
      <p class="text-xs font-bold uppercase tracking-widest text-primary/60 mb-2 px-1">{{ 'predictive_search.did_you_mean' | t }}</p>
      <div data-ps-no-results-queries></div>
    </div>
    <button type="button" data-ps-see-all-alt class="mt-4 w-full h-11 flex items-center justify-center gap-1 text-primary font-semibold text-sm bg-card-high hover:bg-surface-container border border-outline-variant rounded-full cursor-pointer focus-ring">
      <span data-field="see-all-alt-label"></span>
    </button>
  </div>

  <div data-ps-state="error" class="hidden py-8 px-6 text-center">
    {% render 'icon', name: 'circle-alert', class: 'text-[24px] text-important' %}
    <p class="text-sm text-primary mt-2" data-field="error-message"></p>
    <button type="button" data-ps-retry class="mt-3 bg-card-high hover:bg-surface-container text-primary border border-outline-variant font-bold h-11 px-6 rounded-full text-sm cursor-pointer focus-ring">{{ 'predictive_search.try_again' | t }}</button>
  </div>
</div>

<div class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-ps-live-region="{{ id }}"></div>

<template data-ps-template="query" data-ps-owner="{{ id }}">
  <a href="#" class="predictive-search-row flex items-center gap-3 h-11 px-4 text-sm text-primary no-underline hover:bg-card-high focus-ring" data-field="url" role="option">
    {% render 'icon', name: 'search', class: 'text-[18px] text-primary/45' %}
    <span data-field="text"></span>
  </a>
</template>

<template data-ps-template="other" data-ps-owner="{{ id }}">
  <a href="#" class="predictive-search-row flex items-center gap-3 h-11 px-4 text-sm text-primary no-underline hover:bg-card-high focus-ring" data-field="url" role="option">
    <span data-field="icon"></span>
    <span data-field="text"></span>
  </a>
</template>

<template data-ps-template="product" data-ps-owner="{{ id }}">
  {% render 'predictive-search-product' %}
</template>

<template data-ps-template="skeleton-row" data-ps-owner="{{ id }}">
  <div class="flex items-center gap-3 px-4 py-2 min-h-[64px]">
    <span class="w-12 h-12 rounded-md bg-card-high animate-pulse shrink-0"></span>
    <span class="flex-1 flex flex-col gap-2">
      <span class="h-[12px] rounded bg-card-high animate-pulse" style="width: 70%;"></span>
      <span class="h-[10px] rounded bg-card-high animate-pulse" style="width: 40%;"></span>
    </span>
  </div>
</template>

<template data-ps-icon="collection" data-ps-owner="{{ id }}">{{ icon_collection_html }}</template>
<template data-ps-icon="page" data-ps-owner="{{ id }}">{{ icon_page_html }}</template>

<script type="application/json" data-ps-strings="{{ id }}">
{
  "soldOut": {{ 'predictive_search.sold_out' | t | json }},
  "fromPrefix": {{ 'predictive_search.from_price' | t | json }},
  "seeAllResultsFor": {{ 'predictive_search.see_all_results_for' | t | json }},
  "seeAllResults": {{ 'predictive_search.see_all_results' | t | json }},
  "noMatchesFor": {{ 'predictive_search.no_matches_for' | t | json }},
  "unavailable": {{ 'predictive_search.unavailable' | t | json }},
  "offline": {{ 'predictive_search.offline' | t | json }},
  "resultsFound": {{ 'predictive_search.results_found' | t | json }},
  "noResultsFound": {{ 'predictive_search.no_results_found' | t | json }},
  "searchUnavailable": {{ 'predictive_search.search_unavailable' | t | json }},
  "collections": {{ 'predictive_search.collections' | t | json }},
  "pages": {{ 'predictive_search.pages' | t | json }},
  "collectionsAndPages": {{ 'predictive_search.collections_and_pages' | t | json }},
  "resultsLabel": {{ 'predictive_search.results_label' | t | json }},
  "didYouMean": {{ 'predictive_search.did_you_mean' | t | json }},
  "moneyFormat": {{ shop.money_format | json }}
}
</script>
