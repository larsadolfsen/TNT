{
  "sections": {
    "product_content": {
      "type": "row",
      "blocks": {
        "page-title": {
          "type": "page-title",
          "settings": {
            "title_override": "{{ product.title }}",
            "show_description": true
          }
        },
        "trust": {
          "type": "product-trust",
          "settings": {
            "rating_score": "4,8",
            "rating_count": "163",
            "badge_text": "300+ købt den seneste måned"
          }
        },
        "media": {
          "type": "product-media",
          "settings": {
            "image_badge": "BESTSELLER"
          }
        },
        "price": {
          "type": "product-price",
          "settings": {
            "price_suffix": "pr. meter inkl. moms",
            "price_subtext": "Skæres efter mål, så du kun betaler for den længde, du vælger."
          }
        },
        "urgency": {
          "type": "product-urgency",
          "settings": {
            "show_urgency": true,
            "urgency_text": "Kun få på lager – bestil snart",
            "hide_under_limit": 5
          }
        },
        "customizer": {
          "type": "product-customizer",
          "settings": {
            "metervare_product": "firkantet-dug",
            "step_size": 10,
            "min_length": 50
          }
        },
        "buy-buttons": {
          "type": "product-buy-buttons",
          "settings": {
            "text_before_price": "Læg i kurv –"
          }
        },
        "shipping-progress": {
          "type": "product-shipping-progress",
          "settings": {
            "hide_everything_except_text": true
          }
        },
        "trust-checkmarks": {
          "type": "product-trust-checkmarks",
          "blocks": {
            "countdown_4gXjVB": {
              "type": "trust-countdown",
              "settings": {
                "text": "Bestil inden",
                "suffix": "timer, for at få den sendt i dag."
              }
            },
            "checkmark_7inAb8": {
              "type": "trust-checkmark",
              "settings": {
                "text": "1-2 dages levering fra 59 kr."
              }
            },
            "checkmark_XTeX48": {
              "type": "trust-checkmark",
              "settings": {
                "text": "30 dages fuld returret"
              }
            }
          },
          "block_order": [
            "countdown_4gXjVB",
            "checkmark_7inAb8",
            "checkmark_XTeX48"
          ],
          "settings": {}
        },
        "materials": {
          "type": "product-materials",
          "blocks": {
            "badge_qNRGJX": {
              "type": "material-badge",
              "settings": {
                "icon": "eco",
                "title": "100% Phthalatfri"
              }
            },
            "badge_NPwiJF": {
              "type": "material-badge",
              "settings": {
                "icon": "verified",
                "title": "Oeko-Tex 100"
              }
            },
            "badge_QGPn7b": {
              "type": "material-badge",
              "settings": {
                "icon": "local_shipping",
                "title": "Sendes på rulle"
              }
            }
          },
          "block_order": [
            "badge_qNRGJX",
            "badge_NPwiJF",
            "badge_QGPn7b"
          ],
          "settings": {}
        },
        "testimonial": {
          "type": "product-testimonial",
          "settings": {
            "heading": "Det siger kunderne",
            "stars": 5,
            "quote": "Fantastisk kvalitet! Man ser næsten ikke at dugen er på, og den beskytter vores egetræsbord perfekt mod børnenes spild.",
            "author": "Mette S., Verificeret køber"
          }
        },
        "product_accordions_C6EJAf": {
          "type": "product-accordions",
          "blocks": {
            "accordion_Bqa6TC": {
              "type": "accordion-panel",
              "settings": {
                "title": "Produktspecifikationer",
                "content": "<p>{{ product.metafields.custom.om_produktet | metafield_tag }}</p>"
              }
            },
            "accordion_QJ83Ua": {
              "type": "accordion-panel",
              "settings": {
                "title": "Om brandet",
                "content": "<p>Textil &amp; Voksdug har siden 2004 leveret skandinavisk designede duge og metervarer i højeste kvalitet. Vi sikrer altid præcis udskæring og hurtig, sikker forsendelse.</p>"
              }
            },
            "accordion_ECACmL": {
              "type": "accordion-panel",
              "settings": {
                "title": "Vedligeholdelse",
                "content": "<p><strong>Daglig rengøring:</strong> Tør blot overfladen af med en fugtig klud efter brug. Du kan eventuelt anvende en smule mild opvaskesæbe til genstridigt snavs.</p><p><strong>Beskyttelse mod varme:</strong> Undgå at placere varme elementer som gryder og pander direkte på overfladen. Brug altid bordskånere for at undgå varmeskader.</p><p><strong>Undgå stærke farvestoffer:</strong> Madvarer med kraftige pigmenter, såsom tomatsovs, karry, rødvin eller ketchup, bør tørres af med det samme for at undgå permanente pletter i plasten.</p><p><strong>Opbevaring:</strong> Ved opbevaring bør dugen rulles op på det medfølgende paprør. Foldning frarådes, da det kan skabe varige folder i materialet.</p>"
              }
            }
          },
          "block_order": [
            "accordion_Bqa6TC",
            "accordion_QJ83Ua",
            "accordion_ECACmL"
          ],
          "settings": {}
        },
        "banner-text": {
          "type": "product-banner-text",
          "settings": {
            "image": "{{ product.featured_image }}",
            "heading": "",
            "content": "{{ product.description }}",
            "border_top": true,
            "border_bottom": true
          }
        },
        "cross-sell": {
          "type": "product-cross-sell",
          "settings": {
            "cross_sell_1": "",
            "cross_sell_2": ""
          }
        }
      },
      "block_order": [
        "page-title",
        "trust",
        "media",
        "price",
        "urgency",
        "customizer",
        "buy-buttons",
        "shipping-progress",
        "trust-checkmarks",
        "materials",
        "testimonial",
        "product_accordions_C6EJAf",
        "banner-text",
        "cross-sell"
      ],
      "settings": {
        "background_color": "light",
        "layout_style": "full_width_bg",
        "padding_top": 48,
        "padding_bottom": 48
      }
    }
  },
  "order": [
    "product_content"
  ]
}
