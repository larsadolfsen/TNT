          "settings": {
            "title": "Er voksduge varmefast?",
            "content": "<p>Nej. Undgå varme fade og tallerkener direkte på dugen — brug en bordskåner. Overfladen tåler normal stuetemperatur uden problemer.</p>",
            "open_by_default": false
          },
          "blocks": {}
