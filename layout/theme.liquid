{% # Base HTML layout shell %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    <script>
      (function() {
        const theme = localStorage.getItem('theme') || 'system';
        const rootEl = document.documentElement;
        if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          rootEl.classList.add('dark');
        } else {
          rootEl.classList.remove('dark');
        }
      })();
    </script>
    <script src="{{ 'money.js' | asset_url }}" defer="defer"></script>

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% if settings.type_header_font.family != blank and settings.type_header_font.system? == false %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_header_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endif %}
    {% if settings.type_body_font.family != blank and settings.type_body_font.system? == false %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endif %}

    {% comment %}
      Material Symbols Outlined is still loaded from Google Fonts because the
      icon system currently renders every icon through this font. Scheduled
      for replacement by the self-hosted/SVG icon snippet system in a later
      task -- do not add other Google Fonts links back here; merchant font
      choices (header/body) are already handled above via the native
      font_picker + font_url preload logic.
    {% endcomment %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" media="print" onload="this.media='all'"/>

    {% # Load and preload the compiled Tailwind CSS %}
    {{ 'output.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }} flex flex-col min-h-screen">
    <a href="#MainContent" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-primary focus:text-on-primary focus:px-4 focus:py-2 focus:rounded">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="focus-none grow" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    <script src="{{ 'masonry.js' | asset_url }}" defer></script>
  </body>
</html>
