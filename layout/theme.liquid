{% # Base HTML layout shell %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    <script>
      (function() {
        function isDark(theme) {
          return theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        }

        function updateToggleIcons(dark) {
          document.querySelectorAll('.theme-toggle-icon use').forEach(function(use) {
            use.setAttribute('href', dark ? '#icon-sun' : '#icon-moon');
          });
        }

        function applyTheme(theme) {
          const dark = isDark(theme);
          document.documentElement.classList.toggle('dark', dark);
          updateToggleIcons(dark);
        }

        applyTheme(localStorage.getItem('theme') || 'system');

        window.toggleTheme = function() {
          const next = isDark(localStorage.getItem('theme') || 'system') ? 'light' : 'dark';
          localStorage.setItem('theme', next);
          applyTheme(next);
        };

        document.addEventListener('DOMContentLoaded', function() {
          updateToggleIcons(document.documentElement.classList.contains('dark'));
        });
      })();
    </script>
    <script src="{{ 'money.min.js' | asset_url }}" defer="defer"></script>

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% if settings.type_header_font.family != blank and settings.type_header_font.system? == false %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_header_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endif %}
    {% if settings.type_body_font.family != blank and settings.type_body_font.system? == false %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endif %}

    {% # Load and preload the compiled Tailwind CSS %}
    {{ 'output.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }} flex flex-col min-h-screen">
    {% render 'icon-sprite' %}
    <a href="#MainContent" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:bg-primary focus:text-on-primary focus:px-4 focus:py-2 focus:rounded">
      {{ 'accessibility.skip_to_text' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" class="focus-none grow" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}
    <script src="{{ 'masonry.min.js' | asset_url }}" defer></script>
  </body>
</html>
