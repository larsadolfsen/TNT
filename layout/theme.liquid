<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    <script>
      (function() {
        const theme = localStorage.getItem('theme') || 'system';
        const rootEl = document.documentElement;
        if (theme === 'dark' || (theme === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          rootEl.classList.add('dark');
        } else {
          rootEl.classList.remove('dark');
        }
      })();
    </script>

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% if settings.type_header_font.family != blank and settings.type_header_font.system? == false %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_header_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endif %}
    {% if settings.type_body_font.family != blank and settings.type_body_font.system? == false %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endif %}

    {% # Load google fonts and material symbols %}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&amp;display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <link href="https://fonts.googleapis.com/css2?family=Work+Sans:wght@400;500;600;700&amp;display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet" media="print" onload="this.media='all'"/>

    {% # Load and preload the compiled Tailwind CSS %}
    {{ 'output.css' | asset_url | stylesheet_tag: preload: true }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }} flex flex-col min-h-screen">
    {% sections 'header-group' %}

    <main id="MainContent" class="focus-none grow" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {%- if template.name == 'product' -%}
      <script>
        (function() {
          function initProductLayout() {
            if (!document.body.classList.contains('template-product')) return;

            const mainContent = document.getElementById('MainContent');
            if (!mainContent) return;

            // 1. Unwrap existing columns if already wrapped (important for Customizer updates)
            const existingGrid = mainContent.querySelector('.product-page-columns-grid');
            if (existingGrid) {
              const wrappedSections = Array.from(existingGrid.querySelectorAll('.product-page-col > .shopify-section'));
              wrappedSections.forEach(sec => {
                mainContent.insertBefore(sec, existingGrid);
              });
              existingGrid.remove();
            }

            // 2. Find all sections that should be wrapped (col-span < 3)
            const sections = Array.from(mainContent.children).filter(el => {
              if (!el.classList.contains('shopify-section')) return false;
              const style = getComputedStyle(el);
              const colSpan = parseInt(style.getPropertyValue('--col-span')) || 3;
              return colSpan < 3;
            });

            if (sections.length === 0) return;

            // 3. Create grid container and column wrappers
            const gridContainer = document.createElement('div');
            gridContainer.className = 'product-page-columns-grid';

            const col1 = document.createElement('div');
            col1.className = 'product-page-col product-page-col-1';
            const col2 = document.createElement('div');
            col2.className = 'product-page-col product-page-col-2';
            const col3 = document.createElement('div');
            col3.className = 'product-page-col product-page-col-3';

            // Insert grid container before the first section
            const firstSection = sections[0];
            mainContent.insertBefore(gridContainer, firstSection);

            // 4. Distribute sections into their corresponding columns based on --col-start style variable
            sections.forEach(sec => {
              const style = getComputedStyle(sec);
              const colStartVal = style.getPropertyValue('--col-start').trim();
              if (colStartVal === '2') {
                col2.appendChild(sec);
              } else if (colStartVal === '3') {
                col3.appendChild(sec);
              } else {
                col1.appendChild(sec);
              }
            });

            gridContainer.appendChild(col1);
            gridContainer.appendChild(col2);
            gridContainer.appendChild(col3);
          }

          document.addEventListener('DOMContentLoaded', initProductLayout);
          document.addEventListener('shopify:section:load', initProductLayout);
          document.addEventListener('shopify:section:unload', initProductLayout);
          document.addEventListener('shopify:section:reorder', initProductLayout);
        })();
      </script>
    {%- endif -%}

    {% sections 'footer-group' %}
  </body>
</html>
