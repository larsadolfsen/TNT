{%- style -%}
  #shopify-block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top }}px !important;
    padding-bottom: {{ block.settings.padding_bottom }}px !important;
    padding-left: {{ block.settings.padding_sides }}px !important;
    padding-right: {{ block.settings.padding_sides }}px !important;
  }
{%- endstyle -%}

<div 
  class="w-full flex" 
  style="justify-content: {% if block.settings.alignment == 'left' %}flex-start{% elsif block.settings.alignment == 'right' %}flex-end{% else %}center{% endif %};" 
  {{ block.shopify_attributes }}
>
  <span 
    class="inline-block text-[10px] font-bold px-3 py-1.5 rounded tracking-widest shadow-sm border uppercase"
    style="background-color: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; border-color: {{ block.settings.background_color }};"
  >
    {{ block.settings.text | default: "BESTSELLER" }}
  </span>
</div>

{% schema %}
{
  "name": "Badge",
  "class": "shopify-block-badge",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Badge Tekst",
      "default": "BESTSELLER"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "Justering",
      "default": "left"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Baggrundsfarve",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Tekstfarve",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Badge"
    }
  ]
}
{% endschema %}
