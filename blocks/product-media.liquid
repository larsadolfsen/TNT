{% comment %}
  Product Media Gallery Section
  Renders the featured image, absolute bestseller badge, and gallery indicator dots.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}

<section class="relative max-w-screen-xl mx-auto">
  <!-- Hidden dummy image for third-party cart compatibility -->
  {%- if featured_image -%}
    <img id="main-product-img" src="{{ featured_image | image_url: width: 1200 }}" class="hidden" alt="" />
  {%- else -%}
    <img id="main-product-img" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDT6v3nHI941v3VLOOVZi6aiIWU9Bk0oFqdFrpEO7HFKCiZVZWAkbZafIRHYpjXJ-vkib7-EqYsE-5f6cnWn3VaO92Upxnr3Udg0oV4LbzaJlQitsTts1KuFfq1PU0VMG5FNT1Mx8PjaQZMPzcPs3QUaHTsVPYlxETHQLH5N6-GqTQnIQ63D-Wyjal17RpHnqDmyEDHeA5W9mgHscm42-_bB9kfmytEfumkgNPSNYbcZvTfvcT4xd6XZB0EuIRQ-DmyrVWWdxzFyBaa" class="hidden" alt="" />
  {%- endif -%}

  <div class="aspect-[3/2] bg-surface-container overflow-hidden relative rounded-2xl">
    <div id="gallery-track" class="flex h-full w-full" style="transform: translateX(0%); transition: transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94);">
      {%- if product.images.size > 0 -%}
        {%- for image in product.images -%}
          <div class="w-full h-full flex-shrink-0">
            <img 
              alt="{{ product.title }}" 
              class="w-full h-full object-cover select-none" 
              src="{{ image.src | image_url: width: 1200 }}"
              width="1200"
              height="800"
              draggable="false"
            />
          </div>
        {%- endfor -%}
      {%- else -%}
        <div class="w-full h-full flex-shrink-0">
          <img 
            alt="Klar voksdug" 
            class="w-full h-full object-cover select-none" 
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuDT6v3nHI941v3VLOOVZi6aiIWU9Bk0oFqdFrpEO7HFKCiZVZWAkbZafIRHYpjXJ-vkib7-EqYsE-5f6cnWn3VaO92Upxnr3Udg0oV4LbzaJlQitsTts1KuFfq1PU0VMG5FNT1Mx8PjaQZMPzcPs3QUaHTsVPYlxETHQLH5N6-GqTQnIQ63D-Wyjal17RpHnqDmyEDHeA5W9mgHscm42-_bB9kfmytEfumkgNPSNYbcZvTfvcT4xd6XZB0EuIRQ-DmyrVWWdxzFyBaa"
            width="1200"
            height="800"
            draggable="false"
          />
        </div>
      {%- endif -%}
    </div>
  </div>
  <div class="absolute top-4 left-4 z-10 pointer-events-none">
    <span class="bg-white/90 backdrop-blur text-primary text-[10px] font-bold px-3 py-1.5 rounded tracking-widest shadow-sm border border-outline-variant">
      {{ block.settings.image_badge | default: "BESTSELLER" }}
    </span>
  </div>
</section>

<!-- Indicator Dots -->
<div class="flex justify-center items-center gap-2 px-4 mt-3 max-w-screen-xl mx-auto" id="gallery-dots">
  {%- if product.images.size > 0 -%}
    {%- for image in product.images -%}
      <button 
        class="dot-btn w-2.5 h-2.5 rounded-full {% if forloop.first %}bg-primary{% else %}bg-slate-300{% endif %} focus:outline-none transition-colors" 
        data-src="{{ image.src | image_url: width: 1200 }}"
        aria-label="Skift billede {{ forloop.index }}"
      ></button>
    {%- endfor -%}
  {%- endif -%}
</div>

<script>
  (() => {
    const initGallery = () => {
      const mainImg = document.getElementById("main-product-img");
      const track = document.getElementById("gallery-track");
      const dots = document.querySelectorAll(".dot-btn");
      if (!mainImg || !track || dots.length <= 1) return;

      const container = track.parentElement;
      if (!container) return;

      // Prevent duplicate initialization (e.g. in theme editor)
      if (track.dataset.galleryInitialized === "true") return;
      track.dataset.galleryInitialized = "true";

      const slides = Array.from(track.children);
      const N = slides.length;
      if (N <= 1) return;

      // Clone first and last slides for infinite looping animation
      const firstClone = slides[0].cloneNode(true);
      const lastClone = slides[N - 1].cloneNode(true);

      // Append firstClone to end, prepend lastClone to start
      track.appendChild(firstClone);
      track.insertBefore(lastClone, slides[0]);

      let currentIndex = 0;
      let isAnimating = false;

      // Find initial active index
      dots.forEach((dot, index) => {
        if (dot.classList.contains("bg-primary")) {
          currentIndex = index;
        }
      });

      // Set initial position (DOM index 1 corresponds to currentIndex 0)
      track.style.transition = "none";
      track.style.transform = `translateX(-${(currentIndex + 1) * 100}%)`;

      function showImage(index) {
        if (isAnimating) return;
        
        let targetIndex = index;
        let isWrapped = false;
        let wrapToDOMIndex = null;

        if (targetIndex >= N) {
          isWrapped = true;
          wrapToDOMIndex = 1; // Slide 0
          currentIndex = 0;
        } else if (targetIndex < 0) {
          isWrapped = true;
          wrapToDOMIndex = N; // Slide N - 1
          currentIndex = N - 1;
        } else {
          currentIndex = targetIndex;
        }

        const activeDot = dots[currentIndex];
        const newSrc = activeDot.getAttribute("data-src");

        // Update dots styles
        dots.forEach(d => {
          d.classList.remove("bg-primary");
          d.classList.add("bg-slate-300");
        });
        activeDot.classList.remove("bg-slate-300");
        activeDot.classList.add("bg-primary");

        // Update hidden main image for cart modal compatibility
        if (mainImg) {
          mainImg.src = newSrc;
        }

        const domIndex = isWrapped ? (targetIndex + 1) : (currentIndex + 1);

        isAnimating = true;
        track.style.transition = "transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94)";
        track.style.transform = `translateX(-${domIndex * 100}%)`;

        setTimeout(() => {
          if (isWrapped) {
            track.style.transition = "none";
            track.style.transform = `translateX(-${wrapToDOMIndex * 100}%)`;
          }
          isAnimating = false;
        }, 300);
      }

      // Click on dots
      dots.forEach((dot, index) => {
        dot.addEventListener("click", () => {
          showImage(index);
        });
      });

      // Swipe and drag logic (follow-the-finger tracking)
      container.style.touchAction = "pan-y";
      container.style.userSelect = "none";
      
      let pointerStartX = 0;
      let pointerStartY = 0;
      let isDragging = false;

      container.addEventListener("pointerdown", (e) => {
        if (e.button !== 0) return; // Left click or touch only
        
        // If we are currently in a transition/wrap, snap immediately to the destination
        if (isAnimating) {
          track.style.transition = "none";
          track.style.transform = `translateX(-${(currentIndex + 1) * 100}%)`;
          isAnimating = false;
        }

        pointerStartX = e.clientX;
        pointerStartY = e.clientY;
        isDragging = true;
        track.style.transition = "none"; // Disable animation during active drag
      });

      document.addEventListener("pointermove", (e) => {
        if (!isDragging) return;

        const currentX = e.clientX;
        const currentY = e.clientY;
        const diffX = currentX - pointerStartX;
        const diffY = currentY - pointerStartY;

        // If user scrolls vertically, cancel drag to let native scroll happen
        if (Math.abs(diffY) > Math.abs(diffX) && Math.abs(diffY) > 10) {
          isDragging = false;
          track.style.transition = "transform 300ms cubic-bezier(0.25, 0.46, 0.45, 0.94)";
          track.style.transform = `translateX(-${(currentIndex + 1) * 100}%)`;
          return;
        }

        // Follow pointer exactly
        const containerWidth = container.offsetWidth || 1;
        const dragPercent = (diffX / containerWidth) * 100;
        const totalTranslate = -((currentIndex + 1) * 100) + dragPercent;
        
        track.style.transform = `translateX(${totalTranslate}%)`;
      });

      document.addEventListener("pointerup", (e) => {
        if (!isDragging) return;
        isDragging = false;

        const pointerEndX = e.clientX;
        const pointerEndY = e.clientY;

        const diffX = pointerEndX - pointerStartX;
        const diffY = pointerEndY - pointerStartY;

        // Threshold swipe detection
        if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
          if (diffX < 0) {
            showImage(currentIndex + 1);
          } else {
            showImage(currentIndex - 1);
          }
        } else {
          // Snap back
          showImage(currentIndex);
        }
      });

      container.addEventListener("pointercancel", () => {
        if (isDragging) {
          isDragging = false;
          showImage(currentIndex);
        }
      });
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initGallery);
    } else {
      initGallery();
    }
  })();
</script>

{% schema %}
{
  "name": "Product Media Gallery",
  "class": "shopify-block-product-media",
  "settings": [
    {
      "type": "text",
      "id": "image_badge",
      "label": "Image Sticker Text",
      "default": "BESTSELLER"
    }
  ],
  "presets": [
    {
      "name": "Product Media Gallery"
    }
  ]
}
{% endschema %}
