{% comment %}
  Product Media Gallery Block
  Renders the swipeable media track (images/video/3D model), the mobile
  indicator dots, and the desktop thumbnail strip. Composition only — the
  hidden cart-compatibility image, gallery track, dots, thumbnails and
  gallery CSS each live in their own snippets/product-media-*.liquid;
  behaviour (swipe/drag, dot/thumbnail clicks, video overlay, variant image
  sync) lives in assets/product-media.js, which needs no Liquid config
  since it reads media data straight from #product-media-variants.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign featured_image = current_variant.featured_image | default: product.featured_image -%}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    {%- render 'block-padding-vars', block: block -%}
  }
{%- endstyle -%}

<div class="relative w-full product-media" {{ block.shopify_attributes }}>
  {%- render 'product-media-hidden-image', featured_image: featured_image -%}

  {%- render 'product-media-gallery-track' -%}

  {%- render 'product-media-dots' -%}

  {%- render 'product-media-thumbnails' -%}
</div>

{%- render 'product-media-gallery-style' -%}

<!-- Variant to media map -->
<script id="product-media-variants" type="application/json">
  {
    {%- for variant in product.variants -%}
      {%- if variant.featured_image != blank -%}
        "{{ variant.id }}": {{ variant.featured_image | image_url: width: 1200 | json }}
      {%- else -%}
        "{{ variant.id }}": null
      {%- endif -%}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  }
</script>

<script src="{{ 'product-media.min.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product Media Gallery",
  "class": "shopify-block-product-media",
  "settings": [
    {
      "type": "text",
      "id": "image_badge",
      "label": "Image Sticker Text",
      "default": "BESTSELLER"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Media Gallery",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}
