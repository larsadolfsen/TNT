{% comment %}
  Product Recommendations (Surfaces 9 + 10)
  Wraps Shopify's native {% recommendations %} tag. A single block covers both
  "related" and "complementary" recommendation intents — the merchant adds it
  twice, once per intent, to show both on one product page. This is
  intentionally NOT the same thing as blocks/product-cross-sell.liquid, which
  is a bespoke, merchant-curated two-product upsell block with its own
  standard-card treatment, visible buy button and no eyebrow label — that
  block is out of scope and must not be redesigned. Recommendations here use
  the lighter-weight "minimal" product-card layout (no buy button, no rating)
  and a fixed, non-editable eyebrow so the two kinds of "more products" never
  read as the same thing.
{% endcomment %}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    {%- render 'block-padding-vars', block: block, top_default: 40, bottom_default: 40 -%}
  }
{%- endstyle -%}

{%- liquid
  assign intent = block.settings.intent | default: 'related'

  if intent == 'complementary'
    assign eyebrow = 'recommendations.complementary_eyebrow' | t
    assign heading_id = 'complementary-products-heading-' | append: block.id
  else
    assign eyebrow = 'recommendations.related_eyebrow' | t
    assign heading_id = 'related-products-heading-' | append: block.id
  endif
-%}

{% recommendations product: product, limit: block.settings.products_to_show | default: 4, intent: intent %}
  {%- if recommendations.performed and recommendations.products.size > 0 -%}
    {%- assign use_scroll = false -%}
    {%- if recommendations.products.size > 4 -%}
      {%- assign use_scroll = true -%}
    {%- endif -%}
    {%- assign card_class = '' -%}
    {%- if use_scroll -%}
      {%- assign card_class = 'w-40 flex-shrink-0' -%}
    {%- endif -%}

    <section aria-labelledby="{{ heading_id }}" {{ block.shopify_attributes }}>
      <span class="block text-xs font-bold uppercase tracking-widest text-primary/60">{{ eyebrow }}</span>
      <h2 id="{{ heading_id }}" class="section-section__heading">{{ block.settings.heading }}</h2>

      <div
        class="{% if use_scroll %}flex gap-4 overflow-x-auto hide-scrollbar{% else %}grid grid-cols-2 gap-4 md:grid-cols-4 md:gap-6{% endif %}"
        {%- if use_scroll %} tabindex="0" role="region" aria-labelledby="{{ heading_id }}"{% endif %}
      >
        {%- for recommended_product in recommendations.products -%}
          {% render 'product-card', product: recommended_product, layout: 'minimal', class: card_class %}
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
{% endrecommendations %}

{% schema %}
{
  "name": "Product Recommendations",
  "class": "shopify-block-product-recommendations",
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "Type",
      "options": [
        { "value": "related", "label": "Relaterede produkter (algoritmisk)" },
        { "value": "complementary", "label": "Komplementære produkter (algoritmisk)" }
      ],
      "default": "related",
      "info": "Bestemmer både Shopifys anbefalingskilde og standard-overskriften nedenfor. Skift til \"Komplementære\" og opdater selv overskriften, da feltet ikke skifter automatisk."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Overskrift",
      "default": "Du synes måske også om"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Antal produkter",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Recommendations",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}
