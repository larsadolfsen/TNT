{% comment %}
  Product Shipping Progress & Trust Badges Section
  Renders the dynamic free shipping progress bar based on current cart total,
  and lists key trust badges with a dynamic shipping countdown timer.
  Markup only — the animated ticker, live shipping-rate fetch, and event
  wiring live in assets/product-shipping-progress.js, fed by the
  #product-shipping-progress-config JSON island below (Liquid render can't
  leak variables back to the caller, so cart_total_dkk/product_price are
  handed over there instead of being duplicated inline in JS).
{% endcomment %}

{%- assign cart_total_dkk = cart.total_price | divided_by: 100.0 -%}
{%- assign threshold = 590.00 -%}

{%- assign product_price = 0 -%}
{%- if product -%}
  {%- assign is_customizable = false -%}
  {%- for variant in product.variants -%}
    {%- if variant.sku == 'BTM001' or variant.title contains 'Tilpasset' or variant.title contains 'tilpasset' -%}
      {%- assign is_customizable = true -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if is_customizable -%}
    {%- assign base_variant = nil -%}
    {%- for variant in product.variants -%}
      {%- unless variant.title contains 'Tilpasset' or variant.title contains 'tilpasset' -%}
        {%- assign base_variant = variant -%}
        {%- break -%}
      {%- endunless -%}
    {%- endfor -%}
    {%- if base_variant == nil -%}
      {%- assign base_variant = product.selected_or_first_available_variant -%}
    {%- endif -%}
    {% comment %} Default customization length on page load is 200 cm {% endcomment %}
    {%- assign product_price = base_variant.price | divided_by: 100.0 | times: 200 -%}
  {%- else -%}
    {%- assign product_price = product.selected_or_first_available_variant.price | divided_by: 100.0 -%}
  {%- endif -%}
{%- endif -%}

{%- assign potential_total = cart_total_dkk | plus: product_price -%}
{%- assign progress = cart_total_dkk | divided_by: threshold | times: 100.0 | at_most: 100.0 -%}
{%- assign potential_progress = potential_total | divided_by: threshold | times: 100.0 | at_most: 100.0 -%}
{%- assign potential_width = potential_progress | minus: progress | at_least: 0 -%}
{%- assign missing = threshold | minus: potential_total | at_least: 0 -%}

{%- assign hide_everything_except_text = block.settings.hide_everything_except_text -%}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    {%- render 'block-padding-vars', block: block -%}
  }
  #shopify-block-{{ block.id }} #shipping-amount-ticker {
    display: inline-flex;
    align-items: baseline;
    overflow: hidden;
  }
  #shopify-block-{{ block.id }} .ticker-char {
    display: inline-block;
    white-space: pre;
    line-height: 1;
  }
  #shopify-block-{{ block.id }} .ticker-digit {
    height: 1em;
    overflow: hidden;
    position: relative;
    display: inline-block;
  }
  #shopify-block-{{ block.id }} .ticker-digit-list {
    display: flex;
    flex-direction: column;
    transition: transform 0.8s cubic-bezier(0.85, 0, 0.15, 1);
  }
  #shopify-block-{{ block.id }} .ticker-digit-list span {
    height: 1em;
    line-height: 1;
    display: block;
    text-align: center;
  }
{%- endstyle -%}

<div {{ block.shopify_attributes }}>
  <!-- Dynamic Free Shipping Progress Bar Widget (No border) -->
  <div id="free-shipping-widget" class="{% if hide_everything_except_text %}py-1{% else %}bg-card-light p-4 rounded-xl space-y-2 border border-outline-variant{% endif %}" data-threshold="{{ threshold }}">
    <div class="flex {% if hide_everything_except_text %}justify-center text-center{% else %}justify-between{% endif %} text-xs text-primary font-bold">
      <span id="shipping-status-text">
        <span id="shipping-progress-msg" class="{% if potential_total >= threshold %}hidden{% endif %}">
          {%- assign progress_message = block.settings.free_shipping_message | default: "Du er kun [beløb] fra fri fragt" -%}
          {%- if progress_message contains '[beløb]' -%}
            {%- assign message_parts = progress_message | split: '[beløb]' -%}
            {{ message_parts[0] }}<span id="shipping-amount-ticker" class="font-mono font-bold text-blue-600 bg-blue-500/10 px-1.5 py-0.5 rounded">{{ missing | times: 100 | money }}</span>{{ message_parts[1] }}
          {%- elsif progress_message contains '[amount]' -%}
            {%- assign message_parts = progress_message | split: '[amount]' -%}
            {{ message_parts[0] }}<span id="shipping-amount-ticker" class="font-mono font-bold text-blue-600 bg-blue-500/10 px-1.5 py-0.5 rounded">{{ missing | times: 100 | money }}</span>{{ message_parts[1] }}
          {%- else -%}
            {{ progress_message | replace: '[beløb]', '<span id="shipping-amount-ticker" class="font-mono font-bold text-blue-600 bg-blue-500/10 px-1.5 py-0.5 rounded"></span>' }}
          {%- endif -%}
        </span>
        <span id="shipping-success-msg" class="{% if potential_total < threshold %}hidden{% endif %}">
          {{ block.settings.free_shipping_success_message | default: "Du har opnået fri fragt!" }}
        </span>
      </span>
    </div>
    <div class="w-full h-2 bg-card-high rounded-full overflow-hidden flex {% if hide_everything_except_text %}hidden{% endif %}">
      <div id="shipping-progress-bar" class="h-full {% if cart_total_dkk < threshold %}bg-emerald-600{% else %}bg-emerald-500{% endif %} transition-all duration-300" style="width: {{ progress }}%"></div>
      <div id="shipping-potential-bar" class="h-full bg-emerald-300 transition-all duration-300" style="width: {{ potential_width }}%"></div>
    </div>
  </div>
</div>

<script type="application/json" id="product-shipping-progress-config">
  {"cartTotal": {{ cart_total_dkk | json }}, "productPrice": {{ product_price | json }}}
</script>
<script src="{{ 'product-shipping-progress.min.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product Shipping Widget",
  "settings": [
    {
      "type": "text",
      "id": "free_shipping_message",
      "label": "Fri fragt besked",
      "default": "Du er kun [beløb] fra fri fragt",
      "info": "Brug [beløb] til at indsætte det resterende beløb."
    },
    {
      "type": "text",
      "id": "free_shipping_success_message",
      "label": "Succesbesked for fri fragt",
      "default": "Du har opnået fri fragt!"
    },
    {
      "type": "checkbox",
      "id": "hide_everything_except_text",
      "label": "Skjul alt undtagen tekst",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Shipping Widget",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}
