{% comment %}
  Product Trust Section
  Renders the star reviews rating and buy volume badge.
{% endcomment %}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    {%- render 'block-padding-vars', block: block -%}
  }
{%- endstyle -%}

  <!-- Product Trust -->
  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1" {{ block.shopify_attributes }}>
    <div class="flex items-center gap-1">
      <div class="flex text-amber-500">
        {% render 'icon', name: 'star', class: 'text-[15px]', style: "font-variation-settings: 'FILL' 1; font-size: 15px; line-height: 1;" %}
        {% render 'icon', name: 'star', class: 'text-[15px]', style: "font-variation-settings: 'FILL' 1; font-size: 15px; line-height: 1;" %}
        {% render 'icon', name: 'star', class: 'text-[15px]', style: "font-variation-settings: 'FILL' 1; font-size: 15px; line-height: 1;" %}
        {% render 'icon', name: 'star', class: 'text-[15px]', style: "font-variation-settings: 'FILL' 1; font-size: 15px; line-height: 1;" %}
        {% render 'icon', name: 'star', class: 'text-[15px]', style: "font-variation-settings: 'FILL' 1; font-size: 15px; line-height: 1;" %}
      </div>
      <span class="text-sm font-semibold text-primary">
        {{ block.settings.rating_score | default: "4,8" }} ({{ block.settings.rating_count | default: "163" }})
      </span>
    </div>
    {%- if block.settings.badge_text != blank -%}
      <span class="text-sm text-primary/85">
        {{ block.settings.badge_text }}
      </span>
    {%- endif -%}
  </div>

{% schema %}
{
  "name": "Product Trust",
  "class": "shopify-block-product-trust",
  "settings": [
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4,8"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Total Review Count",
      "default": "163"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Urgency Badge Text",
      "default": "300+ købt den seneste måned"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Trust",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}
