{% comment %}
  Product Trust Section
  Renders the star reviews rating and buy volume badge.
{% endcomment %}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    --block-padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --block-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    --block-padding-left: {{ block.settings.padding_sides | default: 0 }}px;
    --block-padding-right: {{ block.settings.padding_sides | default: 0 }}px;
  }
{%- endstyle -%}

  <!-- Product Trust -->
  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1" {{ block.shopify_attributes }}>
    <div class="flex items-center gap-1">
      <div class="flex text-amber-500">
        <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1; font-size: 12px; line-height: 1;">star</span>
        <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1; font-size: 12px; line-height: 1;">star</span>
        <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1; font-size: 12px; line-height: 1;">star</span>
        <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1; font-size: 12px; line-height: 1;">star</span>
        <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1; font-size: 12px; line-height: 1;">star</span>
      </div>
      <span class="text-xs font-medium text-primary">
        {{ block.settings.rating_score | default: "4,8" }} ({{ block.settings.rating_count | default: "163" }})
      </span>
    </div>
    {%- if block.settings.badge_text != blank -%}
      <span class="text-xs text-on-surface-variant">
        {{ block.settings.badge_text }}
      </span>
    {%- endif -%}
  </div>

{% schema %}
{
  "name": "Product Trust",
  "class": "shopify-block-product-trust",
  "settings": [
    {
      "type": "text",
      "id": "rating_score",
      "label": "Rating Score",
      "default": "4,8"
    },
    {
      "type": "text",
      "id": "rating_count",
      "label": "Total Review Count",
      "default": "163"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Urgency Badge Text",
      "default": "300+ købt den seneste måned"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Trust"
    }
  ]
}
{% endschema %}
