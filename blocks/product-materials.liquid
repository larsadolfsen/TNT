{%- style -%}
  #shopify-block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top }}px !important;
    padding-bottom: {{ block.settings.padding_bottom }}px !important;
    padding-left: {{ block.settings.padding_sides }}px !important;
    padding-right: {{ block.settings.padding_sides }}px !important;
  }
  .product-materials-grid-{{ block.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.gap | default: 8 }}px;
    justify-content: flex-start;
    width: 100%;
  }
  .product-materials-grid-{{ block.id }} .shopify-block-badge {
    padding: 0 !important;
    display: inline-flex !important;
    width: auto !important;
  }
  .product-materials-grid-{{ block.id }} .shopify-block-badge > div {
    width: auto !important;
    display: inline-flex !important;
  }

  /* If it has material-badge blocks, use the 3-column grid layout */
  .product-materials-grid-{{ block.id }}:has(.shopify-block-material-badge) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ block.settings.gap | default: 8 }}px;
    justify-items: center;
  }
  @media (min-width: 768px) {
    .product-materials-grid-{{ block.id }}:has(.shopify-block-material-badge) {
      gap: {{ block.settings.gap | default: 8 | times: 2 }}px;
    }
  }
{%- endstyle -%}

<div class="product-materials-grid-{{ block.id }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Materialer & Badges",
  "class": "shopify-block-product-materials",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand imellem elementer",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Materialer & Badges"
    }
  ]
}
{% endschema %}
