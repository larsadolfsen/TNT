{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    --block-padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --block-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    --block-padding-left: {{ block.settings.padding_sides | default: 0 }}px;
    --block-padding-right: {{ block.settings.padding_sides | default: 0 }}px;
  }
  .product-materials-grid-{{ block.id }} {
    display: flex;
    flex-wrap: wrap;
    gap: {{ block.settings.gap | default: 8 }}px;
    justify-content: flex-start;
    width: 100%;
  }
  .product-materials-grid-{{ block.id }} .shopify-block-badge {
    padding: 0;
    display: inline-flex;
    width: auto;
  }
  .product-materials-grid-{{ block.id }} .shopify-block-badge > div {
    width: auto;
    display: inline-flex;
  }

  /* If it has icon-style badge blocks (badge.liquid, style: icon), use the 3-column grid layout */
  .product-materials-grid-{{ block.id }}:has([data-badge-style="icon"]) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ block.settings.gap | default: 8 }}px;
    justify-items: center;
  }
  @media (min-width: 768px) {
    .product-materials-grid-{{ block.id }}:has([data-badge-style="icon"]) {
      gap: {{ block.settings.gap | default: 8 | times: 2 }}px;
    }
  }
{%- endstyle -%}

<div class="product-materials-grid-{{ block.id }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Materialer & Badges",
  "class": "shopify-block-product-materials",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    },
    {
      "type": "range",
      "id": "gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand imellem elementer",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Materialer & Badges",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}
