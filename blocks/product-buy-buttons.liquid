{% comment %}
  Product Buy Buttons Block
  Renders the quantity stepper, final price, Add to Cart CTA, accelerated
  checkout, payment badges and the mobile sticky buy bar. Supports both
  customized (custom-cut) and simple products. Composition only — each
  piece lives in its own snippets/product-buy-*.liquid; behaviour (qty
  stepper, price recalculation, add-to-cart, sticky bar sync) lives in
  assets/product-buy-buttons.js, fed by the #product-buy-buttons-config
  JSON island below (Liquid render can't leak variables back to the
  caller, so nothing here needs to come back out of the snippets).
{% endcomment %}

{%- assign text_before_price = block.settings.text_before_price | default: "Læg i kurv – " -%}
{%- liquid
  assign base_variant = nil
  for variant in product.variants
    unless variant.title contains 'Tilpasset' or variant.title contains 'tilpasset'
      assign base_variant = variant
      break
    endunless
  endfor
  if base_variant == nil
    assign base_variant = product.selected_or_first_available_variant
  endif
-%}
{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    {%- render 'block-padding-vars', block: block -%}
  }
{%- endstyle -%}

<div class="flex flex-col gap-4" {{ block.shopify_attributes }}>
  {%- form 'product', product, id: 'product-form-buy-buttons' -%}
  {%- comment -%}
    Always render an "id" field inside the form so `{{ form | payment_button }}`
    (Surface 5) and `{{ form | payment_terms }}` reference a real variant even
    on multi-variant products. When a product-variant-picker block is also on
    the page, its own hidden input renders earlier in the DOM and remains the
    one this block's own JS reads via `querySelector('input[name="id"]')`
    (first match wins) — this field is kept in sync with it via the
    variant-changed event below, purely so Shopify's own dynamic-checkout
    script (which watches this form's field) stays current.
  {%- endcomment -%}
  <input type="hidden" name="id" id="product-variant-id" value="{{ product.selected_or_first_available_variant.id }}">

    <!-- Right: Button and Payment Badges -->
    <div class="flex flex-col items-center gap-3 w-full">
      {%- render 'product-buy-quantity-selector' -%}

      {%- render 'product-buy-cta', text_before_price: text_before_price, show_dynamic_checkout: block.settings.show_dynamic_checkout, form: form, sticky_info_text: block.settings.sticky_info_text -%}

      {%- render 'product-buy-payment-badges', custom_payment_icons_image: block.settings.custom_payment_icons_image, payment_icons_height: block.settings.payment_icons_height -%}
  </div>
  {%- endform -%}
</div>

<script id="simple-variant-data" type="application/json">
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "title": {{ variant.title | json }},
        "options": {{ variant.options | json }},
        "price": {{ variant.price }},
        "price_formatted": {{ variant.price | money | json }},
        "compare_at_price": {% if variant.compare_at_price != blank %}{{ variant.compare_at_price }}{% else %}null{% endif %}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

{%- assign sticky_buy_button_text = block.settings.sticky_buy_button_text | default: "Læg i kurv" -%}
<script type="application/json" id="product-buy-buttons-config">
  {"defaultVariantId": {{ product.selected_or_first_available_variant.id | json }}, "stickyButtonText": {{ sticky_buy_button_text | json }}}
</script>
<script src="{{ 'product-buy-buttons.js' | asset_url }}" defer="defer"></script>

<!-- Mobile Sticky Buy Bar -->
{%- render 'product-buy-sticky-bar', enable_sticky_buy_button: block.settings.enable_sticky_buy_button, sticky_buy_button_text: sticky_buy_button_text -%}

{% schema %}
{
  "name": "Product Buy Buttons",
  "settings": [
    {
      "type": "text",
      "id": "text_before_price",
      "label": "Tekst før pris på købsknap",
      "default": "Læg i kurv – "
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    },
    {
      "type": "header",
      "content": "Hurtig betaling"
    },
    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "Vis hurtige betalingsknapper (Shop Pay / PayPal m.fl.) under Læg i kurv",
      "default": true
    },
    {
      "type": "header",
      "content": "Betalingsikoner"
    },
    {
      "type": "image_picker",
      "id": "custom_payment_icons_image",
      "label": "Brugerdefineret betalingsbillede",
      "info": "Upload et billede med betalingsikoner (f.eks. MobilePay, Visa, Mastercard, Apple Pay) for at erstatte standardteksten."
    },
    {
      "type": "range",
      "id": "payment_icons_height",
      "min": 12,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Højde på betalingsbillede",
      "default": 24
    },
    {
      "type": "header",
      "content": "Sticky købsknap på mobil"
    },
    {
      "type": "checkbox",
      "id": "enable_sticky_buy_button",
      "label": "Aktiver sticky købsknap på mobil",
      "default": true
    },
    {
      "type": "text",
      "id": "sticky_buy_button_text",
      "label": "Tekst på sticky købsknap",
      "default": "Læg i kurv"
    }
  ],
  "presets": [
    {
      "name": "Product Buy Buttons",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}
