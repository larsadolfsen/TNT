{%- style -%}
  #shopify-block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top }}px !important;
    padding-bottom: {{ block.settings.padding_bottom }}px !important;
    padding-left: {{ block.settings.padding_horizontal }}px !important;
    padding-right: {{ block.settings.padding_horizontal }}px !important;
  }
{%- endstyle -%}

  <!-- Category Introduction -->
  <header class="mb-2" {{ block.shopify_attributes }}>
    <h1 class="font-serif text-2xl md:text-2xl font-bold text-primary">
      {%- if block.settings.title_override != blank -%}
        {{ block.settings.title_override }}
      {%- else -%}
        {{ collection.title }}
      {%- endif -%}
    </h1>
    {%- if block.settings.show_description and collection.description != blank -%}
      <div class="text-sm text-on-surface-variant mt-2 max-w-3xl">
        {{ collection.description }}
      </div>
    {%- endif -%}
  </header>

{% schema %}
{
  "name": "Page Title",
  "class": "shopify-block-page-title max-w-screen-xl mx-auto px-4 pt-1 pb-2",
  "settings": [
    {
      "type": "text",
      "id": "title_override",
      "label": "Overskrift override",
      "info": "Efterlad tom for at bruge kollektionens eget navn"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Vis kollektionsbeskrivelse",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Sideafstand",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Page Title"
    }
  ]
}
{% endschema %}
