  <!-- Category Introduction -->
  <header class="mb-2" {{ block.shopify_attributes }}>
    <h1 class="font-serif text-2xl md:text-2xl font-bold text-primary">
      {%- if block.settings.title_override != blank -%}
        {{ block.settings.title_override }}
      {%- else -%}
        {{ collection.title }}
      {%- endif -%}
    </h1>
    {%- if block.settings.show_description and collection.description != blank -%}
      <div class="text-sm text-on-surface-variant mt-2 max-w-3xl">
        {{ collection.description }}
      </div>
    {%- endif -%}
  </header>

{% schema %}
{
  "name": "Page Title",
  "class": "shopify-block-page-title max-w-screen-xl mx-auto px-4 pt-1 pb-2",
  "settings": [
    {
      "type": "text",
      "id": "title_override",
      "label": "Overskrift override",
      "info": "Efterlad tom for at bruge kollektionens eget navn"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Vis kollektionsbeskrivelse",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Page Title"
    }
  ]
}
{% endschema %}
