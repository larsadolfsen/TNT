{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    --block-padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --block-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    --block-padding-left: {{ block.settings.padding_sides | default: 0 }}px;
    --block-padding-right: {{ block.settings.padding_sides | default: 0 }}px;
  }
{%- endstyle -%}

  <!-- Category Introduction -->
  <header class="mb-2" {{ block.shopify_attributes }}>
    <h1 class="font-sans text-2xl md:text-2xl font-bold">
      {%- if block.settings.title_override != blank -%}
        {{ block.settings.title_override }}
      {%- else -%}
        {{ collection.title }}
      {%- endif -%}
    </h1>
    {%- if block.settings.show_description and collection.description != blank -%}
      <div class="text-sm opacity-85 mt-2 max-w-3xl">
        {{ collection.description }}
      </div>
    {%- endif -%}
  </header>

{% schema %}
{
  "name": "Page Title",
  "class": "shopify-block-page-title pt-1 pb-2",
  "settings": [
    {
      "type": "text",
      "id": "title_override",
      "label": "Overskrift override",
      "info": "Efterlad tom for at bruge kollektionens eget navn"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Vis kollektionsbeskrivelse",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Page Title",
      "category": "t:general.general_category"
    }
  ]
}
{% endschema %}
