{% doc %}
  Renders a collections grid block.
  Merchant can choose a specific collection, or it defaults to the template's current collection.
{% enddoc %}

{%- liquid
  assign display_collections = blank
  if collection != blank and collection.metafields.custom.child.value != blank
    assign display_collections = collection.metafields.custom.child.value
  endif
-%}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    --block-padding-top: {{ block.settings.padding_top | default: 12 }}px;
    --block-padding-bottom: {{ block.settings.padding_bottom | default: 12 }}px;
    --block-padding-left: {{ block.settings.padding_sides | default: 0 }}px;
    --block-padding-right: {{ block.settings.padding_sides | default: 0 }}px;
    width: 100%;
  }

  #collections-grid-{{ block.id }} {
    grid-template-columns: repeat({{ block.settings.columns_mobile | default: 2 }}, minmax(0, 1fr));
    --grid-gap: {{ block.settings.grid_gap | default: 16 }}px;
  }

  @media screen and (min-width: 768px) {
    #collections-grid-{{ block.id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet | default: 2 }}, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1024px) {
    #collections-grid-{{ block.id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop | default: 3 }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

{%- if display_collections != blank or request.design_mode -%}
<div id="collections-grid-{{ block.id }}" class="collections">
  {% for col_item in display_collections %}
    <a class="collection-card group" href="{{ col_item.url }}">
      <div class="collection-card__image-wrapper">
        {% if col_item.featured_image %}
          {% render 'image',
            class: 'collection-card__image',
            image: col_item.featured_image,
            width: 600,
            height: 600,
            crop: 'center'
          %}
        {% else %}
          <div class="w-full h-full flex items-center justify-center bg-outline-variant text-primary/85 aspect-square rounded-2xl border border-outline-variant">
            <span class="material-symbols-outlined text-4xl">image</span>
          </div>
        {% endif %}
      </div>

      <div class="collection-card__content">
        <h3 class="collection-card__title">{{ col_item.title }}</h3>

        {% if col_item.description %}
          <p class="collection-card__description">{{ col_item.description | strip_html | truncatewords: 15 }}</p>
        {% endif %}
      </div>
    </a>
  {% else %}
    {% if request.design_mode %}
      {% for i in (1..4) %}
        <div class="collection-card group">
          <div class="collection-card__image-wrapper flex items-center justify-center">
            {{ 'collection-' | append: i | placeholder_svg_tag: 'w-full h-full bg-slate-100 opacity-50' }}
          </div>
          <div class="collection-card__content">
            <h3 class="collection-card__title">Underkategori {{ i }}</h3>
            <p class="collection-card__description">Dette er en eksempel-underkategori i designvisning.</p>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  {% endfor %}
</div>
{%- endif -%}


{% schema %}
{
  "name": "t:general.collections_grid",
  "class": "shopify-block-collections-grid-wrapper",
  "settings": [
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Antal kolonner på mobil",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Antal kolonner på tablet",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Antal kolonner på desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:general.collections_grid",
      "category": "t:general.collection_category"
    }
  ]
}
{% endschema %}
