{% doc %}
  A flex container inside a Header Row 2 with alignment settings (left, center, right).
  Accepts any theme blocks nested inside it.
{% enddoc %}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    display: flex;
    align-items: center;
    height: calc(var(--row-height, 56px) - 12px);
    padding: 0;
  }

  {%- if block.settings.alignment == 'left' -%}
    #shopify-block-{{ block.id }}.shopify-block {
      justify-content: flex-start;
      flex-grow: 0;
      flex-shrink: 0;
    }
  {%- elsif block.settings.alignment == 'right' -%}
    #shopify-block-{{ block.id }}.shopify-block {
      justify-content: flex-end;
      flex-grow: 0;
      flex-shrink: 0;
    }
  {%- else -%}
    #shopify-block-{{ block.id }}.shopify-block {
      justify-content: center;
      /* Grow to fill the row, but stay shrinkable: the left/right groups are
         flex-shrink: 0, so a fixed width: 100% here overflows the row on
         narrow screens and clips whatever sits last in the right group.
         min-width: 0 overrides the flex default of min-width: auto, which
         would otherwise refuse to shrink below the content's width. */
      flex: 1 1 0%;
      min-width: 0;
    }
  {%- endif -%}
{%- endstyle -%}

<div
  class="header-group header-group-block flex items-center{% if block.settings.alignment == 'center' or block.settings.alignment == blank %} w-full min-w-0{% endif %}"
  style="height: calc(var(--row-height, 56px) - 12px); justify-content: {% if block.settings.alignment == 'left' %}flex-start{% elsif block.settings.alignment == 'right' %}flex-end{% else %}center{% endif %};"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Header Group",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "default": "center",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header Group"
    }
  ]
}
{% endschema %}
