{% doc %}
  Renders a grid of SUB-COLLECTIONS of the current/given collection, sourced
  from the collection.metafields.custom.child metafield (not to be confused
  with blocks/collection-products-grid.liquid, which renders a collection's
  products). Card-style layout with image, title and description - for the
  simpler "image + title only" variant see blocks/collection-children.liquid.
{% enddoc %}

{%- liquid
  assign display_collections = blank
  if collection != blank and collection.metafields.custom.child.value != blank
    assign display_collections = collection.metafields.custom.child.value
  endif
-%}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    {%- render 'block-padding-vars', block: block, top_default: 12, bottom_default: 12 -%}
    width: 100%;
  }

  #collections-grid-{{ block.id }} {
    grid-template-columns: repeat({{ block.settings.columns_mobile | default: 2 }}, minmax(0, 1fr));
    --grid-gap: {{ block.settings.grid_gap | default: 16 }}px;
  }

  @media screen and (min-width: 768px) {
    #collections-grid-{{ block.id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet | default: 2 }}, minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1024px) {
    #collections-grid-{{ block.id }} {
      grid-template-columns: repeat({{ block.settings.columns_desktop | default: 3 }}, minmax(0, 1fr));
    }
  }
{%- endstyle -%}

{%- if display_collections != blank or request.design_mode -%}
<div id="collections-grid-{{ block.id }}" class="collections">
  {% for col_item in display_collections %}
    {% render 'collection-card', collection: col_item %}
  {% else %}
    {% if request.design_mode %}
      {% for i in (1..4) %}
        {% render 'collection-card', placeholder_index: i %}
      {% endfor %}
    {% endif %}
  {% endfor %}
</div>
{%- endif -%}


{% schema %}
{
  "name": "t:general.collections_grid",
  "class": "shopify-block-subcollections-grid-wrapper",
  "settings": [
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 6,
      "step": 1,
      "label": "Antal kolonner på mobil",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_tablet",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Antal kolonner på tablet",
      "default": 2
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 12,
      "step": 1,
      "label": "Antal kolonner på desktop",
      "default": 3
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "t:labels.grid_gap",
      "min": 0,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:general.collections_grid",
      "category": "t:general.collection_category"
    }
  ]
}
{% endschema %}
