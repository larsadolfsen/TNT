<div class="flex items-center gap-2.5 text-primary font-medium" 
     id="trust-countdown-{{ block.id }}"
     data-text-before-cutoff="{{ block.settings.text_before_cutoff | escape }}"
     data-text-after-cutoff="{{ block.settings.text_after_cutoff | escape }}"
     data-legacy-text="{{ block.settings.text | escape }}"
     data-legacy-suffix="{{ block.settings.suffix | escape }}"
     data-shipping-sunday-active="{{ settings.shipping_sunday_active | default: false }}"
     data-shipping-sunday-cutoff="{{ settings.shipping_sunday_cutoff | default: '12:00' }}"
     data-shipping-sunday-delivery="{{ settings.shipping_sunday_delivery | default: 'tirsdag' }}"
     data-shipping-monday-active="{{ settings.shipping_monday_active | default: true }}"
     data-shipping-monday-cutoff="{{ settings.shipping_monday_cutoff | default: '12:00' }}"
     data-shipping-monday-delivery="{{ settings.shipping_monday_delivery | default: 'onsdag' }}"
     data-shipping-tuesday-active="{{ settings.shipping_tuesday_active | default: true }}"
     data-shipping-tuesday-cutoff="{{ settings.shipping_tuesday_cutoff | default: '12:00' }}"
     data-shipping-tuesday-delivery="{{ settings.shipping_tuesday_delivery | default: 'torsdag' }}"
     data-shipping-wednesday-active="{{ settings.shipping_wednesday_active | default: true }}"
     data-shipping-wednesday-cutoff="{{ settings.shipping_wednesday_cutoff | default: '12:00' }}"
     data-shipping-wednesday-delivery="{{ settings.shipping_wednesday_delivery | default: 'fredag' }}"
     data-shipping-thursday-active="{{ settings.shipping_thursday_active | default: true }}"
     data-shipping-thursday-cutoff="{{ settings.shipping_thursday_cutoff | default: '12:00' }}"
     data-shipping-thursday-delivery="{{ settings.shipping_thursday_delivery | default: 'fredag' }}"
     data-shipping-friday-active="{{ settings.shipping_friday_active | default: true }}"
     data-shipping-friday-cutoff="{{ settings.shipping_friday_cutoff | default: '12:00' }}"
     data-shipping-friday-delivery="{{ settings.shipping_friday_delivery | default: 'mandag' }}"
     data-shipping-saturday-active="{{ settings.shipping_saturday_active | default: false }}"
     data-shipping-saturday-cutoff="{{ settings.shipping_saturday_cutoff | default: '12:00' }}"
     data-shipping-saturday-delivery="{{ settings.shipping_saturday_delivery | default: 'tirsdag' }}"
     {{ block.shopify_attributes }}>
  <span class="material-symbols-outlined text-lg text-emerald-600" style="font-variation-settings: 'FILL' 1;">check_circle</span>
  <span id="countdown-content-{{ block.id }}">
    {%- if block.settings.text_before_cutoff != blank -%}
      {{ block.settings.text_before_cutoff | replace: '{cutoff}', '12.00' | replace: '{shipping_day}', 'i dag' }}
    {%- else -%}
      {{ block.settings.text }} <span class="font-mono font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded">12.00</span>{{ block.settings.suffix }}
    {%- endif -%}
  </span>
</div>

<script>
  (function() {
    const container = document.getElementById("trust-countdown-{{ block.id }}");
    if (!container) return;
    
    let textBeforeCutoff = container.getAttribute("data-text-before-cutoff");
    let textAfterCutoff = container.getAttribute("data-text-after-cutoff");
    
    // Provide defaults if the block settings are empty
    if (!textBeforeCutoff) {
      textBeforeCutoff = "Bestil inden {cutoff}. Så sender vi {shipping_day}.";
    }
    if (!textAfterCutoff) {
      textAfterCutoff = "Bestil i dag. Så sender vi {shipping_day}.";
    }
    
    const legacyText = container.getAttribute("data-legacy-text") || "";
    const legacySuffix = container.getAttribute("data-legacy-suffix") || "";
    const hasLegacySettings = legacyText !== "" || legacySuffix !== "";
    
    // Parse shipping config from data attributes
    const shippingConfig = [];
    const days = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'];
    days.forEach((day, index) => {
      const activeAttr = container.getAttribute(`data-shipping-${day}-active`);
      const cutoffAttr = container.getAttribute(`data-shipping-${day}-cutoff`);
      const deliveryAttr = container.getAttribute(`data-shipping-${day}-delivery`);
      
      shippingConfig.push({
        active: activeAttr === 'true',
        cutoff: cutoffAttr || '12:00',
        delivery: deliveryAttr || ''
      });
    });
    
    const contentEl = document.getElementById("countdown-content-{{ block.id }}");
    const danishDays = ['søndag', 'mandag', 'tirsdag', 'onsdag', 'torsdag', 'fredag', 'lørdag'];
    
    function getCopenhagenTime() {
      const options = { timeZone: 'Europe/Copenhagen', year: 'numeric', month: 'numeric', day: 'numeric', hour: 'numeric', minute: 'numeric', second: 'numeric', hour12: false };
      const formatter = new Intl.DateTimeFormat('en-US', options);
      const parts = formatter.formatToParts(new Date());
      const partValues = {};
      parts.forEach(p => partValues[p.type] = p.value);
      return new Date(partValues.year, partValues.month - 1, partValues.day, partValues.hour, partValues.minute, partValues.second);
    }
    
    function updateUI() {
      const now = getCopenhagenTime();
      let targetDate = null;
      let shippingDayOffset = 0;
      let config = null;
      let isBeforeCutoff = false;
      
      // Check if we are before today's cutoff (if today is an active shipping day)
      const todayOfWeek = now.getDay();
      const todayConfig = shippingConfig[todayOfWeek];
      
      if (todayConfig && todayConfig.active) {
        const [hoursStr, minutesStr] = todayConfig.cutoff.split(':');
        const targetHours = parseInt(hoursStr, 10) || 12;
        const targetMinutes = parseInt(minutesStr, 10) || 0;
        
        const todayCutoffDate = new Date(now);
        todayCutoffDate.setHours(targetHours, targetMinutes, 0, 0);
        
        if (now < todayCutoffDate) {
          isBeforeCutoff = true;
          targetDate = todayCutoffDate;
          shippingDayOffset = 0;
          config = todayConfig;
        }
      }
      
      // If we are not before today's cutoff, find the next active shipping day
      if (!isBeforeCutoff) {
        for (let i = 1; i < 8; i++) {
          const checkDate = new Date(now);
          checkDate.setDate(now.getDate() + i);
          const dayOfWeek = checkDate.getDay();
          const currentConfig = shippingConfig[dayOfWeek];
          
          if (currentConfig && currentConfig.active) {
            const [hoursStr, minutesStr] = currentConfig.cutoff.split(':');
            const targetHours = parseInt(hoursStr, 10) || 12;
            const targetMinutes = parseInt(minutesStr, 10) || 0;
            
            checkDate.setHours(targetHours, targetMinutes, 0, 0);
            
            targetDate = checkDate;
            shippingDayOffset = i;
            config = currentConfig;
            break;
          }
        }
      }
      
      if (!targetDate) {
        // Fallback
        targetDate = new Date(now);
        targetDate.setDate(now.getDate() + 1);
        targetDate.setHours(12, 0, 0, 0);
        shippingDayOffset = 1;
        config = { active: true, cutoff: '12:00', delivery: '1-2 hverdage' };
      }
      
      // Clean up cutoff string format (e.g. replace ':' with '.') to match Danish style if desired
      const formattedCutoff = config.cutoff.replace(':', '.');
      const cutoffHtml = `<span class="font-mono font-bold text-emerald-600 bg-emerald-50 px-1.5 py-0.5 rounded">${formattedCutoff}</span>`;
      
      // Determine shipping day text
      let shippingDayText = '';
      if (shippingDayOffset === 0) {
        shippingDayText = 'i dag';
      } else if (shippingDayOffset === 1) {
        shippingDayText = 'i morgen';
      } else {
        shippingDayText = 'på ' + danishDays[targetDate.getDay()];
      }
      
      const deliveryDayText = config.delivery || '1-2 hverdage';
      
      // Render text using templates
      if (container.getAttribute("data-text-before-cutoff") || container.getAttribute("data-text-after-cutoff")) {
        // Use custom templates
        const activeTemplate = isBeforeCutoff ? textBeforeCutoff : textAfterCutoff;
        let htmlContent = activeTemplate
          .replace('{cutoff}', cutoffHtml)
          .replace('{shipping_day}', shippingDayText)
          .replace('{delivery_day}', deliveryDayText);
        
        contentEl.innerHTML = htmlContent;
      } else if (hasLegacySettings) {
        // Fallback for legacy blocks
        if (isBeforeCutoff) {
          let suffixText = legacySuffix;
          suffixText = suffixText.replace(/timer\.\s*/gi, "");
          contentEl.innerHTML = `${legacyText} ${cutoffHtml}. ${suffixText}`;
        } else {
          contentEl.innerHTML = `Bestil i dag. Så sender vi ${shippingDayText}.`;
        }
      } else {
        // Default text
        const activeTemplate = isBeforeCutoff ? textBeforeCutoff : textAfterCutoff;
        let htmlContent = activeTemplate
          .replace('{cutoff}', cutoffHtml)
          .replace('{shipping_day}', shippingDayText)
          .replace('{delivery_day}', deliveryDayText);
        
        contentEl.innerHTML = htmlContent;
      }
    }
    
    updateUI();
  })();
</script>

{% schema %}
{
  "name": "Trust Countdown",
  "class": "shopify-block-trust-countdown",
  "settings": [
    {
      "type": "text",
      "id": "text_before_cutoff",
      "label": "Skabelon før cut-off",
      "default": "Bestil inden {cutoff}. Så sender vi {shipping_day}.",
      "info": "Brug {cutoff} for tidsfristen, {shipping_day} for afsendelsesdagen, og {delivery_day} for leveringsdagen."
    },
    {
      "type": "text",
      "id": "text_after_cutoff",
      "label": "Skabelon efter cut-off",
      "default": "Bestil i dag. Så sender vi {shipping_day}.",
      "info": "Brug {shipping_day} for afsendelsesdagen, og {delivery_day} for leveringsdagen."
    },
    {
      "type": "header",
      "content": "Bagudkompatibilitet (Legacy)"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Prefix Text",
      "default": "Afsendes i dag – Bestil inden"
    },
    {
      "type": "text",
      "id": "suffix",
      "label": "Suffix Text",
      "default": " timer"
    }
  ],
  "presets": [
    {
      "name": "Trust Countdown"
    }
  ]
}
{% endschema %}
