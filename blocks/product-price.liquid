{% comment %}
  Product Price Section
  Renders the product price and base price per meter display.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign display_price = current_variant.price
  assign suffix = block.settings.price_suffix
  
  assign is_metervare = false
  if product.metafields.custom.metervare.value == true or product.metafields.custom.metervare == true
    assign is_metervare = true
  endif

  if is_metervare
    assign display_price = current_variant.price | times: 100
    assign suffix = 'pr. meter inkl. moms'
  endif
-%}

{%- if block.settings.suppress_padding_top or block.settings.suppress_padding_bottom -%}
  {%- style -%}
    {%- if block.settings.suppress_padding_top -%}
      #shopify-block-{{ block.id }} {
        padding-top: 0 !important;
      }
    {%- endif -%}
    {%- if block.settings.suppress_padding_bottom -%}
      #shopify-block-{{ block.id }} {
        padding-bottom: 0 !important;
      }
    {%- endif -%}
  {%- endstyle -%}
{%- endif -%}

<div {{ block.shopify_attributes }}>
  <!-- Pricing -->
  <div class="flex items-baseline gap-2 flex-nowrap overflow-hidden">
    <span id="base-price-display" class="text-3xl font-bold tracking-tight text-primary whitespace-nowrap">
      {{ display_price | money }}
    </span>
    {%- if suffix != blank -%}
      <span class="text-sm text-on-surface-variant font-medium whitespace-nowrap">{{ suffix }}</span>
    {%- endif -%}
  </div>
  {%- if block.settings.price_subtext != blank -%}
    <p class="text-xs text-on-surface-variant mt-1.5">{{ block.settings.price_subtext }}</p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Product Price",
  "class": "shopify-block-product-price",
  "settings": [
    {
      "type": "text",
      "id": "price_suffix",
      "label": "Price suffix",
      "default": "pr. meter inkl. moms"
    },
    {
      "type": "text",
      "id": "price_subtext",
      "label": "Price subtext",
      "default": "Skæres efter mål, så du kun betaler for den længde, du vælger."
    },
    {
      "type": "checkbox",
      "id": "suppress_padding_top",
      "label": "Fjern afstand i toppen",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "suppress_padding_bottom",
      "label": "Fjern afstand i bunden",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Product Price"
    }
  ]
}
{% endschema %}
