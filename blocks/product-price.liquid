{% comment %}
  Product Price Section
  Renders the product price and base price per meter display.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign display_price = current_variant.price
  assign compare_price = current_variant.compare_at_price
  assign suffix = block.settings.price_suffix
  
  assign is_metervare = false
  if product.metafields.custom.metervare.value == true or product.metafields.custom.metervare == true
    assign is_metervare = true
  endif

  if is_metervare
    assign display_price = current_variant.price | times: 100
    if compare_price != blank
      assign compare_price = compare_price | times: 100
    endif
    assign suffix = 'pr. meter inkl. moms'
  endif

  assign on_sale = false
  if compare_price != blank and compare_price > display_price
    assign on_sale = true
  endif

  if on_sale
    assign savings = compare_price | minus: display_price | times: 100 | divided_by: compare_price
    assign price_main = display_price | divided_by: 100
    assign price_cents = display_price | modulo: 100
    if price_cents < 10
      assign price_cents = '0' | append: price_cents
    endif
  endif

  # Surface 11: Shop Pay Installments — placement/spacing only, native element.
  assign show_installments = block.settings.show_installments | default: true

  # Surface 12: unit pricing — data-driven, no per-block setting; gated by the
  # (not-yet-added) theme-wide `settings.show_unit_pricing` toggle, defaulting
  # to on so this keeps working once that global setting exists.
  assign show_unit_pricing = settings.show_unit_pricing | default: true
-%}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    --block-padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --block-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    --block-padding-left: {{ block.settings.padding_sides | default: 0 }}px;
    --block-padding-right: {{ block.settings.padding_sides | default: 0 }}px;
  }
{%- endstyle -%}

<div {{ block.shopify_attributes }}>
  <div id="product-price-container-{{ block.id }}" class="flex flex-col gap-1.5">
    {%- if on_sale -%}
      <!-- Savings Tag Above Price -->
      <div class="product-savings-container flex items-center mb-1">
        <span class="product-savings-badge inline-block text-[#c8102e] text-2xl font-bold leading-none">
          Spar {{ savings }}%
        </span>
      </div>
      
      <!-- Price Display -->
      <div class="flex items-baseline gap-x-3 flex-nowrap overflow-hidden">
        <!-- Main Sale Price with superscript cents and currency -->
        <span class="text-5xl font-black tracking-tight text-primary whitespace-nowrap flex items-start select-all">
          <span>{{ price_main }}</span>
          <sup class="text-base font-bold ml-0.5 mt-1.5 text-primary">{{ price_cents }} {{ cart.currency.iso_code }}</sup>
        </span>
        {%- if suffix != blank -%}
          <span class="text-sm text-primary/85 font-medium whitespace-nowrap pb-0.5 ml-0.5">{{ suffix }}</span>
        {%- endif -%}
      </div>
      
      <!-- List price row -->
      <div class="flex items-center gap-1.5 text-sm text-primary/60 mt-1 select-none">
        <span>{{ block.settings.compare_at_price_label | default: settings.compare_at_price_label | default: 'Normalpris' }}:</span>
        <span class="line-through">{{ compare_price | money }}</span>
        {% render 'icon', name: 'info', class: 'text-[16px] cursor-help text-primary/45 hover:text-primary/70 flex items-center', attributes: 'title="Vejledende udsalgspris"' %}
      </div>
    {%- else -%}
      <!-- Standard layout -->
      <div class="flex items-baseline gap-2 flex-nowrap overflow-hidden">
        <span id="base-price-display" class="text-3xl font-bold tracking-tight text-primary whitespace-nowrap">
          {{ display_price | money }}
        </span>
        {%- if suffix != blank -%}
          <span class="text-sm text-primary/85 font-medium whitespace-nowrap">{{ suffix }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if show_unit_pricing -%}
      <div class="mt-1" id="unit-price-row-{{ block.id }}">
        {% render 'unit-price', variant: current_variant, size: 'base' %}
      </div>
    {%- endif -%}
  </div>

  {%- if show_installments -%}
    <div class="installments-wrapper mt-2" id="installments-wrapper-{{ block.id }}">
      {%- for variant in product.variants -%}
        <div class="installments-variant" data-variant-id="{{ variant.id }}" {% unless variant.id == current_variant.id %}hidden{% endunless %}>
          {{ variant.price | payment_terms }}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if block.settings.price_subtext != blank -%}
    <p class="text-sm text-primary/85 mt-1.5">{{ block.settings.price_subtext }}</p>
  {%- endif -%}
</div>

<script id="product-price-variant-data-{{ block.id }}" type="application/json">
  [
    {%- for variant in product.variants -%}
      {%- liquid
        assign v_price = variant.price
        assign v_compare = variant.compare_at_price
        if is_metervare
          assign v_price = v_price | times: 100
          if v_compare != blank
            assign v_compare = v_compare | times: 100
          endif
        endif

        # Surface 12: unit pricing — same reference_value-omission rule as
        # snippets/unit-price.liquid ("40,00 kr / g" when reference_value is 1).
        assign v_measurement = variant.unit_price_measurement
        if v_measurement != blank
          assign v_unit_suffix = v_measurement.reference_unit
          if v_measurement.reference_value != 1
            assign v_unit_suffix = v_measurement.reference_value | append: ' ' | append: v_measurement.reference_unit
          endif
        endif
      -%}
      {
        "id": {{ variant.id }},
        "price": {{ v_price }},
        "compare_at_price": {% if v_compare != blank %}{{ v_compare }}{% else %}null{% endif %},
        "price_formatted": {{ v_price | money | json }},
        "compare_at_price_formatted": {% if v_compare != blank %}{{ v_compare | money | json }}{% else %}null{% endif %},
        "unit_price_formatted": {% if v_measurement != blank %}{{ variant.unit_price | money | json }}{% else %}null{% endif %},
        "unit_price_suffix": {% if v_measurement != blank %}{{ v_unit_suffix | json }}{% else %}null{% endif %}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const container = document.getElementById("product-price-container-{{ block.id }}");
    if (!container) return;

    let priceVariants = [];
    try {
      priceVariants = JSON.parse(document.getElementById("product-price-variant-data-{{ block.id }}").textContent);
    } catch (e) {
      console.error("Failed to parse product price variant data", e);
      return;
    }

    function formatCents(cents) {
      return cents < 10 ? '0' + cents : cents;
    }

    function unitPriceHtml(variant) {
      if (!variant.unit_price_formatted || !{{ show_unit_pricing | json }}) return '';
      return `<div class="mt-1"><span class="unit-price text-sm text-primary/70">${variant.unit_price_formatted} / ${variant.unit_price_suffix}</span></div>`;
    }

    function updatePrice(variantId) {
      const variant = priceVariants.find(v => v.id === parseInt(variantId));
      if (!variant) return;

      const suffix = {{ suffix | json }};
      const currencyCode = {{ cart.currency.iso_code | json }};
      const unitPriceRow = unitPriceHtml(variant);

      const isOnSale = variant.compare_at_price && variant.compare_at_price > variant.price;

      if (isOnSale) {
        const savings = Math.round(((variant.compare_at_price - variant.price) * 100) / variant.compare_at_price);
        const priceMain = Math.floor(variant.price / 100);
        const priceCents = formatCents(variant.price % 100);
        
        let suffixHtml = '';
        if (suffix) {
          suffixHtml = `<span class="text-sm text-primary/85 font-medium whitespace-nowrap pb-0.5 ml-0.5">${suffix}</span>`;
        }

        container.innerHTML = `
          <!-- Savings Tag Above Price -->
          <div class="product-savings-container flex items-center mb-1">
            <span class="product-savings-badge inline-block text-[#c8102e] text-2xl font-bold leading-none">
              Spar ${savings}%
            </span>
          </div>
          <!-- Price Display -->
          <div class="flex items-baseline gap-x-3 flex-nowrap overflow-hidden">
            <span class="text-5xl font-black tracking-tight text-primary whitespace-nowrap flex items-start select-all">
              <span>${priceMain}</span>
              <sup class="text-base font-bold ml-0.5 mt-1.5 text-primary">${priceCents} ${currencyCode}</sup>
            </span>
            ${suffixHtml}
          </div>
          <div class="flex items-center gap-1.5 text-sm text-primary/60 mt-1 select-none">
            <span>{{ block.settings.compare_at_price_label | default: settings.compare_at_price_label | default: 'Normalpris' }}:</span>
            <span class="line-through">${variant.compare_at_price_formatted}</span>
            <span class="material-symbols-outlined text-[16px] cursor-help text-primary/45 hover:text-primary/70 flex items-center" title="Vejledende udsalgspris">info</span>
          </div>
          ${unitPriceRow}
        `;
      } else {
        let suffixHtml = '';
        if (suffix) {
          suffixHtml = `<span class="text-sm text-primary/85 font-medium whitespace-nowrap">${suffix}</span>`;
        }

        container.innerHTML = `
          <div class="flex items-baseline gap-2 flex-nowrap overflow-hidden">
            <span id="base-price-display" class="text-3xl font-bold tracking-tight text-primary whitespace-nowrap">
              ${variant.price_formatted}
            </span>
            ${suffixHtml}
          </div>
          ${unitPriceRow}
        `;
      }
    }

    document.addEventListener("variant-changed", (e) => {
      if (e.detail && e.detail.variantId) {
        updatePrice(e.detail.variantId);
      }
    });

    // Surface 11: Shop Pay Installments — every variant's messaging is
    // pre-rendered by Liquid (payment_terms is a server-only filter with no
    // client-side reformatting API); on variant change we just toggle which
    // one is visible so the amount always matches the selected variant.
    const installmentsWrapper = document.getElementById("installments-wrapper-{{ block.id }}");
    if (installmentsWrapper) {
      document.addEventListener("variant-changed", (e) => {
        if (!e.detail || !e.detail.variantId) return;
        installmentsWrapper.querySelectorAll(".installments-variant").forEach((el) => {
          el.hidden = el.dataset.variantId !== String(e.detail.variantId);
        });
      });
    }
  });
</script>

<style>
  /* Surface 11: hide the installments wrapper entirely when Shop Pay
     Installments is unavailable (feature disabled or product ineligible) for
     the currently visible variant, rather than leaving a stray mt-2 gap. */
  .installments-wrapper:has(.installments-variant:not([hidden]):empty) {
    display: none;
  }
</style>

{% schema %}
{
  "name": "Product Price",
  "class": "shopify-block-product-price",
  "settings": [
    {
      "type": "text",
      "id": "price_suffix",
      "label": "Price suffix",
      "default": "pr. meter inkl. moms"
    },
    {
      "type": "text",
      "id": "compare_at_price_label",
      "label": "Listepris label",
      "default": "Normalpris"
    },
    {
      "type": "text",
      "id": "price_subtext",
      "label": "Price subtext",
      "default": "Skæres efter mål, så du kun betaler for den længde, du vælger."
    },
    {
      "type": "header",
      "content": "Shop Pay-afdrag"
    },
    {
      "type": "checkbox",
      "id": "show_installments",
      "label": "Vis \"fra X kr./md.\" med Shop Pay under prisen",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Price",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}
