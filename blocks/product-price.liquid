{% comment %}
  Product Price Section
  Renders the product price. When the selected variant has native Shopify
  unit pricing (unit_price_measurement), the unit price is the headline and
  the raw per-unit price is suppressed; otherwise unchanged.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign display_price = current_variant.price
  assign compare_price = current_variant.compare_at_price
  assign suffix = block.settings.price_suffix

  # Surface 12: unit pricing — data-driven, no per-block setting; gated by the
  # theme-wide `settings.show_unit_pricing` toggle, defaulting to on.
  assign show_unit_pricing = settings.show_unit_pricing | default: true

  # Headline rule: when the selected variant carries native Shopify unit
  # pricing (unit_price_measurement), its unit price is the headline price
  # and the raw per-unit price is suppressed. No product-type/metafield
  # gating — presence of unit pricing is the only signal, so this stays
  # correct for any merchant who configures it, not just this catalog.
  assign unit_measurement = current_variant.unit_price_measurement
  assign has_unit_price = false
  if unit_measurement != blank and show_unit_pricing
    assign has_unit_price = true
  endif

  assign headline_price = display_price
  if has_unit_price
    assign headline_price = current_variant.unit_price
    assign unit_suffix = unit_measurement.reference_unit
    if unit_measurement.reference_value != 1
      assign unit_suffix = unit_measurement.reference_value | append: ' ' | append: unit_measurement.reference_unit
    endif
  endif

  assign on_sale = false
  if compare_price != blank and compare_price > display_price
    assign on_sale = true
  endif

  if on_sale
    assign savings = compare_price | minus: display_price | times: 100 | divided_by: compare_price
    assign price_main = headline_price | divided_by: 100
    assign price_cents = headline_price | modulo: 100
    if price_cents < 10
      assign price_cents = '0' | append: price_cents
    endif
  endif

  # Surface 11: Shop Pay Installments — placement/spacing only, native element.
  assign show_installments = block.settings.show_installments | default: true
-%}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    {%- render 'block-padding-vars', block: block -%}
  }
{%- endstyle -%}

<div {{ block.shopify_attributes }}>
  <div id="product-price-container-{{ block.id }}" class="flex flex-col gap-1.5">
    {%- if on_sale -%}
      <!-- Savings Tag Above Price -->
      <div class="product-savings-container flex items-center mb-1">
        {%- render 'savings-badge', savings: savings, size: 'lg' -%}
      </div>
      
      <!-- Price Display -->
      <div class="flex items-baseline gap-x-3 flex-nowrap overflow-hidden">
        <!-- Main Sale Price with superscript cents and currency -->
        <span class="text-5xl font-black tracking-tight text-primary whitespace-nowrap flex items-start select-all">
          <span>{{ price_main }}</span>
          <sup class="text-base font-bold ml-0.5 mt-1.5 text-primary">{{ price_cents }} {{ cart.currency.iso_code }}</sup>
        </span>
        {%- if has_unit_price -%}
          <span class="text-sm text-primary/85 font-medium whitespace-nowrap pb-0.5 ml-0.5">/ {{ unit_suffix }}</span>
        {%- endif -%}
        {%- if suffix != blank -%}
          <span class="text-sm text-primary/85 font-medium whitespace-nowrap pb-0.5 ml-0.5">{{ suffix }}</span>
        {%- endif -%}
      </div>
      
      <!-- List price row -->
      {%- comment -%}
        Suppressed when has_unit_price: compare_price is the raw per-unit
        compare-at price (Shopify has no unit-price equivalent for it), and
        showing it crossed out next to a per-reference-unit headline would be
        as misleading as the raw headline price this rule exists to fix. The
        "Spar X%" badge above is a ratio and stays correct either way.
      {%- endcomment -%}
      {%- unless has_unit_price -%}
        <div class="flex items-center gap-1.5 text-sm text-primary/60 mt-1 select-none">
          <span>{{ block.settings.compare_at_price_label | default: settings.compare_at_price_label | default: 'Normalpris' }}:</span>
          <span class="line-through">{{ compare_price | money }}</span>
          {% render 'icon', name: 'info', class: 'text-[16px] cursor-help text-primary/45 hover:text-primary/70 flex items-center', attributes: 'title="Vejledende udsalgspris"' %}
        </div>
      {%- endunless -%}
    {%- else -%}
      <!-- Standard layout -->
      <div class="flex items-baseline gap-2 flex-nowrap overflow-hidden">
        <span id="base-price-display" class="text-3xl font-bold tracking-tight text-primary whitespace-nowrap">
          {{ headline_price | money }}
        </span>
        {%- if has_unit_price -%}
          <span class="text-sm text-primary/85 font-medium whitespace-nowrap">/ {{ unit_suffix }}</span>
        {%- endif -%}
        {%- if suffix != blank -%}
          <span class="text-sm text-primary/85 font-medium whitespace-nowrap">{{ suffix }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%}
      No separate unit-price sub-line here: whenever unit_price_measurement is
      present it's already the headline above, so a smaller render 'unit-price'
      call below it would only duplicate the same value.
    {%- endcomment -%}
  </div>

  {%- if show_installments -%}
    <div class="installments-wrapper mt-2" id="installments-wrapper-{{ block.id }}">
      {%- for variant in product.variants -%}
        <div class="installments-variant" data-variant-id="{{ variant.id }}" {% unless variant.id == current_variant.id %}hidden{% endunless %}>
          {{ variant.price | payment_terms }}
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}

  {%- if block.settings.price_subtext != blank -%}
    <p class="text-sm text-primary/85 mt-1.5">{{ block.settings.price_subtext }}</p>
  {%- endif -%}
</div>

<script id="product-price-variant-data-{{ block.id }}" type="application/json">
  [
    {%- for variant in product.variants -%}
      {%- liquid
        assign v_price = variant.price
        assign v_compare = variant.compare_at_price

        # Headline rule, same signal as the initial render above: a variant
        # with unit_price_measurement gets its unit price as the headline
        # (raw v_price/v_compare travel unmultiplied either way).
        assign v_measurement = variant.unit_price_measurement
        assign v_has_unit_price = false
        if v_measurement != blank and show_unit_pricing
          assign v_has_unit_price = true
        endif

        if v_has_unit_price
          # Surface 12: same reference_value-omission rule as
          # snippets/unit-price.liquid ("40,00 kr / g" when reference_value is 1).
          assign v_unit_suffix = v_measurement.reference_unit
          if v_measurement.reference_value != 1
            assign v_unit_suffix = v_measurement.reference_value | append: ' ' | append: v_measurement.reference_unit
          endif
        endif
      -%}
      {
        "id": {{ variant.id }},
        "price": {{ v_price }},
        "compare_at_price": {% if v_compare != blank %}{{ v_compare }}{% else %}null{% endif %},
        "price_formatted": {{ v_price | money | json }},
        "compare_at_price_formatted": {% if v_compare != blank %}{{ v_compare | money | json }}{% else %}null{% endif %},
        "has_unit_price": {{ v_has_unit_price | json }},
        "unit_price": {% if v_has_unit_price %}{{ variant.unit_price }}{% else %}null{% endif %},
        "unit_price_formatted": {% if v_has_unit_price %}{{ variant.unit_price | money | json }}{% else %}null{% endif %},
        "unit_price_suffix": {% if v_has_unit_price %}{{ v_unit_suffix | json }}{% else %}null{% endif %}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<script type="application/json" id="product-price-config-{{ block.id }}">
{
  "suffix": {{ suffix | json }},
  "currencyCode": {{ cart.currency.iso_code | json }},
  "compareAtPriceLabel": {{ block.settings.compare_at_price_label | default: settings.compare_at_price_label | default: 'Normalpris' | json }}
}
</script>
<script src="{{ 'product-price.min.js' | asset_url }}" defer="defer"></script>

<style>
  /* Surface 11: hide the installments wrapper entirely when Shop Pay
     Installments is unavailable (feature disabled or product ineligible) for
     the currently visible variant, rather than leaving a stray mt-2 gap. */
  .installments-wrapper:has(.installments-variant:not([hidden]):empty) {
    display: none;
  }
</style>

{% schema %}
{
  "name": "Product Price",
  "class": "shopify-block-product-price",
  "settings": [
    {
      "type": "text",
      "id": "price_suffix",
      "label": "Price suffix"
    },
    {
      "type": "text",
      "id": "compare_at_price_label",
      "label": "Listepris label",
      "default": "Normalpris"
    },
    {
      "type": "text",
      "id": "price_subtext",
      "label": "Price subtext",
      "default": "Skæres efter mål, så du kun betaler for den længde, du vælger."
    },
    {
      "type": "header",
      "content": "Shop Pay-afdrag"
    },
    {
      "type": "checkbox",
      "id": "show_installments",
      "label": "Vis \"fra X kr./md.\" med Shop Pay under prisen",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Price",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}

