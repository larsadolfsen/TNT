<div class="flex items-center gap-2.5 text-primary font-medium" {{ block.shopify_attributes }}>
  {% render 'icon', name: 'check_circle', class: 'text-lg text-emerald-600', style: "font-variation-settings: 'FILL' 1;" %}
  <span>{{ block.settings.text }}</span>
</div>

{% schema %}
{
  "name": "Trust Checkmark",
  "class": "shopify-block-trust-checkmark",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Indtast fordel her"
    }
  ],
  "presets": [
    {
      "name": "Trust Checkmark",
      "category": "t:general.general_category"
    }
  ]
}
{% endschema %}
