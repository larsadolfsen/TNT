{%- capture checkmark_content -%}<span>{{ block.settings.text }}</span>{%- endcapture -%}
{% render 'trust-checkmark-item', content: checkmark_content, attributes: block.shopify_attributes %}

{% schema %}
{
  "name": "Trust Checkmark",
  "class": "shopify-block-trust-checkmark",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Indtast fordel her"
    }
  ],
  "presets": [
    {
      "name": "Trust Checkmark",
      "category": "t:general.general_category"
    }
  ]
}
{% endschema %}
