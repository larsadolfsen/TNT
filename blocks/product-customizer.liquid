{% comment %}
  New Product Customizer Section
  Built from scratch. Renders a premium length stepper.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- liquid
  assign min_length = block.settings.min_length | default: 50
  assign step_size = block.settings.step_size | default: 10
  assign product_width_limit = product.metafields.custom.bredde.value | default: product.metafields.custom.bredde | default: 140

  # Detect width option index and values
  assign width_option_name = nil
  assign width_option_index = nil
  assign width_option_values = nil

  for option in product.options_with_values
    assign name_down = option.name | downcase
    if name_down contains 'bredde' or name_down contains 'width' or name_down contains 'størrelse' or name_down contains 'size'
      assign width_option_name = option.name
      assign width_option_index = forloop.index0
      assign width_option_values = option.values
      break
    endif
  endfor

  assign shape_firkantet = all_products[block.settings.firkantet_product]
  assign shape_rund = all_products[block.settings.rund_product]
  assign shape_oval = all_products[block.settings.oval_product]

  assign firkantet_price_formatted = shape_firkantet.price | default: 0 | money | replace: 'kr.', '' | replace: 'kr', '' | replace: 'Kr.', '' | replace: 'Kr', '' | strip | append: ' Kr.'

  assign rund_price_formatted = shape_rund.price | default: 0 | money | replace: 'kr.', '' | replace: 'kr', '' | replace: 'Kr.', '' | replace: 'Kr', '' | strip | append: ' Kr.'

  assign oval_price_formatted = shape_oval.price | default: 0 | money | replace: 'kr.', '' | replace: 'kr', '' | replace: 'Kr.', '' | replace: 'Kr', '' | strip | append: ' Kr.'

  # 1. Try to resolve the configured product from settings and verify it has SKU BTM001
  assign metervare_product = all_products[block.settings.metervare_product]
  assign metervare_variant = nil
  if metervare_product != nil
    for variant in metervare_product.variants
      if variant.sku == 'BTM001'
        assign metervare_variant = variant
        break
      endif
    endfor
  endif

  # 2. If not configured or doesn't have SKU BTM001, dynamically search collections
  if metervare_variant == nil
    for prod in collections.all.products
      for variant in prod.variants
        if variant.sku == 'BTM001'
          assign metervare_product = prod
          assign metervare_variant = variant
          break
        endif
      endfor
      if metervare_variant != nil
        break
      endif
    endfor
  endif

  # 3. Last resort fallback to hardcoded handles
  if metervare_variant == nil
    assign metervare_product = all_products['firkantet-dug'] | default: all_products['metervare']
    for variant in metervare_product.variants
      if variant.sku == 'BTM001'
        assign metervare_variant = variant
        break
      endif
    endfor
  endif

  # Fallback to first available variant if still nil
  if metervare_variant == nil and metervare_product != nil
    assign metervare_variant = metervare_product.selected_or_first_available_variant
  endif

  # Resolve width customization surcharge product (SKU BTM005)
  assign width_surcharge_product = all_products[block.settings.width_surcharge_product]
  assign width_surcharge_variant = nil
  if width_surcharge_product != nil
    for variant in width_surcharge_product.variants
      if variant.sku == 'BTM005'
        assign width_surcharge_variant = variant
        break
      endif
    endfor
    if width_surcharge_variant == nil
      assign width_surcharge_variant = width_surcharge_product.variants.first
    endif
  endif

  if width_surcharge_variant == nil
    for prod in collections.all.products
      for variant in prod.variants
        if variant.sku == 'BTM005'
          assign width_surcharge_variant = variant
          break
        endif
      endfor
      if width_surcharge_variant != nil
        break
      endif
    endfor
  endif

  assign width_surcharge_price_formatted = width_surcharge_variant.price | default: 0 | money | replace: 'kr.', '' | replace: 'kr', '' | replace: 'Kr.', '' | replace: 'Kr', '' | strip | append: ' Kr.'
-%}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    --block-padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --block-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    --block-padding-left: {{ block.settings.padding_sides | default: 0 }}px;
    --block-padding-right: {{ block.settings.padding_sides | default: 0 }}px;
    --color-important: {{ settings.important_color | default: '#e11d48' }};
    
    padding-top: var(--block-padding-top);
    padding-bottom: var(--block-padding-bottom);
    padding-left: var(--block-padding-left);
    padding-right: var(--block-padding-right);

    {%- if block.settings.border_top -%}
      border-top: 1px solid #e2e8f0;
    {%- endif -%}
    {%- if block.settings.border_bottom -%}
      border-bottom: 1px solid #e2e8f0;
    {%- endif -%}
  }
{%- endstyle -%}

<style>
  #display-length:focus,
  #display-qty:focus {
    outline: 2px solid #f5c518;
    outline-offset: 0px;
    border-radius: 4px;
  }
  .width-btn,
  .shape-btn {
    padding: 4px !important;
  }
  .width-btn-slider-item {
    width: calc((100% - 3 * var(--grid-gap, 8px)) / 4);
    flex-shrink: 0;
  }
  @media (min-width: 840px) {
    .width-btn-slider-item {
      width: calc((100% - 7 * var(--grid-gap, 16px)) / 8);
    }
  }
  @media (min-width: 1200px) {
    .width-btn-slider-item {
      width: calc((100% - 11 * var(--grid-gap, 24px)) / 12);
    }
  }
  
  /* Custom styled checkbox styling */
  .custom-checkbox-container:hover .custom-checkbox-box {
    border-color: var(--color-primary) !important;
  }
  #checkbox-custom-width:checked ~ .custom-checkbox-box {
    background-color: var(--color-primary, #0e1a28) !important;
    border-color: var(--color-primary, #0e1a28) !important;
  }
  #checkbox-custom-width:checked ~ .custom-checkbox-box svg {
    opacity: 1 !important;
    transform: scale(1) !important;
  }
  #checkbox-custom-width:focus-visible ~ .custom-checkbox-box {
    outline: 2px solid var(--color-primary, #0e1a28) !important;
    outline-offset: 2px !important;
  }
  .custom-checkbox-container:hover span {
    color: #0f172a !important; /* slate-900 */
  }
</style>

<!-- Hidden element to signal to product-buy-buttons that customizer is active -->
<div id="shape-selector" style="display: none;"></div>

<div id="voksdug-customizer-container" class="w-full pb-3" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h2 class="text-xl md:text-2xl font-bold text-slate-800 mb-8 leading-tight">{{ block.settings.heading }}</h2>
  {%- endif -%}
  <div class="grid-layout">

    <!-- Step 1: Shape Selector -->
    <div id="step-container-shape" class="flex flex-col gap-3 py-2" style="--span-mobile: 4; --span-expanded: 8; --span-large: 12;">
      <div class="flex items-start gap-3">
        <span id="step-number-shape" class="w-7 h-7 flex items-center justify-center bg-slate-900 text-white text-sm font-bold rounded-full mt-0.5 shrink-0">1</span>
        <div class="flex flex-col w-full">
          <span class="font-bold text-base uppercase tracking-wider text-slate-800">Vælg form</span>
          {% if block.settings.shape_description != blank %}
            <p class="text-sm text-primary/85 mt-1">{{ block.settings.shape_description }}</p>
          {% endif %}
        </div>
      </div>
      <div class="grid-layout w-full pl-10">

        <!-- Firkantet dug -->
        <div class="flex flex-col items-center gap-1" style="--span-mobile: 1; --span-expanded: 1; --span-large: 1;">
          <button type="button" id="btn-shape-firkantet" data-shape="firkantet"
            class="shape-btn flex flex-col items-center justify-center gap-1.5 rounded-2xl border border-slate-200 bg-white text-slate-900 shadow-sm transition-all duration-200 cursor-pointer focus:outline-none w-full aspect-square"
            onclick="selectShape('firkantet')">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="26" height="26">
              <rect x="3" y="6" width="18" height="12" rx="1.5"/>
            </svg>
            <div class="flex flex-col items-center gap-0.5 w-full">
              <span class="text-[11px] font-semibold tracking-[0.02em] leading-[1.2] text-center">Firkantet</span>
              <span class="text-[11px] font-normal leading-[1.2] text-center">{{ firkantet_price_formatted }}</span>
            </div>
          </button>
        </div>

        <!-- Rund dug -->
        <div class="flex flex-col items-center gap-1" style="--span-mobile: 1; --span-expanded: 1; --span-large: 1;">
          <button type="button" id="btn-shape-rund" data-shape="rund"
            class="shape-btn flex flex-col items-center justify-center gap-1.5 rounded-2xl border border-slate-200 bg-white text-slate-900 shadow-sm transition-all duration-200 cursor-pointer focus:outline-none w-full aspect-square"
            onclick="selectShape('rund')">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="26" height="26">
              <circle cx="12" cy="12" r="8.5"/>
            </svg>
            <div class="flex flex-col items-center gap-0.5 w-full">
              <span class="text-[11px] font-semibold tracking-[0.02em] leading-[1.2] text-center">Rund</span>
              <span class="text-[11px] font-normal leading-[1.2] text-center">{{ rund_price_formatted }}</span>
            </div>
          </button>
        </div>

        <!-- Oval dug -->
        <div class="flex flex-col items-center gap-1" style="--span-mobile: 1; --span-expanded: 1; --span-large: 1;">
          <button type="button" id="btn-shape-oval" data-shape="oval"
            class="shape-btn flex flex-col items-center justify-center gap-1.5 rounded-2xl border border-slate-200 bg-white text-slate-900 shadow-sm transition-all duration-200 cursor-pointer focus:outline-none w-full aspect-square"
            onclick="selectShape('oval')">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="32" height="32">
              <rect x="3" y="8" width="18" height="8" rx="4"/>
            </svg>
            <div class="flex flex-col items-center gap-0.5 w-full">
              <span class="text-[11px] font-semibold tracking-[0.02em] leading-[1.2] text-center">Oval</span>
              <span class="text-[11px] font-normal leading-[1.2] text-center">{{ oval_price_formatted }}</span>
            </div>
          </button>
        </div>

      </div>
    </div>

    <!-- Step 2: Width Selection (Vælg bredde) -->
    <div id="step-container-width" class="flex flex-col gap-3 py-2" style="--span-mobile: 4; --span-expanded: 8; --span-large: 12;">
      <div class="flex items-start gap-3">
        <span id="step-number-width" class="w-7 h-7 flex items-center justify-center bg-slate-900 text-white text-sm font-bold rounded-full mt-0.5 shrink-0">2</span>
        <div class="flex flex-col w-full">
          <span id="label-width" class="font-bold text-base uppercase tracking-wider text-slate-800">Vælg bredde</span>
          {%- if block.settings.width_step_description != blank -%}
            <p class="text-sm text-primary/85 mt-1">{{ block.settings.width_step_description }}</p>
          {%- endif -%}
        </div>
      </div>
      <div class="flex overflow-x-auto pb-1 hide-scrollbar w-full pl-10" style="gap: var(--grid-gap);">
        {%- if width_option_values != blank -%}
          {%- for value in width_option_values -%}
            {%- assign value_down = value | downcase -%}
            {%- if value_down contains 'tilpasset' or value_down contains 'tilpas' -%}
              {%- continue -%}
            {%- endif -%}
            
            {%- assign numeric_width = value | replace: 'cm', '' | replace: 'CM', '' | strip -%}
            
            <button type="button" 
              class="width-btn width-btn-slider-item flex flex-col items-center justify-center gap-0.5 rounded-2xl border border-slate-200 bg-white text-slate-900 shadow-sm transition-all duration-200 cursor-pointer focus:outline-none aspect-square"
              data-width-value="{{ value | escape }}"
              data-numeric-width="{{ numeric_width }}"
              onclick="selectWidthValue('{{ value | escape }}', {{ numeric_width }})">
              <span class="text-base font-bold text-center leading-[1.2]">{{ value | replace: 'cm', '' | replace: 'CM', '' | strip }}<span class="text-[11px] font-bold ml-0.5 lowercase">cm</span></span>
              <span class="text-[11px] font-normal leading-[1.2] text-center" data-width-value-price="{{ value | escape }}">-- kr.</span>
              <span class="text-[11px] font-normal leading-[1.2] text-center">pr. meter</span>
            </button>
          {%- endfor -%}
        {%- else -%}
          {%- comment -%} Fallback: no width variant option — show product's fixed width from metafield as a single pre-selected button {%- endcomment -%}
          {%- assign fallback_width = product_width_limit | default: 140 -%}
          <button type="button"
            class="width-btn width-btn-slider-item flex flex-col items-center justify-center gap-0.5 rounded-2xl border-2 bg-white text-slate-900 shadow-sm focus:outline-none aspect-square"
            data-width-value="{{ fallback_width }} cm"
            data-numeric-width="{{ fallback_width }}"
            style="border-color: #f5c518; pointer-events: none; cursor: default;"
            aria-pressed="true">
            <span class="text-base font-bold text-center leading-[1.2]">{{ fallback_width }}<span class="text-[11px] font-bold ml-0.5 lowercase">cm</span></span>
            <span class="text-[11px] font-normal leading-[1.2] text-center" data-width-value-price="{{ fallback_width }} cm">-- kr.</span>
            <span class="text-[11px] font-normal leading-[1.2] text-center">pr. meter</span>
          </button>
        {%- endif -%}
      </div>
      
      <!-- Custom Width Checkbox Trigger -->
      <div class="w-full pl-10 mt-2 flex items-center" style="display: flex !important; align-items: center !important; justify-content: flex-start !important;">
        <label for="checkbox-custom-width" class="custom-checkbox-container" style="display: flex !important; align-items: center !important; justify-content: flex-start !important; width: auto !important; gap: 12px !important; cursor: pointer; user-select: none;">
          <input type="checkbox" id="checkbox-custom-width" class="sr-only" />
          <!-- Styled custom checkbox box -->
          <div class="custom-checkbox-box rounded-md border-2 border-slate-300 bg-white" style="width: 24px !important; height: 24px !important; display: flex !important; align-items: center !important; justify-content: center !important; flex-shrink: 0 !important; transition: all 0.2s ease;">
            <svg style="width: 14px !important; height: 14px !important; display: block !important; transition: all 0.2s ease;" class="text-white opacity-0 scale-50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </div>
          <span class="text-sm font-semibold text-slate-800 transition-colors duration-150" style="width: auto !important; display: inline-block !important; margin: 0 !important; padding: 0 !important;">
            {{ block.settings.custom_width_checkbox_label | default: "Tilpas på dine mål" }}
          </span>
        </label>
      </div>
      
      <!-- Tilpas bredde Accordion Content (displayed inline below buttons) -->
      <div id="content-width-accordion" class="flex flex-col gap-2 w-full mt-0.5 pl-10" style="display: none;">
        {%- if block.settings.width_description != blank -%}
          {%- assign width_desc = block.settings.width_description -%}
          <p class="text-sm text-primary/85 pl-1">
            {{ width_desc | replace: '[max_width]', '<span id="max-width-display">140</span>' }}
            {% if width_surcharge_variant %}
               (+{{ width_surcharge_price_formatted | replace: 'Kr.', 'kr.' | replace: 'Kr', 'kr.' | strip }})
            {% endif %}
          </p>
        {%- endif -%}
        
        <!-- Pill-shaped Stepper -->
        <div class="w-full">
          <div class="stepper-pill flex w-full justify-between items-center bg-white border border-slate-200 rounded-full shadow-sm" style="height:56px;">
            <!-- Minus button -->
            <button type="button" id="btn-width-minus" class="h-full flex items-center justify-center text-slate-500 hover:text-slate-900 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none rounded-l-full" style="width:56px;flex-shrink:0;border-right:1px solid #e2e8f0;min-width:56px;min-height:48px;height:100%;padding:0;line-height:1;display:flex;align-items:center;justify-content:center;">
              &mdash;
            </button>
            <!-- Value input -->
            <input id="display-width" type="number" inputmode="numeric" pattern="[0-9]*"
              value="140"
              class="text-center font-bold text-slate-900 text-xl bg-transparent border-none outline-none p-0 m-0"
              style="-moz-appearance:textfield;appearance:textfield;height:100%;width:100%;"
            />
            <!-- Plus button -->
            <button type="button" id="btn-width-plus" class="h-full flex items-center justify-center text-slate-500 hover:text-slate-900 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none rounded-r-full" style="width:56px;flex-shrink:0;border-left:1px solid #e2e8f0;min-width:56px;min-height:48px;height:100%;padding:0;line-height:1;display:flex;align-items:center;justify-content:center;">
              &#43;
            </button>
          </div>
          <!-- Dynamic calculation info under width selector -->
          <div id="width-calculation" class="text-sm text-primary/85 mt-1.5 text-center w-full"></div>
        </div>
      </div>
    </div>

    <!-- Step 3: Length Selection -->
    <div id="step-container-length" class="flex flex-col gap-3 pt-2 pb-0" style="--span-mobile: 4; --span-expanded: 4; --span-large: 6;">
      <div class="flex items-start gap-3">
        <span id="step-number-length" class="w-7 h-7 flex items-center justify-center bg-slate-900 text-white text-sm font-bold rounded-full mt-0.5 shrink-0">3</span>
        <div class="flex flex-col w-full">
          <span id="label-length" class="font-bold text-base uppercase tracking-wider text-slate-800">Vælg længde</span>
          {% if block.settings.length_description != blank %}
            <p class="text-sm text-primary/85 mt-1">{{ block.settings.length_description }}</p>
          {% endif %}
        </div>
      </div>

      <!-- Pill-shaped Stepper -->
      <div class="w-full pl-10">
        <div class="stepper-pill flex w-full justify-between items-center bg-white border border-slate-200 rounded-full shadow-sm" style="height:56px;">
          <!-- Minus button -->
          <button type="button" id="btn-length-minus" class="h-full flex items-center justify-center text-slate-500 hover:text-slate-900 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none rounded-l-full" style="width:56px;flex-shrink:0;border-right:1px solid #e2e8f0;min-width:56px;min-height:48px;height:100%;padding:0;line-height:1;display:flex;align-items:center;justify-content:center;">
            &mdash;
          </button>
          <!-- Value input -->
          <input id="display-length" type="number" inputmode="numeric" pattern="[0-9]*"
            value="200"
            class="text-center font-bold text-slate-900 text-xl bg-transparent border-none outline-none p-0 m-0"
            style="-moz-appearance:textfield;appearance:textfield;height:100%;width:100%;"
          />
          <!-- Plus button -->
          <button type="button" id="btn-length-plus" class="h-full flex items-center justify-center text-slate-500 hover:text-slate-900 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none rounded-r-full" style="width:56px;flex-shrink:0;border-left:1px solid #e2e8f0;min-width:56px;min-height:48px;height:100%;padding:0;line-height:1;display:flex;align-items:center;justify-content:center;">
            &#43;
          </button>
        </div>
        <!-- Dynamic calculation info under length selector -->
        <div id="length-calculation" class="text-sm text-primary/85 mt-1.5 text-center w-full"></div>
      </div>

      <!-- Validation Warning Message -->
      <div id="customizer-warning" class="hidden w-full p-3 bg-rose-50 border border-rose-200 rounded-2xl text-sm text-rose-600 flex items-center gap-2 mt-1">
        <span class="material-symbols-outlined text-rose-500 text-sm">warning</span>
        <span id="customizer-warning-text"></span>
      </div>
    </div>

    <!-- Step 4: Quantity Selector -->
    <div id="step-container-qty" class="flex flex-col gap-2 w-full pt-6 pb-3" style="--span-mobile: 4; --span-expanded: 8; --span-large: 12; grid-column-start: 1;">
      <div class="flex items-start gap-3">
        <span id="step-number-qty" class="w-7 h-7 flex items-center justify-center bg-slate-900 text-white text-sm font-bold rounded-full mt-0.5 shrink-0">4</span>
        <div class="flex flex-col w-full">
          <span class="font-bold text-base uppercase tracking-wider text-slate-800">Antal</span>
          {% if block.settings.qty_description != blank %}
            <p class="text-sm text-primary/85 mt-1">{{ block.settings.qty_description }}</p>
          {% endif %}
        </div>
      </div>
      <div class="w-full pl-10">
        <div class="stepper-pill flex w-full justify-between items-center bg-white border border-slate-200 rounded-full shadow-sm" style="height:56px;transition:border-color 0.15s,box-shadow 0.15s;">
          <!-- Minus button -->
          <button type="button" id="btn-qty-minus" class="h-full flex items-center justify-center text-slate-500 hover:text-slate-900 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none rounded-l-full" style="width:56px;flex-shrink:0;border-right:1px solid #e2e8f0;min-width:56px;min-height:48px;height:100%;padding:0;line-height:1;display:flex;align-items:center;justify-content:center;">
            &mdash;
          </button>
          <!-- Value input -->
          <input id="display-qty" type="number" inputmode="numeric" pattern="[0-9]*"
            value="1"
            min="1"
            class="text-center font-bold text-slate-900 text-xl bg-transparent border-none outline-none p-0 m-0"
            style="-moz-appearance:textfield;appearance:textfield;height:100%;width:100%;"
          />
          <!-- Plus button -->
          <button type="button" id="btn-qty-plus" class="h-full flex items-center justify-center text-slate-500 hover:text-slate-900 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none rounded-r-full" style="width:56px;flex-shrink:0;border-left:1px solid #e2e8f0;min-width:56px;min-height:48px;height:100%;padding:0;line-height:1;display:flex;align-items:center;justify-content:center;">
            &#43;
          </button>
        </div>
      </div>
    </div>

    <!-- Selected Specs & Price (Calculation Table Summary) -->
    <div id="buy-buttons-summary-container" class="flex flex-col text-left w-full border border-slate-200 rounded-2xl pt-5 pb-4 px-4 mt-2 mb-3 text-sm text-primary/90" style="display: none; --span-mobile: 4; --span-expanded: 8; --span-large: 12; grid-column-start: 1;">
      <!-- Title -->
      <div id="calc-title" class="mb-2 font-semibold text-primary"></div>
      
      <!-- Lines -->
      <div class="flex flex-col gap-1 w-full">
        <div class="flex justify-between items-center" id="calc-shape-row">
          <span id="calc-shape-label">Form</span>
          <span id="calc-shape-price"></span>
        </div>
        <div class="flex justify-between items-center">
          <span id="calc-metervare-label">Metervare</span>
          <span id="calc-metervare-price"></span>
        </div>
        <div class="flex justify-between items-center" id="calc-width-row" style="display: none;">
          <span id="calc-width-label">Bredde</span>
          <span id="calc-width-price"></span>
        </div>
        
        <div class="border-t border-slate-200 my-2"></div>
        
        <div class="flex justify-between items-center">
          <span>Pris pr. dug.</span>
          <span id="calc-total-price"></span>
        </div>
      </div>
    </div>

  </div>
</div>

<!-- Toast notification popup -->
<div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-[calc(1280px-2rem)] z-50 bg-[#0e1a28] border border-slate-800 text-white text-sm px-4 py-3 rounded-full shadow-xl flex items-center justify-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
  <span class="material-symbols-outlined text-emerald-400">check_circle</span>
  <span id="toast-text" class="truncate">Lagt i kurven</span>
</div>

<!-- Variant Data JSON -->
<script id="variant-data" type="application/json">
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "title": {{ variant.title | json }},
        "options": {{ variant.options | json }},
        "price": {{ variant.price | divided_by: 100.0 }},
        "available": {{ variant.available }},
        "image": {{ variant.featured_image | default: product.featured_image | image_url: width: 150, height: 150, crop: 'center' | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>


<!-- Shape Data JSON -->
<script id="shape-data" type="application/json">
  {
    "firkantet": {
      "id": {{ shape_firkantet.first_available_variant.id | default: shape_firkantet.variants.first.id | json }},
      "price": {{ shape_firkantet.price | default: 0 | divided_by: 100.0 }},
      "price_formatted": {{ firkantet_price_formatted | json }}
    },
    "rund": {
      "id": {{ shape_rund.first_available_variant.id | default: shape_rund.variants.first.id | json }},
      "price": {{ shape_rund.price | default: 0 | divided_by: 100.0 }},
      "price_formatted": {{ rund_price_formatted | json }}
    },
    "oval": {
      "id": {{ shape_oval.first_available_variant.id | default: shape_oval.variants.first.id | json }},
      "price": {{ shape_oval.price | default: 0 | divided_by: 100.0 }},
      "price_formatted": {{ oval_price_formatted | json }}
    }
  }
</script>

<!-- Width Surcharge Data JSON -->
<script id="width-surcharge-data" type="application/json">
  {
    "id": {{ width_surcharge_variant.id | json }},
    "price": {{ width_surcharge_variant.price | default: 0 | divided_by: 100.0 }},
    "price_formatted": {{ width_surcharge_price_formatted | json }}
  }
</script>

<script>
  // Shape selector (global so onclick= attributes can call it)
  let selectedShape = 'firkantet';
  let soldOutLabel = {{ block.settings.sold_out_text | default: "Ikke på lager" | json }};
  function selectShape(shape) {
    selectedShape = shape;
    
    const widthLabel = document.getElementById('label-width');
    if (widthLabel) {
      widthLabel.textContent = (shape === 'rund') ? 'Vælg diameter' : 'Vælg bredde';
    }
    const lengthLabel = document.getElementById('label-length');
    if (lengthLabel) {
      lengthLabel.textContent = (shape === 'rund') ? 'Vælg diameter' : 'Vælg længde';
    }

    document.querySelectorAll('.shape-btn').forEach(btn => {
      const isActive = btn.dataset.shape === shape;
      if (isActive) {
        btn.style.borderColor = '#f5c518';
        btn.style.borderWidth = '2px';
        btn.classList.remove('border', 'border-slate-200');
        btn.classList.add('border-2');
      } else {
        btn.style.borderColor = '';
        btn.style.borderWidth = '';
        btn.classList.remove('border-2');
        btn.classList.add('border', 'border-slate-200');
      }
      // Both active and not selected have text-slate-900
      btn.classList.remove('text-slate-600', 'text-slate-400');
      btn.classList.add('text-slate-900');
    });
    
    if (typeof window.updateCustomizerUI === "function") {
      window.updateCustomizerUI();
    }
  }


  function initCustomizer() {
    console.log("Voksdug Customizer - Version: swap-voksdug-metervare (Release 29)");
    console.log("Debug - Width surcharge setting handle:", "{{ block.settings.width_surcharge_product }}");
    console.log("Debug - Width surcharge variant ID:", "{{ width_surcharge_variant.id }}");
    console.log("Debug - Width surcharge variant price:", "{{ width_surcharge_variant.price }}");
    // 1. Config variables from Liquid settings
    const minLength = {{ min_length | json }};
    const stepSize = {{ step_size | json }};
    const maxWidthLimit = {{ product_width_limit | json }};
    const metervareVariantId = {% if metervare_variant %}"gid://shopify/ProductVariant/{{ metervare_variant.id }}"{% else %}null{% endif %};
    const metervareVariantIntId = {% if metervare_variant %}{{ metervare_variant.id }}{% else %}null{% endif %};
    const widthOptionIndex = {{ width_option_index | json }};
    const widthOptionName = {{ width_option_name | json }};
    const soldOutLabel = {{ block.settings.sold_out_text | default: "Ikke på lager" | json }};
    
    // Parse variants
    let variants = [];
    try {
      variants = JSON.parse(document.getElementById('variant-data').textContent);
    } catch (e) {
      console.error("Failed to parse variants", e);
    }

    // Determine the absolute max width limit from variants or metafield limit
    let absoluteMaxWidth = maxWidthLimit;
    if (widthOptionIndex !== null && variants.length > 0) {
      variants.forEach(v => {
        if (v.title.toLowerCase().includes("tilpasset")) return;
        const wVal = v.options[widthOptionIndex];
        if (wVal) {
          const match = wVal.match(/\d+/);
          if (match) {
            const w = parseInt(match[0]);
            if (w > absoluteMaxWidth) {
              absoluteMaxWidth = w;
            }
          }
        }
      });
    }

    // Parse shape data
    let shapeData = {};
    try {
      shapeData = JSON.parse(document.getElementById('shape-data').textContent);
    } catch (e) {
      console.error("Failed to parse shape data", e);
    }

    // Parse width surcharge data
    let widthSurchargeData = {};
    try {
      widthSurchargeData = JSON.parse(document.getElementById('width-surcharge-data').textContent);
    } catch (e) {
      console.error("Failed to parse width surcharge data", e);
    }

    const productTitle = {{ product.title | json }};
    // Helper: Parse width from variant title or product title.
    // Produkttitel slutter altid med ", xxx cm" - søg efter det mønster først.
    function getVariantWidth(variantTitle) {
      if (!variantTitle) return 140;
      // Prefer "xxx cm" pattern (e.g. ", 140 cm" at end of title)
      let match = variantTitle.match(/(\d+)\s*cm/i);
      if (match && match[1]) {
        return parseInt(match[1]);
      }
      if (!match && productTitle) {
        match = productTitle.match(/(\d+)\s*cm/i);
        if (match && match[1]) {
          return parseInt(match[1]);
        }
      }
      // Fallback: first number anywhere
      match = variantTitle.match(/(\d+)/);
      if (match) {
        return parseInt(match[0]);
      }
      return 140;
    }

    // Safety fallback for empty/missing variants
    const fallbackVariant = { id: null, title: "", options: [], price: 0 };

    function getProductFormVariantInput() {
      const customizerContainer = document.getElementById("voksdug-customizer-container");
      if (customizerContainer) {
        const closestForm = customizerContainer.closest('form[action*="/cart/add"]');
        if (closestForm) {
          const input = closestForm.querySelector('select[name="id"], input[name="id"]');
          if (input) return input;
        }
        const closestSection = customizerContainer.closest('.product, .product-section, section');
        if (closestSection) {
          const input = closestSection.querySelector('select[name="id"], input[name="id"]');
          if (input) return input;
        }
      }
      const allInputs = document.querySelectorAll('select[name="id"], input[name="id"]');
      for (const input of allInputs) {
        const path = input.closest('.cart-drawer, .quick-add, .drawer, header, footer, #cart');
        if (!path) {
          return input;
        }
      }
      return document.querySelector('select[name="id"], input[name="id"]');
    }

    function getCurrentVariant() {
      if (!variants || variants.length === 0) return fallbackVariant;
      let activeVariantId = null;
      const variantInput = getProductFormVariantInput();
      if (variantInput) {
        activeVariantId = parseInt(variantInput.value);
      }
      return variants.find(v => v.id === activeVariantId) || variants[0] || fallbackVariant;
    }

    function getPricingVariant(currentVariant) {
      if (!variants || variants.length === 0) return fallbackVariant;
      if (!currentVariant) currentVariant = getCurrentVariant();
      let pricingVariant = currentVariant;
      if (pricingVariant && pricingVariant.title && pricingVariant.title.toLowerCase().includes("tilpasset")) {
        pricingVariant = variants.find(v => !v.title.toLowerCase().includes("tilpasset") && v.price > 0) || variants[0] || fallbackVariant;
      }
      return pricingVariant || fallbackVariant;
    }

    // State
    let state = {
      length: 200,
      width: 140,
      customizeWidth: false,
      quantity: 1
    };

    // Initialize initial width state from active variant on load (or from metafield limit when no width option)
    let initVariant = getCurrentVariant();
    if (initVariant && widthOptionIndex !== null) {
      state.width = getVariantWidth(initVariant.title);
    } else {
      // No width option on this product — use the metafield width limit as the fixed width
      state.width = maxWidthLimit;
    }

    // DOM cache
    const displayLength = document.getElementById("display-length");
    const btnLengthMinus = document.getElementById("btn-length-minus");
    const btnLengthPlus = document.getElementById("btn-length-plus");

    const displayQty = document.getElementById("display-qty");
    const btnQtyMinus = document.getElementById("btn-qty-minus");
    const btnQtyPlus = document.getElementById("btn-qty-plus");

    // Hide browser spinner arrows on number inputs
    const inputStyle = document.createElement('style');
    inputStyle.textContent = '#display-length::-webkit-inner-spin-button,#display-length::-webkit-outer-spin-button,#display-qty::-webkit-inner-spin-button,#display-qty::-webkit-outer-spin-button{-webkit-appearance:none;margin:0;}';
    document.head.appendChild(inputStyle);

    const addToCartBtn = document.getElementById("btn-add-to-cart");

    // Helper to format price in Danish format: "X,00 Kr."
    function formatDanishPrice(priceInKr) {
      return priceInKr.toLocaleString("da-DK", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " Kr.";
    }

    // Helper to find standard variant for width matching other option values
    function findVariantForWidthAndOtherOptions(widthVal, currentVariant) {
      if (widthOptionIndex === null || widthOptionIndex === undefined) return null;
      if (!variants || variants.length === 0) return null;
      
      const targetValNormalized = widthVal.toLowerCase().trim();
      
      // Try exact match on other options first
      let match = variants.find(v => {
        if (!currentVariant || !currentVariant.options) return false;
        for (let i = 0; i < v.options.length; i++) {
          if (i === widthOptionIndex) continue;
          const optA = (v.options[i] || '').toLowerCase().trim();
          const optB = (currentVariant.options[i] || '').toLowerCase().trim();
          if (optA !== optB) return false;
        }
        if (!v.options || !v.options[widthOptionIndex]) return false;
        const vWidthVal = v.options[widthOptionIndex].toLowerCase().trim().replace('cm', '').replace(/\s+/g, '');
        const normTarget = targetValNormalized.replace('cm', '').replace(/\s+/g, '');
        if (targetValNormalized === 'tilpasset') {
          return vWidthVal.includes('tilpasset') || vWidthVal.includes('tilpas');
        } else {
          return vWidthVal === normTarget;
        }
      });

      // Fallback: match just the width if options mismatched (e.g. if the product has options that don't match perfectly)
      if (!match) {
        match = variants.find(v => {
          if (!v.options || !v.options[widthOptionIndex]) return false;
          const vWidthVal = v.options[widthOptionIndex].toLowerCase().trim().replace('cm', '').replace(/\s+/g, '');
          const normTarget = targetValNormalized.replace('cm', '').replace(/\s+/g, '');
          if (targetValNormalized === 'tilpasset') {
            return vWidthVal.includes('tilpasset') || vWidthVal.includes('tilpas');
          } else {
            return vWidthVal === normTarget;
          }
        });
      }
      return match;
    }

    // Helper to find the smallest standard variant width that is >= targetWidth
    function findPricingVariantForWidth(targetWidth, currentVariant) {
      if (widthOptionIndex === null || widthOptionIndex === undefined) return currentVariant;
      if (!currentVariant || !currentVariant.options) return currentVariant;
      
      const matchingStandardVariants = variants.filter(v => {
        if (!v || !v.title || v.title.toLowerCase().includes("tilpasset")) return false;
        for (let i = 0; i < v.options.length; i++) {
          if (i === widthOptionIndex) continue;
          const optA = (v.options[i] || '').toLowerCase().trim();
          const optB = (currentVariant.options[i] || '').toLowerCase().trim();
          if (optA !== optB) return false;
        }
        return true;
      });
      
      const variantsWithNumericWidth = matchingStandardVariants.map(v => {
        const wVal = v.options[widthOptionIndex];
        const match = wVal.match(/\d+/);
        const numericW = match ? parseInt(match[0]) : 140;
        return { variant: v, width: numericW };
      });
      
      variantsWithNumericWidth.sort((a, b) => a.width - b.width);
      
      const bestMatch = variantsWithNumericWidth.find(item => item.width >= targetWidth);
      return bestMatch ? bestMatch.variant : (variantsWithNumericWidth[variantsWithNumericWidth.length - 1]?.variant || currentVariant);
    }

    function selectVariantById(variantId) {
      const mainInput = getProductFormVariantInput();
      if (mainInput) {
        mainInput.value = variantId;
        mainInput.dispatchEvent(new Event('change', { bubbles: true }));
      }
      
      const variantInputs = document.querySelectorAll('select[name="id"], input[name="id"]');
      variantInputs.forEach(input => {
        if (input !== mainInput) {
          input.value = variantId;
          input.dispatchEvent(new Event('change', { bubbles: true }));
        }
      });
      
      const url = new URL(window.location.href);
      url.searchParams.set('variant', variantId);
      window.history.replaceState({}, '', url.toString());

      document.dispatchEvent(new CustomEvent("variant-changed", {
        detail: { variantId: variantId }
      }));
    }

    function updateWidthButtonsUI(selectedValue) {
      if (!selectedValue) return;
      const normalizedSelected = selectedValue.toString().toLowerCase().replace(/\s+/g, '').replace('cm', '');
      document.querySelectorAll('.width-btn').forEach(btn => {
        const val = btn.dataset.widthValue;
        if (!val) return;
        const normalizedVal = val.toLowerCase().replace(/\s+/g, '').replace('cm', '');
        const isBtnActive = normalizedVal === normalizedSelected;
        
        if (isBtnActive) {
          btn.style.borderColor = '#f5c518';
          btn.style.borderWidth = '2px';
          btn.classList.remove('border-slate-200');
          btn.classList.add('border-2');
        } else {
          btn.style.borderColor = '';
          btn.style.borderWidth = '';
          btn.classList.remove('border-2');
          btn.classList.add('border-slate-200');
        }
        // Both active and not selected should stay text-slate-900 by default,
        // unless they are disabled/deactivated by updateUI check.
        if (!btn.classList.contains('opacity-25')) {
          btn.classList.remove('text-slate-600', 'text-slate-400');
          btn.classList.add('text-slate-900');
        }
      });
    }

    function updateStepNumbers() {
      let stepNum = 1;
      const steps = [
        { containerId: "step-container-shape", labelId: "step-number-shape" },
        { containerId: "step-container-width", labelId: "step-number-width" },
        { containerId: "step-container-length", labelId: "step-number-length" },
        { containerId: "step-container-qty", labelId: "step-number-qty" }
      ];
      
      steps.forEach(step => {
        const container = document.getElementById(step.containerId);
        const label = document.getElementById(step.labelId);
        if (container && label) {
          if (window.getComputedStyle(container).display !== "none") {
            label.textContent = stepNum;
            stepNum++;
          }
        }
      });
    }

    function selectWidthOptionInShopify(value) {
      // 1. Try to find and click/select buttons or radios in the theme
      const btn = Array.from(document.querySelectorAll('.product-variant-selectors button, .product-form__input input[type="radio"], fieldset input[type="radio"]'))
        .find(b => {
          if (b.dataset && b.dataset.optionName === widthOptionName && b.dataset.optionValue === value) {
            return true;
          }
          if (b.value === value || b.value.toLowerCase().trim() === value.toLowerCase().trim()) {
            return true;
          }
          return false;
        });
      
      if (btn) {
        btn.removeAttribute('disabled');
        btn.disabled = false;
        btn.classList.remove('disabled');
        btn.click();
        if (btn.tagName === 'INPUT') {
          btn.checked = true;
          btn.dispatchEvent(new Event('change', { bubbles: true }));
        }
      }

      // 2. Try to find and update select dropdowns
      const selects = document.querySelectorAll('select.single-option-selector, .product-form__input select, select[data-index]');
      selects.forEach(select => {
        const optionLabel = select.getAttribute('aria-label') || select.getAttribute('data-name') || '';
        const isWidthSelect = optionLabel.toLowerCase().includes('bredde') || 
                              optionLabel.toLowerCase().includes('width') || 
                              optionLabel.toLowerCase().includes('størrelse') ||
                              select.id.toLowerCase().includes('option' + (widthOptionIndex + 1));
                              
        if (isWidthSelect) {
          const opt = Array.from(select.options).find(o => o.value === value || o.value.toLowerCase().trim() === value.toLowerCase().trim());
          if (opt) {
            opt.removeAttribute('disabled');
            opt.disabled = false;
            select.value = opt.value;
            select.dispatchEvent(new Event('change', { bubbles: true }));
          }
        }
      });
      
      // 3. Directly force update the variant ID in Shopify's form inputs to guarantee selection
      let currentVariant = getCurrentVariant();
      let targetVariant = findVariantForWidthAndOtherOptions(value, currentVariant);
      if (!targetVariant && variants && variants.length > 0) {
        const targetValNorm = value.toLowerCase().replace('cm', '').replace(/\s+/g, '');
        targetVariant = variants.find(v => {
          if (!v.options || !v.options[widthOptionIndex]) return false;
          const w = v.options[widthOptionIndex].toLowerCase().replace('cm', '').replace(/\s+/g, '');
          return w === targetValNorm;
        });
      }
      if (targetVariant) {
        selectVariantById(targetVariant.id);
      }
    }

    window.selectWidthValue = function(value, numericWidth) {
      let currentVariant = getCurrentVariant();
      let match = findVariantForWidthAndOtherOptions(value, currentVariant);
      if (!match && variants && variants.length > 0) {
        const targetValNorm = value.toLowerCase().replace('cm', '').replace(/\s+/g, '');
        match = variants.find(v => {
          if (!v.options || !v.options[widthOptionIndex]) return false;
          const w = v.options[widthOptionIndex].toLowerCase().replace('cm', '').replace(/\s+/g, '');
          return w === targetValNorm;
        });
      }


      const customWidthCheckbox = document.getElementById("checkbox-custom-width");
      if (customWidthCheckbox) {
        customWidthCheckbox.checked = false;
      }
      state.width = numericWidth;
      
      selectWidthOptionInShopify(value);
      
      updateWidthButtonsUI(value);
      updateUI();
    };

    // Hide duplicate width option swatches in standard variant picker
    const customizer = document.getElementById("voksdug-customizer-container");
    if (customizer) {
      const optionContainers = document.querySelectorAll('.product-variant-selectors [data-option-index]');
      optionContainers.forEach(container => {
        const label = container.querySelector('[data-selected-option-label]');
        if (label && (label.dataset.selectedOptionLabel.toLowerCase().includes("bredde") || 
                      label.dataset.selectedOptionLabel.toLowerCase().includes("width") ||
                      label.dataset.selectedOptionLabel.toLowerCase().includes("størrelse"))) {
          container.style.display = "none";
        }
      });
    }

    // Recalculate price display
    function updateUI() {
      try {
        // Find currently selected variant ID on the page (variant picker sets this)
        let currentVariant = getCurrentVariant();
        let pricingVariant = getPricingVariant(currentVariant);

        // Cap length (diameter) if shape is 'rund'
        if (selectedShape === 'rund') {
          state.length = state.width;
        }

        // Enable or disable the length stepper plus button based on shape and limit
        if (btnLengthPlus) {
          const maxAllowed = (selectedShape === 'rund') ? absoluteMaxWidth : 9999;
          if (state.length >= maxAllowed) {
            btnLengthPlus.disabled = true;
            btnLengthPlus.classList.add("opacity-30", "pointer-events-none");
          } else {
            btnLengthPlus.disabled = false;
            btnLengthPlus.classList.remove("opacity-30", "pointer-events-none");
          }
        }

        // Enable or disable the length stepper minus button based on minLength
        if (btnLengthMinus) {
          if (state.length <= minLength) {
            btnLengthMinus.disabled = true;
            btnLengthMinus.classList.add("opacity-30", "pointer-events-none");
          } else {
            btnLengthMinus.disabled = false;
            btnLengthMinus.classList.remove("opacity-30", "pointer-events-none");
          }
        }

        // Width validation / setup
        const resolvedWidthFromVariant = getVariantWidth(pricingVariant ? pricingVariant.title : "");
        const width = state.width ? state.width : resolvedWidthFromVariant;
        
        // Update prices per meter on the standard width buttons and handle out-of-stock states
        if (widthOptionIndex !== null) {
          document.querySelectorAll('.width-btn[data-width-value]').forEach(btn => {
            const val = btn.dataset.widthValue;
            let match = findVariantForWidthAndOtherOptions(val, currentVariant);
            if (!match && variants && variants.length > 0) {
              const targetValNorm = val.toLowerCase().replace('cm', '').replace(/\s+/g, '');
              match = variants.find(v => {
                if (!v.options || !v.options[widthOptionIndex]) return false;
                const w = v.options[widthOptionIndex].toLowerCase().replace('cm', '').replace(/\s+/g, '');
                return w === targetValNorm;
              });
            }
            const priceSpan = btn.querySelector('[data-width-value-price]');
            if (priceSpan && match) {
              const pricePerMeter = match.price * 100;
              priceSpan.textContent = formatDanishPrice(pricePerMeter).replace("Kr.", "kr.");
            }
            
            // Check availability/inventory
            if (match && !match.available) {
              btn.classList.add("opacity-25", "bg-slate-50/70");
              btn.classList.remove("text-slate-900");
              btn.classList.add("text-slate-400");
              btn.style.cursor = "not-allowed";
              btn.style.borderColor = "#e2e8f0";
              
              // Hide price per meter details
              if (priceSpan) priceSpan.style.display = "none";
              
              const soldOutIndicator = btn.querySelector('.sold-out-badge');
              if (!soldOutIndicator) {
                const badge = document.createElement('span');
                badge.className = 'sold-out-badge text-[11px] font-normal leading-[1.2] text-center mt-0.5';
                badge.innerText = soldOutLabel;
                // Find "pr. meter" span and replace/insert before it
                const prMeterText = btn.lastElementChild;
                if (prMeterText && prMeterText.textContent.includes("meter")) {
                  btn.insertBefore(badge, prMeterText);
                  prMeterText.style.display = "none";
                } else {
                  btn.appendChild(badge);
                }
              } else {
                soldOutIndicator.innerText = soldOutLabel;
              }
            } else {
              btn.classList.remove("opacity-25", "bg-slate-50/70", "text-slate-400");
              btn.classList.add("text-slate-900");
              btn.style.cursor = "pointer";
              
              // Restore price per meter details
              if (priceSpan) priceSpan.style.display = "";
              
              const soldOutIndicator = btn.querySelector('.sold-out-badge');
              if (soldOutIndicator) {
                soldOutIndicator.remove();
              }
              const prMeterText = btn.lastElementChild;
              if (prMeterText && prMeterText.textContent.includes("meter")) {
                prMeterText.style.display = "";
              }
            }
          });
        } else if (pricingVariant && pricingVariant.price > 0) {
          // Fallback: no width option — update the single fixed-width button price
          const fallbackPriceSpan = document.querySelector('.width-btn [data-width-value-price]');
          if (fallbackPriceSpan) {
            const pricePerMeter = pricingVariant.price * 100;
            fallbackPriceSpan.textContent = formatDanishPrice(pricePerMeter).replace("Kr.", "kr.");
          }
        }

        // Sync active state of width buttons (use base variant width so it stays active when custom width is enabled)
        if (widthOptionIndex !== null) {
          updateWidthButtonsUI(width);
        }

        // If shape is round, length selection is not possible (since diameter is determined by width)
        const widthSelectionContainer = document.getElementById("step-container-width");
        const lengthSelectionContainer = document.getElementById("step-container-length");
        
        if (selectedShape === 'rund') {
          if (widthSelectionContainer) widthSelectionContainer.style.display = "flex";
          if (lengthSelectionContainer) lengthSelectionContainer.style.display = "none";
        } else {
          if (widthSelectionContainer) widthSelectionContainer.style.display = "flex";
          if (lengthSelectionContainer) lengthSelectionContainer.style.display = "flex";
        }

        const widthAccordion = document.getElementById("content-width-accordion");
        const customWidthCheckbox = document.getElementById("checkbox-custom-width");
        if (widthAccordion && customWidthCheckbox) {
          widthAccordion.style.display = customWidthCheckbox.checked ? "flex" : "none";
        }

        // Dynamically update all step numbers based on visibility
        updateStepNumbers();

        const maxWidth = width;
        const maxAllowedWidth = (customWidthCheckbox && customWidthCheckbox.checked) ? (maxWidth - 5) : maxWidth;

        const maxWidthDisplay = document.getElementById("max-width-display");
        if (maxWidthDisplay) {
          maxWidthDisplay.textContent = maxAllowedWidth;
        }

        // Clamp state width
        if (state.width > maxAllowedWidth) {
          state.width = maxAllowedWidth;
        }
        const displayWidth = document.getElementById("display-width");
        if (displayWidth && parseInt(displayWidth.value) !== state.width) {
          displayWidth.value = state.width;
        }

        // Width stepper plus / minus state
        const btnWidthPlus = document.getElementById("btn-width-plus");
        if (btnWidthPlus) {
          if (state.width >= maxAllowedWidth) {
            btnWidthPlus.disabled = true;
            btnWidthPlus.classList.add("opacity-30", "pointer-events-none");
          } else {
            btnWidthPlus.disabled = false;
            btnWidthPlus.classList.remove("opacity-30", "pointer-events-none");
          }
        }

        const btnWidthMinus = document.getElementById("btn-width-minus");
        const minWidth = 50;
        if (btnWidthMinus) {
          if (state.width <= minWidth) {
            btnWidthMinus.disabled = true;
            btnWidthMinus.classList.add("opacity-30", "pointer-events-none");
          } else {
            btnWidthMinus.disabled = false;
            btnWidthMinus.classList.remove("opacity-30", "pointer-events-none");
          }
        }

        let isTooWide = false;
        if ((selectedShape === 'firkantet' || selectedShape === 'oval') && width > absoluteMaxWidth) {
          isTooWide = true;
        }

        // Warning and buy button state handling
        const warningEl = document.getElementById("customizer-warning");
        const warningTextEl = document.getElementById("customizer-warning-text");
        const btnTextSpan = addToCartBtn ? addToCartBtn.querySelector('span:not(#btn-price-display)') : null;
        const btnPriceSpan = document.getElementById("btn-price-display");

        if (isTooWide) {
          if (warningEl && warningTextEl) {
            warningTextEl.textContent = `Dugens bredde (${width} cm) må ikke være bredere end ${absoluteMaxWidth} cm.`;
            warningEl.classList.remove("hidden");
          }
          if (addToCartBtn) {
            addToCartBtn.disabled = true;
            addToCartBtn.classList.add("bg-slate-200", "text-slate-400", "cursor-not-allowed");
            addToCartBtn.classList.remove("bg-accent", "hover:brightness-95");
            if (btnTextSpan) {
              btnTextSpan.textContent = `Bredde overskrider maks bredde (${absoluteMaxWidth} cm)`;
              if (btnPriceSpan) btnPriceSpan.style.display = "none";
            } else {
              addToCartBtn.textContent = `Bredde overskrider maks bredde (${absoluteMaxWidth} cm)`;
            }
          }
        } else {
          if (warningEl) {
            warningEl.classList.add("hidden");
          }
          if (addToCartBtn) {
            addToCartBtn.disabled = false;
            addToCartBtn.classList.remove("bg-slate-200", "text-slate-400", "cursor-not-allowed");
            addToCartBtn.classList.add("bg-accent", "hover:brightness-95");
            if (btnTextSpan) {
              btnTextSpan.textContent = addToCartBtn.getAttribute("data-text-before-price") || "Læg i kurv";
              if (btnPriceSpan) btnPriceSpan.style.display = "";
            }
          }
        }

        if (pricingVariant && !isTooWide) {
          // Calculate shape price
          const shapeInfo = shapeData[selectedShape];
          const shapePrice = (shapeInfo ? shapeInfo.price : 0) * state.quantity;

          // Calculate width surcharge
          const isWidthAdjusted = state.width < maxWidth;
          const widthSurcharge = isWidthAdjusted ? (widthSurchargeData.price || 0) * state.quantity : 0;

          // Calculate price: (price per cm) * length * quantity
          const totalClothPrice = pricingVariant.price * state.length * state.quantity;
          const totalClothAndShapePrice = totalClothPrice + shapePrice + widthSurcharge;
          
          const formattedPrice = totalClothAndShapePrice.toLocaleString("da-DK", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " Kr.";
          
          // Update price display on buy button
          const priceDisplay = document.getElementById("btn-price-display");
          if (priceDisplay) {
            priceDisplay.textContent = formattedPrice;
          } else if (addToCartBtn) {
            const prefix = addToCartBtn.getAttribute("data-text-before-price") || "Læg i kurv – ";
            addToCartBtn.textContent = prefix + formattedPrice;
          }

          // Update the summary section if it exists
          const summaryPris = document.getElementById("summary-pris");
          if (summaryPris) {
            summaryPris.textContent = "Pris: " + formattedPrice;
          }

          // Update the calculation table elements if they exist
          const summaryContainer = document.getElementById("buy-buttons-summary-container");
          if (summaryContainer) {
            summaryContainer.style.display = "flex";
          }

          const calcTitle = document.getElementById("calc-title");
          const calcMetervareLabel = document.getElementById("calc-metervare-label");
          const calcMetervarePrice = document.getElementById("calc-metervare-price");
          const calcShapeRow = document.getElementById("calc-shape-row");
          const calcShapeLabel = document.getElementById("calc-shape-label");
          const calcShapePrice = document.getElementById("calc-shape-price");
          const calcWidthRow = document.getElementById("calc-width-row");
          const calcWidthLabel = document.getElementById("calc-width-label");
          const calcWidthPrice = document.getElementById("calc-width-price");
          const calcTotalPrice = document.getElementById("calc-total-price");

          if (calcTitle) {
            calcTitle.textContent = productTitle;
          }

          if (calcMetervareLabel) {
            const labelText = (selectedShape === 'rund') ? 'Diameter' : 'Længde';
            calcMetervareLabel.textContent = `${labelText}: ${state.length} cm`;
          }
          
          const singleClothPrice = pricingVariant.price * state.length;
          if (calcMetervarePrice) {
            calcMetervarePrice.textContent = formatDanishPrice(singleClothPrice);
          }

          if (calcShapeRow) {
            if (shapeInfo) {
              calcShapeRow.style.display = "flex";
              const shapeLabels = { firkantet: 'Form: Firkantet', rund: 'Form: Rund', oval: 'Form: Oval' };
              if (calcShapeLabel) {
                calcShapeLabel.textContent = shapeLabels[selectedShape] || `Form: ${selectedShape.charAt(0).toUpperCase() + selectedShape.slice(1)}`;
              }
              if (calcShapePrice) {
                calcShapePrice.textContent = formatDanishPrice(shapeInfo.price);
              }
            } else {
              calcShapeRow.style.display = "none";
            }
          }

          if (calcWidthRow) {
            if (selectedShape === 'firkantet' || selectedShape === 'oval') {
              calcWidthRow.style.display = "flex";
              const tableclothWidth = state.width;
              if (calcWidthLabel) {
                calcWidthLabel.textContent = `Bredde: ${tableclothWidth} cm`;
              }
              if (calcWidthPrice) {
                const surchargePrice = isWidthAdjusted ? (widthSurchargeData.price || 0) : 0;
                calcWidthPrice.textContent = formatDanishPrice(surchargePrice);
              }
            } else {
              calcWidthRow.style.display = "none";
            }
          }

          if (calcTotalPrice) {
            const singleShapePrice = shapeInfo ? shapeInfo.price : 0;
            const singleWidthSurcharge = isWidthAdjusted ? (widthSurchargeData.price || 0) : 0;
            const singleTotalPrice = singleClothPrice + singleShapePrice + singleWidthSurcharge;
            calcTotalPrice.textContent = formatDanishPrice(singleTotalPrice);
          }

          // Update length calculation display
          const lengthCalculation = document.getElementById("length-calculation");
          if (lengthCalculation) {
            const totalLengthPrice = pricingVariant.price * state.length;
            const formattedTotalLengthPrice = totalLengthPrice.toLocaleString("da-DK", { 
              minimumFractionDigits: 2, 
              maximumFractionDigits: 2 
            });
            lengthCalculation.textContent = `${formattedTotalLengthPrice} Kr.`;
          }

          // Update width calculation display
          const widthCalculation = document.getElementById("width-calculation");
          if (widthCalculation) {
            if (isWidthAdjusted) {
              const totalWidthPrice = widthSurchargeData.price || 0;
              const formattedTotalWidthPrice = totalWidthPrice.toLocaleString("da-DK", { 
                minimumFractionDigits: 2, 
                maximumFractionDigits: 2 
              });
              widthCalculation.textContent = `${formattedTotalWidthPrice} Kr.`;
              widthCalculation.style.display = "block";
            } else {
              widthCalculation.style.display = "none";
            }
          }

          // Set global variable to resolve initial page load race condition
          window.currentPageProductPrice = totalClothAndShapePrice;

          // Dispatch custom event to notify other scripts about product price update
          document.dispatchEvent(new CustomEvent("product-price-updated", {
            detail: { price: totalClothAndShapePrice }
          }));
        }
      } catch (err) {
        console.error("Error in updateUI:", err);
        const calcTitle = document.getElementById("calc-title");
        if (calcTitle) {
          calcTitle.innerHTML = `<span style="color:red; font-size:11px;">FEJL: ${err.message}</span>`;
        }
      }
    }

    // Expose updateUI globally so that selectShape can trigger it
    window.updateCustomizerUI = updateUI;

    // Helper: snap length to nearest valid step within bounds
    function clampLength(val) {
      const maxAllowed = (selectedShape === 'rund') ? absoluteMaxWidth : 9999;
      val = Math.round(val / stepSize) * stepSize;
      return Math.min(maxAllowed, Math.max(minLength, val));
    }

    // Steppers listeners
    if (btnLengthMinus && displayLength) {
      btnLengthMinus.addEventListener("click", () => {
        if (state.length > minLength) {
          state.length = clampLength(state.length - stepSize);
          displayLength.value = state.length;
          updateUI();
        }
      });
    }

    if (btnLengthPlus && displayLength) {
      btnLengthPlus.addEventListener("click", () => {
        const maxAllowed = (selectedShape === 'rund') ? absoluteMaxWidth : 9999;
        if (state.length < maxAllowed) {
          state.length = clampLength(state.length + stepSize);
          displayLength.value = state.length;
          updateUI();
        }
      });
    }



    // Direct keyboard input – length
    if (displayLength) {
      displayLength.addEventListener("change", () => {
        const raw = parseInt(displayLength.value, 10);
        if (!isNaN(raw)) {
          state.length = clampLength(raw);
          displayLength.value = state.length;
          updateUI();
        } else {
          displayLength.value = state.length;
        }
      });
      displayLength.addEventListener("blur", () => {
        const raw = parseInt(displayLength.value, 10);
        state.length = isNaN(raw) ? state.length : clampLength(raw);
        displayLength.value = state.length;
        updateUI();
      });
      // Select all text on focus for easy overtyping
      displayLength.addEventListener("focus", () => displayLength.select());
    }

    // Width stepper buttons listeners
    const btnWidthMinus = document.getElementById("btn-width-minus");
    const btnWidthPlus = document.getElementById("btn-width-plus");
    const displayWidth = document.getElementById("display-width");

    function clampWidth(val, maxVal) {
      val = Math.round(val / 5) * 5;
      return Math.min(maxVal, Math.max(50, val));
    }

    if (btnWidthMinus && displayWidth) {
      btnWidthMinus.addEventListener("click", () => {
        if (state.width > 50) {
          // Resolve standard width first to get maxAllowedWidth
          const currentVariant = getCurrentVariant();
          const pricingVariant = getPricingVariant(currentVariant);
          const stdWidth = getVariantWidth(pricingVariant ? pricingVariant.title : "");
          const maxAllowedWidth = stdWidth - 5;

          state.width = clampWidth(state.width - 5, maxAllowedWidth);
          displayWidth.value = state.width;
          updateUI();
        }
      });
    }

    if (btnWidthPlus && displayWidth) {
      btnWidthPlus.addEventListener("click", () => {
        // Resolve standard width first to get maxAllowedWidth
        const currentVariant = getCurrentVariant();
        const pricingVariant = getPricingVariant(currentVariant);
        const stdWidth = getVariantWidth(pricingVariant ? pricingVariant.title : "");
        const maxAllowedWidth = stdWidth - 5;

        if (state.width < maxAllowedWidth) {
          state.width = clampWidth(state.width + 5, maxAllowedWidth);
          displayWidth.value = state.width;
          updateUI();
        }
      });
    }

    if (displayWidth) {
      displayWidth.addEventListener("change", () => {
        // Resolve standard width first to get maxAllowedWidth
        const currentVariant = getCurrentVariant();
        const pricingVariant = getPricingVariant(currentVariant);
        const stdWidth = getVariantWidth(pricingVariant ? pricingVariant.title : "");
        const maxAllowedWidth = stdWidth - 5;

        const raw = parseInt(displayWidth.value, 10);
        if (!isNaN(raw)) {
          state.width = clampWidth(raw, maxAllowedWidth);
          displayWidth.value = state.width;
          updateUI();
        } else {
          displayWidth.value = state.width;
        }
      });
      displayWidth.addEventListener("blur", () => {
        // Resolve standard width first to get maxAllowedWidth
        const currentVariant = getCurrentVariant();
        const pricingVariant = getPricingVariant(currentVariant);
        const stdWidth = getVariantWidth(pricingVariant ? pricingVariant.title : "");
        const maxAllowedWidth = stdWidth - 5;

        const raw = parseInt(displayWidth.value, 10);
        state.width = isNaN(raw) ? state.width : clampWidth(raw, maxAllowedWidth);
        displayWidth.value = state.width;
        updateUI();
      });
      displayWidth.addEventListener("focus", () => displayWidth.select());
    }

    // Custom Width Checkbox listener
    const customWidthCheckbox = document.getElementById("checkbox-custom-width");
    if (customWidthCheckbox) {
      customWidthCheckbox.addEventListener("change", () => {
        if (!customWidthCheckbox.checked) {
          // Reset width to standard active variant width when unchecked
          const currentVariant = getCurrentVariant();
          const pricingVariant = getPricingVariant(currentVariant);
          const stdWidth = getVariantWidth(pricingVariant ? pricingVariant.title : "");
          state.width = stdWidth;
        } else {
          // If checked, set width to standard active variant width minus 5
          const currentVariant = getCurrentVariant();
          const pricingVariant = getPricingVariant(currentVariant);
          const stdWidth = getVariantWidth(pricingVariant ? pricingVariant.title : "");
          state.width = stdWidth - 5;
        }
        updateUI();
      });
    }

    if (btnQtyMinus && displayQty) {
      btnQtyMinus.addEventListener("click", () => {
        if (state.quantity > 1) {
          state.quantity -= 1;
          displayQty.value = state.quantity;
          updateUI();
        }
      });
    }

    if (btnQtyPlus && displayQty) {
      btnQtyPlus.addEventListener("click", () => {
        state.quantity += 1;
        displayQty.value = state.quantity;
        updateUI();
      });
    }

    // Direct keyboard input – quantity
    if (displayQty) {
      displayQty.addEventListener("change", () => {
        const raw = parseInt(displayQty.value, 10);
        if (!isNaN(raw) && raw >= 1) {
          state.quantity = raw;
          displayQty.value = state.quantity;
          updateUI();
        } else {
          displayQty.value = state.quantity;
        }
      });
      displayQty.addEventListener("blur", () => {
        const raw = parseInt(displayQty.value, 10);
        state.quantity = (!isNaN(raw) && raw >= 1) ? raw : state.quantity;
        displayQty.value = state.quantity;
        updateUI();
      });
      displayQty.addEventListener("focus", () => displayQty.select());
    }

    // Add to cart click handler
    if (addToCartBtn) {
      addToCartBtn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        addToCartBtn.disabled = true;
        addToCartBtn.classList.add("opacity-50");

        if (selectedShape === 'rund') {
          state.length = state.width;
        }

        // Find active variant ID and pricing variant
        const currentVariant = getCurrentVariant();
        const pricingVariant = getPricingVariant(currentVariant);

        if (!metervareVariantIntId) {
          showToast("Fejl: Kunne ikke finde rå metervare-variant (SKU BTM001).");
          addToCartBtn.disabled = false;
          addToCartBtn.classList.remove("opacity-50");
          return;
        }

        const width = getVariantWidth(pricingVariant ? pricingVariant.title : currentVariant.title);
        const refPrice = pricingVariant ? pricingVariant.price : currentVariant.price;
        
        const basePriceCents = Math.round(refPrice * state.length * 100);
        const shapeInfo = shapeData[selectedShape];
        const shapeSurchargeCents = Math.round((shapeInfo ? shapeInfo.price : 0) * 100);
        
        const isWidthAdjusted = state.width < width;
        const finalWidth = state.width;
        const widthSurchargeCents = isWidthAdjusted ? Math.round((widthSurchargeData.price || 0) * 100) : 0;
        
        const unitPriceCents = basePriceCents + shapeSurchargeCents + widthSurchargeCents;

        const targetVoksdugVariantId = pricingVariant ? pricingVariant.id : currentVariant.id;
        const targetVoksdugImage = pricingVariant && pricingVariant.image ? pricingVariant.image : "";

        const shapeVariantId = shapeInfo ? shapeInfo.id : null;

        const shapeNames = { firkantet: 'Firkantet', rund: 'Rund', oval: 'Oval' };
        const displayShape = shapeNames[selectedShape] || (selectedShape.charAt(0).toUpperCase() + selectedShape.slice(1));

        const itemToAdd = {
          id: metervareVariantIntId,
          quantity: state.quantity,
          properties: {
            "_length": state.length.toString(),
            "_width": finalWidth.toString(),
            "_shape": selectedShape,
            "_base_price": basePriceCents.toString(),
            "_shape_surcharge": shapeSurchargeCents.toString(),
            "_width_surcharge": widthSurchargeCents.toString(),
            "_unit_price": unitPriceCents.toString(),
            "Form": displayShape
          }
        };

        if (selectedShape === 'rund') {
          itemToAdd.properties["Diameter"] = `${state.length} cm`;
        } else {
          itemToAdd.properties["Længde"] = `${state.length} cm`;
          itemToAdd.properties["Bredde"] = `${finalWidth} cm`;
        }

        if (shapeVariantId) {
          itemToAdd.properties["_shape_variant_id"] = `gid://shopify/ProductVariant/${shapeVariantId}`;
        }
        
        if (isWidthAdjusted && widthSurchargeData && widthSurchargeData.id) {
          itemToAdd.properties["_width_variant_id"] = `gid://shopify/ProductVariant/${widthSurchargeData.id}`;
        }

        // Add the product title and image to properties so they can be accessed by the Cart Transform function
        itemToAdd.properties["_metervare_title"] = productTitle;
        let variantImage = pricingVariant && pricingVariant.image ? pricingVariant.image : (currentVariant && currentVariant.image ? currentVariant.image : "");
        if (variantImage) {
          if (variantImage.startsWith("//")) {
            variantImage = "https:" + variantImage;
          }
          itemToAdd.properties["_image"] = variantImage;
        }

        if (targetVoksdugVariantId) {
          itemToAdd.properties["_metervare_variant_id"] = `gid://shopify/ProductVariant/${targetVoksdugVariantId}`;
          itemToAdd.properties["_price_per_cm"] = refPrice.toString();
        }

        // Optimistic cart count increment
        const counters = document.querySelectorAll('#cart-counter');
        counters.forEach(counter => {
          const currentCount = parseInt(counter.innerText) || 0;
          counter.innerText = currentCount + state.quantity;
          counter.classList.remove("scale-0");
          counter.classList.add("scale-100");
        });

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [itemToAdd] })
        })
        .then(response => {
          if (!response.ok) throw new Error("Add to cart failed");
          return response.json();
        })
        .then(data => {
          showToast("Lagt i kurven!");
          // Wait for Shopify session to update and fetch cart
          setTimeout(() => {
            fetch('/cart.js')
              .then(res => res.json())
              .then(cartData => {
                // Update cart count
                counters.forEach(counter => {
                  counter.innerText = cartData.item_count;
                });
                // Dispatch cart update event
                document.dispatchEvent(new CustomEvent("cart-updated-total", { 
                  detail: { cartTotal: cartData.total_price / 100.0 } 
                }));
                
                // if (typeof window.toggleCartDrawer === "function") {
                //   window.toggleCartDrawer(true);
                // }
              });
          }, 350);
        })
        .catch(err => {
          console.error(err);
          showToast("Fejl ved tilføjelse til kurv.");
        })
        .finally(() => {
          addToCartBtn.disabled = false;
          addToCartBtn.classList.remove("opacity-50");
        });
      });
    }

    // Helper: Toast alert
    function showToast(message) {
      const toast = document.getElementById("toast");
      const toastText = document.getElementById("toast-text");
      if (!toast || !toastText) return;

      toastText.textContent = message;
      toast.classList.remove("translate-y-20", "opacity-0");
      toast.classList.add("translate-y-0", "opacity-100");

      clearTimeout(window.customizerToastTimeout);
      window.customizerToastTimeout = setTimeout(() => {
        toast.classList.remove("translate-y-0", "opacity-100");
        toast.classList.add("translate-y-20", "opacity-0");
      }, 2500);
    }

    // Listen for variant selections changes on page to recalculate
    document.addEventListener("change", (e) => {
      if (e.target && (e.target.name === "id" || e.target.classList.contains("single-option-selector"))) {
        setTimeout(updateUI, 50);
      }
    });

    // Initial load
    selectShape('firkantet');
    updateUI();
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initCustomizer);
  } else {
    initCustomizer();
  }
</script>

