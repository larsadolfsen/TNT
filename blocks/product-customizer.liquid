{% comment %}
  New Product Customizer Section
  Built from scratch. Renders a premium length stepper.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}

{%- liquid
  assign min_length = block.settings.min_length | default: 50
  assign step_size = block.settings.step_size | default: 10

  # 1. Try to resolve the configured product from settings and verify it has SKU BTM001
  assign metervare_product = all_products[block.settings.metervare_product]
  assign metervare_variant = nil
  if metervare_product != nil
    for variant in metervare_product.variants
      if variant.sku == 'BTM001'
        assign metervare_variant = variant
        break
      endif
    endfor
  endif

  # 2. If not configured or doesn't have SKU BTM001, dynamically search collections
  if metervare_variant == nil
    for prod in collections.all.products
      for variant in prod.variants
        if variant.sku == 'BTM001'
          assign metervare_product = prod
          assign metervare_variant = variant
          break
        endif
      endfor
      if metervare_variant != nil
        break
      endif
    endfor
  endif

  # 3. Last resort fallback to hardcoded handles
  if metervare_variant == nil
    assign metervare_product = all_products['firkantet-dug'] | default: all_products['metervare']
    for variant in metervare_product.variants
      if variant.sku == 'BTM001'
        assign metervare_variant = variant
        break
      endif
    endfor
  endif

  # Fallback to first available variant if still nil
  if metervare_variant == nil and metervare_product != nil
    assign metervare_variant = metervare_product.selected_or_first_available_variant
  endif
-%}

{%- style -%}
  #shopify-block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top }}px !important;
    padding-bottom: {{ block.settings.padding_bottom }}px !important;
    padding-left: {{ block.settings.padding_sides }}px !important;
    padding-right: {{ block.settings.padding_sides }}px !important;
  }
{%- endstyle -%}

<!-- Hidden element to signal to product-buy-buttons that customizer is active -->
<div id="shape-selector" style="display: none;"></div>

<div class="w-full border-y border-slate-100" {{ block.shopify_attributes }}>
  <div class="flex flex-col gap-4">

    <!-- Step 1: Shape Selector -->
    <div class="flex items-start gap-3">
      <span class="w-6 h-6 flex items-center justify-center bg-slate-900 text-white text-xs font-bold rounded-full mt-0.5 shrink-0">1</span>
      <div class="flex flex-col w-full">
        <span class="font-bold text-sm uppercase tracking-wider text-slate-800">Vælg form</span>
      </div>
    </div>
    <div class="flex gap-4">

      <!-- Firkantet dug -->
      <button type="button" id="btn-shape-firkantet" data-shape="firkantet"
        class="shape-btn flex flex-col items-center justify-center gap-1.5 rounded-2xl border-2 bg-white text-slate-900 shadow-sm transition-all duration-200 cursor-pointer focus:outline-none"
        style="width:72px;height:72px;border-color:#f5c518" onclick="selectShape('firkantet')">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="26" height="26">
          <rect x="3" y="6" width="18" height="12" rx="1.5"/>
        </svg>
        <span style="font-size:10px;font-weight:600;letter-spacing:0.02em;line-height:1.2;text-align:center">Firkantet</span>
      </button>

      <!-- Rund dug -->
      <button type="button" id="btn-shape-rund" data-shape="rund"
        class="shape-btn flex flex-col items-center justify-center gap-1.5 rounded-2xl border border-slate-200 bg-white text-slate-600 shadow-sm transition-all duration-200 cursor-pointer focus:outline-none"
        style="width:72px;height:72px" onclick="selectShape('rund')">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="26" height="26">
          <circle cx="12" cy="12" r="8.5"/>
        </svg>
        <span style="font-size:10px;font-weight:600;letter-spacing:0.02em;line-height:1.2;text-align:center">Rund</span>
      </button>

      <!-- Oval dug -->
      <button type="button" id="btn-shape-oval" data-shape="oval"
        class="shape-btn flex flex-col items-center justify-center gap-1.5 rounded-2xl border border-slate-200 bg-white text-slate-600 shadow-sm transition-all duration-200 cursor-pointer focus:outline-none"
        style="width:72px;height:72px" onclick="selectShape('oval')">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" width="26" height="26">
          <rect x="3" y="8" width="18" height="8" rx="4"/>
        </svg>
        <span style="font-size:10px;font-weight:600;letter-spacing:0.02em;line-height:1.2;text-align:center">Oval</span>
      </button>

    </div>


    <!-- Step 2: Length Selection -->
    <div class="flex items-start gap-3">
      <span class="w-6 h-6 flex items-center justify-center bg-slate-900 text-white text-xs font-bold rounded-full mt-0.5 shrink-0">2</span>
      <div class="flex flex-col">
        <span class="font-bold text-sm uppercase tracking-wider text-slate-800">Vælg længde</span>
        <p class="text-xs text-on-surface-variant mt-1">Vi anbefaler ca. 20 cm til nedhæng i hver ende.</p>
      </div>
    </div>

    <!-- Pill-shaped Stepper -->
    <div class="w-full">
      <div class="flex w-full h-12 justify-between items-center bg-white border border-slate-200 rounded-full px-4 shadow-sm select-none">
        <!-- Minus button -->
        <button type="button" id="btn-length-minus" class="w-12 h-full flex items-center justify-center text-slate-500 hover:text-slate-955 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none">
          &mdash;
        </button>
        <!-- Value display -->
        <span id="display-length" class="text-center font-bold text-slate-900 text-base">200 cm</span>
        <!-- Plus button -->
        <button type="button" id="btn-length-plus" class="w-12 h-full flex items-center justify-center text-slate-500 hover:text-slate-955 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none">
          &#43;
        </button>
      </div>
      <!-- Dynamic calculation info under length selector -->
      <div id="length-calculation" class="text-xs text-on-surface-variant mt-1.5 text-center w-full"></div>
    </div>

    <!-- Step 3: Quantity Selector -->
    <div class="flex flex-col gap-2 mt-2 w-full">
      <div class="flex items-center gap-3">
        <span class="w-6 h-6 flex items-center justify-center bg-slate-900 text-white text-xs font-bold rounded-full">3</span>
        <span class="font-bold text-sm uppercase tracking-wider text-slate-800">Antal</span>
      </div>
      <div class="flex w-full h-12 justify-between items-center bg-white border border-slate-200 rounded-full px-4 shadow-sm select-none">
        <!-- Minus button -->
        <button type="button" id="btn-qty-minus" class="w-12 h-full flex items-center justify-center text-slate-500 hover:text-slate-955 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none">
          &mdash;
        </button>
        <!-- Value display -->
        <span id="display-qty" class="text-center font-bold text-slate-900 text-base">1</span>
        <!-- Plus button -->
        <button type="button" id="btn-qty-plus" class="w-12 h-full flex items-center justify-center text-slate-500 hover:text-slate-955 active:scale-90 transition-transform font-bold text-xl cursor-pointer focus:outline-none">
          &#43;
        </button>
      </div>
    </div>
  </div>
</div>

<!-- Toast notification popup -->
<div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 w-[calc(100%-2rem)] max-w-[calc(1280px-2rem)] z-50 bg-[#0e1a28] border border-slate-800 text-white text-sm px-4 py-3 rounded-full shadow-xl flex items-center justify-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
  <span class="material-symbols-outlined text-emerald-400">check_circle</span>
  <span id="toast-text" class="truncate">Lagt i kurven</span>
</div>

<!-- Variant Data JSON -->
<script id="variant-data" type="application/json">
  [
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id }},
        "title": {{ variant.title | json }},
        "price": {{ variant.price | divided_by: 100.0 }},
        "available": {{ variant.available }},
        "image": {{ variant.featured_image | default: product.featured_image | image_url: width: 150, height: 150, crop: 'center' | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
</script>

<script>
  // Shape selector (global so onclick= attributes can call it)
  let selectedShape = 'firkantet';
  function selectShape(shape) {
    selectedShape = shape;
    document.querySelectorAll('.shape-btn').forEach(btn => {
      const isActive = btn.dataset.shape === shape;
      if (isActive) {
        btn.style.borderColor = '#f5c518';
        btn.style.borderWidth = '2px';
        btn.classList.remove('border', 'border-slate-200', 'text-slate-600');
        btn.classList.add('border-2', 'text-slate-900');
      } else {
        btn.style.borderColor = '';
        btn.style.borderWidth = '';
        btn.classList.remove('border-2', 'text-slate-900');
        btn.classList.add('border', 'border-slate-200', 'text-slate-600');
      }
    });
  }


  document.addEventListener("DOMContentLoaded", () => {
    console.log("Voksdug Customizer - Version: swap-voksdug-metervare (Release 26)");
    // 1. Config variables from Liquid settings
    const minLength = {{ min_length | json }};
    const stepSize = {{ step_size | json }};
    const metervareVariantId = {% if metervare_variant %}"gid://shopify/ProductVariant/{{ metervare_variant.id }}"{% else %}null{% endif %};
    const metervareVariantIntId = {% if metervare_variant %}{{ metervare_variant.id }}{% else %}null{% endif %};
    
    // Parse variants
    let variants = [];
    try {
      variants = JSON.parse(document.getElementById('variant-data').textContent);
    } catch (e) {
      console.error("Failed to parse variants", e);
    }

    const productTitle = {{ product.title | json }};
    // Helper: Parse width from variant title or product title (e.g. "140 cm bred" -> 140)
    function getVariantWidth(variantTitle) {
      let match = variantTitle.match(/(\d+)/);
      if (!match && productTitle) {
        match = productTitle.match(/(\d+)/);
      }
      return match ? parseInt(match[1]) : 140;
    }

    // State
    let state = {
      length: 200,
      quantity: 1
    };

    // DOM cache
    const displayLength = document.getElementById("display-length");
    const btnLengthMinus = document.getElementById("btn-length-minus");
    const btnLengthPlus = document.getElementById("btn-length-plus");

    const displayQty = document.getElementById("display-qty");
    const btnQtyMinus = document.getElementById("btn-qty-minus");
    const btnQtyPlus = document.getElementById("btn-qty-plus");

    const addToCartBtn = document.getElementById("btn-add-to-cart");
    const summaryMal = document.getElementById("summary-mål");

    // Recalculate price display
    function updateUI() {
      // Find currently selected variant ID on the page (variant picker sets this)
      let activeVariantId = null;
      const variantInput = document.querySelector('select[name="id"], input[name="id"]');
      if (variantInput) {
        activeVariantId = parseInt(variantInput.value);
      }
      
      // Find the pricing variant (the one that is not the 'Tilpasset' variant)
      const pricingVariant = variants.find(v => !v.title.toLowerCase().includes("tilpasset") && v.price > 0) || variants[0];
      if (pricingVariant) {
        // Calculate price: (price per cm) * length * quantity
        const totalClothPrice = pricingVariant.price * state.length * state.quantity;
        
        const formattedPrice = totalClothPrice.toLocaleString("da-DK", { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + " kr.";
        
        // Update price display on buy button
        const priceDisplay = document.getElementById("btn-price-display");
        if (priceDisplay) {
          priceDisplay.textContent = formattedPrice;
        } else if (addToCartBtn) {
          const prefix = addToCartBtn.getAttribute("data-text-before-price") || "Læg i kurv – ";
          addToCartBtn.textContent = prefix + formattedPrice;
        }

        // Update the summary section if it exists
        const summaryPris = document.getElementById("summary-pris");
        if (summaryPris) {
          summaryPris.textContent = "Pris: " + formattedPrice;
        }

        // Update summary dimensions text (e.g. Du er ved at købe: 1 x Klar gennemsigtig voksdug - 140 x 200 cm)
        if (summaryMal) {
          const width = getVariantWidth(pricingVariant.title);
          const rawTitle = pricingVariant.title === "Default Title" ? productTitle : pricingVariant.title;
          const displayTitle = rawTitle.split("-")[0].trim();
          summaryMal.textContent = `Du er ved at købe: ${state.quantity} x ${displayTitle} - ${width} x ${state.length} cm`;
        }

        // Update length calculation display
        const lengthCalculation = document.getElementById("length-calculation");
        if (lengthCalculation) {
          const lengthInMeters = state.length / 100;
          const pricePerMeter = pricingVariant.price * 100;
          const totalLengthPrice = pricingVariant.price * state.length;
          
          const formattedPricePerMeter = pricePerMeter.toLocaleString("da-DK", { 
            minimumFractionDigits: 2, 
            maximumFractionDigits: 2 
          });
          const formattedTotalLengthPrice = totalLengthPrice.toLocaleString("da-DK", { 
            minimumFractionDigits: 2, 
            maximumFractionDigits: 2 
          });
          
          lengthCalculation.textContent = `${formattedTotalLengthPrice} kr.`;
        }

        // Set global variable to resolve initial page load race condition
        window.currentPageProductPrice = totalClothPrice;

        // Dispatch custom event to notify other scripts about product price update
        document.dispatchEvent(new CustomEvent("product-price-updated", {
          detail: { price: totalClothPrice }
        }));
      }
    }

    // Steppers listeners
    if (btnLengthMinus && displayLength) {
      btnLengthMinus.addEventListener("click", () => {
        if (state.length > minLength) {
          state.length -= stepSize;
          displayLength.textContent = state.length + " cm";
          updateUI();
        }
      });
    }

    if (btnLengthPlus && displayLength) {
      btnLengthPlus.addEventListener("click", () => {
        state.length += stepSize;
        displayLength.textContent = state.length + " cm";
        updateUI();
      });
    }

    if (btnQtyMinus && displayQty) {
      btnQtyMinus.addEventListener("click", () => {
        if (state.quantity > 1) {
          state.quantity -= 1;
          displayQty.textContent = state.quantity;
          updateUI();
        }
      });
    }

    if (btnQtyPlus && displayQty) {
      btnQtyPlus.addEventListener("click", () => {
        state.quantity += 1;
        displayQty.textContent = state.quantity;
        updateUI();
      });
    }

    // Add to cart click handler
    if (addToCartBtn) {
      addToCartBtn.addEventListener("click", (e) => {
        e.preventDefault();
        e.stopPropagation();

        addToCartBtn.disabled = true;
        addToCartBtn.classList.add("opacity-50");

        // Find variant to add to cart (always add the 'Tilpasset' variant)
        const customizedVariant = variants.find(v => v.title.toLowerCase().includes("tilpasset")) || variants[0];
        // Find variant to use for pricing/width reference (not containing 'Tilpasset')
        const pricingVariant = variants.find(v => !v.title.toLowerCase().includes("tilpasset") && v.price > 0) || variants[0];

        if (!metervareVariantIntId) {
          showToast("Fejl: Kunne ikke finde rå metervare-variant (SKU BTM001).");
          addToCartBtn.disabled = false;
          addToCartBtn.classList.remove("opacity-50");
          return;
        }

        const width = getVariantWidth(pricingVariant ? pricingVariant.title : customizedVariant.title);
        const refPrice = pricingVariant ? pricingVariant.price : customizedVariant.price;
        const unitPriceCents = Math.round(refPrice * state.length * 100);

        const targetVoksdugVariantId = pricingVariant ? pricingVariant.id : customizedVariant.id;
        const targetVoksdugImage = pricingVariant && pricingVariant.image ? pricingVariant.image : "";

        const itemToAdd = {
          id: metervareVariantIntId,
          quantity: state.quantity,
          properties: {
            "_length": state.length.toString(),
            "_width": width.toString(),
            "_shape": selectedShape,
            "_unit_price": unitPriceCents.toString()
          }
        };

        // Add the product title and image to properties so they can be accessed by the Cart Transform function
        itemToAdd.properties["_metervare_title"] = productTitle;
        let variantImage = pricingVariant && pricingVariant.image ? pricingVariant.image : (customizedVariant && customizedVariant.image ? customizedVariant.image : "");
        if (variantImage) {
          if (variantImage.startsWith("//")) {
            variantImage = "https:" + variantImage;
          }
          itemToAdd.properties["_image"] = variantImage;
        }

        if (targetVoksdugVariantId) {
          itemToAdd.properties["_metervare_variant_id"] = `gid://shopify/ProductVariant/${targetVoksdugVariantId}`;
          itemToAdd.properties["_price_per_cm"] = refPrice.toString();
        }

        // Optimistic cart count increment
        const counters = document.querySelectorAll('#cart-counter');
        counters.forEach(counter => {
          const currentCount = parseInt(counter.innerText) || 0;
          counter.innerText = currentCount + state.quantity;
          counter.classList.remove("scale-0");
          counter.classList.add("scale-100");
        });

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [itemToAdd] })
        })
        .then(response => {
          if (!response.ok) throw new Error("Add to cart failed");
          return response.json();
        })
        .then(data => {
          showToast("Lagt i kurven!");
          // Wait for Shopify session to update and fetch cart
          setTimeout(() => {
            fetch('/cart.js')
              .then(res => res.json())
              .then(cartData => {
                // Update cart count
                counters.forEach(counter => {
                  counter.innerText = cartData.item_count;
                });
                // Dispatch cart update event
                document.dispatchEvent(new CustomEvent("cart-updated-total", { 
                  detail: { cartTotal: cartData.total_price / 100.0 } 
                }));
                
                if (typeof window.toggleCartDrawer === "function") {
                  window.toggleCartDrawer(true);
                }
              });
          }, 350);
        })
        .catch(err => {
          console.error(err);
          showToast("Fejl ved tilføjelse til kurv.");
        })
        .finally(() => {
          addToCartBtn.disabled = false;
          addToCartBtn.classList.remove("opacity-50");
        });
      });
    }

    // Helper: Toast alert
    function showToast(message) {
      const toast = document.getElementById("toast");
      const toastText = document.getElementById("toast-text");
      if (!toast || !toastText) return;

      toastText.textContent = message;
      toast.classList.remove("translate-y-20", "opacity-0");
      toast.classList.add("translate-y-0", "opacity-100");

      clearTimeout(window.customizerToastTimeout);
      window.customizerToastTimeout = setTimeout(() => {
        toast.classList.remove("translate-y-0", "opacity-100");
        toast.classList.add("translate-y-20", "opacity-0");
      }, 2500);
    }

    // Listen for variant selections changes on page to recalculate
    document.addEventListener("change", (e) => {
      if (e.target && (e.target.name === "id" || e.target.classList.contains("single-option-selector"))) {
        setTimeout(updateUI, 50);
      }
    });

    // Initial load
    updateUI();
  });
</script>

{% schema %}
{
  "name": "Product Customizer",
  "class": "shopify-block-product-customizer",
  "settings": [
    {
      "type": "product",
      "id": "metervare_product",
      "label": "Metervare Produkt (sku=BTM001)",
      "info": "Vælg det produkt, der repræsenterer rå metervare (SKU BTM001)"
    },
    {
      "type": "header",
      "content": "Form-knapper"
    },
    {
      "type": "product",
      "id": "firkantet_product",
      "label": "Firkantet dug – produkt"
    },
    {
      "type": "product",
      "id": "rund_product",
      "label": "Rund dug – produkt"
    },
    {
      "type": "product",
      "id": "oval_product",
      "label": "Oval dug – produkt"
    },
    {
      "type": "number",
      "id": "step_size",
      "label": "Længde trin (cm)",
      "default": 10
    },
    {
      "type": "number",
      "id": "min_length",
      "label": "Minimum længde (cm)",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Customizer"
    }
  ]
}
{% endschema %}