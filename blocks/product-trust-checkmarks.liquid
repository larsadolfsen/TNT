{%- style -%}
  #shopify-block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top }}px !important;
    padding-bottom: {{ block.settings.padding_bottom }}px !important;
    padding-left: {{ block.settings.padding_horizontal }}px !important;
    padding-right: {{ block.settings.padding_horizontal }}px !important;
  }
{%- endstyle -%}

<div class="space-y-2.5 text-sm" {{ block.shopify_attributes }}>
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Product Trust Checkmarks",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Sideafstand",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Product Trust Checkmarks"
    }
  ]
}
{% endschema %}
