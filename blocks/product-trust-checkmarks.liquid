{%- if block.settings.suppress_padding_top or block.settings.suppress_padding_bottom -%}
  {%- style -%}
    {%- if block.settings.suppress_padding_top -%}
      #shopify-block-{{ block.id }} {
        padding-top: 0 !important;
      }
    {%- endif -%}
    {%- if block.settings.suppress_padding_bottom -%}
      #shopify-block-{{ block.id }} {
        padding-bottom: 0 !important;
      }
    {%- endif -%}
  {%- endstyle -%}
{%- endif -%}

<div class="space-y-2.5 text-sm" {{ block.shopify_attributes }}>
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "Product Trust Checkmarks",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "suppress_padding_top",
      "label": "Fjern afstand i toppen",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "suppress_padding_bottom",
      "label": "Fjern afstand i bunden",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Product Trust Checkmarks"
    }
  ]
}
{% endschema %}
