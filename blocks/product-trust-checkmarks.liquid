{%- style -%}
  #shopify-block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top }}px !important;
    padding-bottom: {{ block.settings.padding_bottom }}px !important;
    padding-left: {{ block.settings.padding_sides }}px !important;
    padding-right: {{ block.settings.padding_sides }}px !important;
  }
  #shopify-block-{{ block.id }} .shopify-block {
    padding: 0 !important;
  }
{%- endstyle -%}

<div class="product-trust-checkmarks-list space-y-1 text-sm" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Product Trust Checkmarks",
  "class": "shopify-block-product-trust-checkmarks",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Trust Checkmarks"
    }
  ]
}
{% endschema %}
