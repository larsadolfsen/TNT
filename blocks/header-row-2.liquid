{% doc %}
  A horizontal row inside Header 2. Add Header Group blocks to arrange items
  left/center/right. Any other block added directly will span full width.
{% enddoc %}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    display: flex;
    align-items: center;
    width: 100%;
    height: 56px;
    padding-top: 4px;
    padding-bottom: 4px;
    box-sizing: border-box;
    padding-left: 0;
    padding-right: 0;
  }

  /* Direct children that are NOT a header-group take full width */
  #shopify-block-{{ block.id }} > .shopify-block:not(.header-group-block) {
    flex: 1 1 100%;
    width: 100%;
  }
{%- endstyle -%}

<div
  class="header-row-2 flex items-center w-full gap-4"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Header Row 2",
  "blocks": [
    { "type": "@theme" }
  ],
  "settings": [],
  "presets": [
    {
      "name": "Header Row 2"
    }
  ]
}
{% endschema %}
