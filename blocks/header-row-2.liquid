{% doc %}
  A horizontal row inside Header 2. Add Header Group blocks to arrange items
  left/center/right. Any other block added directly will span full width.
{% enddoc %}

{%- liquid
  assign row_padding_y = 6
  if block.settings.row_height == '44'
    assign row_padding_y = 0
  endif
-%}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    display: flex;
    align-items: center;
    width: 100%;
    height: {{ block.settings.row_height }}px;
    --row-height: {{ block.settings.row_height }}px;
    --row-padding-y: {{ row_padding_y }}px;
    padding: {{ row_padding_y }}px 0;
    box-sizing: border-box;
  }

  /* Direct children that are NOT a header-group take full width */
  #shopify-block-{{ block.id }} > .shopify-block:not(.header-group-block) {
    flex: 1 1 100%;
    width: 100%;
  }
{%- endstyle -%}

<div
  class="header-row-2 flex items-center w-full gap-4"
  style="height: 100%; --row-height: {{ block.settings.row_height }}px; --row-padding-y: {{ row_padding_y }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% schema %}
{
  "name": "Header Row 2",
  "blocks": [
    { "type": "header-group" },
    { "type": "header-navigation" },
    { "type": "header-logo" },
    { "type": "header-search" },
    { "type": "header-search-icon" },
    { "type": "header-cart" },
    { "type": "header-account" },
    { "type": "header-follow-on-shop" },
    { "type": "header-theme-toggle" },
    { "type": "header-hamburger" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "row_height",
      "label": "Row height",
      "options": [
        {
          "value": "56",
          "label": "56px (Default)"
        },
        {
          "value": "44",
          "label": "44px (Compact)"
        }
      ],
      "default": "56"
    }
  ],
  "presets": [
    {
      "name": "Header Row 2"
    }
  ]
}
{% endschema %}
