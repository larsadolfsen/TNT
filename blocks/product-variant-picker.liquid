{% comment %}
  Product Variant Picker Block
  Renders swatches for colors and text pills for other options.
{% endcomment %}

{%- if product.variants.size > 1 -%}
  {%- style -%}
    #shopify-block-{{ block.id }}.shopify-block {
      {%- render 'block-padding-vars', block: block, top_default: 12, bottom_default: 12 -%}
      
      padding-top: var(--block-padding-top);
      padding-bottom: var(--block-padding-bottom);
      padding-left: var(--block-padding-left);
      padding-right: var(--block-padding-right);
    }
  {%- endstyle -%}

  <div class="w-full" id="variant-picker-{{ block.id }}" {{ block.shopify_attributes }}>
    <input type="hidden" name="id" id="product-variant-id-{{ block.id }}" value="{{ product.selected_or_first_available_variant.id }}">

    {%- if product.variants.size > 1 -%}
      <div class="product-variant-selectors flex flex-col gap-4 mb-2">
        {%- for option in product.options_with_values -%}
          {%- assign option_name_down = option.name | downcase -%}
          {%- assign is_color = false -%}
          {%- if option_name_down contains 'farve' or option_name_down contains 'mønster' or option_name_down contains 'color' or option_name_down contains 'colour' -%}
            {%- assign is_color = true -%}
          {%- endif -%}
          
          <div class="flex flex-col gap-1.5" data-option-index="{{ forloop.index0 }}">
            <span class="text-xs font-bold text-primary/70 uppercase tracking-wider">
              {{ option.name }}: <span class="text-primary font-semibold normal-case text-sm" data-selected-option-label="{{ option.name }}">{{ product.selected_or_first_available_variant.options[forloop.index0] }}</span>
            </span>
            <div class="flex flex-wrap gap-2">
              {%- for value in option.values -%}
                {%- assign is_selected = false -%}
                {%- if product.selected_or_first_available_variant.options[forloop.parentloop.index0] == value -%}
                  {%- assign is_selected = true -%}
                {%- endif -%}
                
                {%- if is_color -%}
                  {%- assign swatch_img = product.featured_image -%}
                  {%- for v in product.variants -%}
                    {%- if v.options[forloop.parentloop.parentloop.index0] == value -%}
                      {%- if v.featured_image != blank -%}
                        {%- assign swatch_img = v.featured_image -%}
                      {%- endif -%}{%- break -%}
                    {%- endif -%}
                  {%- endfor -%}
                  
                   <button 
                    type="button"
                    class="w-12 h-12 rounded-2xl overflow-hidden border-2 bg-card-high shadow-sm p-0.5 cursor-pointer transition-all {% if is_selected %}border-[var(--color-accent)] ring-4 ring-[var(--color-accent)]/10{% else %}border-outline-variant hover:border-[var(--color-accent)]/60{% endif %}"
                    data-option-name="{{ option.name }}"
                    data-option-value="{{ value | escape }}"
                    title="{{ value | escape }}"
                  >
                    <img src="{{ swatch_img | image_url: width: 120 }}" alt="{{ value | escape }}" class="w-full h-full object-cover rounded-[14px]" width="120" height="120" />
                  </button>
                {%- else -%}
                  <button 
                    type="button"
                    class="px-4 py-2 text-sm rounded-2xl bg-card-high shadow-sm cursor-pointer transition-all {% if is_selected %}border-2 text-primary font-bold{% else %}border border-outline-variant text-primary/70{% endif %}"
                    style="{% if is_selected %}border-color: var(--color-accent);{% endif %}"
                    data-option-name="{{ option.name }}"
                    data-option-value="{{ value | escape }}"
                  >
                    {{ value }}
                  </button>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <script id="picker-variant-data-{{ block.id }}" type="application/json">
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "title": {{ variant.title | json }},
          "options": {{ variant.options | json }},
          "price": {{ variant.price }},
          "price_formatted": {{ variant.price | money | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>

  <script src="{{ 'product-variant-picker.js' | asset_url }}" defer="defer"></script>
{%- else -%}
  {%- style -%}
    #shopify-block-{{ block.id }}.shopify-block {
      display: none;
    }
  {%- endstyle -%}
{%- endif -%}

{% schema %}
{
  "name": "Product Variant Picker",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Variant Picker",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}
