{%- liquid
  assign border_classes = ""
  if block.settings.border_top
    assign border_classes = border_classes | append: " border-t"
  endif
  if block.settings.border_bottom
    assign border_classes = border_classes | append: " border-b"
  endif
-%}

<section class="px-4 py-10 space-y-6 bg-white border-outline-variant max-w-screen-xl mx-auto{{ border_classes }}">
  {%- if block.settings.image != blank -%}
    <div class="aspect-video w-full rounded-xl overflow-hidden bg-surface-container">
      <img 
        alt="{{ block.settings.image.alt | default: block.settings.heading }}" 
        class="w-full h-full object-cover" 
        src="{{ block.settings.image | image_url: width: 1200 }}" 
        width="1200" 
        height="675"
      />
    </div>
  {%- endif -%}


  
  <div class="space-y-4">
    {%- if block.settings.heading != blank -%}
      <h2 class="text-xl font-bold text-primary leading-tight">{{ block.settings.heading }}</h2>
    {%- endif -%}
    
    <div class="rte text-sm text-on-surface-variant leading-relaxed">
      {{ block.settings.content }}
    </div>
  </div>
</section>

