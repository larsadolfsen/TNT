{%- liquid
  assign border_classes = ""
  if block.settings.border_top
    assign border_classes = border_classes | append: " border-t"
  endif
  if block.settings.border_bottom
    assign border_classes = border_classes | append: " border-b"
  endif
-%}

{%- if block.settings.suppress_padding_top or block.settings.suppress_padding_bottom -%}
  {%- style -%}
    {%- if block.settings.suppress_padding_top -%}
      #shopify-block-{{ block.id }} {
        padding-top: 0 !important;
      }
    {%- endif -%}
    {%- if block.settings.suppress_padding_bottom -%}
      #shopify-block-{{ block.id }} {
        padding-bottom: 0 !important;
      }
    {%- endif -%}
  {%- endstyle -%}
{%- endif -%}

<section class="p-4 space-y-6 bg-white border-outline-variant{{ border_classes }}" {{ block.shopify_attributes }}>
  {%- if block.settings.image != blank -%}
    <div class="aspect-video w-full rounded-xl overflow-hidden bg-surface-container">
      <img 
        alt="{{ block.settings.image.alt | default: block.settings.heading }}" 
        class="w-full h-full object-cover" 
        src="{{ block.settings.image | image_url: width: 1200 }}" 
        width="1200" 
        height="675"
      />
    </div>
  {%- endif -%}


  
  <div class="space-y-4">
    {%- if block.settings.heading != blank -%}
      <h2 class="text-xl font-bold text-primary leading-tight">{{ block.settings.heading }}</h2>
    {%- endif -%}
    
    <div class="rte text-sm text-on-surface-variant leading-relaxed">
      {{ block.settings.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Tekst",
  "class": "shopify-block-product-banner-text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Billede"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Overskrift",
      "default": "Klar voksdug – Den ultimative beskyttelse af dit bord"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Brødtekst",
      "default": "<p>Vores klare voksdug er designet til at give dit bord den maksimale beskyttelse uden at gå på kompromis med æstetikken. Med en tykkelse på 0,20 mm PVC får du en dug, der er både robust og utroligt nem at vedligeholde. Den gennemsigtige finish sikrer, at dit bords naturlige skønhed – om det er smukt egetræ eller moderne marmor – forbliver fuldt synligt.</p><p>Dugen er 100% phthalatfri og OEKO-TEX® certificeret, hvilket gør den sikker at bruge for hele familien, selv i hjem med små børn. Den er ekstremt vand- og smudsafvisende, så spild fra kaffe, rødvin eller børnenes madpakker nemt kan tørres af med en fugtig klud. Hver dug skæres præcist efter dine personlige mål, så den passer perfekt til dit unikke bord.</p>"
    },
    {
      "type": "checkbox",
      "id": "border_top",
      "label": "Vis kant i toppen",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "Vis kant i bunden",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "suppress_padding_top",
      "label": "Fjern afstand i toppen",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "suppress_padding_bottom",
      "label": "Fjern afstand i bunden",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Tekst"
    }
  ]
}
{% endschema %}
