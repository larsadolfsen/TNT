<div class="flex items-center" {{ block.shopify_attributes }}>
  <a
    href="{{ routes.cart_url }}"
    onclick="event.preventDefault(); toggleCartDrawer(true);"
    class="cursor-pointer text-primary no-underline flex items-center justify-center hover:opacity-80 transition-opacity"
  >
    {% render 'icon', name: 'shopping-cart', button: true, class: 'text-primary', badge: true, badge_id: 'cart-counter', badge_value: cart.item_count, badge_hidden: cart.item_count == 0 %}
  </a>
</div>

{% schema %}
{
  "name": "Cart Icon",
  "settings": [],
  "presets": [
    {
      "name": "Cart Icon"
    }
  ]
}
{% endschema %}
