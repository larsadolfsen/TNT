{% doc %}
  Renders an icon (or an uploaded image in its place), optionally linked.

  @example
  {% content_for 'block', type: 'icon', id: 'icon' %}
{% enddoc %}

{%- liquid
  assign valid_icons = 'arrow-left,arrow-right,arrow-up-down,check,chevron-down,chevron-left,chevron-right,chevron-up,circle-alert,circle-check,circle-play,clock,code,file-text,frown,globe,image,info,key,leaf,list-filter,lock,mail,map-pin,menu,minus,moon,phone,play,plus,refresh-cw,search,search-x,shield-check,shopping-basket,shopping-cart,star,star-half,store,sun,tag,trash-2,triangle-alert,user,x' | split: ','
  assign icon_name = block.settings.icon
  assign has_icon = false
  if icon_name != blank and icon_name != 'none' and valid_icons contains icon_name
    assign has_icon = true
  endif
  assign icon_size = block.settings.width | default: 24
-%}
{%- capture icon_style -%}font-size: {{ icon_size }}px;{%- endcapture -%}

{%- capture icon_content -%}
  {%- if block.settings.image_upload != blank -%}
    {% render 'image', image: block.settings.image_upload, width: icon_size, height: icon_size, class: 'icon-block__image', img_class: 'w-full h-full object-contain' %}
  {%- elsif has_icon -%}
    {% render 'icon', name: icon_name, style: icon_style %}
  {%- endif -%}
{%- endcapture -%}

<div class="icon-block" {{ block.shopify_attributes }}>
  {%- if block.settings.link != blank -%}
    <a
      href="{{ block.settings.link }}"
      class="text-inherit"
      {%- if block.settings.open_in_new_tab %} target="_blank" rel="noopener"{% endif -%}
    >{{ icon_content }}</a>
  {%- else -%}
    {{ icon_content }}
  {%- endif -%}
</div>

{% stylesheet %}
  .icon-block {
    display: flex;
    flex-shrink: 0;
  }
  .icon-block__image {
    display: block;
  }
{% endstylesheet %}

