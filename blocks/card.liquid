{% doc %}
  Renders a customizable card block.

  @example
  {% content_for 'block', type: 'card', id: 'card' %}
{% enddoc %}

{%- liquid
  assign card_classes = 'card-block flex flex-col relative overflow-hidden transition-all duration-300 w-full h-full'
  
  # Mobile/Desktop hiding
  if block.settings.hide_on_mobile
    assign card_classes = card_classes | append: ' hidden md:flex'
  elsif block.settings.hide_on_desktop
    assign card_classes = card_classes | append: ' flex md:hidden'
  endif

  # Design mapping
  if block.settings.design == 'border' or block.settings.design == 'raised'
    assign card_classes = card_classes | append: ' rounded-2xl'
  endif

  # Background color mapping
  if block.settings.design != 'none'
    case block.settings.background_color
      when 'light'
        assign card_classes = card_classes | append: ' bg-card-light text-primary'
      when 'dark'
        assign card_classes = card_classes | append: ' bg-background-dark text-white'
      when 'transparent'
        assign card_classes = card_classes | append: ' bg-transparent'
    endcase
  endif

  # Apply border / shadow classes based on design style
  if block.settings.design == 'border'
    assign card_classes = card_classes | append: ' border border-outline-variant'
  elsif block.settings.design == 'raised'
    assign card_classes = card_classes | append: ' shadow-sm hover:shadow-md'
  endif

  # Text Alignment
  case block.settings.alignment
    when 'center'
      assign card_classes = card_classes | append: ' text-center items-center'
      assign content_align_class = 'items-center text-center'
    when 'right'
      assign card_classes = card_classes | append: ' text-right items-end'
      assign content_align_class = 'items-end text-right'
    when 'justify'
      assign card_classes = card_classes | append: ' text-justify'
      assign content_align_class = 'items-stretch text-justify'
    else
      assign card_classes = card_classes | append: ' text-left items-start'
      assign content_align_class = 'items-start text-left'
  endcase

  # Background image handling
  assign has_bg_image = false
  if block.settings.image != blank and block.settings.image_placement == 'background'
    assign has_bg_image = true
    assign card_classes = card_classes | append: ' text-white'
  endif

  # Aspect ratio style mapping
  case block.settings.image_aspect_ratio
    when 'square'
      assign aspect_ratio_style = 'aspect-ratio: 1/1'
    when 'portrait'
      assign aspect_ratio_style = 'aspect-ratio: 3/4'
    when 'landscape'
      assign aspect_ratio_style = 'aspect-ratio: 16/9'
    else
      assign aspect_ratio_style = 'aspect-ratio: auto'
    endcase
-%}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    --span-mb: {{ block.settings.span_mobile | default: 4 }};
    --span-tb: {{ block.settings.span_tablet | default: 8 }};
    --span-lg: {{ block.settings.span_desktop | default: 12 }};
    --span-mobile: {{ block.settings.span_mobile | default: 4 }};
    --span-expanded: {{ block.settings.span_tablet | default: 8 }};
    --span-large: {{ block.settings.span_desktop | default: 12 }};
    {%- liquid
      assign padding_top = block.settings.padding_top | default: 24
      assign padding_bottom = block.settings.padding_bottom | default: 24
      assign padding_sides = block.settings.padding_sides | default: 24

      if block.settings.design == 'none'
        if padding_top == 24
          assign padding_top = 16
        endif
        if padding_bottom == 24
          assign padding_bottom = 16
        endif
        if padding_sides == 24
          assign padding_sides = 0
        endif
      endif
    -%}
    --card-padding-top: {{ padding_top }}px;
    --card-padding-bottom: {{ padding_bottom }}px;
    --card-padding-left: {{ padding_sides }}px;
    --card-padding-right: {{ padding_sides }}px;
  }

  #shopify-block-{{ block.id }} .card-content {
    --span-mobile: 4;
    --span-expanded: 8;
    --span-large: 12;
    --section-span-mobile: 4;
    --section-span-expanded: 8;
    --section-span-large: 12;
    {%- if block.settings.block_gap != blank -%}
      --grid-gap: {{ block.settings.block_gap }}px;
      gap: var(--grid-gap);
    {%- endif -%}
    padding-top: var(--card-padding-top);
    padding-bottom: var(--card-padding-bottom);
    padding-left: var(--card-padding-left);
    padding-right: var(--card-padding-right);
  }

  /* Force headers and links to inherit color on dark background cards */
  {%- liquid
    assign force_inherit_color = false
    if block.settings.design != 'none' and block.settings.background_color == 'dark'
      assign force_inherit_color = true
    endif
    if has_bg_image
      assign force_inherit_color = true
    endif
  -%}
  {%- if force_inherit_color -%}
    #shopify-block-{{ block.id }} .rte h1,
    #shopify-block-{{ block.id }} .rte h2,
    #shopify-block-{{ block.id }} .rte h3,
    #shopify-block-{{ block.id }} .rte h4,
    #shopify-block-{{ block.id }} .rte h5,
    #shopify-block-{{ block.id }} .rte h6,
    #shopify-block-{{ block.id }} .card-title {
      color: currentColor !important;
    }
    #shopify-block-{{ block.id }} .rte a {
      color: currentColor !important;
      text-decoration-color: currentColor !important;
    }
  {%- endif -%}
{%- endstyle -%}

<div class="{{ card_classes }}" {{ block.shopify_attributes }}>
  
  {%- if block.settings.image != blank and block.settings.image_placement == 'top' -%}
    {%- liquid
      assign image_wrapper_classes = "w-full overflow-hidden z-10"
      if block.settings.design == 'border'
        assign image_wrapper_classes = image_wrapper_classes | append: " border-b border-inherit"
      endif
    -%}
    <div class="{{ image_wrapper_classes }}">
      {{ block.settings.image | image_url: width: 800 | image_tag: 
        class: 'w-full object-cover',
        style: aspect_ratio_style,
        loading: 'lazy'
      }}
    </div>
  {%- endif -%}

  {%- liquid
    assign card_content_classes = 'card-content w-full z-10 flex-1'
    if block.settings.grid_direction == 'horizontal'
      assign flex_justify = 'justify-start'
      case block.settings.alignment
        when 'center'
          assign flex_justify = 'justify-center'
        when 'right'
          assign flex_justify = 'justify-end'
        when 'justify'
          assign flex_justify = 'justify-between'
      endcase
      assign card_content_classes = card_content_classes | append: ' flex flex-row flex-wrap items-center ' | append: flex_justify
    else
      assign card_content_classes = card_content_classes | append: ' grid-layout'
    endif
  -%}
  <div class="{{ card_content_classes }}">
    {% content_for 'blocks' %}
  </div>

  {%- if block.settings.image != blank and block.settings.image_placement == 'bottom' -%}
    {%- liquid
      assign image_wrapper_classes = "w-full overflow-hidden mt-auto z-10"
      if block.settings.design == 'border'
        assign image_wrapper_classes = image_wrapper_classes | append: " border-t border-inherit"
      endif
    -%}
    <div class="{{ image_wrapper_classes }}">
      {{ block.settings.image | image_url: width: 800 | image_tag: 
        class: 'w-full object-cover',
        style: aspect_ratio_style,
        loading: 'lazy'
      }}
    </div>
  {%- endif -%}

  {%- if has_bg_image -%}
    <div class="absolute inset-0 z-0 pointer-events-none">
      {{ block.settings.image | image_url: width: 1200 | image_tag: 
        class: 'w-full h-full object-cover',
        loading: 'lazy'
      }}
      <div class="absolute inset-0 bg-black/40" style="opacity: {{ block.settings.image_overlay_opacity | divided_by: 100.0 }};"></div>
    </div>
  {%- endif -%}

  {%- if block.settings.card_link != blank -%}
    <a href="{{ block.settings.card_link }}" class="absolute inset-0 z-20 cursor-pointer" aria-label="Card link"></a>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:general.card",
  "class": "shopify-block-card",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Skjul på mobil",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Skjul på desktop",
      "default": false
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "design",
      "label": "t:labels.design",
      "options": [
        { "value": "none", "label": "t:options.design.none" },
        { "value": "border", "label": "t:options.design.border" },
        { "value": "raised", "label": "t:options.design.raised" }
      ],
      "default": "border"
    },
    {
      "type": "select",
      "id": "background_color",
      "label": "t:labels.background",
      "options": [
        { "value": "transparent", "label": "Transparent" },
        { "value": "light", "label": "Light" },
        { "value": "dark", "label": "Dark" }
      ],
      "default": "light",
      "visible_if": "{{ block.settings.design != 'none' }}"
    },
    {
      "type": "select",
      "id": "grid_direction",
      "label": "Grid retning",
      "options": [
        { "value": "vertical", "label": "Lodret (Vertical)" },
        { "value": "horizontal", "label": "Vandret (Horizontal)" }
      ],
      "default": "vertical"
    },
    {
      "type": "select",
      "id": "block_gap",
      "label": "Brugerdefineret afstand (Gap)",
      "options": [
        { "value": "", "label": "Global / Standard" },
        { "value": "0", "label": "0px" },
        { "value": "4", "label": "4px" },
        { "value": "8", "label": "8px" },
        { "value": "12", "label": "12px" },
        { "value": "16", "label": "16px" },
        { "value": "20", "label": "20px" },
        { "value": "24", "label": "24px" },
        { "value": "32", "label": "32px" },
        { "value": "40", "label": "40px" },
        { "value": "48", "label": "48px" },
        { "value": "64", "label": "64px" }
      ],
      "default": ""
    },
    {
      "type": "header",
      "content": "Grid Bredde"
    },
    {
      "type": "select",
      "id": "span_mobile",
      "label": "Bredde på mobil",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "span_tablet",
      "label": "Bredde på tablet",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" },
        { "value": "7", "label": "7" },
        { "value": "8", "label": "8" }
      ],
      "default": "8"
    },
    {
      "type": "select",
      "id": "span_desktop",
      "label": "Bredde på desktop",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" },
        { "value": "7", "label": "7" },
        { "value": "8", "label": "8" },
        { "value": "9", "label": "9" },
        { "value": "10", "label": "10" },
        { "value": "11", "label": "11" },
        { "value": "12", "label": "12" }
      ],
      "default": "12"
    },
    {
      "type": "header",
      "content": "Indhold"
    },
    {
      "type": "url",
      "id": "card_link",
      "label": "t:labels.card_link"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Billede"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Billede"
    },
    {
      "type": "select",
      "id": "image_placement",
      "label": "Billedplacering",
      "options": [
        { "value": "top", "label": "I toppen" },
        { "value": "bottom", "label": "I bunden" },
        { "value": "background", "label": "Som baggrund" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Billedformat",
      "options": [
        { "value": "adapt", "label": "Tilpas" },
        { "value": "square", "label": "Firkantet (1:1)" },
        { "value": "portrait", "label": "Portræt (3:4)" },
        { "value": "landscape", "label": "Landskab (16:9)" }
      ],
      "default": "landscape"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Mørk overlay (kun baggrund)",
      "default": 30
    },
    {
      "type": "header",
      "content": "Indre Afstand (Padding)"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "t:general.card",
      "category": "t:general.layout",
      "settings": {
        "design": "border"
      }
    }
  ]
}
{% endschema %}
