{% doc %}
  Renders a group of blocks with configurable layout direction, gap and
  alignment.

  All settings apply to only one dimension to reduce configuration complexity.

  This component is a wrapper concerned only with rendering its children in
  the specified layout direction with appropriate padding and alignment.

  @example
  {% content_for 'block', type: 'group', id: 'group' %}
{% enddoc %}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    --span-mb: {{ block.settings.span_mobile | default: 4 }};
    --span-tb: {{ block.settings.span_tablet | default: 4 }};
    --span-lg: {{ block.settings.span_desktop | default: 6 }};
    --span-mobile: {{ block.settings.span_mobile | default: 4 }};
    --span-expanded: {{ block.settings.span_tablet | default: 4 }};
    --span-large: {{ block.settings.span_desktop | default: 6 }};
  }

  #shopify-block-{{ block.id }} > .group {
    padding-top: {{ block.settings.padding_top | default: 0 }}px;
    padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    padding-left: {{ block.settings.padding_sides | default: 0 }}px;
    padding-right: {{ block.settings.padding_sides | default: 0 }}px;
  }

  {%- if block.settings.layout_direction == 'group--horizontal' and block.settings.align_left -%}
    #shopify-block-{{ block.id }} > .group--horizontal {
      justify-content: flex-start;
      gap: 8px;
    }
    #shopify-block-{{ block.id }} > .group--horizontal > * {
      width: auto;
      flex: 0 1 auto;
    }
    #shopify-block-{{ block.id }} > .group--horizontal > * > * {
      width: auto;
    }
  {%- endif -%}
{%- endstyle -%}

<div
  class="group {{ block.settings.layout_direction }}{% if block.settings.sticky %} group--sticky{% endif %}"
  style="
    --alignment: {{ block.settings.alignment }};
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>


{% schema %}
{
  "name": "t:general.group",
  "blocks": [{ "type": "@theme" }],
  "settings": [
    {
      "type": "select",
      "id": "span_mobile",
      "label": "Bredde",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "span_tablet",
      "label": "Bredde",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" },
        { "value": "7", "label": "7" },
        { "value": "8", "label": "8" }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "span_desktop",
      "label": "Bredde",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" },
        { "value": "7", "label": "7" },
        { "value": "8", "label": "8" },
        { "value": "9", "label": "9" },
        { "value": "10", "label": "10" },
        { "value": "11", "label": "11" },
        { "value": "12", "label": "12" }
      ],
      "default": "6"
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Gør indhold sticky (fastlåst på desktop)",
      "default": false
    },
    {
      "type": "select",
      "id": "layout_direction",
      "label": "t:labels.layout_direction",
      "default": "group--vertical",
      "options": [
        { "value": "group--horizontal", "label": "t:options.direction.horizontal" },
        { "value": "group--vertical", "label": "t:options.direction.vertical" }
      ]
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:labels.alignment",
      "default": "flex-start",
      "options": [
        { "value": "flex-start", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "flex-end", "label": "t:options.alignment.right" }
      ]
    },
    {
      "type": "checkbox",
      "id": "align_left",
      "label": "Stak elementer til venstre (fjern spredning)",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:general.column",
      "category": "t:general.layout",
      "settings": {
        "layout_direction": "group--vertical",
        "alignment": "flex-start",
        "padding_top": 0,
        "padding_bottom": 0,
        "padding_sides": 0
      }
    }
  ]
}
{% endschema %}
