<div class="accordion-item border-t border-outline-variant py-2 w-full" id="accordion-{{ block.id }}" {{ block.shopify_attributes }}>
  <button class="accordion-trigger flex items-center justify-between w-full text-left font-bold text-primary focus:outline-none">
    <span class="text-base">{{ block.settings.title }}</span>
    <span class="w-12 h-12 flex items-center justify-center flex-shrink-0 text-primary/85 rounded-full hover:bg-black/5 transition-colors">
      <span class="material-symbols-outlined transition-transform duration-200{% if block.settings.open_by_default %} rotate-180{% endif %}">expand_more</span>
    </span>
  </button>
  <div class="rte accordion-content{% unless block.settings.open_by_default %} hidden{% endunless %} mt-1 text-base text-primary/85">
    {{ block.settings.content }}
  </div>
</div>

<script>
  (function() {
    const trigger = document.querySelector('#accordion-{{ block.id }} .accordion-trigger');
    if (!trigger) return;
    trigger.addEventListener('click', function() {
      const content = this.nextElementSibling;
      const icon = this.querySelector('.material-symbols-outlined');
      if (content.classList.contains('hidden')) {
        content.classList.remove('hidden');
        if (icon) icon.classList.add('rotate-180');
      } else {
        content.classList.add('hidden');
        if (icon) icon.classList.remove('rotate-180');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Accordion",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Produktspecifikationer"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Indhold",
      "default": "<p>Indtast indhold her.</p>"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Udfoldet som standard",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Accordion"
    }
  ]
}
{% endschema %}
