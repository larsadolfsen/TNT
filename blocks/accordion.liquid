<div class="accordion-item border-t border-outline-variant py-2 w-full" {{ block.shopify_attributes }}>
  <button class="accordion-trigger flex items-center justify-between w-full text-left font-bold text-primary focus:outline-none">
    <span class="text-sm">{{ block.settings.title }}</span>
    <span class="material-symbols-outlined text-on-surface-variant transition-transform duration-200{% if block.settings.open_by_default %} rotate-180{% endif %}">expand_more</span>
  </button>
  <div class="rte accordion-content{% unless block.settings.open_by_default %} hidden{% endunless %} mt-1 text-sm text-on-surface-variant">
    {{ block.settings.content }}
  </div>
</div>

{% schema %}
{
  "name": "Accordion",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Produktspecifikationer"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Indhold",
      "default": "<p>Indtast indhold her.</p>"
    },
    {
      "type": "checkbox",
      "id": "open_by_default",
      "label": "Udfoldet som standard",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Accordion"
    }
  ]
}
{% endschema %}
