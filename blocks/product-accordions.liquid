{%- style -%}
  #shopify-block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top }}px !important;
    padding-bottom: {{ block.settings.padding_bottom }}px !important;
    padding-left: {{ block.settings.padding_sides }}px !important;
    padding-right: {{ block.settings.padding_sides }}px !important;
  }

  #shopify-section-accordions-{{ block.id }} > *:first-child {
    border-top: 1px solid var(--color-outline-variant);
  }

  #shopify-section-accordions-{{ block.id }} > *:last-child {
    border-bottom: 1px solid var(--color-outline-variant);
  }

  @media screen and (max-width: 767px) {
    .row-section:not(.row-section--full-width) #shopify-block-{{ block.id }} {
      margin-left: -2.5rem !important;
      margin-right: -2.5rem !important;
      width: calc(100% + 5rem) !important;
    }

    .row-section--full-width #shopify-block-{{ block.id }} {
      margin-left: -1rem !important;
      margin-right: -1rem !important;
      width: calc(100% + 2rem) !important;
    }

    #shopify-section-accordions-{{ block.id }} .accordion-trigger,
    #shopify-section-accordions-{{ block.id }} .accordion-content {
      padding-left: 24px !important;
      padding-right: 24px !important;
    }
  }
{%- endstyle -%}

<div class="divide-y divide-outline-variant" id="shopify-section-accordions-{{ block.id }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

<script>
  document.addEventListener("DOMContentLoaded", function() {
    const sectionContainer = document.getElementById("shopify-section-accordions-{{ block.id }}");
    if (!sectionContainer) return;
    
    const triggers = sectionContainer.querySelectorAll(".accordion-trigger");
    triggers.forEach(trigger => {
      if (trigger.dataset.accordionBound === "true") return;
      trigger.dataset.accordionBound = "true";
      
      trigger.addEventListener("click", function() {
        const content = this.nextElementSibling;
        const icon = this.querySelector(".material-symbols-outlined");
        
        if (content.classList.contains("hidden")) {
          content.classList.remove("hidden");
          if (icon) icon.classList.add("rotate-180");
        } else {
          content.classList.add("hidden");
          if (icon) icon.classList.remove("rotate-180");
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Product Accordions",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Accordions"
    }
  ]
}
{% endschema %}
