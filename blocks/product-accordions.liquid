{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    {%- render 'block-padding-vars', block: block -%}
  }

  @media screen and (max-width: 767px) {
    .row-section:not(.row-section--full-width) #shopify-block-{{ block.id }}.shopify-block {
      margin-left: -2.5rem;
      margin-right: -2.5rem;
      width: calc(100% + 5rem);
    }

    .row-section--full-width #shopify-block-{{ block.id }}.shopify-block {
      margin-left: -1rem;
      margin-right: -1rem;
      width: calc(100% + 2rem);
    }

    #shopify-section-accordions-{{ block.id }} .accordion-trigger,
    #shopify-section-accordions-{{ block.id }} .accordion-content {
      padding-left: 24px;
      padding-right: 24px;
    }
  }
{%- endstyle -%}

<div id="shopify-section-accordions-{{ block.id }}" {{ block.shopify_attributes }}>
  {% content_for 'blocks' %}
</div>

<script src="{{ 'product-accordions.min.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "Product Accordions",
  "blocks": [
    {
      "type": "@theme"
    }
  ],
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Accordions",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}
