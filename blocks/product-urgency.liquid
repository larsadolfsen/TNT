{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    {%- render 'block-padding-vars', block: block -%}
  }
{%- endstyle -%}

{% comment %}
  Product Stock Urgency Section
  Renders the stock warning message with an warning icon.
{% endcomment %}

{%- assign btm_variant = nil -%}
{%- for variant in product.variants -%}
  {%- if variant.sku == 'BTM001' -%}
    {%- assign btm_variant = variant -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}

{%- if btm_variant != nil -%}
  {%- assign target_variant = btm_variant -%}
{%- else -%}
  {%- assign target_variant = product.selected_or_first_available_variant -%}
{%- endif -%}

{%- assign show_urgency = block.settings.show_urgency -%}
{%- assign hide_under_limit = block.settings.hide_under_limit | default: 5 -%}

{%- assign urgency_state = 'in-stock' -%}
{%- if target_variant -%}
  {%- if target_variant.inventory_management != blank -%}
    {%- if target_variant.inventory_quantity <= 0 -%}
      {%- assign show_urgency = false -%}
    {%- elsif target_variant.inventory_quantity < hide_under_limit -%}
      {%- assign urgency_state = 'low-stock' -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

<div id="product-urgency-section-{{ block.id }}" style="{% unless show_urgency %}display: none;{% endunless %}" {{ block.shopify_attributes }}>
  <p id="product-urgency-text-{{ block.id }}" class="text-sm font-semibold {% if urgency_state == 'low-stock' %}text-red-700{% else %}text-emerald-600{% endif %}">
    {%- if urgency_state == 'low-stock' -%}
      {%- assign qty = target_variant.inventory_quantity -%}
      {%- assign default_text = "Kun få på lager. Fri fragt på ordrer over 599 kr." -%}
      {%- assign block_text = block.settings.urgency_text | default: default_text -%}
      {{ block_text | replace: 'få', qty | replace: 'Få', qty | replace: '[count]', qty | replace: '[antal]', qty }}
    {%- else -%}
      {%- assign qty = target_variant.inventory_quantity -%}
      {%- assign default_text = "På lager. Fri fragt på ordrer over 599 kr." -%}
      {%- assign block_text = block.settings.in_stock_text | default: default_text -%}
      {{ block_text | replace: '[count]', qty | replace: '[antal]', qty }}
    {%- endif -%}
  </p>
</div>

{%- if product -%}
<script id="product-urgency-variant-data-{{ block.id }}" type="application/json">
  {
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 }},
          "inventory_management": {{ variant.inventory_management | json }},
          "sku": {{ variant.sku | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "hideUnderLimit": {{ hide_under_limit }},
    "urgencyText": {{ block.settings.urgency_text | default: "Kun få på lager. Fri fragt på ordrer over 599 kr." | json }},
    "inStockText": {{ block.settings.in_stock_text | default: "På lager. Fri fragt på ordrer over 599 kr." | json }},
    "showUrgency": {{ block.settings.show_urgency | json }}
  }
</script>

<script src="{{ 'product-urgency.min.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% schema %}
{
  "name": "Product Stock Urgency",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Show stock urgency",
      "default": true
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency Warning Text (Red)",
      "default": "Kun få på lager. Fri fragt på ordrer over 599 kr."
    },
    {
      "type": "text",
      "id": "in_stock_text",
      "label": "In Stock Text (Green)",
      "default": "På lager. Fri fragt på ordrer over 599 kr."
    },
    {
      "type": "number",
      "id": "hide_under_limit",
      "label": "Tærskel for lavt lager",
      "default": 5,
      "info": "Viser rød tekst (kun få på lager) hvis der er under dette antal enheder tilbage. Viser grøn tekst (på lager) hvis der er over eller lig med dette antal enheder tilbage. Banneret skjules hvis varen er helt udsolgt."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Stock Urgency",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}

