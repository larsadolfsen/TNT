{% comment %}
  Product Stock Urgency Section
  Renders the stock warning message with an warning icon.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign show_urgency = block.settings.show_urgency -%}
{%- assign hide_under_limit = block.settings.hide_under_limit | default: 5 -%}

{%- if current_variant and current_variant.inventory_management != blank -%}
  {%- if current_variant.inventory_quantity <= 0 or current_variant.inventory_quantity >= hide_under_limit -%}
    {%- assign show_urgency = false -%}
  {%- endif -%}
{%- endif -%}

<section id="product-urgency-section-{{ block.id }}" class="max-w-screen-xl mx-auto px-4 pt-0 pb-3" style="{% unless show_urgency %}display: none;{% endunless %}">
  <p class="text-xs font-medium text-amber-700">
    {{ block.settings.urgency_text | default: "Kun få på lager – bestil snart" }}
  </p>
</section>

{%- if product -%}
<script id="product-urgency-variant-data-{{ block.id }}" type="application/json">
  {
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 }},
          "inventory_management": {{ variant.inventory_management | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "hideUnderLimit": {{ hide_under_limit }}
  }
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const dataEl = document.getElementById("product-urgency-variant-data-{{ block.id }}");
    const sectionEl = document.getElementById("product-urgency-section-{{ block.id }}");
    if (!dataEl || !sectionEl) return;

    let urgencyData = { variants: [], hideUnderLimit: 5 };
    try {
      urgencyData = JSON.parse(dataEl.textContent);
    } catch (e) {
      console.error("Failed to parse stock urgency data", e);
    }

    function updateUrgency(variantId) {
      {%- unless block.settings.show_urgency -%}
        sectionEl.style.display = "none";
        return;
      {%- endunless -%}

      const variant = urgencyData.variants.find(v => v.id === parseInt(variantId));
      if (!variant) return;

      let show = true;
      if (variant.inventory_management) {
        if (variant.inventory_quantity <= 0 || variant.inventory_quantity >= urgencyData.hideUnderLimit) {
          show = false;
        }
      }

      if (show) {
        sectionEl.style.display = "";
      } else {
        sectionEl.style.display = "none";
      }
    }

    document.addEventListener("variant-changed", (e) => {
      if (e.detail && e.detail.variantId) {
        updateUrgency(e.detail.variantId);
      }
    });
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Product Stock Urgency",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Show stock urgency",
      "default": true
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency Warning Text",
      "default": "Kun få på lager – bestil snart"
    },
    {
      "type": "number",
      "id": "hide_under_limit",
      "label": "Vis kun hvis under X enheder",
      "default": 5,
      "info": "Vis kun stock urgency hvis der er under dette antal enheder tilbage. Banneret skjules også, hvis varen er helt udsolgt."
    }
  ],
  "presets": [
    {
      "name": "Product Stock Urgency"
    }
  ]
}
{% endschema %}

