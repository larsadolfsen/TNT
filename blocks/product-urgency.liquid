{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    --block-padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --block-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    --block-padding-left: {{ block.settings.padding_sides | default: 0 }}px;
    --block-padding-right: {{ block.settings.padding_sides | default: 0 }}px;
  }
{%- endstyle -%}

{% comment %}
  Product Stock Urgency Section
  Renders the stock warning message with an warning icon.
{% endcomment %}

{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- assign show_urgency = block.settings.show_urgency -%}
{%- assign hide_under_limit = block.settings.hide_under_limit | default: 5 -%}

{%- assign urgency_state = 'in-stock' -%}
{%- if current_variant -%}
  {%- if current_variant.inventory_management != blank -%}
    {%- if current_variant.inventory_quantity <= 0 -%}
      {%- assign show_urgency = false -%}
    {%- elsif current_variant.inventory_quantity < hide_under_limit -%}
      {%- assign urgency_state = 'low-stock' -%}
    {%- endif -%}
  {%- endif -%}
{%- endif -%}

<div id="product-urgency-section-{{ block.id }}" style="{% unless show_urgency %}display: none;{% endunless %}" {{ block.shopify_attributes }}>
  <p id="product-urgency-text-{{ block.id }}" class="text-sm font-semibold {% if urgency_state == 'low-stock' %}text-red-700{% else %}text-emerald-600{% endif %}">
    {%- if urgency_state == 'low-stock' -%}
      {{ block.settings.urgency_text | default: "Kun få på lager. Fri fragt på ordrer over 599 kr." }}
    {%- else -%}
      {{ block.settings.in_stock_text | default: "På lager. Fri fragt på ordrer over 599 kr." }}
    {%- endif -%}
  </p>
</div>

{%- if product -%}
<script id="product-urgency-variant-data-{{ block.id }}" type="application/json">
  {
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id }},
          "inventory_quantity": {{ variant.inventory_quantity | default: 0 }},
          "inventory_management": {{ variant.inventory_management | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "hideUnderLimit": {{ hide_under_limit }},
    "urgencyText": {{ block.settings.urgency_text | default: "Kun få på lager. Fri fragt på ordrer over 599 kr." | json }},
    "inStockText": {{ block.settings.in_stock_text | default: "På lager. Fri fragt på ordrer over 599 kr." | json }}
  }
</script>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const dataEl = document.getElementById("product-urgency-variant-data-{{ block.id }}");
    const sectionEl = document.getElementById("product-urgency-section-{{ block.id }}");
    const textEl = document.getElementById("product-urgency-text-{{ block.id }}");
    if (!dataEl || !sectionEl || !textEl) return;

    let urgencyData = { variants: [], hideUnderLimit: 5, urgencyText: "", inStockText: "" };
    try {
      urgencyData = JSON.parse(dataEl.textContent);
    } catch (e) {
      console.error("Failed to parse stock urgency data", e);
    }

    function updateUrgency(variantId) {
      {%- unless block.settings.show_urgency -%}
        sectionEl.style.display = "none";
        return;
      {%- endunless -%}

      const variant = urgencyData.variants.find(v => v.id === parseInt(variantId));
      if (!variant) return;

      let show = true;
      let state = 'in-stock';

      if (variant.inventory_management) {
        if (variant.inventory_quantity <= 0) {
          show = false;
        } else if (variant.inventory_quantity < urgencyData.hideUnderLimit) {
          state = 'low-stock';
        }
      }

      if (show) {
        sectionEl.style.display = "";
        if (state === 'low-stock') {
          textEl.textContent = urgencyData.urgencyText;
          textEl.className = "text-sm font-semibold text-red-700";
        } else {
          textEl.textContent = urgencyData.inStockText;
          textEl.className = "text-sm font-semibold text-emerald-600";
        }
      } else {
        sectionEl.style.display = "none";
      }
    }

    document.addEventListener("variant-changed", (e) => {
      if (e.detail && e.detail.variantId) {
        updateUrgency(e.detail.variantId);
      }
    });
  });
</script>
{%- endif -%}

{% schema %}
{
  "name": "Product Stock Urgency",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_urgency",
      "label": "Show stock urgency",
      "default": true
    },
    {
      "type": "text",
      "id": "urgency_text",
      "label": "Urgency Warning Text (Red)",
      "default": "Kun få på lager. Fri fragt på ordrer over 599 kr."
    },
    {
      "type": "text",
      "id": "in_stock_text",
      "label": "In Stock Text (Green)",
      "default": "På lager. Fri fragt på ordrer over 599 kr."
    },
    {
      "type": "number",
      "id": "hide_under_limit",
      "label": "Tærskel for lavt lager",
      "default": 5,
      "info": "Viser rød tekst (kun få på lager) hvis der er under dette antal enheder tilbage. Viser grøn tekst (på lager) hvis der er over eller lig med dette antal enheder tilbage. Banneret skjules hvis varen er helt udsolgt."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Stock Urgency"
    }
  ]
}
{% endschema %}

