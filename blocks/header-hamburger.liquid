<div class="flex items-center md:hidden" {{ block.shopify_attributes }}>
  <button
    id="menu-toggle"
    class="focus:outline-none bg-transparent border-0 p-0 cursor-pointer flex items-center justify-center hover:opacity-80 transition-opacity"
    aria-label="Menu"
    onclick="toggleMobileMenu(true)"
  >
    <span class="material-symbols-outlined text-2xl text-primary block">menu</span>
  </button>
</div>

<script>
  (function() {
    var blockEl = document.getElementById('shopify-block-{{ block.id }}');
    function fixGroupAlignment() {
      if (!blockEl) return;
      var group = blockEl.closest('.header-group-block');
      if (!group) return;
      if (window.innerWidth >= 768) {
        group.style.justifyContent = 'flex-start';
        group.style.flexGrow = '0';
      } else {
        group.style.justifyContent = '';
        group.style.flexGrow = '';
      }
    }
    document.addEventListener('DOMContentLoaded', fixGroupAlignment);
    window.addEventListener('resize', fixGroupAlignment);
  })();
</script>

{% schema %}
{
  "name": "Mobile Hamburger Menu",
  "settings": [
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Mobile Menu Override"
    }
  ],
  "presets": [
    {
      "name": "Mobile Hamburger Menu"
    }
  ]
}
{% endschema %}
