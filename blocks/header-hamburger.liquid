{%- style -%}
  @media (min-width: 768px) {
    #shopify-block-{{ block.id }} {
      display: none;
    }
  }
{%- endstyle -%}

<div class="flex items-center md:hidden" {{ block.shopify_attributes }}>
  <button
    id="menu-toggle"
    class="focus:outline-none bg-transparent border-0 p-0 cursor-pointer flex items-center justify-center hover:opacity-80 transition-opacity"
    aria-label="Menu"
    onclick="toggleMobileMenu(true)"
  >
    {% render 'icon', name: 'menu', class: 'text-2xl text-primary block' %}
  </button>
</div>

{% schema %}
{
  "name": "Mobile Hamburger Menu",
  "settings": [
    {
      "type": "link_list",
      "id": "mobile_menu",
      "label": "Mobile Menu Override"
    }
  ],
  "presets": [
    {
      "name": "Mobile Hamburger Menu"
    }
  ]
}
{% endschema %}
