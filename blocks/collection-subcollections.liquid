{% doc %}
  Renders a horizontally-scrollable row of PILL/CHIP links for the current
  collection's sub-collections (sourced from a configurable metafield,
  default custom.child), with an active-state highlight and AJAX-swapped
  product grid navigation. Distinct from the grid-of-cards blocks in the
  collection-grid naming cluster (collection-products-grid.liquid,
  subcollections-grid.liquid, collection-children.liquid) - this one is a
  filter/navigation control, not a content grid.
{% enddoc %}

{%- style -%}
  #shopify-block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top | times: 0.75 | round }}px;
    padding-bottom: {{ block.settings.padding_bottom | times: 0.75 | round }}px;
  }

  @media screen and (min-width: 840px) {
    #shopify-block-{{ block.id }} {
      padding-top: {{ block.settings.padding_top }}px;
      padding-bottom: {{ block.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign parent_col = collection.metafields.custom.parent.value

  # If the current collection has a parent, then the parent collection is the main one.
  # Otherwise, the current collection is the main/parent one.
  assign target_parent = collection
  if parent_col != blank
    assign target_parent = parent_col
  endif

  # Retrieve child collections from target_parent using the configured metafield key
  assign metafield_key = block.settings.metafield_key | default: "custom.child"
  assign parts = metafield_key | split: '.'
  assign namespace = parts[0]
  assign key = parts[1]
  assign child_collections = target_parent.metafields[namespace][key].value

  assign has_subcollections = false
  assign own_child_collections = collection.metafields[namespace][key].value
  if own_child_collections != blank
    assign has_subcollections = true
  endif

-%}

{%- if has_subcollections or request.design_mode -%}
<div id="collection-subcollections-container" class="shopify-block-collection-subcollections w-full" {{ block.shopify_attributes }}>
  {%- if block.settings.title != blank -%}
    <h2 class="text-xs font-bold text-primary uppercase tracking-wider mb-3">
      {{ block.settings.title }}
    </h2>
  {%- endif -%}

  <div class="flex overflow-x-auto gap-2.5 pb-2 hide-scrollbar -mx-4 px-4 md:mx-0 md:px-0">

    <!-- Render automatic subcollections from metafield -->
    {%- for sub_col in child_collections -%}
      {%- liquid
        if sub_col == blank
          continue
        endif

        assign is_pill_active = false
        if collection.handle == sub_col.handle
          assign is_pill_active = true
        endif

        assign pill_class = "bg-surface-container text-primary border border-outline-variant hover:border-primary/50"
        if is_pill_active
          assign pill_class = "bg-black text-white border border-black font-bold"
        endif

        assign pill_label = sub_col.metafields.custom.label_override.value | default: sub_col.metafields.custom.label_override | default: sub_col.title
        assign subtitle = sub_col.metafields.custom.subtitle.value | default: sub_col.metafields.custom.subtitle | default: sub_col.metafields.custom.suffix.value | default: sub_col.metafields.custom.suffix
        if subtitle != blank
          assign pill_label = pill_label | append: ' (' | append: subtitle | append: ')'
        endif
      -%}
      <a href="{{ sub_col.url }}" data-collection-chip="true" class="{{ pill_class }} px-5 py-2.5 rounded-full text-xs font-semibold whitespace-nowrap inline-flex items-center justify-center transition-colors no-underline">
        {%- if is_pill_active -%}
          {% render 'icon', name: 'check', class: 'text-[14px] mr-1 select-none pointer-events-none', stroke_width: '3px' %}
        {%- endif -%}
        {{ pill_label }}
      </a>
    {%- endfor -%}

    {%- if has_subcollections == false and request.design_mode -%}
      <!-- Fallback Mockup Data in design mode if empty -->
      <a href="#" data-collection-chip="true" class="bg-surface-container text-primary border border-outline-variant hover:border-primary/50 px-5 py-2.5 rounded-full text-xs font-semibold whitespace-nowrap inline-flex items-center justify-center transition-colors no-underline">
        Børnefamilien (Let rengøring)
      </a>
      <a href="#" data-collection-chip="true" class="bg-surface-container text-primary border border-outline-variant hover:border-primary/50 px-5 py-2.5 rounded-full text-xs font-semibold whitespace-nowrap inline-flex items-center justify-center transition-colors no-underline">
        Havebordet (Udeliv & UV-resistent)
      </a>
      <a href="#" data-collection-chip="true" class="bg-surface-container text-primary border border-outline-variant hover:border-primary/50 px-5 py-2.5 rounded-full text-xs font-semibold whitespace-nowrap inline-flex items-center justify-center transition-colors no-underline">
        Minimalistisk (Diskret beskyttelse)
      </a>
      <a href="#" data-collection-chip="true" class="bg-surface-container text-primary border border-outline-variant hover:border-primary/50 px-5 py-2.5 rounded-full text-xs font-semibold whitespace-nowrap inline-flex items-center justify-center transition-colors no-underline">
        Professionel (Ekstra slidstærk)
      </a>
    {%- endif -%}
  </div>
</div>

<script>
(function() {
  function handleChipClick(e) {
    var chip = e.target.closest('[data-collection-chip="true"]');
    if (!chip || !chip.href || chip.href === '#') return;
    e.preventDefault();
    var targetUrl = chip.href;
    var productGrid = document.getElementById('product-grid');
    var subcollectionsContainer = document.getElementById('collection-subcollections-container');
    var productCountDisplay = document.getElementById('product-count-display');
    var appliedFilters = document.getElementById('applied-filters-container');
    var desktopFilters = document.getElementById('desktop-filters');
    var mobileFilters = document.getElementById('mobile-filters');
    if (productGrid) { productGrid.classList.add('opacity-50', 'pointer-events-none'); }
    fetch(targetUrl)
      .then(function(res) { return res.text(); })
      .then(function(html) {
        var parser = new DOMParser();
        var doc = parser.parseFromString(html, 'text/html');
        var newGrid = doc.getElementById('product-grid');
        if (newGrid && productGrid) { productGrid.innerHTML = newGrid.innerHTML; }
        var newCount = doc.getElementById('product-count-display');
        if (newCount && productCountDisplay) { productCountDisplay.innerText = newCount.innerText; }
        var newApplied = doc.getElementById('applied-filters-container');
        if (newApplied && appliedFilters) {
          appliedFilters.innerHTML = newApplied.innerHTML;
          appliedFilters.className = newApplied.className;
        } else if (appliedFilters) {
          appliedFilters.classList.add('hidden');
        }
        var newDesktop = doc.getElementById('desktop-filters');
        if (newDesktop && desktopFilters) { desktopFilters.innerHTML = newDesktop.innerHTML; }
        var newMobile = doc.getElementById('mobile-filters');
        if (newMobile && mobileFilters) { mobileFilters.innerHTML = newMobile.innerHTML; }
        var newSubs = doc.getElementById('collection-subcollections-container');
        if (newSubs && subcollectionsContainer) {
          subcollectionsContainer.innerHTML = newSubs.innerHTML;
        }
        window.history.pushState({ path: targetUrl }, '', targetUrl);
        if (productGrid) { productGrid.classList.remove('opacity-50', 'pointer-events-none'); }
        if (typeof enhanceColorSwatches === 'function') enhanceColorSwatches();
        if (typeof truncateFilterLists === 'function') truncateFilterLists();
      })
      .catch(function(err) {
        console.error('Chip navigation error:', err);
        if (productGrid) { productGrid.classList.remove('opacity-50', 'pointer-events-none'); }
      });
  }
  document.addEventListener('click', handleChipClick);
})();
</script>

{%- endif -%}

{% schema %}
{
  "name": "Underkollektioner Række",
  "class": "shopify-block-collection-subcollections-wrapper",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Overskrift",
      "default": "SØG UD FRA DIT BEHOV"
    },
    {
      "type": "text",
      "id": "metafield_key",
      "label": "Underkollektioner Metafelt-nøgle / Subcollections Metafield Key",
      "default": "custom.child",
      "info": "Indtast metafelt-nøglen (f.eks. 'custom.child') der indeholder listen af underkollektioner."
    },
    {
      "type": "text",
      "id": "show_all_label",
      "label": "Label til 'Vis alle'",
      "default": "Vis alle"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Underkollektioner Række"
    }
  ]
}
{% endschema %}
