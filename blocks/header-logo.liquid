<div class="flex items-center" {{ block.shopify_attributes }}>
  <style>
    .header-logo-link--{{ block.id }} {
      font-size: {{ block.settings.logo_height }}px;
    }
    {% if block.settings.desktop_align == 'left' %}
    @media (min-width: 768px) {
      .header-group-block:has(#shopify-block-{{ block.id }}) {
        justify-content: flex-start !important;
        flex-grow: 0 !important;
      }
    }
    {% endif %}
  </style>
  <a
    href="{{ routes.root_url }}"
    class="header-logo-link--{{ block.id }} font-serif font-bold text-primary tracking-tight no-underline block hover:opacity-90 transition-opacity"
  >
    {%- if block.settings.logo_text != blank -%}
      {{ block.settings.logo_text }}
    {%- else -%}
      {{ shop.name }}
    {%- endif -%}
  </a>
</div>

{% schema %}
{
  "name": "Logo",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text Override"
    },
    {
      "type": "range",
      "id": "logo_height",
      "min": 12,
      "max": 72,
      "step": 1,
      "unit": "px",
      "default": 24,
      "label": "Height"
    },
    {
      "type": "select",
      "id": "desktop_align",
      "label": "Desktop alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo"
    }
  ]
}
{% endschema %}
