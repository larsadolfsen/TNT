{% doc %}
  Renders a horizontal divider line.

  @example
  {% content_for 'block', type: '_divider', id: 'divider' %}
{% enddoc %}

{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    {%- render 'block-padding-vars', block: block -%}
    --divider-thickness: {{ block.settings.thickness | default: 1 }}px;
    --divider-width: {{ block.settings.width_percent | default: 100 }}%;
  }
{%- endstyle -%}

<div
  class="divider-block{% if block.settings.corner_radius == 'rounded' %} divider-block--rounded{% endif %}"
  {{ block.shopify_attributes }}
></div>

{% schema %}
{
  "name": "t:blocks_layout.divider",
  "settings": [
    {
      "type": "range",
      "id": "thickness",
      "label": "t:blocks_layout.divider_thickness",
      "min": 0.5,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 1
    },
    {
      "type": "select",
      "id": "corner_radius",
      "label": "t:blocks_layout.divider_corner_radius",
      "options": [
        { "value": "square", "label": "t:blocks_layout.corner_radius_square" },
        { "value": "rounded", "label": "t:blocks_layout.corner_radius_rounded" }
      ],
      "default": "square",
      "visible_if": "{{ block.settings.thickness > 1 }}"
    },
    {
      "type": "range",
      "id": "width_percent",
      "label": "t:blocks_layout.divider_length",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "t:blocks_layout.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:blocks_layout.padding_top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:blocks_layout.padding_bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:blocks_layout.divider",
      "category": "t:blocks_layout.category_layout"
    }
  ]
}
{% endschema %}
