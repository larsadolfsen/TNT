{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    --block-padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --block-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    --block-padding-left: {{ block.settings.padding_sides | default: 0 }}px;
    --block-padding-right: {{ block.settings.padding_sides | default: 0 }}px;
  }
{%- endstyle -%}

{% comment %}
  Product Cross-sell Section
  Renders up to 2 merchant-picked cross-sell products as horizontally
  scrollable cards. Each card is snippets/product-card.liquid; an unset
  product slot renders nothing.
{% endcomment %}

<section class="p-4 border-t border-outline-variant" {{ block.shopify_attributes }}>
  <div class="-mx-4 overflow-hidden">
    <div class="flex gap-4 overflow-x-auto hide-scrollbar pt-2 pb-6 px-4 -mt-2 -mb-6">
    <!-- Card 1 -->
    {%- assign cs_prod_1 = block.settings.cross_sell_1 -%}
    {%- if cs_prod_1 != blank -%}
      {% render 'product-card', product: cs_prod_1, class: 'w-44 flex-shrink-0' %}
    {%- endif -%}

    <!-- Card 2 -->
    {%- assign cs_prod_2 = block.settings.cross_sell_2 -%}
    {%- if cs_prod_2 != blank -%}
      {% render 'product-card', product: cs_prod_2, class: 'w-44 flex-shrink-0' %}
    {%- endif -%}
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Cross-sell",
  "class": "shopify-block-product-cross-sell",
  "settings": [
    {
      "type": "product",
      "id": "cross_sell_1",
      "label": "Cross-sell Product 1"
    },
    {
      "type": "product",
      "id": "cross_sell_2",
      "label": "Cross-sell Product 2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Cross-sell",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}
