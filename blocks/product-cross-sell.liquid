{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    --block-padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --block-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    --block-padding-left: {{ block.settings.padding_sides | default: 0 }}px;
    --block-padding-right: {{ block.settings.padding_sides | default: 0 }}px;
  }
{%- endstyle -%}

{% comment %}
  Product Cross-sell Section
  Renders up to 2 cross-sell product cards with quick-add buttons.
{% endcomment %}

<section class="p-4 border-t border-outline-variant" {{ block.shopify_attributes }}>
  <div class="-mx-4 overflow-hidden">
    <div class="flex gap-4 overflow-x-auto hide-scrollbar pt-2 pb-6 px-4 -mt-2 -mb-6">
    <!-- Card 1 -->
    {%- assign cs_prod_1 = block.settings.cross_sell_1 -%}
    {%- if cs_prod_1 != blank -%}
      {% render 'product-card', product: cs_prod_1, class: 'w-44 flex-shrink-0' %}
    {%- else -%}
      <div class="product-card flex flex-col bg-card-light border border-outline-variant rounded-2xl overflow-hidden hover:shadow-md hover:border-primary/40 transition-all duration-300 group relative w-44 flex-shrink-0">
        <div class="relative w-full flex-shrink-0 bg-surface-container overflow-hidden" style="aspect-ratio: 1/1;">
          <img alt="Dugholdere i stål" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuB3q8voEmliO4VwxQb6kInoHXYV4yQ44zu38WSBUJ6infMVqpD0TLdCN7S8v49YIXOfNU0tjjru5XoGEltxlA4uk60WqVoJvFCQsi9IOpT4uAi-IhDeAr7aQN6rqdGxwWJDC-S90tuJvMIEWGLTmgi5WOwrGjCF_xxnZYgVxSKYOzTu57p_vCIyMdptx4s4NHwo_WWVSLrGjtvfuTiqnRJcQZdipeP2LFKWtPPZDBpBRGesbjvCfbI__yH4D43N3l9x5uLHkrQhhK0a" width="300" height="300"/>
        </div>
        <div class="p-3 flex flex-col justify-between flex-1 min-w-0">
          <div class="space-y-1">
            <h3 class="text-sm font-bold text-primary leading-tight hover:text-secondary mb-1 truncate">
              Dugholdere i stål
            </h3>
            <!-- Rating: 5 Stars -->
            <div class="flex items-center gap-1 text-xs text-secondary mt-1">
              <div class="flex text-star-rating gap-0.5">
                <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star</span>
                <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star</span>
                <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star</span>
                <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star</span>
                <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star</span>
              </div>
              <span class="font-bold text-primary ml-1">4.8</span>
              <span class="text-primary/85">(142)</span>
            </div>
          </div>
          <div class="mt-3 space-y-3">
            <div class="flex flex-col items-start gap-1">
              <span class="text-xs text-primary/85 leading-none">Pris</span>
              <span class="text-sm sm:text-base font-bold text-primary leading-none">49,00 kr.</span>
            </div>
            <button data-id="holdere-mock" data-navn="Dugholdere i stål" data-pris="49" class="btn-cross-sell w-full bg-accent hover:brightness-95 text-primary py-2 rounded-full flex items-center justify-center gap-1.5 transition-colors focus:outline-none text-xs sm:text-sm font-bold border-0 cursor-pointer">Køb</button>
          </div>
        </div>
      </div>
    {%- endif -%}

    <!-- Card 2 -->
    {%- assign cs_prod_2 = block.settings.cross_sell_2 -%}
    {%- if cs_prod_2 != blank -%}
      {% render 'product-card', product: cs_prod_2, class: 'w-44 flex-shrink-0' %}
    {%- else -%}
      <div class="product-card flex flex-col bg-card-light border border-outline-variant rounded-2xl overflow-hidden hover:shadow-md hover:border-primary/40 transition-all duration-300 group relative w-44 flex-shrink-0">
        <div class="relative w-full flex-shrink-0 bg-surface-container overflow-hidden" style="aspect-ratio: 1/1;">
          <img alt="Opbevaringspose" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDG8LJSBQCnrrQMlodcn5g-wgXMzOiKvuBRaV3mhi75TiUQignYncFT-v1fsBZJmKDw7UOdeTcQTICqryNUb6qtV7_Sgrg22dqm_ca3chJl6Qzx1z_4VgpmGVP-1ZV3FXIVJ7IcUusZ79HARWIQYpsv4MjFgduq8ZKJmsZhqe4W1bHbDDKdDFWZR8Eduskzguzv-rXcY4zaiicuXI9GC92QlDp_snd-jC-uLyKHYWK64-MY78i88VsnxE_IwcGCHvFnGhSEgW9BS95J" width="300" height="300"/>
        </div>
        <div class="p-3 flex flex-col justify-between flex-1 min-w-0">
          <div class="space-y-1">
            <h3 class="text-sm font-bold text-primary leading-tight hover:text-secondary mb-1 truncate">
              Opbevaringspose
            </h3>
            <!-- Rating: 5 Stars -->
            <div class="flex items-center gap-1 text-xs text-secondary mt-1">
              <div class="flex text-star-rating gap-0.5">
                <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star</span>
                <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star</span>
                <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star</span>
                <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star</span>
                <span class="material-symbols-outlined text-[14px] filled-star select-none" style="font-size: 14px; line-height: 1;">star</span>
              </div>
              <span class="font-bold text-primary ml-1">4.8</span>
              <span class="text-primary/85">(142)</span>
            </div>
          </div>
          <div class="mt-3 space-y-3">
            <div class="flex flex-col items-start gap-1">
              <span class="text-xs text-primary/85 leading-none">Pris</span>
              <span class="text-sm sm:text-base font-bold text-primary leading-none">89,00 kr.</span>
            </div>
            <button data-id="pose-mock" data-navn="Opbevaringspose" data-pris="89" class="btn-cross-sell w-full bg-accent hover:brightness-95 text-primary py-2 rounded-full flex items-center justify-center gap-1.5 transition-colors focus:outline-none text-xs sm:text-sm font-bold border-0 cursor-pointer">Køb</button>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Cross-sell",
  "class": "shopify-block-product-cross-sell",
  "settings": [
    {
      "type": "product",
      "id": "cross_sell_1",
      "label": "Cross-sell Product 1"
    },
    {
      "type": "product",
      "id": "cross_sell_2",
      "label": "Cross-sell Product 2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Product Cross-sell"
    }
  ]
}
{% endschema %}
