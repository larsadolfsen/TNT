<section class="px-4 py-10 bg-surface-container border-y border-outline-variant">
  <div class="max-w-screen-xl mx-auto">
    {%- if block.settings.heading != blank -%}
      <h3 class="text-center font-bold text-primary mb-6">{{ block.settings.heading }}</h3>
    {%- endif -%}
    
    <div class="bg-white p-6 rounded-2xl shadow-sm space-y-3 italic text-center max-w-lg mx-auto">
      <div class="flex justify-center text-amber-500 mb-2">
        {%- for i in (1..block.settings.stars) -%}
          <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1; font-size: 12px;">star</span>
        {%- endfor -%}
      </div>
      
      {%- if block.settings.quote != blank -%}
        <p class="text-sm text-primary">"{{ block.settings.quote }}"</p>
      {%- endif -%}
      
      {%- if block.settings.author != blank -%}
        <p class="text-xs font-bold text-on-surface-variant not-italic">â€” {{ block.settings.author }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Kundeanmeldelse",
  "class": "shopify-block-product-testimonial",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Sektionsoverskrift",
      "default": "Det siger kunderne"
    },
    {
      "type": "range",
      "id": "stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Stjerner",
      "default": 5
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Anmeldelse",
      "default": "Fantastisk kvalitet! Man ser nÃ¦sten ikke at dugen er pÃ¥, og den beskytter vores egetrÃ¦sbord perfekt mod bÃ¸rnenes spild."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Forfatter",
      "default": "Mette S., Verificeret kÃ¸ber"
    }
  ],
  "presets": [
    {
      "name": "Kundeanmeldelse"
    }
  ]
}
{% endschema %}
