{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    --block-padding-top: {{ block.settings.padding_top | default: 0 }}px;
    --block-padding-bottom: {{ block.settings.padding_bottom | default: 0 }}px;
    --block-padding-left: {{ block.settings.padding_sides | default: 0 }}px;
    --block-padding-right: {{ block.settings.padding_sides | default: 0 }}px;
  }

  .testimonial-slider-{{ block.id }} {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-left: 7.5%;
    padding-right: 7.5%;
    padding-bottom: 16px;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .testimonial-slider-{{ block.id }}::-webkit-scrollbar {
    display: none;
  }

  .testimonial-item-{{ block.id }} {
    flex-shrink: 0;
    width: 85%;
    scroll-snap-align: center;
  }

  .testimonial-dot-btn-{{ block.id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    transition: all 0.2s ease-in-out;
    padding: 0;
    border: none;
    cursor: pointer;
  }

  .testimonial-heading-{{ block.id }} {
    padding-left: 24px;
    padding-right: 24px;
  }

  .testimonial-single-card-{{ block.id }} {
    margin-left: 24px;
    margin-right: 24px;
  }

  @media screen and (min-width: 840px) {
    .testimonial-slider-{{ block.id }} {
      display: grid;
      gap: 24px;
      overflow-x: visible;
      padding-left: 0;
      padding-right: 0;
      padding-bottom: 0;
    }

    .testimonial-item-{{ block.id }} {
      width: 100%;
    }

    .testimonial-grid-2-{{ block.id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 896px;
      margin-left: auto;
      margin-right: auto;
    }

    .testimonial-grid-3-{{ block.id }} {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .testimonial-grid-4-{{ block.id }} {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .testimonial-heading-{{ block.id }} {
      padding-left: 0;
      padding-right: 0;
    }

    .testimonial-single-card-{{ block.id }} {
      margin-left: auto;
      margin-right: auto;
    }
  }
{%- endstyle -%}

{%- assign testimonial_count = 0 -%}
{%- if block.settings.quote != blank -%}
  {%- assign testimonial_count = testimonial_count | plus: 1 -%}
{%- endif -%}
{%- if block.settings.quote_2 != blank -%}
  {%- assign testimonial_count = testimonial_count | plus: 1 -%}
{%- endif -%}
{%- if block.settings.quote_3 != blank -%}
  {%- assign testimonial_count = testimonial_count | plus: 1 -%}
{%- endif -%}
{%- if block.settings.quote_4 != blank -%}
  {%- assign testimonial_count = testimonial_count | plus: 1 -%}
{%- endif -%}

<section class="py-8 bg-surface-container" {{ block.shopify_attributes }}>
  <div class="max-w-[var(--page-width)] mx-auto px-0 expanded:px-8">
    {%- if block.settings.heading != blank -%}
      <h3 class="text-center font-bold text-primary mb-6 text-xl expanded:text-2xl testimonial-heading-{{ block.id }}">{{ block.settings.heading }}</h3>
    {%- endif -%}

    {%- if testimonial_count == 1 -%}
      <div class="bg-white p-6 rounded-2xl shadow-sm space-y-3 italic text-center max-w-lg testimonial-single-card-{{ block.id }}">
        <div class="flex justify-center text-amber-500 mb-2">
          {%- for i in (1..block.settings.stars) -%}
            <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1; font-size: 12px;">star</span>
          {%- endfor -%}
        </div>
        {%- if block.settings.quote != blank -%}
          <p class="text-sm text-primary">"{{ block.settings.quote }}"</p>
        {%- endif -%}
        {%- if block.settings.author != blank -%}
          <p class="text-xs font-bold text-on-surface-variant not-italic">— {{ block.settings.author }}</p>
        {%- endif -%}
      </div>
    {%- elsif testimonial_count > 1 -%}
      <div class="relative overflow-hidden">
        <!-- Slider / Grid wrapper -->
        <div 
          id="testimonial-slider-{{ block.id }}" 
          class="testimonial-slider-{{ block.id }} {% if testimonial_count == 2 %}testimonial-grid-2-{{ block.id }}{% elsif testimonial_count == 3 %}testimonial-grid-3-{{ block.id }}{% else %}testimonial-grid-4-{{ block.id }}{% endif %} expanded:px-0"
        >
          <!-- Review 1 -->
          {%- if block.settings.quote != blank -%}
            <div class="testimonial-item-{{ block.id }} bg-white p-6 rounded-2xl shadow-sm space-y-3 italic text-center flex flex-col justify-between">
              <div>
                <div class="flex justify-center text-amber-500 mb-2">
                  {%- for i in (1..block.settings.stars) -%}
                    <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1; font-size: 12px;">star</span>
                  {%- endfor -%}
                </div>
                <p class="text-sm text-primary">"{{ block.settings.quote }}"</p>
              </div>
              {%- if block.settings.author != blank -%}
                <p class="text-xs font-bold text-on-surface-variant not-italic mt-2">— {{ block.settings.author }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}

          <!-- Review 2 -->
          {%- if block.settings.quote_2 != blank -%}
            <div class="testimonial-item-{{ block.id }} bg-white p-6 rounded-2xl shadow-sm space-y-3 italic text-center flex flex-col justify-between">
              <div>
                <div class="flex justify-center text-amber-500 mb-2">
                  {%- for i in (1..block.settings.stars_2) -%}
                    <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1; font-size: 12px;">star</span>
                  {%- endfor -%}
                </div>
                <p class="text-sm text-primary">"{{ block.settings.quote_2 }}"</p>
              </div>
              {%- if block.settings.author_2 != blank -%}
                <p class="text-xs font-bold text-on-surface-variant not-italic mt-2">— {{ block.settings.author_2 }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}

          <!-- Review 3 -->
          {%- if block.settings.quote_3 != blank -%}
            <div class="testimonial-item-{{ block.id }} bg-white p-6 rounded-2xl shadow-sm space-y-3 italic text-center flex flex-col justify-between">
              <div>
                <div class="flex justify-center text-amber-500 mb-2">
                  {%- for i in (1..block.settings.stars_3) -%}
                    <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1; font-size: 12px;">star</span>
                  {%- endfor -%}
                </div>
                <p class="text-sm text-primary">"{{ block.settings.quote_3 }}"</p>
              </div>
              {%- if block.settings.author_3 != blank -%}
                <p class="text-xs font-bold text-on-surface-variant not-italic mt-2">— {{ block.settings.author_3 }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}

          <!-- Review 4 -->
          {%- if block.settings.quote_4 != blank -%}
            <div class="testimonial-item-{{ block.id }} bg-white p-6 rounded-2xl shadow-sm space-y-3 italic text-center flex flex-col justify-between">
              <div>
                <div class="flex justify-center text-amber-500 mb-2">
                  {%- for i in (1..block.settings.stars_4) -%}
                    <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1; font-size: 12px;">star</span>
                  {%- endfor -%}
                </div>
                <p class="text-sm text-primary">"{{ block.settings.quote_4 }}"</p>
              </div>
              {%- if block.settings.author_4 != blank -%}
                <p class="text-xs font-bold text-on-surface-variant not-italic mt-2">— {{ block.settings.author_4 }}</p>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>

        <!-- Slider Dots (Mobile only) -->
        <div class="flex justify-center gap-2 mt-4 expanded:hidden">
          {%- for i in (1..testimonial_count) -%}
            <button 
              type="button" 
              class="testimonial-dot-btn-{{ block.id }} testimonial-dot-{{ block.id }}"
              aria-label="Gå til anmeldelse {{ i }}"
            ></button>
          {%- endfor -%}
        </div>
      </div>

      <script>
        document.addEventListener('DOMContentLoaded', () => {
          const slider = document.getElementById('testimonial-slider-{{ block.id }}');
          const dots = document.querySelectorAll('.testimonial-dot-{{ block.id }}');
          if (!slider || dots.length === 0) return;

          const updateDots = () => {
            const sliderRect = slider.getBoundingClientRect();
            const sliderCenter = sliderRect.left + sliderRect.width / 2;
            
            let closestIndex = 0;
            let minDistance = Infinity;
            
            const items = slider.querySelectorAll('.testimonial-item-{{ block.id }}');
            items.forEach((item, index) => {
              const itemRect = item.getBoundingClientRect();
              const itemCenter = itemRect.left + itemRect.width / 2;
              const distance = Math.abs(sliderCenter - itemCenter);
              if (distance < minDistance) {
                minDistance = distance;
                closestIndex = index;
              }
            });
            
            dots.forEach((dot, index) => {
              if (index === closestIndex) {
                dot.style.backgroundColor = 'var(--color-primary)';
                dot.style.opacity = '1';
              } else {
                dot.style.backgroundColor = 'var(--color-outline-variant)';
                dot.style.opacity = '0.5';
              }
            });
          };

          slider.addEventListener('scroll', updateDots);
          
          dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
              const items = slider.querySelectorAll('.testimonial-item-{{ block.id }}');
              const item = items[index];
              if (item) {
                const offset = item.offsetLeft - (slider.clientWidth - item.clientWidth) / 2;
                slider.scrollTo({
                  left: offset,
                  behavior: 'smooth'
                });
              }
            });
          });
          
          // Initial run to color the dots correctly
          updateDots();
        });
      </script>
    {%- endif -%}
  </div>
</section>

