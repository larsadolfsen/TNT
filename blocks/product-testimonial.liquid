{%- style -%}
  #shopify-block-{{ block.id }} {
    padding-top: {{ block.settings.padding_top }}px !important;
    padding-bottom: {{ block.settings.padding_bottom }}px !important;
    padding-left: {{ block.settings.padding_horizontal }}px !important;
    padding-right: {{ block.settings.padding_horizontal }}px !important;
  }
{%- endstyle -%}

<section class="p-4 bg-surface-container" {{ block.shopify_attributes }}>
    {%- if block.settings.heading != blank -%}
      <h3 class="text-center font-bold text-primary mb-6">{{ block.settings.heading }}</h3>
    {%- endif -%}
    
    <div class="bg-white p-6 rounded-2xl shadow-sm space-y-3 italic text-center max-w-lg mx-auto">
      <div class="flex justify-center text-amber-500 mb-2">
        {%- for i in (1..block.settings.stars) -%}
          <span class="material-symbols-outlined text-[12px]" style="font-variation-settings: 'FILL' 1; font-size: 12px;">star</span>
        {%- endfor -%}
      </div>
      
      {%- if block.settings.quote != blank -%}
        <p class="text-sm text-primary">"{{ block.settings.quote }}"</p>
      {%- endif -%}
      
      {%- if block.settings.author != blank -%}
        <p class="text-xs font-bold text-on-surface-variant not-italic">— {{ block.settings.author }}</p>
      {%- endif -%}
    </div>
</section>

{% schema %}
{
  "name": "Kundeanmeldelse",
  "class": "shopify-block-product-testimonial",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Sektionsoverskrift",
      "default": "Det siger kunderne"
    },
    {
      "type": "range",
      "id": "stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Stjerner",
      "default": 5
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Anmeldelse",
      "default": "Fantastisk kvalitet! Man ser næsten ikke at dugen er på, og den beskytter vores egetræsbord perfekt mod børnenes spild."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Forfatter",
      "default": "Mette S., Verificeret køber"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Sideafstand",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Kundeanmeldelse"
    }
  ]
}
{% endschema %}
