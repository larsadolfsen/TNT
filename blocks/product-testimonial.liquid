{%- style -%}
  #shopify-block-{{ block.id }}.shopify-block {
    {%- render 'block-padding-vars', block: block -%}
  }

  .testimonial-slider-{{ block.id }} {
    display: flex;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    padding-left: 7.5%;
    padding-right: 7.5%;
    padding-bottom: 16px;
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .testimonial-slider-{{ block.id }}::-webkit-scrollbar {
    display: none;
  }

  .testimonial-item-{{ block.id }} {
    flex-shrink: 0;
    width: 85%;
    scroll-snap-align: center;
  }

  .testimonial-item-{{ block.id }},
  .testimonial-single-card-{{ block.id }} {
    --color-primary: var(--color-primary);
  }

  .testimonial-dot-btn-{{ block.id }} {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    transition: all 0.2s ease-in-out;
    padding: 0;
    border: none;
    cursor: pointer;
  }

  .testimonial-heading-{{ block.id }} {
    padding-left: 24px;
    padding-right: 24px;
  }

  .testimonial-single-card-{{ block.id }} {
    margin-left: 24px;
    margin-right: 24px;
  }

  @media screen and (min-width: 840px) {
    .testimonial-slider-{{ block.id }} {
      display: grid;
      gap: 24px;
      overflow-x: visible;
      padding-left: 0;
      padding-right: 0;
      padding-bottom: 0;
    }

    .testimonial-item-{{ block.id }} {
      width: 100%;
    }

    .testimonial-grid-2-{{ block.id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      max-width: 896px;
      margin-left: auto;
      margin-right: auto;
    }

    .testimonial-grid-3-{{ block.id }} {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .testimonial-grid-4-{{ block.id }} {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .testimonial-heading-{{ block.id }} {
      padding-left: 0;
      padding-right: 0;
    }

    .testimonial-single-card-{{ block.id }} {
      margin-left: auto;
      margin-right: auto;
    }
  }
{%- endstyle -%}

{%- assign testimonial_count = 0 -%}
{%- if block.settings.quote != blank -%}
  {%- assign testimonial_count = testimonial_count | plus: 1 -%}
{%- endif -%}
{%- if block.settings.quote_2 != blank -%}
  {%- assign testimonial_count = testimonial_count | plus: 1 -%}
{%- endif -%}
{%- if block.settings.quote_3 != blank -%}
  {%- assign testimonial_count = testimonial_count | plus: 1 -%}
{%- endif -%}
{%- if block.settings.quote_4 != blank -%}
  {%- assign testimonial_count = testimonial_count | plus: 1 -%}
{%- endif -%}

<div class="py-8 bg-transparent" {{ block.shopify_attributes }}>
  <div class="max-w-[var(--page-width)] mx-auto px-0 md:px-8">
    {%- if block.settings.heading != blank -%}
      <h3 class="text-center font-bold text-primary mb-6 text-xl md:text-2xl testimonial-heading-{{ block.id }}">{{ block.settings.heading }}</h3>
    {%- endif -%}

    {%- if testimonial_count == 1 -%}
      {%- render 'testimonial-card',
        block_id: block.id,
        stars: block.settings.stars,
        quote: block.settings.quote,
        author: block.settings.author,
        layout: 'single'
      -%}
    {%- elsif testimonial_count > 1 -%}
      <div class="relative overflow-hidden">
        <!-- Slider / Grid wrapper -->
        <div
          id="testimonial-slider-{{ block.id }}" 
          class="testimonial-slider-{{ block.id }} {% if testimonial_count == 2 %}testimonial-grid-2-{{ block.id }}{% elsif testimonial_count == 3 %}testimonial-grid-3-{{ block.id }}{% else %}testimonial-grid-4-{{ block.id }}{% endif %} md:px-0"
        >
          <!-- Review 1 -->
          {%- if block.settings.quote != blank -%}
            {%- render 'testimonial-card', block_id: block.id, stars: block.settings.stars, quote: block.settings.quote, author: block.settings.author -%}
          {%- endif -%}

          <!-- Review 2 -->
          {%- if block.settings.quote_2 != blank -%}
            {%- render 'testimonial-card', block_id: block.id, stars: block.settings.stars_2, quote: block.settings.quote_2, author: block.settings.author_2 -%}
          {%- endif -%}

          <!-- Review 3 -->
          {%- if block.settings.quote_3 != blank -%}
            {%- render 'testimonial-card', block_id: block.id, stars: block.settings.stars_3, quote: block.settings.quote_3, author: block.settings.author_3 -%}
          {%- endif -%}

          <!-- Review 4 -->
          {%- if block.settings.quote_4 != blank -%}
            {%- render 'testimonial-card', block_id: block.id, stars: block.settings.stars_4, quote: block.settings.quote_4, author: block.settings.author_4 -%}
          {%- endif -%}
        </div>

        <!-- Slider Dots (Mobile only) -->
        <div class="flex justify-center gap-2 mt-4 md:hidden">
          {%- for i in (1..testimonial_count) -%}
            <button
              type="button" 
              class="testimonial-dot-btn-{{ block.id }} testimonial-dot-{{ block.id }}"
              aria-label="Gå til anmeldelse {{ i }}"
            ></button>
          {%- endfor -%}
        </div>
      </div>

      <script src="{{ 'product-testimonial.js' | asset_url }}" defer="defer"></script>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kundeanmeldelse",
  "class": "shopify-block-product-testimonial",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Sektionsoverskrift",
      "default": "Det siger kunderne"
    },
    {
      "type": "header",
      "content": "Anmeldelse 1"
    },
    {
      "type": "range",
      "id": "stars",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Stjerner",
      "default": 5
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Anmeldelse",
      "default": "Fantastisk kvalitet! Man ser næsten ikke at dugen er på, og den beskytter vores egetræsbord perfekt mod børnenes spild."
    },
    {
      "type": "text",
      "id": "author",
      "label": "Forfatter",
      "default": "Mette S., Verificeret køber"
    },
    {
      "type": "header",
      "content": "Anmeldelse 2"
    },
    {
      "type": "range",
      "id": "stars_2",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Stjerner",
      "default": 5
    },
    {
      "type": "textarea",
      "id": "quote_2",
      "label": "Anmeldelse",
      "default": "Super hurtig levering og rigtig flot dug. Målene passede perfekt."
    },
    {
      "type": "text",
      "id": "author_2",
      "label": "Forfatter",
      "default": "Thomas K., Verificeret køber"
    },
    {
      "type": "header",
      "content": "Anmeldelse 3"
    },
    {
      "type": "range",
      "id": "stars_3",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Stjerner",
      "default": 5
    },
    {
      "type": "textarea",
      "id": "quote_3",
      "label": "Anmeldelse",
      "default": "Rigtig god service. Dugen er nem at tørre af og ser virkelig eksklusiv ud."
    },
    {
      "type": "text",
      "id": "author_3",
      "label": "Forfatter",
      "default": "Sofia L., Verificeret køber"
    },
    {
      "type": "header",
      "content": "Anmeldelse 4"
    },
    {
      "type": "range",
      "id": "stars_4",
      "min": 1,
      "max": 5,
      "step": 1,
      "label": "Stjerner",
      "default": 5
    },
    {
      "type": "textarea",
      "id": "quote_4",
      "label": "Anmeldelse",
      "default": "Perfekt beskyttelse til vores spisebord. Dugen ligger stabilt og glider ikke."
    },
    {
      "type": "text",
      "id": "author_4",
      "label": "Forfatter",
      "default": "Jonas M., Verificeret køber"
    },
    {
      "type": "header",
      "content": "Afstand"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i toppen",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i bunden",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_sides",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Afstand i siderne",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Kundeanmeldelse",
      "category": "t:general.product_category"
    }
  ]
}
{% endschema %}
