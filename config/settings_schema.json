[
  {
    "name": "theme_info",
    "theme_name": "TNT",
    "theme_version": "1.0.135",
    "theme_author": "larsadolfsen",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "t:general.typography",
    "settings": [
      {
        "type": "header",
        "content": "t:general.fonts"
      },
      {
        "type": "font_picker",
        "id": "type_header_font",
        "default": "playfair_display_n4",
        "label": "Header font"
      },
      {
        "type": "font_picker",
        "id": "type_body_font",
        "default": "work_sans_n4",
        "label": "Body font"
      }
    ]
  },
  {
    "name": "t:general.layout",
    "settings": [
      {
        "type": "range",
        "id": "max_page_width",
        "min": 1000,
        "max": 2000,
        "step": 20,
        "unit": "px",
        "label": "t:labels.page_width",
        "default": 1440
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "t:labels.page_margin",
        "default": 20
      },
      {
        "type": "range",
        "id": "grid_cols_mobile",
        "min": 1,
        "max": 6,
        "step": 1,
        "label": "Antal layout-kolonner på mobil",
        "default": 2
      },
      {
        "type": "range",
        "id": "grid_cols_tablet",
        "min": 1,
        "max": 8,
        "step": 1,
        "label": "Antal layout-kolonner på tablet",
        "default": 2
      },
      {
        "type": "range",
        "id": "grid_cols_desktop",
        "min": 1,
        "max": 12,
        "step": 1,
        "label": "Antal layout-kolonner på desktop",
        "default": 3
      },
      {
        "type": "checkbox",
        "id": "show_breadcrumbs",
        "label": "Vis brødkrummer / Show breadcrumbs",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "disable_savings_badge",
        "label": "Deaktiver rabatmærkat",
        "default": false
      },
      {
        "type": "checkbox",
        "id": "show_unit_pricing",
        "label": "Vis enhedspris / Show unit pricing (e.g. \"40,00 kr / 100 g\")",
        "default": true
      },
      {
        "type": "text",
        "id": "savings_badge_text",
        "label": "Tekst på rabatmærkat",
        "default": "[savings] % rabat",
        "info": "Brug '[savings]' til at indsætte rabatprocenten. F.eks. '[savings] % rabat'"
      },
      {
        "type": "text",
        "id": "compare_at_price_label",
        "label": "Tekst for før-pris (Normalpris / Listepris)",
        "default": "Normalpris"
      }
    ]
  },
  {
    "name": "Logo & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon-billede / Favicon image",
        "info": "Bliver skaleret til 32x32px / Will be scaled to 32x32px"
      }
    ]
  },
  {
    "name": "Kontakt / Contact",
    "settings": [
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Telefon / Phone"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Email"
      }
    ]
  },
  {
    "name": "Lys Tema / Light Theme",
    "settings": [
      {
        "type": "color",
        "id": "primary_color_light",
        "default": "#0e1a28",
        "label": "Primær farve"
      },
      {
        "type": "color",
        "id": "primary_foreground_color_light",
        "default": "#ffffff",
        "label": "Primær tekst"
      },
      {
        "type": "color",
        "id": "accent_color_light",
        "default": "#FFD814",
        "label": "Accent farve"
      },
      {
        "type": "color",
        "id": "accent_foreground_color_light",
        "default": "#0e1a28",
        "label": "Accent tekst/ikon farve / Accent foreground"
      },
      {
        "type": "color",
        "id": "background_color_light",
        "default": "#ffffff",
        "label": "Side BG"
      },
      {
        "type": "color",
        "id": "background_shade_color_light",
        "default": "#f9f9f9",
        "label": "Baggrund shade farve / Background shade color"
      },
      {
        "type": "color",
        "id": "card_light_color_light",
        "default": "#ffffff",
        "label": "Kort BG"
      },
      {
        "type": "color",
        "id": "card_high_color_light",
        "default": "#f3f4f6",
        "label": "Hævet BG"
      },
      {
        "type": "color",
        "id": "border_color_light",
        "default": "#e2e8f0",
        "label": "Border farve"
      },
      {
        "type": "color",
        "id": "foreground_color_light",
        "default": "#333333",
        "label": "Tekstfarve"
      },
      {
        "type": "header",
        "content": "Generelt / General"
      },
      {
        "type": "color",
        "id": "important_color",
        "default": "#e11d48",
        "label": "Important / Advarselsfarve"
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 10,
        "step": 1,
        "unit": "px",
        "label": "t:labels.input_corner_radius",
        "default": 4
      }
    ]
  },
